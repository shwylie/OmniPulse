{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniPulse",
  "mainBinaryName": "OmniPulse",
  "version": "0.1.0",
  "identifier": "dev.scclient.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "icons/taskbar/*"
    ],
    "externalBin": [
      "binaries/offset-omnipulse"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "omnipulse"
        ]
      }
    }
  }
}
