{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniPulse",
  "mainBinaryName": "OmniPulse",
  "version": "0.2.2",
  "identifier": "dev.scclient.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "icons/taskbar/*"
    ],
    "externalBin": [
      "binaries/omnipulse-offset"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "omnipulse"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFQ0Y4MEMxMDNFNDhCRTYKUldUbWkrUUR3WURQem1TTE93NnBweCtpemIxdjRVWE5HMDVLQUc1QTZZV1E4TGoydG5OdWI2Z0QK",
      "endpoints": [
        "https://github.com/shwylie/omnipulse-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
