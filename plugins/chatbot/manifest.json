{
  "id": "chatbot",
  "name": "OmniPulse Stream Suite",
  "version": "0.3.0",
  "author": "OmniPulse",
  "description": "Everything for your stream in one place: a chatbot with song requests, your own actions and OBS controls; alerts, goals, timers and on-stream widgets; and OBS docks. Works with Twitch and Kick, and YouTube is coming.",
  "main": "main.js",
  "hosts": [
    "id.twitch.tv",
    "api.twitch.tv",
    "irc-ws.chat.twitch.tv",
    "eventsub.wss.twitch.tv",
    "127.0.0.1",
    "www.youtube.com",
    "kick.com",
    "web.kick.com",
    "api.kick.com",
    "id.kick.com",
    "*.platform.kick.com",
    "sockets.streamlabs.com",
    "astro.streamelements.com",
    "opentdb.com",
    "omnipulse-jam.shwylie101.workers.dev"
  ],
  "capabilities": [
    "sockets",
    "app"
  ],
  "section": "Streaming",
  "wip": true,
  "icon": "M4 3h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-5l-4 4v-4H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm3 6a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zm5 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zm5 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z",
  "settings": [
    {
      "key": "twitchClientId",
      "label": "Twitch Client ID",
      "type": "text",
      "note": "Your own, from dev.twitch.tv/console/apps: Register Your Application, any name, OAuth Redirect URL http://localhost, category Chat Bot, Client Type Public. Then copy its Client ID here."
    },
    {
      "key": "twitchSignIn",
      "label": "Your Channel",
      "type": "button",
      "press": "Sign In with Twitch",
      "call": "signInChannel",
      "note": "Your own Twitch account, for your chat and its events (follows, subs, bits, raids...)."
    },
    {
      "key": "twitchSignInCopy",
      "label": "Your Channel, Another Browser",
      "type": "button",
      "press": "Copy Sign-In Link",
      "call": "signInChannelCopy",
      "note": "The sign-in link copied instead, to open where you like."
    },
    {
      "key": "twitchBotSignIn",
      "label": "Bot Account (optional)",
      "type": "button",
      "press": "Sign In the Bot",
      "call": "signInBot",
      "note": "A second Twitch account that posts the replies. Without one, they come from your channel."
    },
    {
      "key": "twitchBotSignInCopy",
      "label": "Bot Account, Another Browser",
      "type": "button",
      "press": "Copy Sign-In Link",
      "call": "signInBotCopy",
      "note": "Paste it into a private window and sign in as the bot there. You stay signed in to your own account in your normal browser."
    },
    {
      "key": "twitchSignOut",
      "label": "Sign Out",
      "type": "button",
      "press": "Sign Out of Twitch",
      "call": "signOut",
      "note": "Forgets both sign-ins on this PC."
    },
    {
      "key": "kickOn",
      "label": "Kick",
      "type": "toggle",
      "default": false,
      "note": "The chatbot also answers your Kick chat, with song requests, your actions and alerts."
    },
    {
      "key": "kickChannel",
      "label": "Kick Channel",
      "type": "text",
      "default": "",
      "note": "The name in your kick.com address. It's filled in when you sign in."
    },
    {
      "key": "kickClientId",
      "label": "Kick Client ID",
      "type": "text",
      "default": "",
      "note": "Your own Kick app. On kick.com, open Settings > Developer and click Create App. Set its Redirect URL to http://localhost:8476/kick and tick all its scopes. Then copy its Client ID here."
    },
    {
      "key": "kickClientSecret",
      "label": "Kick Client Secret",
      "type": "password",
      "default": "",
      "note": "From the same app."
    },
    {
      "key": "kickSignIn",
      "label": "Kick Sign-In",
      "type": "button",
      "press": "Sign In with Kick",
      "call": "signInKick",
      "note": "Your Kick account. The chatbot answers as you."
    },
    {
      "key": "kickSignInCopy",
      "label": "Kick, Another Browser",
      "type": "button",
      "press": "Copy Sign-In Link",
      "call": "signInKickCopy",
      "note": "Copies the sign-in link instead. Open it in a private window on this PC."
    },
    {
      "key": "kickBotSignIn",
      "label": "Kick Bot Account (optional)",
      "type": "button",
      "press": "Sign In the Kick Bot",
      "call": "signInKickBot",
      "note": "A second Kick account that posts the replies, through the same Kick app. Without one, they come from your channel."
    },
    {
      "key": "kickBotSignInCopy",
      "label": "Kick Bot, Another Browser",
      "type": "button",
      "press": "Copy Sign-In Link",
      "call": "signInKickBotCopy",
      "note": "Paste it into a private window on this PC and sign in as the bot there. You stay signed in to your own account in your normal browser."
    },
    {
      "key": "kickSignOut",
      "label": "Kick Sign Out",
      "type": "button",
      "press": "Sign Out of Kick",
      "call": "signOutKick",
      "note": "Forgets both Kick sign-ins on this PC."
    },
    {
      "key": "actionsOpen",
      "label": "Actions",
      "type": "actions",
      "note": "What your chatbot does and when. Each action has a trigger (a command, a message, an event, a timer or the music), then steps that run in order."
    },
    {
      "key": "pointsOn",
      "label": "Points",
      "type": "toggle",
      "default": false,
      "note": "Your own currency, like Mix It Up's. Viewers earn some for chatting while you're live, and spend them in your actions."
    },
    {
      "key": "pointsName",
      "label": "Points' Name",
      "type": "text",
      "default": "points",
      "note": "What they're called in chat (%pointsname%)."
    },
    {
      "key": "pointsAmount",
      "label": "Points Each Time",
      "type": "number",
      "default": 10,
      "note": "For each viewer who's chatted since the last time."
    },
    {
      "key": "pointsEvery",
      "label": "Every",
      "type": "number",
      "default": 10,
      "note": "Minutes."
    },
    {
      "key": "pointsRanks",
      "label": "Ranks",
      "type": "text",
      "default": "0 Newcomer, 100 Regular, 500 Veteran, 2000 Legend",
      "note": "Points, then the rank's name, with commas between: %rank% in an action is a viewer's."
    },
    {
      "key": "pointsOffline",
      "label": "Points While Offline Too",
      "type": "toggle",
      "default": false,
      "note": "When this is off, viewers only earn points while you're live."
    },
    {
      "key": "obsOn",
      "label": "OBS",
      "type": "toggle",
      "default": false,
      "note": "Your actions can switch scenes, show or hide sources, and more. In OBS, open Tools > WebSocket Server Settings, tick Enable WebSocket server, and enter its password below."
    },
    {
      "key": "obsAddress",
      "label": "OBS Address",
      "type": "text",
      "default": "127.0.0.1:4455",
      "note": "Where OBS's WebSocket server is (this PC, its port)."
    },
    {
      "key": "obsPassword",
      "label": "OBS Password",
      "type": "password",
      "default": "",
      "note": "From the same place in OBS (Show Connect Info)."
    },
    {
      "key": "streamlabsToken",
      "label": "Streamlabs Donations",
      "type": "password",
      "default": "",
      "note": "Your Socket API Token. On streamlabs.com, open Settings > API Settings > API Tokens. Donations then start A Donation actions and show as alerts. Leave it empty to turn this off."
    },
    {
      "key": "streamelementsToken",
      "label": "StreamElements Tips",
      "type": "password",
      "default": "",
      "note": "Your JWT Token. On streamelements.com, open your account's Channels page and click Show Secrets. Leave it empty to turn this off."
    },
    {
      "key": "kofiToken",
      "label": "Ko-fi Tips",
      "type": "password",
      "default": "",
      "note": "Your Verification Token. On ko-fi.com, open More > API > Webhooks, then Advanced. Paste your webhook address from Tips and Donations there too. Leave it empty to turn this off."
    },
    {
      "key": "requests",
      "label": "Song Requests",
      "type": "toggle",
      "default": true,
      "note": "!sr (or !request) and a song, !song for what's playing, !wrongsong to take back your last one. Uses Settings > Streaming > Song Requests' limits and replies."
    },
    {
      "key": "alerts",
      "label": "Alerts",
      "type": "toggle",
      "default": true,
      "note": "Follows, subs, resubs, gifts, bits, raids, hype trains and polls, to your alerts on the Stream Widget."
    },
    {
      "key": "srCommands",
      "label": "Request Commands",
      "type": "text",
      "default": "!sr, !request",
      "note": "With commas between."
    },
    {
      "key": "songCommands",
      "label": "Now Playing Commands",
      "type": "text",
      "default": "!song",
      "note": "With commas between."
    },
    {
      "key": "wrongCommands",
      "label": "Wrong Song Commands",
      "type": "text",
      "default": "!wrongsong",
      "note": "With commas between."
    },
    {
      "key": "srWho",
      "label": "Who Can Request",
      "type": "select",
      "default": "everyone",
      "options": [
        "everyone",
        "subscribers",
        "vips",
        "mods"
      ]
    },
    {
      "key": "srCooldown",
      "label": "Wait Between Requests",
      "type": "number",
      "default": 0,
      "note": "Seconds before the same viewer can request again. 0 for no wait."
    },
    {
      "key": "srCost",
      "label": "Points per Request",
      "type": "number",
      "default": 0,
      "note": "With Points on. 0 for free."
    },
    {
      "key": "suiteAnim",
      "label": "Widget Animation",
      "type": "select",
      "default": "rise",
      "note": "How the Suite's widgets come in."
    },
    {
      "key": "suiteTheme",
      "label": "Widget Theme",
      "type": "select",
      "default": "dark",
      "options": ["dark", "glass", "neon", "comic", "minimal", "pastel", "y2k", "pixel", "edge", "sticker"],
      "note": "How the Suite's widgets look."
    },
    { "key": "streamApp", "label": "Your Streaming Software", "type": "select", "default": "", "options": ["", "obs", "meld", "slobs"] },
    {"key": "camSpot", "label": "Where Your Camera Is", "type": "select", "default": "br", "options": ["br", "bl", "tr", "tl", "custom"]},
    {"key": "camX", "label": "Camera Across (%)", "type": "number", "default": 72},
