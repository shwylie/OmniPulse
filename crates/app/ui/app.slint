                                Marquee { text: "There: " + r.old; font-size: 12px; font-weight: 400; ink: Theme.muted; }
                            }
                            VerticalLayout { alignment: center; Pill { label: r.choice; clicked => { root.la-cycle(i); } } }
                        }
                    }
