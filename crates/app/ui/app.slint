}

// Tooltips (as the web app's title="..."): one label for the whole window, put up by a control the
// pointer has rested on for a moment, under it (over it near the window's foot); gone when the pointer
// leaves, the control's clicked, or after a few seconds
/// The window's size, for menus opened near its edges (they open up or to the left instead)
export global Win {
    in-out property <length> w: 1200px;
    in-out property <length> h: 800px;
}

export global Tips {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <length> h;
    in-out property <bool> on;
}

// A control's tooltip: as big as the control it's in, and told when the pointer's over it
component TipSpot inherits Rectangle {
    in property <string> tip;
    in property <bool> hover;
    width: 100%;
    height: 100%;
    Timer {
        interval: 500ms;
        running: root.hover && root.tip != "" && !(Tips.on && Tips.text == root.tip);
        triggered => {
            Tips.text = root.tip;
            Tips.x = root.absolute-position.x + root.width / 2;
            Tips.y = root.absolute-position.y;
            Tips.h = root.height;
            Tips.on = true;
        }
    }
    changed hover => { if (!root.hover && Tips.text == root.tip) { Tips.on = false; } }
}

component Glyph inherits Path {
    in property <string> d;
    commands: d;
    // (shapes with holes: the YouTube screen, Spotify's mark)
    fill-rule: evenodd;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke-width: 0;
}

component IconButton inherits Rectangle {
    in property <string> d;
    in property <string> tip;
    in property <length> size: 36px;
    in property <bool> filled: false;
    in property <color> tint: Theme.muted;
    callback clicked;
    callback right-click(length, length);
    width: size;
    height: size;
    border-radius: size / 2;
    background: filled ? Theme.accent : (ta.has-hover ? Theme.elevated : transparent);
    Glyph { d: root.d; width: root.size * 0.55; height: root.size * 0.55; fill: filled ? Theme.on-accent : (ta.has-hover ? Theme.text : root.tint); }
    TipSpot { tip: root.tip; hover: ta.has-hover; }
    ta := TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) { root.right-click(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } clicked => { Tips.on = false; root.clicked(); } }
}

component RoundButton inherits Rectangle {
    in property <string> d;
    in property <string> tip;
    in property <bool> enabled: true;
    callback clicked;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: Theme.bg.mix(Theme.panel, ta.has-hover && root.enabled ? 0.45 : 0.7);
    opacity: root.enabled ? 1 : 0.45;
    Glyph { d: root.d; width: 20px; height: 20px; fill: Theme.text; }
    TipSpot { tip: root.tip; hover: ta.has-hover; }
    ta := TouchArea { enabled: root.enabled; clicked => { Tips.on = false; root.clicked(); } }
}

component Pill inherits Rectangle {
    in property <string> label;
    in property <string> tip;
    in property <string> d;
    in property <bool> on;
    callback clicked;
    callback right-click(length, length);
    height: 38px;
    width: t.preferred-width + 36px + (root.d != "" ? 20px : 0px);
    border-radius: 19px;
    border-width: 1px;
    border-color: root.on ? Theme.accent : (ta.has-hover ? Theme.muted : Theme.line);
    background: root.on ? Theme.accent.with-alpha(0.14) : transparent;
    HorizontalLayout {
        spacing: 6px;
        alignment: center;
        if root.d != "": VerticalLayout { alignment: center; Glyph { d: root.d; width: 14px; height: 14px; fill: root.on ? Theme.accent : Theme.muted; } }
        t := Text { text: root.label; color: Theme.text; font-size: 13px; font-weight: 600; vertical-alignment: center; }
    }
    TipSpot { tip: root.tip; hover: ta.has-hover; }
    ta := TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) { root.right-click(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } clicked => { Tips.on = false; root.clicked(); } }
}

component Range inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> value;
    in property <bool> enabled: true;
    /// as it's dragged, and where it's let go
    callback changed(float);
    callback released(float);
    height: 20px;
    min-width: 40px;
    property <float> drag: -1;
    property <float> shown: root.drag >= 0 ? root.drag : root.value;
    property <float> frac: max(0, min(1, (root.shown - root.minimum) / max(0.0001, root.maximum - root.minimum)));
    property <float> at: max(0, min(1, ta.mouse-x / max(1px, root.width)));
    opacity: root.enabled ? 1 : 0.45;
    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.text.with-alpha(0.18);
        Rectangle { x: 0; width: parent.width * root.frac; height: 100%; border-radius: 2px; background: Theme.accent; }
    }
    Rectangle {
        x: (root.width - 14px) * root.frac;
        y: (root.height - 14px) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: ta.has-hover || ta.pressed ? Theme.accent.brighter(0.15) : Theme.accent;
        border-width: 2px;
        border-color: Theme.panel;
    }
    ta := TouchArea {
        enabled: root.enabled;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.drag = root.minimum + root.at * (root.maximum - root.minimum);
                root.changed(root.drag);
            } else if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.drag >= 0) {
                root.released(root.drag);
                root.drag = -1;
            }
        }
        moved => {
            if (self.pressed) {
                root.drag = root.minimum + root.at * (root.maximum - root.minimum);
                root.changed(root.drag);
            }
        }
    }
}

// A slider of named steps (Theme, Tint Strength): a notch at each, the thumb only ever on one (dragged,
// it moves from notch to notch), each name under its own notch
component Steps inherits Rectangle {
    in property <[string]> names;
    in property <int> value;
    callback changed(int);
    property <int> n: root.names.length;
    property <length> pad: 7px;
    property <length> span: max(1px, root.width - 14px);
    property <int> at: max(0, min(root.n - 1, round((ta.mouse-x - root.pad) / root.span * (root.n - 1))));
    height: 44px;
    min-width: 120px;
    // the track, filled up to the step it's on
    Rectangle {
        x: root.pad;
        y: 8px;
        width: root.span;
        height: 4px;
        border-radius: 2px;
        background: Theme.text.with-alpha(0.18);
        Rectangle { x: 0; width: root.span * root.value / max(1, root.n - 1); height: 100%; border-radius: 2px; background: Theme.accent; }
    }
    // a notch at each step
    for nm[i] in root.names: Rectangle {
        x: root.pad + root.span * i / max(1, root.n - 1) - 1px;
        y: 3px;
        width: 2px;
        height: 14px;
        border-radius: 1px;
        background: i <= root.value ? Theme.accent : Theme.text.with-alpha(0.32);
    }
    Rectangle {
        x: root.span * root.value / max(1, root.n - 1);
        y: 3px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: ta.has-hover || ta.pressed ? Theme.accent.brighter(0.15) : Theme.accent;
        border-width: 2px;
        border-color: Theme.panel;
    }
    // each name under its notch (the first and last kept inside)
    for nm[i] in root.names: Text {
        text: nm;
        y: 24px;
        x: i == 0 ? 0px : i == root.n - 1 ? root.width - self.width : root.pad + root.span * i / max(1, root.n - 1) - self.width / 2;
        color: i == root.value ? Theme.text : Theme.muted;
        font-size: 12px;
        font-weight: i == root.value ? 700 : 400;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down && root.at != root.value) { root.changed(root.at); }
        }
        moved => { if (self.pressed && root.at != root.value) { root.changed(root.at); } }
    }
}

/// Waveform: the song's own shape as its progress (each bar's loudness, 0 to 1), clicked to go there
component WaveBar inherits Rectangle {
    in property <[float]> wave;
    in property <float> value;
    callback released(float);
    height: 26px;
    property <float> hover-at: wta.has-hover ? wta.mouse-x / max(1px, self.width) : -1;
    for v[k] in root.wave: Rectangle {
        property <length> step: root.width / max(1, root.wave.length);
        property <float> at: (k + 0.5) / max(1, root.wave.length);
        x: k * self.step;
        width: max(1px, self.step * 0.7);
        height: max(2px, root.height * v);
        y: (root.height - self.height) / 2;
        border-radius: 1px;
        background: self.at <= root.value ? Theme.accent : root.hover-at >= 0 && self.at <= root.hover-at ? Theme.accent.with-alpha(0.45) : Theme.text.with-alpha(0.22);
    }
    wta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.released(self.mouse-x / max(1px, root.width)); } }
}

/// Turntable: the cover as a record, turning while it plays
component Record inherits Rectangle {
    in property <image> art;
    in property <bool> spin;
    in property <length> size: 62px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: #0b0b0d;
    border-width: 1px;
    border-color: #ffffff22;
    // (the clock read only while it turns: still, nothing's drawn again)
    property <angle> turn: root.spin && Theme.motion ? mod(animation-tick() / 1ms, 1800) / 1800 * 360deg : 0deg;
    Rectangle { x: root.size * 0.09; y: root.size * 0.09; width: root.size * 0.82; height: self.width; border-radius: self.width / 2; border-width: 1px; border-color: #ffffff12; }
    Rectangle { x: root.size * 0.17; y: root.size * 0.17; width: root.size * 0.66; height: self.width; border-radius: self.width / 2; border-width: 1px; border-color: #ffffff10; }
    Rectangle {
        x: root.size * 0.27; y: root.size * 0.27; width: root.size * 0.46; height: self.width;
        border-radius: self.width / 2;
        clip: true;
        background: Theme.accent;
        Image { source: root.art; width: parent.width; height: parent.height; image-fit: cover; transform-rotation: root.turn; }
    }
    Rectangle { x: (root.size - 5px) / 2; y: (root.size - 5px) / 2; width: 5px; height: 5px; border-radius: 2.5px; background: #0b0b0d; }
}

/// The equalizer as a graphic EQ: a slider for each band on a grid from +12 to -12 dB, the curve drawn through
/// them (made by the app, in a 1000 by 240 box), dragged up or down, double-clicked back to 0
component GraphicEq inherits Rectangle {
    in property <[float]> gains;
    in property <string> curve;
    in property <string> curve-fill;
    callback band(int, float);
    // (its curve's box, as wide for its height as it's drawn: the app makes the curve to fit it, a path being
    // scaled the same both ways)
    callback shape(float);
    property <float> aspect: (self.area-w - self.band-w) / max(1px, self.plot-h);
    changed aspect => { root.shape(self.aspect); }
    init => { root.shape(self.aspect); }
    height: 210px;
    border-radius: 12px;
    background: Theme.bg;
    border-width: 1px;
    border-color: Theme.line;
    property <length> top: 18px;
    property <length> bottom: 30px;
    property <length> plot-h: self.height - self.top - self.bottom;
    property <length> left: 40px;
    property <length> area-w: self.width - self.left - 12px;
    property <length> band-w: self.area-w / 10;
    for k in 5: Rectangle { x: root.left; y: root.top + root.plot-h * k / 4; width: root.area-w; height: 1px; background: k == 2 ? Theme.line : Theme.line.with-alpha(0.45); }
    for k in 5: Text { x: 8px; y: root.top + root.plot-h * k / 4 - 7px; text: ["+12", "+6", "0", "-6", "-12"][k]; color: Theme.muted; font-size: 10px; }
    // (the curve through the sliders, and under it, a wash of the accent)
    Path { x: root.left + root.band-w / 2; y: root.top; width: root.area-w - root.band-w; height: root.plot-h; viewbox-width: 240 * root.aspect; viewbox-height: 240; commands: root.curve-fill; fill: @linear-gradient(180deg, Theme.accent.with-alpha(0.28) 0%, Theme.accent.with-alpha(0.02) 100%); stroke-width: 0; }
    Path { x: root.left + root.band-w / 2; y: root.top; width: root.area-w - root.band-w; height: root.plot-h; viewbox-width: 240 * root.aspect; viewbox-height: 240; commands: root.curve; stroke: @linear-gradient(90deg, Theme.accent 0%, Theme.accent-2 100%); stroke-width: 2px; fill: transparent; }
    for g[i] in root.gains: Rectangle {
        x: root.left + i * root.band-w;
        y: root.top;
        width: root.band-w;
        height: root.plot-h;
        Rectangle { x: (parent.width - 4px) / 2; width: 4px; height: parent.height; border-radius: 2px; background: Theme.line.with-alpha(0.55); }
        knob := Rectangle {
            width: 16px; height: 16px; border-radius: 8px;
            x: (parent.width - self.width) / 2;
            y: parent.height * (12 - g) / 24 - 8px;
            background: Theme.accent;
            border-width: 2px;
            border-color: Theme.bg;
        }
        if ta.has-hover || ta.pressed: Text { x: (parent.width - self.width) / 2; y: knob.y - 18px; text: (g > 0 ? "+" : "") + round(g) + " dB"; color: Theme.text; font-size: 11px; font-weight: 700; }
        Text { y: parent.height + 9px; width: parent.width; horizontal-alignment: center; text: ["31", "62", "125", "250", "500", "1k", "2k", "4k", "8k", "16k"][i]; color: Theme.muted; font-size: 11px; }
        ta := TouchArea {
            mouse-cursor: MouseCursor.ns-resize;
            // (from where the pointer is: the top +12 dB, the foot -12)
            pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.band(i, max(-12, min(12, round(12 - self.mouse-y / self.height * 24)))); } }
            moved => { if (self.pressed) { root.band(i, max(-12, min(12, round(12 - self.mouse-y / self.height * 24)))); } }
            double-clicked => { root.band(i, 0); }
        }
    }
}

component Progress inherits Rectangle {
    /// where it is (0 to 1), and the track's length in seconds (for the time shown while pointed at)
    in property <float> value;
    in property <float> length-secs;
    /// the next track being found (the song before still playing, its progress behind, not draggable),
    /// or found ahead while this one plays: a marquee glides along the bar, as Windows Vista's did
    in property <bool> loading;
    in property <bool> preloading;
    /// a mix playing (Seamless Mix): the played part sweeps from one accent to the other
    in property <bool> mixing;
    callback released(float);
    height: 16px;
    property <float> drag: -1;
    property <float> at: max(0, min(1, ta.mouse-x / max(1px, root.width)));
    property <float> frac: max(0, min(1, root.drag >= 0 ? root.drag : root.value));
    property <bool> live: ta.has-hover || root.drag >= 0;
    property <float> tip-secs: (root.drag >= 0 ? root.drag : root.at) * root.length-secs;
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: root.live ? 6px : 3px;
        animate height { duration: Theme.motion ? 120ms : 0ms; }
        border-radius: 3px;
        background: Theme.text.with-alpha(0.16);
        clip: true;
        Rectangle { x: 0; width: parent.width * root.frac; height: 100%; background: Theme.accent; opacity: root.loading ? 0.6 : 1; }
        if root.mixing: Rectangle {
            property <float> ph: mod(animation-tick() / 1ms, 1400) / 1400;
            x: 0;
            width: parent.width * root.frac;
            height: 100%;
            clip: true;
            Rectangle {
                x: -parent.width + parent.width * 2 * parent.ph;
                width: parent.width * 2;
                height: 100%;
                background: @linear-gradient(90deg, Theme.accent 0%, Theme.accent-2 25%, Theme.accent 50%, Theme.accent-2 75%, Theme.accent 100%);
            }
        }
    }
    if root.loading || root.preloading: Rectangle {
        // (a layer of its own, clipped to the bar's length; the glow fades in and out near its ends)
        y: (parent.height - self.height) / 2;
        height: 14px;
        clip: true;
        property <float> phase: mod(animation-tick() / 1ms, 1600) / 1600;
        property <length> glow: root.width * 0.24;
        Rectangle {
            x: -parent.glow + (root.width + parent.glow) * parent.phase;
            width: parent.glow;
            height: 12px;
            y: 1px;
            border-radius: 6px;
            opacity: min(1, min(parent.phase * 5, (1 - parent.phase) * 5));
            background: @radial-gradient(circle, #ffffff 0%, Theme.accent.mix(#ffffff, 0.3) 30%, Theme.accent.with-alpha(0.55) 60%, transparent 100%);
        }
    }
    // the time there, above it
    if root.live && root.length-secs > 0: Rectangle {
        property <int> secs: floor(root.tip-secs);
        x: max(0px, min(root.width - self.width, root.width * (root.drag >= 0 ? root.drag : root.at) - self.width / 2));
        y: -22px;
        width: tip.preferred-width + 12px;
        height: 18px;
        border-radius: 6px;
        background: Theme.elevated;
        tip := Text { text: floor(parent.secs / 60) + ":" + (mod(parent.secs, 60) < 10 ? "0" : "") + mod(parent.secs, 60); color: Theme.text; font-size: 11px; }
    }
    if root.live: Rectangle {
        x: root.width * root.frac - 6px;
        y: (root.height - 12px) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.accent;
    }
    ta := TouchArea {
        enabled: !root.loading;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.drag = root.at;
            } else if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.drag >= 0) {
                root.released(root.drag);
                root.drag = -1;
            }
        }
        moved => { if (self.pressed) { root.drag = root.at; } }
    }
}

// A line of text too long for its room: it scrolls (a pause at its start, along to its end, a pause,
// back), never cut short with an ellipsis; one that fits just shows. (Animations off: it stays still.)
component Marquee inherits Rectangle {
    in property <string> text;
    in property <brush> ink: Theme.text;
    in property <length> font-size: 14px;
    in property <int> font-weight: 700;
    in property <bool> right;
    clip: true;
    height: t.preferred-height;
    preferred-width: t.preferred-width;
    min-width: 0;
    property <length> over: max(0px, t.preferred-width - root.width);
    // (a one-way glide as long as it is: about 40 px a second, a second and a half at least)
    property <float> per: max(1500, root.over / 1px * 25);
    property <float> ph: mod(animation-tick() / 1ms, root.per * 2 + 4000);
    property <float> k: !Theme.motion || root.over <= 0 ? 0
        : root.ph < 2000 ? 0
        : root.ph < 2000 + root.per ? (root.ph - 2000) / root.per
        : root.ph < 4000 + root.per ? 1
        : max(0, 1 - (root.ph - 4000 - root.per) / root.per);
    t := Text {
        text: root.text;
        color: root.ink;
        font-size: root.font-size;
        font-weight: root.font-weight;
        width: self.preferred-width;
        vertical-alignment: center;
        x: root.over > 0 ? -root.over * root.k : (root.right ? root.width - self.width : 0px);
    }
}

component MenuRow inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    /// (where the sound plays: OmniPulse Offset plays here, a ring and its name)
    in property <bool> offset;
    /// (opens a list: an arrow after it; the way back: one before it)
    in property <bool> more;
    in property <bool> back;
    callback clicked;
    height: 32px;
    border-radius: 6px;
    background: ta.has-hover ? Theme.accent.with-alpha(0.22) : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Rectangle { width: 8px; Rectangle { width: 8px; height: 8px; y: (parent.height - self.height) / 2; border-radius: 4px; background: root.on ? Theme.accent : transparent; } }
        if root.offset: Rectangle { width: 8px; Rectangle { width: 8px; height: 8px; y: (parent.height - self.height) / 2; border-radius: 4px; border-width: 2px; border-color: Theme.accent-2; } }
        if root.back: Text { text: "\u{2039}"; color: Theme.accent; font-size: 16px; vertical-alignment: center; }
        Text { text: root.label; color: Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        if root.more: Text { text: "\u{203a}"; color: Theme.accent; font-size: 16px; vertical-alignment: center; }
        if root.offset: Text { text: "Offset"; color: Theme.accent-2; font-size: 11px; font-weight: 700; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

/// One entry of our own right-click menu: a label (or a line), shown or not, and which of the two
/// lists it opens instead (1, 2), if any
export struct MenuEnt { label: string, show: bool, sep: bool, sub: int }

/// Our own right-click menu, in the app's look (Slint's own only follows light or dark): placed over
/// what it's for, opened by open() from that one's right-click. A list entry ("Add to Playlist >")
/// shows that list in its place, with a way back. picked(entry, which in its list, or -1)
component CtxMenu inherits Rectangle {
    in property <[MenuEnt]> items;
    in property <[string]> list1;
    in property <[string]> list1-more;
    in property <[string]> list2;
    in property <[string]> list2-more;
    in property <bool> enabled: true;
    callback picked(int, int);
    property <int> sub: 0;
    property <int> from: -1;
    property <length> px;
    property <length> py;
    /// (x, y: where it was right-clicked, in the window: the menu opens there, wherever this sits)
    public function open(x: length, y: length) {
        if (!root.enabled) { return; }
        root.sub = 0;
        root.px = x - root.absolute-position.x;
        root.py = y - root.absolute-position.y;
        pop.show();
    }
    function pick(n: int, k: int) {
        pop.close();
        root.picked(n, k);
    }
    pop := PopupWindow {
        // (kept in the window: up from the pointer near the bottom, left of it near the right)
        x: root.absolute-position.x + root.px + 250px > Win.w - 8px ? root.px - 250px : root.px;
        y: root.absolute-position.y + root.py + frame.preferred-height > Win.h - 8px ? max(root.py - frame.preferred-height, 8px - root.absolute-position.y) : root.py;
        width: 250px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        frame := Rectangle {
            background: Theme.menu;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000070;
            VerticalLayout {
                padding: 6px;
                if root.sub == 0: VerticalLayout {
                    for m[n] in root.items: VerticalLayout {
                        if m.show && m.sep: Rectangle { height: 9px; Rectangle { height: 1px; background: Theme.line; } }
                        if m.show && !m.sep: MenuRow {
                            label: m.label;
                            more: m.sub > 0;
                            clicked => { if (m.sub > 0) { root.from = n; root.sub = m.sub; } else { root.pick(n, -1); } }
                        }
                    }
                }
                if root.sub > 0: VerticalLayout {
                    MenuRow { label: "Back"; back: true; clicked => { root.sub = 0; } }
                    Rectangle { height: 9px; Rectangle { height: 1px; background: Theme.line; } }
                    Flickable {
                        height: min(col.preferred-height, 360px);
                        col := VerticalLayout {
                            if root.sub == 1: VerticalLayout {
                                for l[k] in root.list1: MenuRow { label: l; clicked => { root.pick(root.from, k); } }
                                for l[k] in root.list1-more: MenuRow { label: l; clicked => { root.pick(root.from, root.list1.length + k); } }
                            }
                            if root.sub == 2: VerticalLayout {
                                for l[k] in root.list2: MenuRow { label: l; clicked => { root.pick(root.from, k); } }
                                for l[k] in root.list2-more: MenuRow { label: l; clicked => { root.pick(root.from, root.list2.length + k); } }
                            }
                        }
                    }
                }
            }
        }
    }
}

/// Rounded corners for a gradient (the software renderer draws gradients square-cornered): at each
/// corner asked for, the colour outside it with a quarter circle of the gradient's colour there. Laid
/// over the shape, the size of it.
component Caps inherits Rectangle {
    in property <length> r;
    in property <color> outside: Theme.bg;
    in property <color> tl;
    in property <color> tr;
    in property <color> bl;
    in property <color> br;
    in property <bool> top: true;
    in property <bool> bottom: false;
    in property <bool> left: true;
    in property <bool> right: true;
    if root.r > 0 && root.top && root.left: Rectangle { x: 0; y: 0; width: root.r; height: root.r; clip: true; background: root.outside;
        Rectangle { x: 0; y: 0; width: root.r * 2; height: root.r * 2; border-radius: root.r; background: root.tl; } }
    if root.r > 0 && root.top && root.right: Rectangle { x: parent.width - root.r; y: 0; width: root.r; height: root.r; clip: true; background: root.outside;
        Rectangle { x: -root.r; y: 0; width: root.r * 2; height: root.r * 2; border-radius: root.r; background: root.tr; } }
    if root.r > 0 && root.bottom && root.left: Rectangle { x: 0; y: parent.height - root.r; width: root.r; height: root.r; clip: true; background: root.outside;
        Rectangle { x: 0; y: -root.r; width: root.r * 2; height: root.r * 2; border-radius: root.r; background: root.bl; } }
    if root.r > 0 && root.bottom && root.right: Rectangle { x: parent.width - root.r; y: parent.height - root.r; width: root.r; height: root.r; clip: true; background: root.outside;
        Rectangle { x: -root.r; y: -root.r; width: root.r * 2; height: root.r * 2; border-radius: root.r; background: root.br; } }
}

/// A page's top: both accents across it (the first on the left, the second on the right, as the web
/// app's), fading down into the panel
component AccentGlow inherits Rectangle {
    // Settings' (all but App & Look, which stays as the pages are, to preview them): the same accents, but
    // softer, the other way round, over a deeper panel, so it's plainly not one of the music's pages
    in property <bool> settings;
    in property <color> base: Theme.panel;
    y: 0;
    height: root.settings ? 220px : 340px;
    property <color> c1: root.settings ? Theme.plain-panel.mix(Theme.accent-2, 0.82) : Theme.plain-panel.mix(Theme.accent, 0.66);
    property <color> c2: root.settings ? Theme.plain-panel.mix(Theme.accent, 0.82) : Theme.plain-panel.mix(Theme.accent-2, 0.66);
    // (solid panels: the accents across it, fading down into the panel, which is the same colour all the way)
    if !Theme.aurora: Rectangle { background: @linear-gradient(90deg, root.c1 0%, root.c2 100%); }
    if !Theme.aurora: Rectangle { background: @linear-gradient(180deg, root.base.with-alpha(0) 0%, root.base 100%); }
    if !Theme.aurora: Caps { r: Theme.panel-radius; tl: root.c1; tr: root.c2; }
    // (Aurora's see-through panels: a fade to the panel's colour would end in a band where the page shows the
    // aurora through it; so two soft glows of the accents instead, see-through all the way out, as the aurora's)
    if Theme.aurora: Rectangle {
        clip: true;
        border-radius: Theme.panel-radius;
        property <length> s: root.height * 2.4;
        Rectangle { x: parent.width * 0.18 - parent.s / 2; y: -parent.s / 2; width: parent.s; height: parent.s;
            background: @radial-gradient(circle, (root.settings ? Theme.accent-2 : Theme.accent).with-alpha(root.settings ? 0.28 : 0.42) 0%, transparent 70%); }
        Rectangle { x: parent.width * 0.82 - parent.s / 2; y: -parent.s / 2; width: parent.s; height: parent.s;
            background: @radial-gradient(circle, (root.settings ? Theme.accent : Theme.accent-2).with-alpha(root.settings ? 0.28 : 0.42) 0%, transparent 70%); }
    }
}

/// A choice from a list, as the web app's dropdowns: what's chosen, and a ▾; a click shows the list, in a
/// menu of the app's look (up from it near the window's foot; it scrolls when it's long)
component Dropdown inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    in property <bool> enabled: true;
    /// shown when none of them is chosen
    in property <string> placeholder;
    callback picked(int);
    // (as wide as the web app's, never stretched across the row)
    width: 220px;
    height: 34px;
    border-radius: 8px;
    background: dta.has-hover && root.enabled ? Theme.elevated : Theme.panel;
    border-width: 1px;
    border-color: dta.has-hover && root.enabled ? Theme.accent.with-alpha(0.6) : Theme.line;
    opacity: root.enabled ? 1 : 0.45;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;
        Text { text: root.current >= 0 && root.current < root.options.length ? root.options[root.current] : root.placeholder; color: root.current >= 0 ? Theme.text : Theme.muted; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        VerticalLayout { alignment: center; Path { commands: "M 2 4 L 6 8 L 10 4"; viewbox-width: 12; viewbox-height: 12; width: 10px; height: 10px; stroke: Theme.muted; stroke-width: 1.6px; fill: transparent; } }
    }
    dta := TouchArea { enabled: root.enabled; mouse-cursor: MouseCursor.pointer; clicked => { pop.show(); } }
    // (a long list: at most 330 px of it, scrolled; and no taller than the window has room for, above or below)
    property <length> room-below: Win.h - 8px - (root.absolute-position.y + root.height + 4px);
    property <length> room-above: root.absolute-position.y - 12px;
    // (its list's height, from how many there are: a menu row is 32 px, 6 px round them)
    property <length> full-h: root.options.length * 32px + 12px;
    property <bool> up: self.full-h > self.room-below && self.room-above > self.room-below;
    property <length> list-h: min(self.full-h, 330px, max(120px, self.up ? self.room-above : self.room-below));
    pop := PopupWindow {
        x: 0;
        y: root.up ? -root.list-h - 4px : root.height + 4px;
        width: max(root.width, 200px);
        height: root.list-h;
        close-policy: PopupClosePolicy.close-on-click-outside;
        list := Rectangle {
            background: Theme.menu;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000070;
            height: root.list-h;
            clip: true;
            ScrollView {
                horizontal-scrollbar-policy: always-off;
                vertical-scrollbar-policy: root.full-h > root.list-h ? ScrollBarPolicy.as-needed : ScrollBarPolicy.always-off;
                col := VerticalLayout {
                    padding: 6px;
                    for o[k] in root.options: MenuRow { label: o; on: k == root.current; clicked => { root.picked(k); pop.close(); } }
                }
            }
        }
    }
}

/// A fold's arrow: > folded, v open (drawn as the dropdowns' arrow is)
component Chevron inherits Path {
    in property <bool> open;
    in property <color> tint: Theme.muted;
    width: 10px;
    height: 10px;
    commands: root.open ? "M 2 4 L 6 8 L 10 4" : "M 4 2 L 8 6 L 4 10";
    viewbox-width: 12;
    viewbox-height: 12;
    stroke: root.tint;
    stroke-width: 1.6px;
    fill: transparent;
}

/// A menu in categories, as Streamer.bot's: each opened with a click; a search over them all
component GroupedPicker inherits Rectangle {
    in property <[MenuEntry]> entries;
    in property <string> label;
    in property <string> placeholder;
    callback picked(int);
    callback query(string);
    property <string> open-cat;
    property <string> q;
    width: 260px;
    height: 34px;
    border-radius: 8px;
    background: gpa.has-hover ? Theme.elevated : Theme.panel;
    border-width: 1px;
    border-color: gpa.has-hover ? Theme.accent.with-alpha(0.6) : Theme.line;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;
        Text { text: root.label != "" ? root.label : root.placeholder; color: root.label != "" ? Theme.text : Theme.muted; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        VerticalLayout { alignment: center; Path { commands: "M 2 4 L 6 8 L 10 4"; viewbox-width: 12; viewbox-height: 12; width: 10px; height: 10px; stroke: Theme.muted; stroke-width: 1.6px; fill: transparent; } }
    }
    gpa := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { pop.show(); } }
    property <length> room-below: Win.h - 8px - (root.absolute-position.y + root.height + 4px);
    property <bool> up: root.room-below < 260px && root.absolute-position.y - 12px > root.room-below;
    property <length> most: min(400px, max(160px, root.up ? root.absolute-position.y - 12px : root.room-below));
    pop := PopupWindow {
        x: 0;
        y: root.up ? -gpl.height - 4px : root.height + 4px;
        width: max(root.width, 300px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        gpl := Rectangle {
            height: min(root.most, gpc.preferred-height + 50px);
            background: Theme.menu;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000070;
            clip: true;
            VerticalLayout {
                padding: 6px;
                spacing: 4px;
                Rectangle {
                    clip: true;
                    height: 32px;
                    border-radius: 8px;
                    background: Theme.bg;
                    border-width: 1px;
                    border-color: gpq.has-focus ? Theme.accent : Theme.line;
                    Glyph { d: Icons.search; x: 9px; width: 13px; height: 13px; y: (parent.height - self.height) / 2; fill: Theme.muted; }
                    if root.q == "": Text { x: 30px; height: parent.height; vertical-alignment: center; text: "Find one"; color: Theme.muted; font-size: 12px; }
                    gpq := TextInput { property <length> sx; cursor-position-changed(p) => { if (p.x + self.sx < 0px) { self.sx = -p.x; } else if (p.x + self.sx > parent.width - 40px - 2px) { self.sx = parent.width - 40px - 2px - p.x; } }  x: 30px + min(0px, max(parent.width - 40px - self.width, self.sx)); width: max(parent.width - 40px, self.preferred-width + 4px); height: parent.height; vertical-alignment: center; color: Theme.text; font-size: 12px; single-line: true; edited => { root.q = self.text; root.query(self.text); } }
                }
                ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    gpc := VerticalLayout {
                        for e[i] in root.entries: VerticalLayout {
                            // (a category: opened or closed)
                            if e.head && root.q == "": Rectangle {
                                height: 32px;
                                border-radius: 6px;
                                background: gph.has-hover ? Theme.panel : transparent;
                                gph := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.open-cat = root.open-cat == e.cat ? "" : e.cat; } }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    Text { text: e.cat; color: Theme.text; font-size: 13px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                                    VerticalLayout { alignment: center; Chevron { open: root.open-cat == e.cat; tint: Theme.muted; } }
                                }
                            }
                            if !e.head && ((root.q == "" && root.open-cat == e.cat) || (root.q != "" && e.hit)): HorizontalLayout {
                                padding-left: root.q == "" ? 12px : 0px;
                                MenuRow { horizontal-stretch: 1; label: root.q != "" ? e.cat + " \u{203a} " + e.label : e.label; on: root.q == "" && e.cat + " \u{203a} " + e.label == root.label; clicked => { root.picked(i); pop.close(); } }
                            }
                        }
                    }
                }
            }
        }
    }
}

/// A value stepped down and up, as the web app's − / +
component Stepper inherits HorizontalLayout {
    in property <string> value;
    in property <bool> can-down: true;
    in property <bool> can-up: true;
    callback down();
    callback up();
    spacing: 6px;
    alignment: end;
    VerticalLayout { alignment: center; Pill { label: "\u{2212}"; opacity: root.can-down ? 1 : 0.4; clicked => { if (root.can-down) { root.down(); } } } }
    Text { text: root.value; min-width: 52px; color: Theme.text; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    VerticalLayout { alignment: center; Pill { label: "+"; opacity: root.can-up ? 1 : 0.4; clicked => { if (root.can-up) { root.up(); } } } }
}

/// A song's menu, the same wherever it's right-clicked (a page's row, a tile, Stats, the queue), as
/// the web app's openTrackMenu: what it does comes back by name in act()
component TrackMenu inherits CtxMenu {
    in property <Row> item;
    /// your playlists on this PC (to add to)
    in property <[string]> lists;
    /// in a playlist of yours: Remove from This Playlist
    in property <bool> removable;
    /// a queue row: Remove from Queue and Shuffle Next Up; the one playing has no Play or Play Next
    in property <bool> queue-row;
    callback act(string);
    items: [
        { label: "Play", show: !(root.queue-row && root.item.playing) },
        { label: "Play Next", show: !(root.queue-row && root.item.playing) },
        { label: "Add to Queue", show: !root.queue-row },
        { label: "Remove from Queue", show: root.queue-row && !root.item.playing },
        { label: "Shuffle Next Up", show: root.queue-row },
        { label: "Add to Playlist", show: true, sub: 1 },
        { sep: true, show: true },
        { label: root.item.liked ? "Remove from Likes" : "Add to Likes", show: root.item.can-like },
        { label: root.item.fav ? "Remove from Favourites" : "Add to Favourites", show: root.item.fav-on },
        { label: "Go to Artist", show: root.item.artists.length > 1, sub: 2 },
        { label: "Go to Artist", show: root.item.artists.length <= 1 },
        { label: "Go to " + root.item.uploader + " (Uploader)", show: root.item.uploader != "" },
        { label: "Remove from This Playlist", show: root.removable },
        { sep: true, show: true },
        { label: "Don't Recommend This Track", show: true },
        { label: "Don't Recommend This Album", show: root.item.album != "" },
        { label: "Don't Recommend " + root.item.artist, show: root.item.artist != "" },
        { label: root.item.cleared, show: root.item.cleared != "" },
        { sep: true, show: root.item.open-label != "" || root.item.sc-link || root.item.sp-link || root.item.yt-link },
        { label: root.item.open-label, show: root.item.open-label != "" },
        { label: "Copy SoundCloud Link", show: root.item.sc-link },
        { label: "Copy Spotify Link", show: root.item.sp-link },
        { label: "Copy YouTube Music Link", show: root.item.yt-link },
        { sep: true, show: true },
        { label: "Track Preferences...", show: true },
        { sep: true, show: root.item.versions != "" || root.item.version },
        { label: "More Versions", show: root.item.versions != "" || root.item.version }
    ];
    list1: root.lists;
    list1-more: ["New Playlist..."];
    list2: root.item.artists;
    picked(n, k) => {
        if (n == 0) { root.act("play"); }
        if (n == 1) { root.act("next"); }
        if (n == 2) { root.act("add"); }
        if (n == 3) { root.act("remove"); }
        if (n == 4) { root.act("shuffle"); }
        if (n == 5) { if (k < root.lists.length) { root.act("pl" + k); } else if (k == root.lists.length + 0) { root.act("plnew"); } }
        if (n == 7) { root.act("like"); }
        if (n == 8) { root.act("fav"); }
        if (n == 9) { if (k < root.item.artists.length) { root.act("artist:" + k); } }
        if (n == 10) { root.act("artist:0"); }
        if (n == 11) { root.act("uploader"); }
        if (n == 12) { root.act("plremove"); }
        if (n == 14) { root.act("hide:track"); }
        if (n == 15) { root.act("hide:album"); }
        if (n == 16) { root.act("hide:artist"); }
        if (n == 17) { root.act("cleared"); }
        if (n == 19) { root.act("open"); }
        if (n == 20) { root.act("link:soundcloud"); }
        if (n == 21) { root.act("link:spotify"); }
        if (n == 22) { root.act("link:youtube"); }
        if (n == 24) { root.act("prefs"); }
        if (n == 26) { root.act("moreversions"); }
    }
}

component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled();
    width: 42px;
    height: 24px;
    border-radius: 12px;
    background: root.checked ? Theme.accent : Theme.line;
    animate background { duration: Theme.motion ? 150ms : 0ms; }
    Rectangle {
        x: root.checked ? parent.width - self.width - 3px : 3px;
        animate x { duration: Theme.motion ? 150ms : 0ms; easing: ease-out; }
        y: 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.checked ? Theme.on-accent : Theme.muted;
    }
    TouchArea { clicked => { root.checked = !root.checked; root.toggled(); } }
}

/// A switch in a row: centred in it, however tall the row (a layout doesn't heed a switch's own y)
component CenterToggle inherits VerticalLayout {
    in-out property <bool> checked;
    callback toggled();
    alignment: center;
    Toggle { checked <=> root.checked; toggled => { root.toggled(); } }
}


component PlatIcon inherits Rectangle {
    in property <string> plat;
    in property <bool> title-bar;   // (YouTube Music's own mark there)
    in property <brush> fill: root.plat == "xpl" ? transparent : root.plat == "spotify" ? #1ed760 : root.plat == "youtube" ? #ff0033 : root.plat == "local" ? #f2b544 : root.plat == "musicbrainz" ? #ba478f : root.plat == "plugin" ? #38bdf8 : root.plat == "deezer" ? #a238ff : root.plat == "itunes" ? #fa2d48 : #ff5500;
    if root.plat != "xpl": Glyph { d: root.plat == "xpl" ? Icons.xpl : root.plat == "spotify" ? Icons.spotify : root.plat == "youtube" ? (root.title-bar ? Icons.youtube-mark : Icons.youtube) : root.plat == "local" ? Icons.local : root.plat == "musicbrainz" ? Icons.musicbrainz : root.plat == "plugin" ? Icons.plugin : root.plat == "deezer" ? Icons.deezer : root.plat == "itunes" ? Icons.itunes : Icons.soundcloud; fill: root.fill; width: parent.width; height: parent.height; }
    // (a playlist on this PC: the web app's rainbow, as a picture: a gradient on a shape is drawn against the
    // window here, not the icon, and slides as the list does)
    if root.plat == "xpl": Image { source: @image-url("xpl.svg"); width: parent.width; height: parent.height; }
}

/// The visualiser, wherever it's shown (Now Playing, the player, full screen): Bars from the foot, Mirror
/// from the middle, Peaks (Bars, each one's recent top held), Blocks (an LED meter's segments), Wave (a
/// smooth line through them), Centre (the low end in the middle, mirrored out). Each bar glides to where it's
/// sent (30 times a second), so it never steps.
/// The Wave's paths, from the app (viz::wave_paths), for every visualiser showing it
export global VizPaths {
    in-out property <string> line;
    in-out property <string> area;
}

component VizView inherits Rectangle {
    in property <string> style;
    in property <[float]> bands;
    in property <[float]> peaks;
    in property <[float]> curve;
    in property <float> strength: 1;
    property <bool> mirror: root.style == "mirror";
    property <duration> glide: Theme.motion ? 90ms : 0ms;
    // Bars, Mirror, Peaks: a bar a band
    if root.style == "bars" || root.style == "mirror" || root.style == "peaks": Rectangle {
        for v[k] in root.bands: Rectangle {
            property <length> step: root.width / max(1, root.bands.length);
            x: k * self.step + self.step * 0.15;
            width: self.step * 0.7;
            height: max(2px, root.height * v);
            animate height { duration: root.glide; easing: ease-out; }
            y: root.mirror ? (root.height - self.height) / 2 : root.height - self.height;
            border-radius: min(self.width, self.height) / 2;
            background: Theme.accent.mix(Theme.accent-2, 1 - k / max(1, root.bands.length - 1)).with-alpha(root.strength);
        }
    }
    if root.style == "peaks": Rectangle {
        for p[k] in root.peaks: Rectangle {
            property <length> step: root.width / max(1, root.peaks.length);
            x: k * self.step + self.step * 0.15;
            width: self.step * 0.7;
            height: 3px;
            y: max(0px, root.height - root.height * p - 6px);
            animate y { duration: root.glide; easing: ease-out; }
            border-radius: 1.5px;
            background: Theme.text.with-alpha(0.8 * root.strength);
        }
    }
    // Blocks: each band's segments lit up to its level (12 to a column)
    if root.style == "blocks": Rectangle {
        for v[k] in root.bands: Rectangle {
            property <length> step: root.width / max(1, root.bands.length);
            property <length> seg: root.height / 12;
            x: k * self.step + self.step * 0.12;
            width: self.step * 0.76;
            for n in 12: Rectangle {
                y: root.height - (n + 1) * parent.seg;
                height: parent.seg * 0.7;
                border-radius: 1.5px;
                property <bool> lit: (n + 0.5) / 12 <= v;
                background: Theme.accent.mix(Theme.accent-2, 1 - n / 11).with-alpha(self.lit ? root.strength : 0.08 * root.strength);
                animate background { duration: Theme.motion ? 120ms : 0ms; }
            }
        }
    }
    // Wave: one smooth line through the bands, the area under it faint (until the app's sent its paths: a dot
    // each step)
    if root.style == "wave" && VizPaths.line != "": Rectangle {
        Path {
            width: root.width;
            height: root.height;
            viewbox-width: 1000;
            viewbox-height: 1000;
            commands: VizPaths.area;
            fill: @linear-gradient(180deg, Theme.accent-2.with-alpha(0.32 * root.strength) 0%, Theme.accent.with-alpha(0.04 * root.strength) 100%);
        }
        Path {
            width: root.width;
            height: root.height;
            viewbox-width: 1000;
            viewbox-height: 1000;
            commands: VizPaths.line;
            fill: transparent;
            stroke: @linear-gradient(90deg, Theme.accent.with-alpha(root.strength) 0%, Theme.accent-2.with-alpha(root.strength) 100%);
            stroke-width: max(2.5px, root.height / 40);
        }
    }
    if root.style == "wave" && VizPaths.line == "": Rectangle {
        for v[k] in root.curve: Rectangle {
            property <length> step: root.width / max(1, root.curve.length);
            x: k * self.step;
            width: max(2px, self.step * 1.05);
            y: root.height * (1 - v) * 0.86 + root.height * 0.07 - self.width / 2;
            animate y { duration: root.glide; easing: ease-out; }
            height: self.width;
            border-radius: self.width / 2;
            background: Theme.accent.mix(Theme.accent-2, 1 - k / max(1, root.curve.length - 1)).with-alpha(root.strength);
            // (the fill under the line, faint)
            Rectangle {
                y: parent.height / 2;
                height: max(0px, root.height - parent.y - parent.height / 2);
                width: parent.width;
                background: @linear-gradient(180deg, Theme.accent.mix(Theme.accent-2, 1 - k / max(1, root.curve.length - 1)).with-alpha(0.28 * root.strength) 0%, transparent 100%);
            }
        }
    }
    // Centre: the low end in the middle, the highs out to both edges
    if root.style == "centre": Rectangle {
        for v[k] in root.bands: Rectangle {
            property <length> step: root.width / max(1, root.bands.length * 2);
            property <length> h: max(2px, root.height * v);
            animate h { duration: root.glide; easing: ease-out; }
            property <color> c: Theme.accent.mix(Theme.accent-2, 1 - k / max(1, root.bands.length - 1)).with-alpha(root.strength);
            Rectangle { x: root.width / 2 + k * parent.step + parent.step * 0.15; width: parent.step * 0.7; height: parent.h; y: (root.height - self.height) / 2; border-radius: min(self.width, self.height) / 2; background: parent.c; }
            Rectangle { x: root.width / 2 - (k + 1) * parent.step + parent.step * 0.15; width: parent.step * 0.7; height: parent.h; y: (root.height - self.height) / 2; border-radius: min(self.width, self.height) / 2; background: parent.c; }
        }
    }
}

/// Ring (as Proximity's round its logo, the cover ours): one solid wave round the cover, out from its edges all the
/// way round, each its own frequency: the bass at the middle of its foot, out along it, up its sides, the highs
/// meeting in the middle of its top; the left half and the right mirrored. Laid over the cover, drawn outside it
component VizRing inherits Rectangle {
    // (its slices, from the app: viz::ring_pieces', over the whole box, the cover in its middle; each its own
    // step of the gradient, as the bars are, the bass's colour at the foot and the highs' at the top)
    in property <[RingPiece]> pieces;
    in property <float> strength: 1;
    // (one outline, the cover's circle cut out (even-odd); its gradient the bars', the bass's colour at the foot
    // and the highs' at the top; a fine line of the same along its edge, to keep the edge clean)
    for p in root.pieces: Path {
        width: root.width;
        height: root.height;
        viewbox-width: 1000;
        viewbox-height: 1000;
        commands: p.d;
        fill-rule: evenodd;
        fill: @linear-gradient(0deg, Theme.accent.with-alpha(root.strength) 0%, Theme.accent-2.with-alpha(root.strength) 100%);
        stroke: @linear-gradient(0deg, Theme.accent.with-alpha(root.strength * 0.55) 0%, Theme.accent-2.with-alpha(root.strength * 0.55) 100%);
        stroke-width: 1.2px;
    }
}

/// An action's trigger's or step's fields, each a row: its label and note, and its box, list or switch
component FlowFieldsView inherits VerticalLayout {
    in property <[FlowField]> fields;
    callback changed(int, string);
    callback picked(int, int);
    spacing: 8px;
    for fl[i] in root.fields: HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            if fl.label != "": Text { text: fl.label; color: Theme.text; font-size: 13px; font-weight: 600; }
            if fl.note != "": Text { text: fl.note; color: Theme.muted; font-size: 11px; wrap: word-wrap; min-height: self.preferred-height; }
        }
        if fl.kind == "text" || fl.kind == "number": Rectangle {
            clip: true;
            width: fl.kind == "number" ? 90px : 280px;
            height: 32px;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            background: Theme.bg;
            border-width: 1px;
            border-color: fti.has-focus ? Theme.accent : Theme.line;
            fti := TextInput { property <length> sx; cursor-position-changed(p) => { if (p.x + self.sx < 0px) { self.sx = -p.x; } else if (p.x + self.sx > parent.width - 20px - 2px) { self.sx = parent.width - 20px - 2px - p.x; } }  x: 10px + min(0px, max(parent.width - 20px - self.width, self.sx)); width: max(parent.width - 20px, self.preferred-width + 4px); height: parent.height; vertical-alignment: center; color: Theme.text; font-size: 13px; single-line: true; input-type: fl.kind == "number" ? InputType.decimal : InputType.text; text: fl.value; edited => { root.changed(i, self.text); } }
        }
        if fl.kind == "select": VerticalLayout { alignment: center; Dropdown { options: fl.options; current: fl.at; picked(k) => { root.picked(i, k); } } }
        // (a program: typed, or picked from the ones open now)
        if fl.kind == "program" || fl.kind == "scene" || fl.kind == "source" || fl.kind == "reward" || fl.kind == "mscene" || fl.kind == "mlayer" || fl.kind == "meffect" || fl.kind == "mtrack" || fl.kind == "sscene" || fl.kind == "ssource": VerticalLayout {
            alignment: center;
            spacing: 6px;
            Rectangle {
                clip: true;
                width: 280px;
                height: 32px;
                border-radius: 8px;
                background: Theme.bg;
                border-width: 1px;
                border-color: fpti.has-focus ? Theme.accent : Theme.line;
                fpti := TextInput { property <length> sx; cursor-position-changed(p) => { if (p.x + self.sx < 0px) { self.sx = -p.x; } else if (p.x + self.sx > parent.width - 20px - 2px) { self.sx = parent.width - 20px - 2px - p.x; } }  x: 10px + min(0px, max(parent.width - 20px - self.width, self.sx)); width: max(parent.width - 20px, self.preferred-width + 4px); height: parent.height; vertical-alignment: center; color: Theme.text; font-size: 13px; single-line: true; text: fl.value; edited => { root.changed(i, self.text); } }
            }
            Dropdown { width: 280px; options: fl.options; current: -1;
                placeholder: fl.kind == "program" ? (fl.options.length > 0 ? "Pick one that's open now" : "No other programs open") : fl.kind == "reward" ? "Pick a reward, or make one"
                    : fl.kind == "scene" || fl.kind == "mscene" || fl.kind == "sscene" ? "Pick a scene" : fl.kind == "mlayer" ? "Pick a layer" : fl.kind == "meffect" ? "Pick an effect" : fl.kind == "mtrack" ? "Pick an audio track" : "Pick a source";
                picked(k) => { root.picked(i, k); } }
        }
        if fl.kind == "toggle": CenterToggle { checked: fl.value == "true"; toggled => { root.changed(i, self.checked ? "true" : "false"); } }
    }
}

/// A card of an action's flow: its trigger ("WHEN"), or a step (its number): which kind it is, what it
/// says, its fields; a step's can be moved up or down, or taken out
component FlowCard inherits Rectangle {
    in property <[MenuEntry]> menu;
    in property <string> label;
    callback menu-query(string);
    in property <string> badge;
    in property <bool> trigger;
    in property <[string]> types;
    in property <int> type-at;
    in property <string> note;
    in property <[FlowField]> fields;
    in property <bool> first;
    in property <bool> last;
    callback type-picked(int);
    callback changed(int, string);
    callback picked(int, int);
    callback up();
    callback down();
    callback remove();
    border-radius: 12px;
    background: Theme.panel;
    border-width: 1px;
    border-color: root.trigger ? Theme.accent.with-alpha(0.7) : Theme.line;
    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout { alignment: center; Rectangle {
                width: max(28px, fbt.preferred-width + 18px);
                height: 24px;
               
                border-radius: 12px;
                background: root.trigger ? Theme.accent : Theme.elevated;
                fbt := Text { text: root.badge; color: root.trigger ? Theme.on-accent : Theme.text; font-size: 11px; font-weight: 800; letter-spacing: 1px; }
            } }
            VerticalLayout { alignment: center; GroupedPicker { entries: root.menu; label: root.label; picked(k) => { root.type-picked(k); } query(t) => { root.menu-query(t); } } }
            Rectangle { horizontal-stretch: 1; }
            if !root.trigger: VerticalLayout { alignment: center; IconButton { tip: "Move Up"; d: "M7 14l5-5 5 5z"; size: 30px; opacity: root.first ? 0.35 : 1; clicked => { if (!root.first) { root.up(); } } } }
            if !root.trigger: VerticalLayout { alignment: center; IconButton { tip: "Move Down"; d: "M7 10l5 5 5-5z"; size: 30px; opacity: root.last ? 0.35 : 1; clicked => { if (!root.last) { root.down(); } } } }
            if !root.trigger: VerticalLayout { alignment: center; IconButton { tip: "Take This Step Out"; d: Icons.close; size: 30px; clicked => { root.remove(); } } }
        }
        if root.note != "": Text { text: root.note; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
        FlowFieldsView { fields: root.fields; changed(i, v) => { root.changed(i, v); } picked(i, k) => { root.picked(i, k); } }
    }
}

/// The line between two cards of a flow, from one to the next
component FlowLink inherits Rectangle {
    height: 20px;
    Rectangle { x: 27px; width: 2px; height: parent.height; background: Theme.accent.with-alpha(0.45); }
}


/// A page loading: an equaliser's bars moving, and each platform asked, ticked as it answers (so the
/// slowest is the one still spinning)
component LoadingView inherits Rectangle {
    in property <[LoadStep]> steps;
    height: 96px;
    VerticalLayout {
        alignment: center;
        spacing: 12px;
        HorizontalLayout {
            alignment: center;
            spacing: 10px;
            // (a fixed box: the bars move inside it, nothing around them moves with them)
            Rectangle {
                width: 36px;
                height: 24px;
                for k in [0, 1, 2, 3, 4]: Rectangle {
                    x: k * 8px;
                    width: 4px;
                    property <float> wave: Theme.motion ? (1 + Math.sin((animation-tick() / 1ms * 0.4 + k * 70) * 1deg)) / 2 : 0.5;
                    height: 6px + 18px * self.wave;
                    y: (24px - self.height) / 2;
                    border-radius: 2px;
                    background: Theme.accent.mix(Theme.accent-2, 1 - k / 4);
                }
            }
            Text { text: "Loading..."; color: Theme.muted; font-size: 14px; vertical-alignment: center; }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            for st in root.steps: Rectangle {
                height: 30px;
                border-radius: 15px;
                background: st.done ? Theme.accent.with-alpha(0.14) : Theme.elevated;
                border-width: 1px;
                border-color: st.done ? Theme.accent.with-alpha(0.45) : Theme.line;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    VerticalLayout { alignment: center; PlatIcon { plat: st.plat; width: 14px; height: 14px; } }
                    Text { text: st.name; color: st.done ? Theme.text : Theme.muted; font-size: 12px; vertical-alignment: center; }
                    // (a tick once it's answered; a dot going round till then)
                    Rectangle {
                        min-width: 14px;
                        max-width: 14px;
                        if st.done: Path { commands: "M 2 7.5 L 5.5 11 L 12 3.5"; viewbox-width: 14; viewbox-height: 14; width: 14px; height: 14px; y: (parent.height - self.height) / 2; stroke: Theme.accent; stroke-width: 2px; fill: transparent; }
                        if !st.done: Rectangle {
                            property <angle> at: Theme.motion ? (animation-tick() / 1ms * 0.36) * 1deg : 0deg;
                            width: 4px; height: 4px; border-radius: 2px;
                            background: Theme.muted;
                            x: 5px + 5px * Math.cos(self.at);
                            y: (parent.height - 4px) / 2 + 5px * Math.sin(self.at);
                        }
                    }
                }
            }
        }
    }
}

/// A pill with platforms' symbols in place of their names: the one it's from (if any) → the one it's
/// for, then what it does ("Follow 12", "Also follow")
component PlatPill inherits Rectangle {
    in property <string> from;
    in property <string> to;
    in property <string> label;
    in property <string> tip;
    callback clicked;
    height: 38px;
    width: row.preferred-width + 32px;
    border-radius: 19px;
    border-width: 1px;
    border-color: pta.has-hover ? Theme.accent : Theme.line;
    background: pta.has-hover ? Theme.elevated : transparent;
    row := HorizontalLayout {
        x: 16px;
        spacing: 7px;
        if root.from != "": VerticalLayout { alignment: center; PlatIcon { plat: root.from; width: 15px; height: 15px; } }
        if root.from != "": Text { text: "\u{2192}"; color: Theme.muted; font-size: 13px; vertical-alignment: center; }
        VerticalLayout { alignment: center; PlatIcon { plat: root.to; width: 15px; height: 15px; } }
        Text { text: root.label; color: Theme.text; font-size: 13px; font-weight: 600; vertical-alignment: center; }
    }
    pta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { Tips.on = false; root.clicked(); } }
    TipSpot { tip: root.tip; hover: pta.has-hover; }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> d;
    in property <bool> active;
    /// the narrow window: the icon alone, in the middle
    in property <bool> compact;
    /// its icon turns slowly while it's pointed at (Favourites' star)
    in property <bool> spin;
    callback clicked;
    callback right-click(length, length);
    height: 38px;
    border-radius: 8px;
    background: active ? Theme.elevated : (ta.has-hover ? #ffffff08 : transparent);
    HorizontalLayout {
        padding-left: root.compact ? 0px : 12px;
        spacing: 12px;
        alignment: root.compact ? center : start;
        Glyph {
            d: root.d;
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            fill: active ? Theme.text : Theme.muted;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-rotation: root.spin && ta.has-hover ? mod(animation-tick() / 1ms, 4000) / 4000 * 360deg : 0deg;
        }
        if !root.compact: Text { text: root.label; color: active ? Theme.text : Theme.muted; font-size: 14px; font-weight: active ? 700 : 500; vertical-alignment: center; overflow: elide; }
    }
    ta := TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) { root.right-click(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } clicked => { root.clicked(); } }
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked;
    height: 32px;
    width: t.preferred-width + 28px;
    border-radius: 16px;
    background: on ? Theme.accent : (ta.has-hover ? Theme.line : Theme.elevated);
    t := Text { text: root.label; color: on ? Theme.on-accent : Theme.text; font-size: 13px; font-weight: 600; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component TrackRow inherits Rectangle {
    in property <Row> item;
    in property <int> index;
    /// little room: no album column
    in property <bool> compact;
    /// your playlists on this PC (to add to), and whether this list is one of them
    in property <[string]> lists;
    in property <bool> removable;
    // Search: each track's genres as tags, a click searching that genre
    in property <bool> show-genres;
    callback genre(string);
    callback play();
    callback act(string);
    // Ctrl+click picks it (or lets it go), Shift+click picks everything from the last one picked
    callback pick(int);
    property <bool> picking;
    // (the pointer over its artist's name: that's a link to the artist, not the row's play)
    property <length> px: ta.absolute-position.x + ta.mouse-x;
    property <length> py: ta.absolute-position.y + ta.mouse-y;
    property <bool> over-artist: ta.has-hover && root.item.artist != ""
        && root.px >= art-t.absolute-position.x && root.px <= art-t.absolute-position.x + art-t.width
        && root.py >= art-t.absolute-position.y && root.py <= art-t.absolute-position.y + art-t.height;
    height: Theme.row-h;
    border-radius: 6px;
    background: root.item.picked ? Theme.accent.with-alpha(0.2) : ta.has-hover ? Theme.elevated : root.item.version ? Theme.elevated.with-alpha(0.45) : Theme.glow && root.item.playing ? Theme.accent.with-alpha(0.08) : transparent;
    // (a glowing theme: what's playing outlined and lit in the accent)
    border-width: Theme.glow && root.item.playing ? 1px : 0px;
    border-color: Theme.accent.with-alpha(0.7);
    drop-shadow-blur: Theme.glow && root.item.playing ? 14px : 0px;
    drop-shadow-color: Theme.accent.with-alpha(0.45);
    HorizontalLayout {
        padding-left: root.item.version ? 28px : 8px;
        padding-right: 16px;
        spacing: 16px;
        Rectangle {
            width: 28px;
            if !ta.has-hover && !root.item.playing: Text { text: root.item.version ? "" : index + 1; width: parent.width; height: parent.height; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; font-size: 13px; }
            if ta.has-hover || root.item.playing: Path { commands: Icons.play; x: (parent.width - 16px) / 2; y: (parent.height - 16px) / 2; width: 16px; height: 16px; fill: Theme.accent; }
        }
        VerticalLayout { alignment: center; Rectangle {
            width: Theme.row-art;
            height: Theme.row-art;
            border-radius: Theme.round-art ? self.width / 2 : 4px;
            clip: true;
            background: Theme.elevated;
            Image { source: root.item.art; width: parent.width; height: parent.height; image-fit: cover; }
        } }
        VerticalLayout { alignment: center; PlatIcon { plat: root.item.plat; width: 18px; height: 18px; fill: Theme.muted; opacity: ta.has-hover || root.item.picked ? 1 : 0; animate opacity { duration: Theme.motion ? 150ms : 0ms; } } }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: root.item.title; color: root.item.playing ? Theme.accent : Theme.text; font-weight: 700; font-size: 14px; overflow: elide; }
            HorizontalLayout {
                spacing: 6px;
                art-t := Text { text: root.item.artist; color: root.over-artist ? Theme.text : Theme.muted; font-size: 13px; overflow: elide; horizontal-stretch: 1; max-width: self.preferred-width; }
                // (a collaborative playlist: who added it, as you hover over it)
                if (ta.has-hover || root.item.picked) && root.item.added-by != "": Text { text: "Added by " + root.item.added-by; color: Theme.muted; font-size: 12px; overflow: elide; vertical-alignment: center; }
                for g in root.item.genres: VerticalLayout { alignment: center; Rectangle {
                    visible: root.show-genres;
                    height: 18px;
                   
                    width: root.show-genres ? gt.preferred-width + 12px : 0px;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: gta.has-hover ? Theme.accent : Theme.line;
                    gt := Text { text: g; color: gta.has-hover ? Theme.text : Theme.muted; font-size: 11px; }
                    gta := TouchArea { clicked => { root.genre(g); } }
                } }
                Rectangle { horizontal-stretch: 0; }
            }
        }
        if !root.compact: Text { text: root.item.album; width: 26%; color: Theme.muted; font-size: 13px; overflow: elide; vertical-alignment: center; }
        // (room for its versions' button, laid over it below)
        if root.item.versions != "": Rectangle { width: 130px; }
        // (room for its star (with Favourites on) and its heart, laid over them below: buttons of their own,
        // over the row's)
        if root.item.fav-on: Rectangle { width: 24px; }
        Rectangle { width: 24px; }
        Text { text: root.item.dur; width: 48px; color: Theme.muted; font-size: 13px; horizontal-alignment: right; vertical-alignment: center; }
    }
    DragArea {
      allow-copy: true;
      data: Dnd.payload("t:" + root.index);
      Rectangle {
        ta := TouchArea {
            mouse-cursor: root.over-artist ? MouseCursor.pointer : MouseCursor.default;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) { cm1.open(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.picking = e.modifiers.control || e.modifiers.shift;
                    if (root.picking) { root.pick(e.modifiers.shift ? 2 : 1); }
                }
            }
            // (on its artist's name: that artist, the one of them under the pointer, as a share of the name's width)
            clicked => {
                if (root.picking) { return; }
                if (root.over-artist) { root.act("artistat:" + Math.round((root.px - art-t.absolute-position.x) / max(1px, art-t.width) * 1000)); return; }
                root.play();
            }
        }
          // (on top: it only takes right-clicks, the rest goes through to what's under it)
          cm1 := TrackMenu {
              width: 100%; height: 100%;
              item: root.item;
              lists: root.lists;
              removable: root.removable;
              act(a) => { root.act(a); }
          }
      }
    }
    // its heart: filled when liked, an outline when not, a click either way (the space for it: the row's right
    // padding, its length and the spacing between, in from the right)
    if root.item.liked || root.item.can-like: Rectangle {
        x: parent.width - 16px - 48px - 16px - 24px;
        width: 24px;
        Glyph { d: root.item.liked ? Icons.library : Icons.heart-out; width: 18px; height: 18px; y: (parent.height - self.height) / 2; fill: root.item.liked || hta.has-hover ? Theme.accent : Theme.muted; }
        TipSpot { tip: root.item.liked ? "Remove from Likes" : "Add to Likes"; hover: hta.has-hover; }
    }
    // its star (with Favourites on), the same, beside it
    if root.item.fav-on: Rectangle {
        x: parent.width - 16px - 48px - 16px - 24px - 16px - 24px;
        width: 24px;
        Glyph { d: root.item.fav ? Icons.star : Icons.star-out; width: 18px; height: 18px; y: (parent.height - self.height) / 2; fill: root.item.fav || fta.has-hover ? Theme.accent : Theme.muted; }
        TipSpot { tip: root.item.fav ? "Remove from Favourites" : "Add to Favourites"; hover: fta.has-hover; }
    }
    fta := TouchArea {
        x: parent.width - 16px - 48px - 16px - 24px - 16px - 24px;
        width: 24px;
        enabled: root.item.fav-on;
        mouse-cursor: root.item.fav-on ? MouseCursor.pointer : MouseCursor.default;
        clicked => { Tips.on = false; root.act("fav"); }
    }
    hta := TouchArea {
        x: parent.width - 16px - 48px - 16px - 24px;
        width: 24px;
        enabled: root.item.can-like;
        mouse-cursor: root.item.can-like ? MouseCursor.pointer : MouseCursor.default;
        clicked => { Tips.on = false; root.act("like"); }
    }
    // an artist's page: its other versions (remixes, edits and the like), opened beneath it
    if root.item.versions != "": Rectangle {
        x: parent.width - 250px - (root.item.fav-on ? 40px : 0px);
        y: (parent.height - self.height) / 2;
        width: 130px;
        height: 26px;
        border-radius: 13px;
        border-width: 1px;
        border-color: vta.has-hover ? Theme.accent : Theme.line;
        background: vta.has-hover ? Theme.elevated : transparent;
        Text { text: root.item.versions; color: vta.has-hover ? Theme.text : Theme.muted; font-size: 12px; font-weight: 600; }
        vta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.act("versions"); } }
        TipSpot { tip: "Other versions of this song, like remixes and edits"; hover: vta.has-hover; }
    }
}

/// An album among a list's tracks: its cover, "Album" with where it's from, its title and artist; a
/// click opens it, the button plays it
component AlbumStrip inherits Rectangle {
    in property <string> title;
    in property <string> by;
    in property <string> plat;
    in property <image> art;
    callback open;
    callback play;
    height: 68px;
    border-radius: 8px;
    background: ata.has-hover ? Theme.elevated : Theme.elevated.with-alpha(0.35);
    ata := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.open(); } }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 16px;
        spacing: 14px;
        VerticalLayout { alignment: center; Rectangle {
            width: 52px;
            height: 52px;
           
            border-radius: 6px;
            clip: true;
            background: Theme.elevated;
            Image { source: root.art; width: parent.width; height: parent.height; image-fit: cover; }
        } }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 5px;
                alignment: start;
                VerticalLayout { alignment: center; PlatIcon { plat: root.plat; width: 12px; height: 12px; } }
                Text { text: "ALBUM"; color: Theme.muted; font-size: 10px; font-weight: 800; letter-spacing: 1px; }
            }
            Text { text: root.title; color: Theme.text; font-weight: 700; font-size: 14px; overflow: elide; }
            Text { text: root.by; color: Theme.muted; font-size: 12px; overflow: elide; }
        }
        VerticalLayout { alignment: center; IconButton { tip: "Play album"; d: Icons.play; filled: true; size: 34px; clicked => { root.play(); } } }
    }
}

component Cover inherits Rectangle {
    in property <image> art;
    in property <string> initial;
    border-radius: 8px;
    background: Theme.elevated;
    clip: true;
    Text { text: root.initial; color: Theme.muted; font-size: root.height * 0.35; font-weight: 800; }
    Image { source: root.art; width: parent.width; height: parent.height; image-fit: cover; }
}

/// A song's artists, each one a link to their page (as the web app's fillArtists): one name as it is,
/// several side by side with their commas
component ArtistLinks inherits HorizontalLayout {
    in property <[string]> names;
    in property <string> text;
    in property <length> size: 13px;
    in property <color> tint: Theme.muted;
    in property <bool> bold;
    in property <bool> right;
    callback pick(int);
    alignment: root.right ? LayoutAlignment.end : LayoutAlignment.start;
    if root.names.length <= 1: Text {
        text: root.text;
        color: one.has-hover ? Theme.text : root.tint;
        font-size: root.size;
        font-weight: root.bold ? 600 : 400;
        overflow: elide;
        horizontal-alignment: root.right ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        one := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.pick(0); } }
    }
    if root.names.length > 1: HorizontalLayout {
        for n[k] in root.names: HorizontalLayout {
            if k > 0: Text { text: ", "; color: root.tint; font-size: root.size; font-weight: root.bold ? 600 : 400; }
            Text {
                text: n;
                color: each.has-hover ? Theme.text : root.tint;
                font-size: root.size;
                font-weight: root.bold ? 600 : 400;
                overflow: elide;
                each := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.pick(k); } }
            }
        }
    }
}

// A cover with where it plays from as a round badge on its corner (the player bar's and Now Playing's,
// as the web app's): always there, with YouTube Music's own mark (on the art it can't pass for a play button)
component BadgedCover inherits Rectangle {
    in property <image> art;
    in property <string> initial;
    in property <string> plat;
    in property <length> badge: 22px;
    in property <length> corner: 6px;
    /// its badge clickable (the player's: the uploader's page)
    in property <bool> badge-link;
    callback badge-clicked;
    Cover { art: root.art; initial: root.initial; width: parent.width; height: parent.height; border-radius: root.corner; }
    if root.plat != "": Rectangle {
        x: parent.width - self.width * 0.78;
        y: parent.height - self.height * 0.78;
        width: root.badge;
        height: root.badge;
        border-radius: self.width / 2;
        background: Theme.panel;
        border-width: 2px;
        border-color: Theme.panel;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000060;
        PlatIcon { plat: root.plat; title-bar: true; width: root.badge * 0.6; height: root.badge * 0.6; }
        if root.badge-link: TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.badge-clicked(); } }
    }
}

/// A Seamless Mix under way, as a DJ's crossfader: the one going out's cover (fading), the fader (its knob
/// across as the mix goes), the one coming in's (brightening); its words beside it unless it's compact
component Crossfade inherits Rectangle {
    in property <image> from-art;
    in property <image> to-art;
    in property <float> frac;
    in property <string> label;
    in property <bool> compact;
    property <length> c: root.compact ? 18px : 34px;
    property <float> p: max(0, min(1, root.frac));
    height: root.compact ? 20px : 44px;
    HorizontalLayout {
        alignment: start;
        spacing: root.compact ? 6px : 10px;
        VerticalLayout { alignment: center; Rectangle {
            width: root.c;
            height: root.c;
           
            border-radius: 4px;
            clip: true;
            background: Theme.elevated;
            opacity: 1 - 0.65 * root.p;
            Image { source: root.from-art; width: parent.width; height: parent.height; image-fit: cover; }
        } }
        Rectangle {
            width: root.compact ? 52px : 110px;
            height: 4px;
            y: (parent.height - self.height) / 2;
            border-radius: 2px;
            background: Theme.text.with-alpha(0.15);
            Rectangle { x: 0; width: parent.width * root.p; height: 100%; border-radius: 2px; background: Theme.accent.mix(Theme.accent-2, 1 - root.p); animate width { duration: Theme.motion ? 260ms : 0ms; } }
            Rectangle {
                x: parent.width * root.p - self.width / 2;
                y: (parent.height - self.height) / 2;
                width: root.compact ? 7px : 10px;
                height: root.compact ? 12px : 18px;
                border-radius: 3px;
                background: Theme.text;
                animate x { duration: Theme.motion ? 260ms : 0ms; }
            }
        }
        VerticalLayout { alignment: center; Rectangle {
            width: root.c;
            height: root.c;
           
            border-radius: 4px;
            clip: true;
            background: Theme.elevated;
            opacity: 0.35 + 0.65 * root.p;
            Image { source: root.to-art; width: parent.width; height: parent.height; image-fit: cover; }
        } }
        if !root.compact: VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text { text: "MIXING"; color: Theme.accent; font-size: 11px; font-weight: 800; letter-spacing: 1px; }
            Text { text: root.label; color: Theme.muted; font-size: 12px; overflow: elide; }
        }
    }
}

/// The tab's cover, with the visualiser round it (In the Player on): Glow's rings, or the Ring
component TabCover inherits Rectangle {
    in property <image> art;
    in property <string> plat;
    in property <string> viz;
    in property <float> level;
    // (the Ring's spikes round it: viz::ring_small's)
    in property <[RingPiece]> ring;
    in property <length> badge: 22px;
    callback badge-clicked();
    width: 44px;
    height: 44px;
    for r in [4, 3, 2, 1]: Rectangle {
        visible: root.viz == "glow";
        property <length> out: r * (1px + 1.6px * root.level);
        x: -self.out;
        y: -self.out;
        width: parent.width + 2 * self.out;
        height: parent.height + 2 * self.out;
        border-radius: 8px + self.out;
        background: Theme.accent.mix(Theme.accent-2, 1 - root.level).with-alpha((0.08 + 0.2 * root.level) * (5 - r) / 4);
    }
    // (Ring: the cover smaller in its place, its spikes round it, out into the 10 px round the place)
    if root.viz == "ring": VizRing { x: -10px; y: -10px; width: root.width + 20px; height: root.height + 20px; pieces: root.ring; }
    BadgedCover { art: root.art; initial: ""; plat: root.plat; badge: root.viz == "ring" ? root.badge * 0.8 : root.badge; corner: root.viz == "ring" ? 4px : 6px; width: root.viz == "ring" ? parent.width * 0.7 : parent.width; height: self.width; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; badge-link: true; badge-clicked => { root.badge-clicked(); } }
}

component TileView inherits Rectangle {
    in property <Tile> tile;
    /// your playlists on this PC (a song's Add to Playlist)
    in property <[string]> lists;
    callback clicked;
    // a song's tile right-clicked: what's picked from its menu
    callback act(string);
    // an album's tile (the Library's Albums): its own menu
    in property <bool> album;
    // (pointed at: its play button and platform show)
    property <bool> hover: ta.has-hover;
    width: root.tile.miss ? 0px : 170px;
    height: 226px;
    visible: !root.tile.miss;
    VerticalLayout {
        spacing: 8px;
        Rectangle {
            height: 170px;
            if !root.tile.genre: Cover { art: root.tile.art; initial: root.tile.title; width: 100%; height: 100%; }
            if root.tile.genre: Rectangle {
                border-radius: 8px;
                clip: true;
                background: @radial-gradient(circle, root.tile.c1 0%, root.tile.c2 100%);
                Text { x: 12px; y: parent.height - self.height - 14px; width: parent.width - 24px; text: root.tile.title; color: #ffffff; font-size: 22px; font-weight: 800; wrap: word-wrap; }
            }
            if hover: Rectangle { x: parent.width - 52px; y: parent.height - 52px; width: 42px; height: 42px; border-radius: 21px; background: Theme.accent;
                Glyph { d: Icons.play; width: 22px; height: 22px; fill: Theme.on-accent; } }
            if hover: PlatIcon { plat: root.tile.plat; title-bar: true; x: 8px; y: 8px; width: 18px; height: 18px; }
        }
        Text { text: root.tile.title; color: Theme.text; font-weight: 700; font-size: 13px; overflow: elide; }
        Text { text: root.tile.sub; color: Theme.muted; font-size: 12px; overflow: elide; }
    }
    Rectangle {
        ta := TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) { if (root.album) { cm2.open(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } else { cmt.open(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } } clicked => { root.clicked(); } }
        // (a song's: the same menu as anywhere else, as the web app's)
        cmt := TrackMenu {
            width: 100%; height: 100%;
            enabled: root.tile.track && !root.album;
            item: root.tile.row;
            lists: root.lists;
            act(a) => { if (a == "play") { root.clicked(); } else { root.act(a); } }
        }
        // (on top: it only takes right-clicks, the rest goes through to what's under it)
        cm2 := CtxMenu {
            width: 100%; height: 100%;
            enabled: root.tile.track || root.album;
            items: [
                { label: "Open", show: root.album },
                { label: "Play", show: root.album },
                { sep: true, show: root.album },
                { label: "Don't Recommend This Album", show: root.album },
                { label: "Play", show: !root.album },
                { label: "Play Next", show: !root.album },
                { label: "Add to Queue", show: !root.album },
                { sep: true, show: !root.album },
                { label: root.tile.liked ? "Remove from Likes" : "Add to Likes", show: !root.album },
                { label: "Add to Favourites", show: !root.album },
                { label: "Go to Artist", show: !root.album },
                { sep: true, show: !root.album },
                { label: "Don't Recommend This Track", show: !root.album },
                { label: "Don't Recommend This Artist", show: !root.album },
                { sep: true, show: !root.album },
                { label: "Open on Its Platform", show: !root.album },
                { label: "Track Preferences...", show: !root.album }
            ];
            picked(n, k) => {
                if (n == 0) { root.clicked(); }
                if (n == 1) { root.act("album-play"); }
                if (n == 3) { root.act("album-hide"); }
                if (n == 4) { root.clicked(); }
                if (n == 5) { root.act("next"); }
                if (n == 6) { root.act("add"); }
                if (n == 8) { root.act("like"); }
                if (n == 9) { root.act("fav"); }
                if (n == 10) { root.act("artist:0"); }
                if (n == 12) { root.act("hide:track"); }
                if (n == 13) { root.act("hide:artist"); }
                if (n == 15) { root.act("open"); }
                if (n == 16) { root.act("prefs"); }
            }
        }
    }
}

/// A Settings category's title: a click opens or closes it

/// A shelf of tiles, as the web app's: it moves sideways with its own Back and More buttons and the
/// bar under it (where in the row you are, and how much of it shows; click or drag it), not the scroll
/// wheel; Show all lays every tile out in rows
component ShelfView inherits VerticalLayout {
    in property <Shelf> shelf;
    visible: !root.shelf.gone;
    max-height: root.shelf.gone ? 0px : 100000px;
    in property <[string]> lists;
    callback tile-clicked(int);
    callback tile-act(int, string);
    property <bool> open: root.shelf.open;
    property <length> span: max(0px, row.content-width - row.width);
    property <bool> over: root.span > 2px && !root.open;
    property <int> per: max(1, floor((root.width + 16px) / 186px));
    spacing: 10px;
    HorizontalLayout {
        spacing: 8px;
        Text { text: root.shelf.title; color: Theme.text; font-size: 20px; font-weight: 800; horizontal-stretch: 1; vertical-alignment: center; }
        RoundButton { visible: root.over; d: "M15.4 7.4L14 6l-6 6 6 6 1.4-1.4L10.8 12z"; tip: "Back"; enabled: row.content-x < -2px; width: 34px; height: 34px; clicked => { row.content-x = min(0px, row.content-x + row.width * 0.9); } }
        RoundButton { visible: root.over; d: "M8.6 16.6L10 18l6-6-6-6-1.4 1.4 4.6 4.6z"; tip: "More"; enabled: -row.content-x < root.span - 2px; width: 34px; height: 34px; clicked => { row.content-x = max(-root.span, row.content-x - row.width * 0.9); } }
        Pill { visible: root.span > 2px || root.open; label: root.open ? "Show less" : "Show all"; height: 34px; clicked => { root.open = !root.open; row.content-x = 0; } }
    }
    row := Flickable {
        visible: !root.open;
        height: root.open ? 0px : 230px;
        content-width: (root.shelf.shown > 0 ? root.shelf.shown : root.shelf.tiles.length) * 186px - 16px;
        HorizontalLayout {
            alignment: start;
            // (each tile with its gap after it: one left out of what's typed leaves no gap)
            for t[k] in root.shelf.tiles: Rectangle {
                width: t.miss ? 0px : 186px;
                TileView { x: 0; tile: t; lists: root.lists; clicked => { root.tile-clicked(k); } act(a) => { root.tile-act(k, a); } }
            }
        }
    }
    // the bar
    Rectangle {
        visible: root.over;
        height: 6px;
        border-radius: 3px;
        background: Theme.text.with-alpha(bta.has-hover || bta.pressed ? 0.14 : 0.08);
        property <float> shown: row.width / row.content-width;
        Rectangle {
            x: parent.width * (-row.content-x / row.content-width);
            width: parent.width * parent.shown;
            border-radius: 3px;
            background: bta.has-hover || bta.pressed ? Theme.accent : Theme.muted.with-alpha(0.6);
        }
        bta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            property <length> from-x;
            property <length> from-content;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    self.from-x = self.mouse-x;
                    // (a press beside the thumb centres the view there; on it, it's dragged)
                    if (self.mouse-x < parent.width * (-row.content-x / row.content-width) || self.mouse-x > parent.width * ((-row.content-x + row.width) / row.content-width)) {
                        row.content-x = -max(0px, min(root.span, self.mouse-x / parent.width * row.content-width - row.width / 2));
                    }
                    self.from-content = row.content-x;
                }
            }
            moved => { if (self.pressed) { row.content-x = -max(0px, min(root.span, -self.from-content + (self.mouse-x - self.from-x) * row.content-width / parent.width)); } }
        }
    }
    // Show all: every tile, in rows
    // (placed by hand, not by a layout: how many fit a row comes from the shelf's width)
    if root.open: Rectangle {
        height: ceil(root.shelf.tiles.length / root.per) * 242px - 16px;
        for t[k] in root.shelf.tiles: TileView { x: mod(k, root.per) * 186px; y: floor(k / root.per) * 242px; tile: t; lists: root.lists; clicked => { root.tile-clicked(k); } act(a) => { root.tile-act(k, a); } }
    }
}

/// The setting a search found (its name), lit where it shows; and where it is in the window once it's drawn
/// (n: told again each time), so its page scrolls to it
export global Hi {
    in-out property <string> label;
    in-out property <length> y;
    in-out property <int> n;
}

/// (the setting a search found: a soft glow round it, fading out after; where it is, told once it's drawn)
component HiGlow inherits Rectangle {
    in property <bool> lit;
    in property <length> r: 12px;
    property <bool> told;
    property <float> o: root.lit ? 1 : 0;
    animate o { duration: Theme.motion ? 700ms : 0ms; }
    border-radius: root.r;
    border-width: 2px;
    border-color: Theme.accent.with-alpha(0.8 * root.o);
    background: Theme.accent.with-alpha(0.13 * root.o);
    Timer { interval: 150ms; running: root.lit && !root.told; triggered => { root.told = true; Hi.y = root.absolute-position.y; Hi.n += 1; } }
    changed lit => { if (!self.lit) { self.told = false; } }
}

/// A hand-made setting's name: lit when a search found it
component HiTitle inherits Rectangle {
    in property <string> text;
    height: ht.preferred-height;
    min-width: ht.preferred-width;
    HiGlow { x: -12px; y: -7px; width: parent.width + 24px; height: parent.height + 14px; lit: Hi.label != "" && Hi.label == root.text; r: 10px; }
    ht := Text { width: parent.width; text: root.text; color: Hi.label == root.text ? Theme.accent : Theme.text; font-weight: 700; animate color { duration: 300ms; } }
}

/// App & Look's preview: the app, small, as it's set (its theme, tint, accents, player style, title bar,
/// corners and density), changing as they're changed
component LookPreview inherits Rectangle {
    in property <string> style;
    in property <string> title;
    in property <bool> compact;
    height: 150px;
    border-radius: 14px;
    background: Theme.bg;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;
    property <length> r: Theme.radius > 0 ? 7px : 0px;
    property <color> ca: root.title == "subtle" ? Theme.panel.mix(Theme.bar-a, 0.6) : Theme.bar-a;
    property <color> cb: root.title == "subtle" ? Theme.panel.mix(Theme.bar-b, 0.6) : Theme.bar-b;
    property <length> foot: root.style == "tab" ? 34px : root.style == "minimal" ? 16px : 24px;
    property <length> body: root.height - 28px - root.foot - 12px;
    // the title bar
    Rectangle { x: 8px; y: 8px; width: parent.width - 16px; height: 14px; border-radius: root.r; background: root.title == "plain" ? Theme.panel : @linear-gradient(90deg, root.ca 0%, root.cb 100%); }
    // the sidebar and the page
    Rectangle {
        x: 8px; y: 28px; width: 82px; height: root.body; border-radius: root.r; background: Theme.panel;
        for k in 5: Rectangle { x: 8px; y: 10px + k * 12px; width: k == 0 ? 50px : 40px + mod(k * 13, 20) * 1px; height: 5px; border-radius: 2px; background: k == 0 ? Theme.accent.with-alpha(0.8) : Theme.muted.with-alpha(0.35); }
    }
    Rectangle {
        x: 96px; y: 28px; width: parent.width - 104px; height: root.body; border-radius: root.r; background: Theme.panel;
        Rectangle { x: 10px; y: 9px; width: 90px; height: 9px; border-radius: 3px; background: Theme.text.with-alpha(0.75); }
        for k in (root.compact ? 6 : 4): Rectangle {
            x: 10px; y: 26px + k * (root.compact ? 9px : 13px); width: parent.width - 20px; height: root.compact ? 6px : 9px; border-radius: 2px;
            background: k == 1 ? Theme.accent.with-alpha(0.25) : Theme.elevated;
        }
    }
    // the player, as its style has it
    if root.style == "tab": Rectangle { x: 8px; y: root.height - root.foot - 4px; width: 120px; height: 12px; border-radius: root.r; background: root.ca; }
    if root.style != "minimal": Rectangle {
        x: root.style == "float" ? 40px : 8px;
        y: root.height - (root.style == "tab" ? 22px : root.foot) - (root.style == "float" ? 6px : 4px);
        width: parent.width - (root.style == "float" ? 80px : 16px);
        height: root.style == "tab" ? 18px : 20px;
        border-radius: root.style == "float" ? 10px : root.r;
        background: @linear-gradient(90deg, Theme.bar-a 0%, Theme.bar-b 100%);
        Rectangle { x: (parent.width - 12px) / 2; y: (parent.height - 12px) / 2; width: 12px; height: 12px; border-radius: 6px; background: Theme.accent; }
    }
    if root.style == "minimal": Rectangle {
        x: 8px; y: root.height - 18px; width: parent.width - 16px; height: 12px; background: Theme.panel; border-radius: root.r;
        Rectangle { width: parent.width * 0.4; height: 2px; background: Theme.accent; }
    }
}

/// A section's heading (App & Look's: Look, Layout...)
component SectionHead inherits Text {
    color: Theme.muted;
    font-family: Theme.head-font;
    font-size: 12px;
    font-weight: 700;
}

/// The Stream Suite, in Settings > Streaming while it's on: a card of its own, in the accents, glowing
component SuiteHero inherits Rectangle {
    in property <SetRow> r;
    // (the page's colour behind it: its corners rounded over the gradient, which some renderers draw square)
    in property <color> outside: Theme.panel;
    callback toggle(string);
    callback open(string);
    height: 196px;
    border-radius: Theme.card-radius;
    clip: true;
    background: @linear-gradient(120deg, Theme.accent.mix(Theme.bg, 0.42) 0%, Theme.accent-2.mix(Theme.bg, 0.5) 100%);
    // (light drifting across it, slowly, while it runs)
    property <float> ph: root.r.on && Theme.motion ? mod(animation-tick() / 1ms, 9000) / 9000 : 0.3;
    Rectangle { x: root.width * (0.1 + 0.7 * root.ph) - 160px; y: -120px; width: 380px; height: 380px; background: @radial-gradient(circle, #ffffff30 0%, transparent 65%); }
    Rectangle { x: root.width - 230px; y: 40px; width: 300px; height: 300px; background: @radial-gradient(circle, Theme.accent-2.with-alpha(0.45) 0%, transparent 70%); }
    // (rings behind its icon)
    // (centred on the icon: its middle is the padding (26) and half its width (38) in)
    for k in 3: Rectangle { x: 64px - self.width / 2; y: (root.height - self.height) / 2; width: 76px + (k + 1) * 44px; height: self.width; border-radius: self.width / 2; border-width: 1px; border-color: #ffffff18; }
    HorizontalLayout {
        padding: 26px;
        spacing: 22px;
        VerticalLayout { alignment: center; Rectangle {
            width: 76px; height: 76px; border-radius: 38px;
            // (solid, not a gradient: the software renderer draws a gradient square, a square behind the circle)
            background: #ffffff26;
            border-width: 1px; border-color: #ffffff50;
            Glyph { d: Icons.robot; width: 40px; height: 40px; x: 18px; y: 18px; fill: #ffffff; }
        } }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 6px;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Text { text: "Stream Suite"; color: #ffffff; font-size: 30px; font-weight: 800; font-family: Theme.head-font; }
                VerticalLayout { alignment: center; Rectangle {
                    height: 22px; width: st.preferred-width + 18px; border-radius: 11px;
                    background: root.r.on ? #3ddc8440 : #ffffff20;
                    st := Text { x: 9px; height: parent.height; vertical-alignment: center; text: root.r.on ? "Running" : "Off"; color: #ffffff; font-size: 11px; font-weight: 700; }
                } }
            }
            Text { text: "Your chatbot, alerts, goals, timers, widgets and OBS docks, all in one place."; color: #ffffffd8; font-size: 13px; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for t in ["Chatbot", "Song Requests", "Alerts", "Goals and Timers", "Widgets", "Docks"]: Rectangle {
                    height: 24px; width: tt.preferred-width + 20px; border-radius: 12px;
                    background: #00000030; border-width: 1px; border-color: #ffffff30;
                    tt := Text { x: 10px; height: parent.height; vertical-alignment: center; text: t; color: #ffffff; font-size: 11px; font-weight: 600; }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 12px;
            HorizontalLayout { alignment: end; CenterToggle { checked: root.r.on; toggled => { root.toggle(root.r.key); } } }
            Rectangle {
                width: 170px; height: 42px; border-radius: 21px;
                background: oa.has-hover ? #ffffff : #ffffffe6;
                drop-shadow-blur: 14px; drop-shadow-color: #00000050;
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    VerticalLayout { alignment: center; Text { text: "Open the Suite"; color: Theme.accent.mix(#000000, 0.45); font-size: 14px; font-weight: 800; } }
                }
                oa := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.open(root.r.key); } }
            }
        }
    }
    Caps { r: Theme.card-radius; outside: root.outside; tl: Theme.accent.mix(Theme.bg, 0.42); bl: Theme.accent.mix(Theme.bg, 0.42); tr: Theme.accent-2.mix(Theme.bg, 0.5); br: Theme.accent-2.mix(Theme.bg, 0.5); bottom: true; }
}

/// A theme, as a little app to pick: its sidebar, its text, its accents
component ThemeTile inherits VerticalLayout {
    preferred-width: 0px;
    min-width: 0px;
    in property <ThemeOpt> t;
    in property <bool> on;
    callback clicked();
    spacing: 5px;
    Rectangle {
        height: 58px;
        border-radius: 10px;
        clip: true;
        background: root.t.bg;
        border-width: root.on ? 2px : 1px;
        border-color: root.on ? Theme.accent : Theme.line;
        Rectangle { x: 0; y: 0; width: parent.width * 0.26; height: parent.height; background: root.t.panel; }
        Rectangle { x: 7px; y: 10px; width: parent.width * 0.26 - 14px; height: 4px; border-radius: 2px; background: root.t.a; }
        Rectangle { x: parent.width * 0.33; y: 10px; width: parent.width * 0.5; height: 6px; border-radius: 3px; background: root.t.text; }
        Rectangle { x: parent.width * 0.33; y: 21px; width: parent.width * 0.36; height: 5px; border-radius: 3px; background: root.t.text.with-alpha(0.4); }
        Rectangle { x: 6px; y: parent.height - 12px; width: parent.width - 12px; height: 6px; border-radius: 3px; background: @linear-gradient(90deg, root.t.a 0%, root.t.b 100%); }
        TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
    }
    Text { text: root.t.name; color: root.on ? Theme.text : Theme.muted; font-size: 12px; font-weight: root.on ? 700 : 400; horizontal-alignment: center; }
}

/// A theme, as a swatch to pick
component ThemeSwatch inherits VerticalLayout {
    in property <string> name;
    in property <color> fill;
    in property <bool> on;
    callback clicked();
    spacing: 5px;
    Rectangle {
        height: 44px;
        border-radius: 10px;
        background: root.fill;
        border-width: root.on ? 2px : 1px;
        border-color: root.on ? Theme.accent : Theme.line;
        // (its accent, a dot: what it'd look like with it)
        Rectangle { x: 8px; y: parent.height - 14px; width: 26px; height: 6px; border-radius: 3px; background: Theme.accent; }
        sta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
    }
    Text { text: root.name; color: root.on ? Theme.text : Theme.muted; font-size: 12px; font-weight: root.on ? 700 : 400; horizontal-alignment: center; }
}

/// A player style, as a little sketch to pick
component StyleSketch inherits VerticalLayout {
    // (each the same width as the others in its row, whatever its name)
    preferred-width: 0px;
    min-width: 0px;
    in property <string> name;
    in property <string> style;
    in property <bool> on;
    in property <string> tip;
    callback clicked();
    spacing: 5px;
    Rectangle {
        height: 54px;
        border-radius: 10px;
        background: Theme.bg;
        border-width: root.on ? 2px : 1px;
        border-color: root.on ? Theme.accent : Theme.line;
        clip: true;
        // (Tab: what's playing on a tab joined to the top of the controls' bar, no gap between)
        if root.style == "tab": Rectangle { x: 8px; y: parent.height - 26px; width: 34%; height: 14px; border-radius: 4px; background: Theme.accent.with-alpha(0.6); }
        if root.style == "tab": Rectangle { x: 8px; y: parent.height - 15px; width: parent.width - 16px; height: 10px; border-radius: 4px; background: @linear-gradient(90deg, Theme.accent.with-alpha(0.6) 0%, Theme.accent-2.with-alpha(0.6) 100%); }
        if root.style == "bar": Rectangle { x: 0; y: parent.height - 13px; width: parent.width; height: 13px; background: @linear-gradient(90deg, Theme.accent.with-alpha(0.6) 0%, Theme.accent-2.with-alpha(0.6) 100%); }
        if root.style == "float": Rectangle { x: 14px; y: parent.height - 16px; width: parent.width - 28px; height: 10px; border-radius: 5px; background: @linear-gradient(90deg, Theme.accent.with-alpha(0.6) 0%, Theme.accent-2.with-alpha(0.6) 100%); }
        if root.style == "minimal": Rectangle { x: 0; y: parent.height - 9px; width: parent.width; height: 9px; background: Theme.elevated; Rectangle { width: parent.width * 0.4; height: 1.5px; background: Theme.accent; } }
        if root.style == "turntable": Rectangle { x: 6px; y: parent.height - 14px; width: parent.width - 12px; height: 10px; border-radius: 4px; background: @linear-gradient(90deg, Theme.accent.with-alpha(0.6) 0%, Theme.accent-2.with-alpha(0.6) 100%); }
        if root.style == "turntable": Rectangle { x: 8px; y: parent.height - 26px; width: 22px; height: 22px; border-radius: 11px; background: #0b0b0d; border-width: 1px; border-color: #ffffff30; Rectangle { x: 7px; y: 7px; width: 8px; height: 8px; border-radius: 4px; background: Theme.accent; } }
        if root.style == "island": Rectangle { x: (parent.width - self.width) / 2; y: parent.height - 13px; width: parent.width * 0.42; height: 9px; border-radius: 4.5px; background: #000000; Rectangle { x: 2px; y: 2px; width: 5px; height: 5px; border-radius: 2.5px; background: Theme.accent; } }
        if root.style == "sidebar": Rectangle { x: 0; y: 0; width: parent.width * 0.26; height: parent.height; background: Theme.panel; Rectangle { x: 4px; y: parent.height - 26px; width: parent.width - 8px; height: 13px; border-radius: 3px; background: Theme.accent.with-alpha(0.6); } Rectangle { x: 4px; y: parent.height - 10px; width: parent.width - 8px; height: 4px; border-radius: 2px; background: Theme.accent-2.with-alpha(0.6); } }
        if root.style == "decks": Rectangle { x: 6px; y: parent.height - 16px; width: parent.width - 12px; height: 12px; border-radius: 4px; background: Theme.elevated; Rectangle { x: 4px; y: 3px; width: parent.width * 0.3; height: 6px; border-radius: 3px; background: Theme.accent.with-alpha(0.7); } Rectangle { x: parent.width * 0.42; y: 4px; width: parent.width * 0.16; height: 4px; border-radius: 2px; background: Theme.line; } Rectangle { x: parent.width * 0.64; y: 3px; width: parent.width * 0.3; height: 6px; border-radius: 3px; background: Theme.accent-2.with-alpha(0.5); } }
        if root.style == "waveform": Rectangle { x: 6px; y: parent.height - 18px; width: parent.width - 12px; height: 14px; for k in 16: Rectangle { x: k * parent.width / 16; width: parent.width / 16 * 0.6; height: parent.height * (0.3 + 0.7 * abs(sin(k * 47deg))); y: (parent.height - self.height) / 2; background: k < 7 ? Theme.accent : Theme.line; } }
        if root.style == "strip": Rectangle { x: 0; y: parent.height - 18px; width: parent.width; height: 18px; background: @linear-gradient(90deg, Theme.accent.with-alpha(0.45) 0%, Theme.accent-2.with-alpha(0.35) 100%); Rectangle { x: 6px; y: 3px; width: 12px; height: 12px; border-radius: 2px; background: Theme.accent-2; } }
        ssa := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
        TipSpot { tip: root.tip; hover: ssa.has-hover; }
    }
    Text { text: root.name; color: root.on ? Theme.text : Theme.muted; font-size: 12px; font-weight: root.on ? 700 : 400; horizontal-alignment: center; }
}

/// A switch in a group (App & Look's): its name (found by search), what it does, its switch
component GroupSwitch inherits HorizontalLayout {
    in property <string> name;
    in property <string> note;
    in-out property <bool> checked;
    callback toggled(bool);
    spacing: 12px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        HiTitle { text: root.name; }
        if root.note != "": Text { text: root.note; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
    }
    CenterToggle { checked <=> root.checked; toggled => { root.toggled(self.checked); } }
}

/// An account, as a tile: its mark, a light (signed in, waiting, out), who, its switch, and its icons (its plans,
/// its keys, its settings, signing in or out); all it says, in a tip over it
component AccountTile inherits Rectangle {
    in property <Account> acc;
    callback act();
    callback keys();
    callback settings();
    callback manage();
    callback toggle();
    property <color> tint: root.acc.name == "SoundCloud" ? #ff5500 : root.acc.name == "Spotify" ? #1db954 : root.acc.name == "Last.fm" ? #d51007 : #ff3b3b;
    height: 112px;
    border-radius: 14px;
    background: Theme.panel;
    border-width: 1px;
    border-color: root.acc.signed ? root.tint.with-alpha(0.65) : Theme.line;
    HiGlow { lit: Hi.label != "" && (Hi.label == root.acc.name || Hi.label == "Accounts"); r: 14px; }
    VerticalLayout {
        padding: 12px;
        spacing: 5px;
        HorizontalLayout {
            spacing: 7px;
            VerticalLayout { alignment: center; Glyph { d: root.acc.name == "SoundCloud" ? Icons.soundcloud : root.acc.name == "Spotify" ? Icons.spotify : root.acc.name == "Last.fm" ? Icons.lastfm : Icons.youtube; width: 16px; height: 16px; fill: root.tint; } }
            Text { text: root.acc.name; color: Theme.text; font-weight: 700; font-size: 13px; overflow: elide; horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 6px;
            VerticalLayout { alignment: center; Rectangle { width: 7px; height: 7px; border-radius: 4px; background: root.acc.busy ? #ffb547 : root.acc.signed ? #4ad295 : #4a5060; } }
            Text { text: root.acc.short; color: Theme.text.mix(Theme.muted, 0.4); font-size: 12px; overflow: elide; horizontal-stretch: 1; }
        }
        Rectangle {
            vertical-stretch: 1;
            tsa := TouchArea { }
            TipSpot { tip: root.acc.status; hover: tsa.has-hover; }
        }
        HorizontalLayout {
            spacing: 2px;
            if root.acc.switch != "": CenterToggle { checked: root.acc.on; toggled => { root.toggle(); } }
            Rectangle { horizontal-stretch: 1; }
            if root.acc.manage != "": IconButton { d: Icons.open; size: 30px; tip: "Manage your subscription, on its site"; clicked => { root.manage(); } }
            if root.acc.keys != "": IconButton { d: Icons.key; size: 30px; tip: root.acc.keys + ": your own app keys, for requests of your own"; clicked => { root.keys(); } }
            if root.acc.settings != "": IconButton { d: Icons.gear; size: 30px; tip: root.acc.name + "'s settings"; clicked => { root.settings(); } }
            IconButton {
                d: root.acc.signed ? Icons.logout : Icons.login;
                size: 30px;
                tint: root.acc.signed ? Theme.muted : Theme.accent;
                tip: root.acc.busy ? "Waiting: finish signing in in your browser" : root.acc.signed ? "Sign out" : "Sign in";
                clicked => { if (!root.acc.busy) { root.act(); } }
            }
        }
    }
}

/// Sound's sketch: one song ending and the next beginning, as they're set to: faded over each other (as long as
/// the fade), a silence jumped, or (Seamless Mix) mixed on the beat
component ChangeSketch inherits Rectangle {
    in property <bool> fade;
    in property <int> fade-ms;
    in property <int> skip;
    in property <bool> seamless;
    in property <int> smart-max: 10;
    // (as it's set: a 40 s stretch, to scale. The song playing ends in the middle; how long the two play
    // over each other, how long its fade is, and the quiet end skipped first)
    property <float> span: 40;
    property <float> over: root.seamless ? root.smart-max : root.fade ? root.fade-ms / 1000 : 0;
    property <length> left: 70px;
    property <length> inner: root.width - root.left - 14px;
    property <length> per: root.inner / root.span;
    property <length> end: root.left + root.inner * 0.55;
    property <length> start: root.end - root.over * root.per;
    property <length> gap: root.skip > 0 ? min(root.skip, 8) * root.per : 0;
    property <length> lane: 18px;
    property <length> top: 26px;
    height: 104px;
    border-radius: 12px;
    background: Theme.bg;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;
    Text { x: 12px; y: 7px; text: root.seamless ? "Blended on the beat, up to " + root.smart-max + " s" : root.fade ? "Faded over each other for " + round(root.fade-ms / 1000) + " s" : "One straight after the other"; color: Theme.text; font-size: 11px; font-weight: 600; }
    if root.skip > 0: Text { x: parent.width - self.width - 12px; y: 7px; text: "Quiet endings over " + root.skip + " s skipped"; color: Theme.muted; font-size: 11px; }
    // the two lanes' names
    Text { x: 12px; y: root.top + (root.lane - self.height) / 2; text: "This song"; color: Theme.muted; font-size: 10px; }
    Text { x: 12px; y: root.top + root.lane + 8px + (root.lane - self.height) / 2; text: "Next song"; color: Theme.muted; font-size: 10px; }
    // this song: full, then fading out over the overlap
    Rectangle { x: root.left; y: root.top; width: max(0, root.start - root.left); height: root.lane; border-radius: 4px; background: Theme.accent.with-alpha(0.8); }
    if root.over > 0: Rectangle { x: root.start; y: root.top; width: root.end - root.start; height: root.lane; background: @linear-gradient(90deg, Theme.accent.with-alpha(0.8) 0%, Theme.accent.with-alpha(0.05) 100%); }
    // its quiet ending, skipped: struck out after the end
    if root.skip > 0: Rectangle {
        x: root.end; y: root.top + 4px; width: root.gap; height: root.lane - 8px;
        border-radius: 3px; border-width: 1px; border-color: Theme.muted.with-alpha(0.5); background: transparent;
        Rectangle { y: parent.height / 2; height: 1px; background: Theme.muted.with-alpha(0.7); }
    }
    // the next: fading in over the overlap, then full
    if root.over > 0: Rectangle { x: root.start; y: root.top + root.lane + 8px; width: root.end - root.start; height: root.lane; background: @linear-gradient(90deg, Theme.accent-2.with-alpha(0.05) 0%, Theme.accent-2.with-alpha(0.8) 100%); }
    Rectangle { x: root.end; y: root.top + root.lane + 8px; width: root.left + root.inner - root.end; height: root.lane; border-radius: 4px; background: Theme.accent-2.with-alpha(0.8); }
    // (on the beat: the bars they're lined up on)
    if root.seamless: Rectangle { for k in 6: Rectangle { x: root.start + k * (root.end - root.start) / 5; y: root.top - 3px; width: 1px; height: 2 * root.lane + 14px; background: Theme.text.with-alpha(0.25); } }
    // (no overlap: the cut)
    if root.over == 0: Rectangle { x: root.end; y: root.top - 3px; width: 1px; height: 2 * root.lane + 14px; background: Theme.text.with-alpha(0.4); }
    // the time: every 5 s, to scale
    for k in 9: Rectangle {
        x: root.left + k * 5 * root.per;
        y: root.top + 2 * root.lane + 14px;
        width: 1px; height: 4px; background: Theme.muted.with-alpha(0.5);
    }
    Text { x: root.left; y: root.height - self.height - 6px; text: "5 s a mark"; color: Theme.muted; font-size: 10px; }
}

/// Something that goes on stream (the Stream Widget, the Lyrics Widget): a tile with its light, its address (copied
/// with a click), its settings, its switch
component StreamTile inherits Rectangle {
    /// (its own colour, from the theme's: a wash behind it, and its edge)
    in property <color> tint: Theme.accent;
    in property <SetRow> r;
    in property <string> addr;
    in property <string> d;
    callback toggle(string);
    callback more(string);
    callback copy(string);
    height: 124px;
    border-radius: 14px;
    background: Theme.panel.mix(root.tint, 0.9);
    border-width: 1px;
    border-color: root.r.on ? root.tint.with-alpha(0.65) : root.tint.with-alpha(0.25);
    HiGlow { lit: Hi.label != "" && Hi.label == root.r.label; r: 14px; }
    VerticalLayout {
        padding: 12px;
        spacing: 5px;
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout { alignment: center; Glyph { d: root.d; width: 16px; height: 16px; fill: root.r.on ? Theme.accent : Theme.muted; } }
            Text { text: root.r.label; color: Theme.text; font-weight: 700; font-size: 13px; overflow: elide; horizontal-stretch: 1; }
        }
        Text { text: root.r.note; color: Theme.muted; font-size: 12px; overflow: elide; }
        if root.r.on && root.addr != "": Text { text: root.addr; color: Theme.accent.mix(Theme.text, 0.55); font-size: 11px; font-family: "Consolas"; overflow: elide; }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 2px;
            CenterToggle { checked: root.r.on; toggled => { root.toggle(root.r.key); } }
            Rectangle { horizontal-stretch: 1; }
            if root.r.on && root.addr != "": IconButton { d: Icons.copy; size: 30px; tip: "Copy its address, for a Browser source in OBS"; clicked => { root.copy(root.addr); } }
            if root.r.more: IconButton { d: Icons.gear; size: 30px; tip: root.r.label + ": its settings"; clicked => { root.more(root.r.key); } }
        }
    }
}

/// A plugin, as a tile: its mark, a light (on, running), what it does, its settings, its switch; or (Add a Plugin)
/// a dashed tile to add one
component PluginTile inherits Rectangle {
    in property <SetRow> r;
    callback toggle(string);
    callback more(string);
    property <bool> add: root.r.key == "plugAdd";
    height: 146px;
    border-radius: 14px;
    background: pta.has-hover && root.add ? Theme.elevated : Theme.panel;
    border-width: root.add ? 2px : 1px;
    border-color: root.add ? Theme.accent.with-alpha(0.45) : root.r.on ? Theme.accent.with-alpha(0.6) : Theme.line;
    HiGlow { lit: Hi.label != "" && Hi.label == root.r.label; r: 14px; }
    pta := TouchArea { enabled: root.add; mouse-cursor: root.add ? MouseCursor.pointer : MouseCursor.default; clicked => { root.more(root.r.key); } }
    VerticalLayout {
        padding: 14px;
        spacing: 5px;
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 30px; height: 30px; border-radius: 9px;
                background: root.add ? Theme.accent.with-alpha(0.15) : root.r.on ? Theme.accent.with-alpha(0.15) : Theme.elevated;
                Glyph { d: root.add ? Icons.add : Icons.plugin; width: 18px; height: 18px; x: 6px; y: 6px; fill: root.add || root.r.on ? Theme.accent : Theme.muted; }
            }
            Text { text: root.r.label; color: Theme.text; font-weight: 700; font-size: 13px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
            if !root.add: VerticalLayout { alignment: center; Rectangle { width: 7px; height: 7px; border-radius: 4px; background: root.r.on ? #4ad295 : #4a5060; } }
        }
        Rectangle {
            vertical-stretch: 1;
            preferred-height: 0px;
            min-height: 0px;
            clip: true;
            pnt := Text { width: parent.width; height: parent.height; text: root.r.note; color: Theme.muted; font-size: 12px; wrap: word-wrap; overflow: elide; vertical-alignment: top; }
            pna := TouchArea { enabled: !root.add; }
            TipSpot { tip: root.r.note; hover: pna.has-hover && !root.add; }
        }
        if !root.add: HorizontalLayout {
            spacing: 2px;
            CenterToggle { checked: root.r.on; toggled => { root.toggle(root.r.key); } }
            Rectangle { horizontal-stretch: 1; }
            if root.r.more: IconButton { d: Icons.gear; size: 30px; tip: root.r.label + ": its settings"; clicked => { root.more(root.r.key); } }
        }
    }
}

/// A widget's design, as a little sketch to pick (in the options' order: card, bar, square, minimal, pill, vinyl,
/// poster, ticker)
component DesignSketch inherits VerticalLayout {
    in property <int> k;
    in property <string> name;
    in property <bool> on;
    callback clicked();
    spacing: 5px;
    sk := Rectangle {
        height: 60px;
        border-radius: 10px;
        background: Theme.bg;
        border-width: root.on ? 2px : 1px;
        border-color: root.on ? Theme.accent : Theme.line;
        clip: true;
        property <brush> fill: @linear-gradient(90deg, Theme.accent.with-alpha(0.55) 0%, Theme.accent-2.with-alpha(0.55) 100%);
        // card
        if root.k == 0: Rectangle { x: 10px; y: 16px; width: parent.width - 20px; height: 28px; border-radius: 6px; background: parent.fill;
            Rectangle { x: 4px; y: 4px; width: 20px; height: 20px; border-radius: 3px; background: Theme.text.with-alpha(0.5); }
            Rectangle { x: 30px; y: 7px; width: 40%; height: 5px; border-radius: 2px; background: Theme.text.with-alpha(0.8); }
            Rectangle { x: 30px; y: 16px; width: 25%; height: 4px; border-radius: 2px; background: Theme.text.with-alpha(0.45); } }
        // slim bar
        if root.k == 1: Rectangle { x: 8px; y: 24px; width: parent.width - 16px; height: 12px; border-radius: 3px; background: parent.fill;
            Rectangle { x: 6px; y: 4px; width: 45%; height: 4px; border-radius: 2px; background: Theme.text.with-alpha(0.8); } }
        // square
        if root.k == 2: Rectangle { x: (parent.width - 38px) / 2; y: 6px; width: 38px; height: 48px; border-radius: 6px; background: parent.fill;
            Rectangle { x: 5px; y: 5px; width: 28px; height: 26px; border-radius: 3px; background: Theme.text.with-alpha(0.5); }
            Rectangle { x: 5px; y: 36px; width: 22px; height: 4px; border-radius: 2px; background: Theme.text.with-alpha(0.8); } }
        // minimal
        if root.k == 3: Rectangle { x: 10px; y: 20px; width: parent.width - 20px; height: 20px;
            Rectangle { width: 14px; height: 14px; y: 3px; border-radius: 3px; background: Theme.text.with-alpha(0.5); }
            Rectangle { x: 20px; y: 5px; width: 45%; height: 5px; border-radius: 2px; background: Theme.text.with-alpha(0.85); }
            Rectangle { x: 20px; y: 13px; width: 30%; height: 3px; border-radius: 2px; background: Theme.text.with-alpha(0.4); } }
        // pill
        if root.k == 4: Rectangle { x: 8px; y: 20px; width: parent.width - 16px; height: 20px; border-radius: 10px; background: parent.fill;
            Rectangle { x: 3px; y: 3px; width: 14px; height: 14px; border-radius: 7px; background: Theme.text.with-alpha(0.5); }
            Rectangle { x: 22px; y: 8px; width: 45%; height: 4px; border-radius: 2px; background: Theme.text.with-alpha(0.8); } }
        // vinyl
        if root.k == 5: Rectangle { x: 10px; y: 14px; width: parent.width - 20px; height: 32px; border-radius: 6px; background: parent.fill;
            Rectangle { x: 4px; y: 3px; width: 26px; height: 26px; border-radius: 13px; background: #111; Rectangle { x: 10px; y: 10px; width: 6px; height: 6px; border-radius: 3px; background: Theme.accent; } }
            Rectangle { x: 36px; y: 10px; width: 40%; height: 5px; border-radius: 2px; background: Theme.text.with-alpha(0.8); } }
        // poster
        if root.k == 6: Rectangle { x: 10px; y: 6px; width: parent.width - 20px; height: 48px; border-radius: 6px; background: parent.fill;
            Rectangle { x: 0; y: 0; width: parent.width; height: 30px; border-radius: 6px; background: Theme.text.with-alpha(0.35); }
            Rectangle { x: 5px; y: 35px; width: 50%; height: 5px; border-radius: 2px; background: Theme.text.with-alpha(0.85); } }
        // ticker
        if root.k == 7: Rectangle { x: 0; y: 25px; width: parent.width; height: 10px; background: parent.fill;
            Rectangle { x: 6px; y: 3px; width: 70%; height: 4px; border-radius: 2px; background: Theme.text.with-alpha(0.8); } }
        // neon sign
        if root.k == 8: Rectangle { x: 14px; y: 14px; width: parent.width - 28px; height: 32px; border-radius: 6px; border-width: 2px; border-color: Theme.accent-2; background: #00000060;
            Rectangle { x: 8px; y: 9px; width: 55%; height: 5px; border-radius: 2px; background: Theme.accent; }
            Rectangle { x: 8px; y: 18px; width: 35%; height: 4px; border-radius: 2px; background: Theme.accent-2; } }
        // lower third
        if root.k == 9: Rectangle { x: 0; y: 34px; width: parent.width * 0.8; height: 18px; background: #000000b0;
            Rectangle { width: 4px; height: parent.height; background: Theme.accent; }
            Rectangle { x: 10px; y: 5px; width: 50%; height: 4px; border-radius: 2px; background: Theme.text.with-alpha(0.85); }
            Rectangle { x: 10px; y: 11px; width: 30%; height: 3px; border-radius: 2px; background: Theme.text.with-alpha(0.45); } }
        // cassette
        if root.k == 10: Rectangle { x: (parent.width - 64px) / 2; y: 8px; width: 64px; height: 44px; border-radius: 5px; background: #2d2d33; border-width: 1px; border-color: #55555d;
            Rectangle { x: 6px; y: 5px; width: parent.width - 12px; height: 14px; border-radius: 2px; background: #f3e6d0; Rectangle { x: 5px; y: 5px; width: 60%; height: 3px; background: Theme.accent; } }
            Rectangle { x: 10px; y: 24px; width: 14px; height: 14px; border-radius: 7px; border-width: 3px; border-color: #0d0d10; background: #9a9aa2; }
            Rectangle { x: parent.width - 24px; y: 24px; width: 14px; height: 14px; border-radius: 7px; border-width: 3px; border-color: #0d0d10; background: #9a9aa2; } }
        // equaliser
        if root.k == 11: Rectangle { x: 10px; y: 8px; width: parent.width - 20px; height: 44px; border-radius: 6px; background: #00000060;
            for b in 10: Rectangle { x: 4px + b * (parent.width - 8px) / 10; width: (parent.width - 8px) / 10 * 0.7; height: parent.height * (0.25 + 0.6 * abs(sin(b * 53deg))); y: parent.height - self.height - 2px; background: Theme.accent.with-alpha(0.6); }
            Rectangle { x: (parent.width - self.width) / 2; y: 16px; width: 50%; height: 5px; border-radius: 2px; background: Theme.text.with-alpha(0.9); } }
        // now and next
        if root.k == 12: Rectangle { x: 10px; y: 8px; width: parent.width - 20px; height: 44px; border-radius: 6px; background: parent.fill;
            Rectangle { x: 6px; y: 7px; width: 55%; height: 5px; border-radius: 2px; background: Theme.text.with-alpha(0.85); }
            Rectangle { x: 6px; y: 16px; width: 35%; height: 3px; border-radius: 2px; background: Theme.text.with-alpha(0.45); }
            Rectangle { x: 6px; y: 24px; width: parent.width - 12px; height: 1px; background: Theme.text.with-alpha(0.3); }
            Rectangle { x: 6px; y: 30px; width: 9px; height: 9px; border-radius: 2px; background: Theme.text.with-alpha(0.5); }
            Rectangle { x: 19px; y: 33px; width: 40%; height: 3px; border-radius: 2px; background: Theme.text.with-alpha(0.55); } }
        // polaroid
        if root.k == 13: Rectangle { x: (parent.width - 34px) / 2; y: 6px; width: 34px; height: 44px; background: #fafafa; transform-rotation: -6deg;
            Rectangle { x: 3px; y: 3px; width: 28px; height: 28px; background: sk.fill; }
            Rectangle { x: 7px; y: 35px; width: 20px; height: 3px; background: #444; } }
        // frosted glass
        if root.k == 14: Rectangle { x: 0; y: 0; width: parent.width; height: parent.height; background: @linear-gradient(135deg, Theme.accent.with-alpha(0.5) 0%, Theme.accent-2.with-alpha(0.4) 100%);
            Rectangle { x: 12px; y: 15px; width: parent.width - 24px; height: 30px; border-radius: 8px; background: #ffffff30; border-width: 1px; border-color: #ffffff50;
                Rectangle { x: 4px; y: 4px; width: 22px; height: 22px; border-radius: 5px; background: Theme.text.with-alpha(0.55); }
                Rectangle { x: 32px; y: 9px; width: 40%; height: 4px; border-radius: 2px; background: Theme.text.with-alpha(0.9); } } }
        // vertical
        if root.k == 15: Rectangle { x: (parent.width - 30px) / 2; y: 4px; width: 30px; height: 52px; border-radius: 5px; background: parent.fill;
            Rectangle { x: 4px; y: 4px; width: 22px; height: 22px; border-radius: 3px; background: Theme.text.with-alpha(0.5); }
            Rectangle { x: 5px; y: 31px; width: 20px; height: 3px; border-radius: 2px; background: Theme.text.with-alpha(0.85); }
            Rectangle { x: 8px; y: 37px; width: 14px; height: 3px; border-radius: 2px; background: Theme.text.with-alpha(0.45); } }
        dsa := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
        // (its recommended Browser source size in OBS, as you point at it: its own shape, sharp at 1080p)
        TipSpot { hover: dsa.has-hover; tip: root.name + ". Recommended Browser source size: " + ["920 × 260", "1120 × 128", "600 × 760", "920 × 220", "960 × 160", "920 × 300", "960 × 540", "1280 × 96", "960 × 280", "1240 × 180", "840 × 440", "1040 × 300", "920 × 300", "600 × 720", "920 × 260", "480 × 840"][root.k] + " px."; }
    }
    Text { text: root.name; color: root.on ? Theme.text : Theme.muted; font-size: 12px; font-weight: root.on ? 700 : 400; horizontal-alignment: center; }
}

/// The Lyrics Widget's preview: a few lines in its look (colours, size, alignment, style, outline, box), as it's set
/// The Stream Widget as it'll look in OBS, near enough: what's playing (or a made-up song), in its design's
/// shape (a row, a column, a slim bar) and its touches (round ends, no panel, a glow, a record)
component WidgetPreview inherits Rectangle {
    in property <WidgetLook> look;
    in property <image> art;
    in property <string> title;
    in property <string> artist;
    height: 190px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;
    Rectangle { background: @linear-gradient(135deg, #2b3550 0%, #3a2b48 100%); }
    Caps { r: 14px; outside: Theme.bg; tl: #2b3550; tr: #33304c; bl: #33304c; br: #3a2b48; top: true; bottom: true; }
    Text { x: 12px; y: 8px; text: "A preview, near enough. Pop Out Preview below shows it exactly."; color: #ffffffa0; font-size: 11px; }
    property <string> d: root.look.design;
    property <bool> column: root.d == "square" || root.d == "poster" || root.d == "polaroid" || root.d == "vertical";
    property <bool> slim: root.d == "bar" || root.d == "ticker";
    property <bool> bare: root.d == "minimal";
    property <bool> round-art: root.d == "vinyl";
    property <length> fs: 15px * clamp(root.look.text, 0.7, 1.6);
    property <float> p: Theme.motion ? mod(animation-tick() / 1ms, 60000) / 60000 : 0.35;
    card := Rectangle {
        property <length> w: root.column ? 170px : root.slim ? min(root.width - 48px, 520px) : min(root.width - 48px, 440px);
        property <length> h: root.column ? 150px : root.slim ? 38px : 96px;
        width: self.w;
        height: self.h;
        x: root.look.right ? root.width - self.w - 24px : 24px;
        y: (root.height - self.h) / 2 + 8px;
        border-radius: !root.look.rounded ? 0px : root.d == "pill" ? self.h / 2 : root.slim ? 6px : 14px;
        // (a solid blend of its two colours: a gradient would lose its rounded corners in the software renderer)
        background: root.bare ? transparent : root.d == "frosted" ? #ffffff26 : root.d == "neon" ? #08061ae6 : root.look.c1.mix(root.look.c2, 0.5).mix(#0a0814, 0.5);
        border-width: root.d == "neon" ? 2px : root.d == "frosted" ? 1px : 0px;
        border-color: root.d == "neon" ? root.look.c1 : #ffffff48;
        drop-shadow-blur: root.d == "neon" ? 16px : 0px;
        drop-shadow-color: root.look.c1;
        clip: true;
        // (its cover: square, or a record that turns)
        Rectangle {
            property <length> s: root.column ? 92px : root.slim ? 28px : 72px;
            width: self.s;
            height: self.s;
            x: root.column ? (parent.width - self.s) / 2 : root.look.right ? parent.width - self.s - 12px : (root.slim ? 5px : 12px);
            y: root.column ? 10px : (parent.height - self.s) / 2;
            border-radius: root.round-art || root.d == "pill" ? self.s / 2 : 8px;
            clip: true;
            background: root.look.c1.with-alpha(0.5);
            Image { source: root.art; width: parent.width; height: parent.height; image-fit: cover; transform-rotation: root.round-art && root.look.spin && Theme.motion ? mod(animation-tick() / 1ms, 4000) / 4000 * 360deg : 0deg; }
        }
        VerticalLayout {
            x: root.column ? 10px : root.look.right ? 12px : (root.slim ? 42px : 98px);
            y: root.column ? 108px : 0px;
            width: root.column ? parent.width - 20px : parent.width - (root.slim ? 54px : 112px);
            height: root.column ? 36px : parent.height;
            alignment: center;
            spacing: 2px;
            Text { text: root.title; color: #ffffff; font-size: root.slim ? root.fs * 0.9 : root.fs * 1.15; font-weight: 800; overflow: elide; horizontal-alignment: root.column ? center : root.look.right ? right : left; }
            if !root.slim: Text { text: root.artist + (root.look.requester ? "  \u{b7}  for PixelPanda" : ""); color: #ffffffc0; font-size: root.fs * 0.85; overflow: elide; horizontal-alignment: root.column ? center : root.look.right ? right : left; }
            if !root.slim && !root.column: Rectangle {
                height: 4px;
                border-radius: 2px;
                background: #ffffff30;
                Rectangle { x: 0; width: parent.width * root.p; border-radius: 2px; background: @linear-gradient(90deg, root.look.c1 0%, root.look.c2 100%); }
            }
        }
    }
}

/// The alerts as they'll look in the Stream Widget: a made-up one every few seconds (a follow, a sub, bits, a
/// raid), in their theme
component AlertPreview inherits Rectangle {
    in property <AlertLook> look;
    height: 190px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;
    Rectangle { background: @linear-gradient(135deg, #2b3550 0%, #3a2b48 100%); }
    Caps { r: 14px; outside: Theme.bg; tl: #2b3550; tr: #33304c; bl: #33304c; br: #3a2b48; top: true; bottom: true; }
    Text { x: 12px; y: 8px; text: root.look.in-widget ? "A preview: made-up alerts in the Stream Widget" : "A preview: made-up alerts, on their own"; color: #ffffffa0; font-size: 11px; }
    property <[{ head: string, main: string, msg: string, d: string }]> samples: [
        { head: "New Follower", main: "PixelPanda", msg: "", d: Icons.heart-out },
        { head: "New Subscriber", main: "Nova", msg: "Tier 1 \u{b7} 6 months", d: Icons.star-out },
        { head: "Bits", main: "Zed cheered 500 bits", msg: "Great stream!", d: Icons.coins },
        { head: "Raid", main: "RaidLeader", msg: "with 42 viewers", d: Icons.broadcast },
    ];
    // (a turn every 5 s: the alert comes in at 1 s, goes at 4 s; between, Now Playing (in the widget) or nothing)
    property <int> turn: Theme.motion ? floor(animation-tick() / 5000ms) : 1;
    property <float> at: Theme.motion ? mod(animation-tick() / 1ms, 5000) : 2000;
    property <float> come: clamp((root.at - 1000) / 550, 0, 1);
    property <float> go: clamp((root.at - 3500) / 500, 0, 1);
    property <bool> entering: root.go == 0;
    // (how far in it is: 0 out, 1 in)
    property <float> ph: root.entering ? root.come : 1 - root.go;
    property <{ head: string, main: string, msg: string, d: string }> it: root.samples[mod(root.turn, 4)];
    property <string> th: root.look.theme;
    property <bool> gifs: root.th == "gif" || root.th == "gifpop" || root.th == "meme";
    // (the way in: in the widget, its transition (Over the Top: its animation); on their own, the animation)
    property <string> tr: root.look.in-widget ? root.look.transition : "overlay";
    property <string> way: root.tr == "overlay" ? root.look.anim : root.tr;
    property <length> w0: min(self.width - 48px, 520px);
    property <length> h0: 92px;
    // (each way, as a scale, a shift and a fade)
    property <float> sc: root.way == "pop" ? 0.6 + 0.4 * root.ph : root.way == "elastic" ? (0.4 + 0.6 * root.ph) + sin(root.ph * 540deg) * 0.08 * (1 - root.ph) * 2
        : root.way == "zoom" ? (root.entering ? 1 + (1 - root.ph) * 0.7 : 0.4 + 0.6 * root.ph) : root.way == "spin" ? 0.2 + 0.8 * root.ph : 1;
    property <float> sx: root.way == "unfold" || root.way == "wipe" ? max(0.02, root.ph) : 1;
    property <float> sy: root.way == "flip" || root.way == "swing" ? max(0.02, root.ph) : root.way == "unfold" ? (root.ph < 0.5 ? 0.12 : 0.12 + (root.ph - 0.5) * 1.76) : 1;
    property <length> dy: root.way == "slide" ? (1 - root.ph) * (root.entering ? 40px : -40px) : root.way == "bounce" || root.way == "drop" ? (1 - root.ph) * (root.entering ? -60px : 60px)
        : root.way == "rise" ? (1 - root.ph) * (root.entering ? 24px : -24px) : 0px;
    property <length> dx: root.way == "push" ? (1 - root.ph) * (root.entering ? root.w0 : root.w0) : root.way == "glitch" ? (1 - root.ph) * (mod(root.at, 120) < 60 ? 14px : -14px) : 0px;
    property <float> op: root.way == "push" || root.way == "wipe" || root.way == "flip" || root.way == "unfold" || root.way == "swing" ? (root.ph > 0.02 ? 1 : 0) : root.ph;
    // (Now Playing, in the widget: there between alerts, and going as the transition has it)
    if root.look.in-widget: Rectangle {
        property <float> gone: root.at < 1000 || root.at > 4000 ? 0 : root.tr == "push" ? 0 : root.ph;
        width: root.w0 * (root.tr == "zoom" ? 1 - 0.4 * self.gone : root.tr == "flip" ? 1 : 1);
        height: root.h0 * (root.tr == "flip" ? max(0.02, 1 - self.gone) : root.tr == "zoom" ? 1 - 0.4 * self.gone : 1);
        x: (parent.width - self.width) / 2 - (root.tr == "push" && root.at >= 1000 && root.at <= 4000 ? root.ph * root.w0 : 0px);
        y: (parent.height - self.height) / 2 + 8px - (root.tr == "rise" ? self.gone * 30px : 0px);
        opacity: root.tr == "push" || root.tr == "flip" || root.tr == "wipe" ? 1 : 1 - self.gone;
        border-radius: 14px;
        background: root.look.c1.mix(root.look.c2, 0.5).darker(0.35);
        HorizontalLayout {
            padding: 12px;
            spacing: 14px;
            Rectangle { width: self.height; border-radius: 10px; background: @linear-gradient(135deg, #8e9bff 0%, #ff7ac8 100%); }
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                Text { text: "Sample Song"; color: #ffffff; font-size: 18px; font-weight: 800; }
                Text { text: "OmniPulse"; color: #ffffffc0; font-size: 13px; }
            }
        }
    }
    al := Rectangle {
        width: root.w0 * root.sc * root.sx;
        height: root.h0 * root.sc * root.sy;
        // (Wipe sweeps in from the left; the rest grow from the middle)
        x: (root.way == "wipe" ? (parent.width - root.w0) / 2 : (parent.width - self.width) / 2) + root.dx;
        y: (parent.height - self.height) / 2 + 8px + root.dy;
        visible: root.at >= 1000 && root.at <= 4000;
        opacity: root.op;
        clip: root.th != "gifpop";
        border-radius: root.th == "comic" ? 6px : root.th == "meme" ? 6px : 14px;
        background: root.th == "glass" ? #ffffff24 : root.th == "neon" ? #080614e0 : root.th == "banner" ? root.look.c1 : root.th == "split" ? #111520 : root.th == "comic" ? #ffffff : root.th == "minimal" ? transparent
            : root.th == "gif" ? #0a0814d1 : root.th == "meme" ? #000000
            // (a solid blend: a gradient would lose its rounded corners in the software renderer)
            : root.look.glow ? root.look.c1.mix(root.look.c2, 0.65) : root.look.c1.mix(root.look.c2, 0.5);
        border-width: root.th == "neon" || root.th == "comic" ? (root.th == "comic" ? 3px : 2px) : root.th == "glass" ? 1px : 0px;
        border-color: root.th == "neon" ? root.look.c1 : root.th == "comic" ? #111111 : #ffffff48;
        drop-shadow-blur: root.th == "neon" ? 18px : 0px;
        drop-shadow-color: root.look.c1;
        // (Meme: the GIF fills it, the words on top)
        if root.th == "meme": Rectangle {
            background: @linear-gradient(135deg, #5b4b7a 0%, #2c3e5a 100%);
            Text { text: "GIF"; color: #ffffff30; font-size: 34px; font-weight: 900; }
        }
        // (GIF Pop-Out: the GIF stands up out of it)
        if root.th == "gifpop": Rectangle {
            x: 10px;
            y: parent.height - self.height - 6px;
            width: parent.height * 0.95;
            height: parent.height * 1.55;
            border-radius: 10px;
            background: #ffffff2a;
            border-width: 1px;
            border-color: #ffffff70;
            Text { text: "GIF"; color: #ffffff; font-size: 16px; font-weight: 900; }
        }
        HorizontalLayout {
            padding: root.th == "gif" ? 6px : 12px;
            padding-left: root.th == "gifpop" ? parent.height * 0.95 + 22px : root.th == "gif" ? 6px : 12px;
            spacing: 14px;
            if root.th != "gifpop" && root.th != "meme": Rectangle {
                width: root.th == "gif" ? self.height * 1.35 : self.height;
                border-radius: 10px;
                background: root.th == "gif" ? #ffffff26 : root.th == "split" ? root.look.c1.mix(root.look.c2, 0.5) : root.th == "comic" ? root.look.c1 : root.th == "neon" ? transparent
                    : root.th == "glass" ? #ffffff2e : root.th == "minimal" ? #00000059 : root.th == "banner" ? #00000038 : root.look.c1.mix(#ffffff, 0.55).with-alpha(0.7);
                border-width: root.th == "neon" || root.th == "comic" ? 2px : 0px;
                border-color: root.th == "neon" ? root.look.c1 : #111111;
                if root.th != "gif": Glyph { d: root.it.d; width: parent.width * 0.5 * clamp(root.look.icon, 0.6, 2); height: self.width; fill: #ffffff; }
                if root.th == "gif": Text { text: "GIF"; color: #ffffff; font-size: 16px; font-weight: 900; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text { text: root.it.head.to-uppercase(); color: root.th == "neon" || root.th == "split" || root.th == "gif" ? root.look.c1 : root.th == "comic" ? #111111c8 : #ffffffc8; font-size: 12px; font-weight: 800; letter-spacing: 1.5px; horizontal-alignment: root.th == "meme" ? center : left; }
                Text { text: root.th == "meme" ? root.it.main.to-uppercase() : root.it.main; color: root.th == "comic" ? #111111 : #ffffff; font-size: root.th == "banner" || root.th == "meme" ? 24px : 20px; font-weight: 800; overflow: elide; horizontal-alignment: root.th == "meme" ? center : left;
                    stroke: root.th == "meme" ? #000000 : transparent; stroke-width: root.th == "meme" ? 2px : 0px; }
                if root.it.msg != "": Text { text: root.it.msg; color: root.th == "comic" ? #111111c8 : #ffffffd0; font-size: 13px; overflow: elide; horizontal-alignment: root.th == "meme" ? center : left; }
            }
        }
    }
}

/// Game HUD Frames' editor: your screenshot, its frames on it; drag a box for a new one, click one to pick it
component HudEditor inherits Rectangle {
    callback act(string);
    height: self.width * HudLook.ratio;
    border-radius: 10px;
    clip: true;
    background: #000000;
    Image { width: parent.width; height: parent.height; source: HudLook.shot; image-fit: fill; }
    for f in HudLook.frames: Rectangle {
        x: parent.width * f.x;
        y: parent.height * f.y;
        width: parent.width * f.w;
        height: parent.height * f.h;
        border-width: f.picked ? 3px : 2px;
        border-color: f.picked ? #ffffff : HudLook.c1;
        background: f.picked ? HudLook.c1.with-alpha(0.18) : transparent;
        if f.label != "": Text { x: 0; y: -16px; text: f.label; color: HudLook.c1; font-size: 11px; font-weight: 800; }
    }
    // (the box being drawn)
    property <length> sx;
    property <length> sy;
    property <bool> dragging;
    if root.dragging: Rectangle {
        x: min(root.sx, ta.mouse-x);
        y: min(root.sy, ta.mouse-y);
        width: abs(ta.mouse-x - root.sx);
        height: abs(ta.mouse-y - root.sy);
        border-width: 2px;
        border-color: #ffffff;
        background: #ffffff22;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.crosshair;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.sx = self.mouse-x; root.sy = self.mouse-y; root.dragging = true; }
            if e.kind == PointerEventKind.up && root.dragging {
                root.dragging = false;
                // (a click, not a drag: the frame under it picked)
                if abs(self.mouse-x - root.sx) < 6px && abs(self.mouse-y - root.sy) < 6px {
                    root.act("hud:pick:" + (self.mouse-x / root.width) + "," + (self.mouse-y / root.height));
                } else {
                    root.act("hud:add:" + (root.sx / root.width) + "," + (root.sy / root.height) + "," + (clamp(self.mouse-x, 0px, root.width) / root.width) + "," + (clamp(self.mouse-y, 0px, root.height) / root.height));
                }
            }
        }
    }
}

/// The panels as they'll look, at Twitch's width (320), two to a row
component PanelPreview inherits Rectangle {
    property <length> ph: PanelLook.height == "short" ? 80px : PanelLook.height == "tall" ? 160px : PanelLook.height == "square" ? 320px : 100px;
    height: pl.preferred-height;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.line;
    background: #16141f;
    pl := VerticalLayout {
        padding: 14px;
        padding-top: 28px;
        spacing: 10px;
        alignment: start;
        Text { text: "A preview: your panels at Twitch's size (a long one grows to fit its words)"; color: #ffffffa0; font-size: 11px; }
        for p[i] in PanelLook.items: HorizontalLayout {
            alignment: start;
            pi := Rectangle {
                property <string> th: PanelLook.theme;
                property <bool> light: self.th == "comic" || self.th == "pastel" || self.th == "y2k" || self.th == "paper" || self.th == "bauhaus" || self.th == "holo" || self.th == "watercolour" || self.th == "ticket";
                property <color> ink: PanelLook.ink-on ? PanelLook.ink : self.th == "pastel" ? #3a2a4a : self.th == "paper" ? #26324a : self.th == "bauhaus" ? #111111 : self.th == "holo" ? #2a1f45 : self.th == "watercolour" ? #2b2233
                    : self.th == "ticket" ? #3b2410 : self.th == "terminal" ? PanelLook.term-ink : self.light ? #2b1b40 : #ffffff;
                // (room at the top for a title bar; room on the right for its art; its type)
                property <length> top: self.th == "y2k" ? 22px : self.th == "terminal" ? 18px : 0px;
                property <length> keep: self.th == "ticket" ? 66px : self.th == "bauhaus" ? 104px : self.th == "synthwave" ? 50px : 0px;
                property <string> ff: self.th == "pixel" || self.th == "terminal" ? "Cascadia Mono" : self.th == "paper" ? "Ink Free" : self.th == "bauhaus" || self.th == "cyber" || self.th == "ticket" ? "Bahnschrift" : self.th == "watercolour" ? "Georgia" : "";
                property <bool> upper: self.th == "pixel" || self.th == "bauhaus" || self.th == "cyber";
                property <string> shown-title: (self.th == "terminal" ? "> " : "") + (self.upper ? p.title.to-uppercase() : p.title) + (self.th == "terminal" ? " \u{2588}" : "");
                width: 320px;
                // (as tall as its words, up to Twitch's 600)
                height: p.body ? min(600px, 74px + p.lines * 17px + 18px + self.top) : root.ph;
                clip: true;
                border-radius: PanelLook.shape == "square" || self.th == "pixel" || self.th == "cyber" ? 0px : self.th == "paper" ? 3px : self.th == "bauhaus" ? 6px : self.th == "terminal" || self.th == "ticket" ? 8px : PanelLook.shape == "pill" && !p.body ? self.height / 2 : 14px;
                // (a plain background: your own colour instead, if you've set one)
                property <bool> flat: self.th == "dark" || self.th == "neon" || self.th == "comic" || self.th == "y2k" || self.th == "pastel" || self.th == "pixel" || self.th == "paper" || self.th == "bauhaus"
                    || self.th == "terminal" || self.th == "watercolour" || self.th == "galaxy" || self.th == "ticket";
                background: PanelLook.bg-on && self.flat ? PanelLook.bg : self.th == "comic" || self.th == "y2k" ? (self.th == "y2k" ? #fdf6ff : #ffffff) : self.th == "pastel" ? #fff6fb : self.th == "glass" ? #ffffff29 : self.th == "neon" ? #080614f0
                    : self.th == "pixel" ? #1b1030 : self.th == "gradient" ? PanelLook.c1.mix(PanelLook.c2, 0.5) : self.th == "minimal" || self.th == "cyber" ? transparent
                    : self.th == "synthwave" ? #12021f : self.th == "paper" ? #fbf6e9 : self.th == "bauhaus" ? #f2ede4 : self.th == "holo" ? #e9e0ff : self.th == "terminal" ? #0a0f0c
                    : self.th == "watercolour" ? #fffdf8 : self.th == "galaxy" ? #05030f : self.th == "ticket" ? #ffe9c7 : #14111f;
                border-width: self.th == "comic" ? 3px : self.th == "y2k" || self.th == "neon" ? 2px : self.th == "pastel" || self.th == "pixel" ? 3px : self.th == "glass" || self.th == "holo" ? 1.5px : self.th == "terminal" ? 1px : 0px;
                border-color: self.th == "comic" || self.th == "y2k" ? #2b1b40 : self.th == "pastel" ? PanelLook.c1.mix(#ffffff, 0.55) : self.th == "pixel" ? #f4f0ff : self.th == "neon" ? PanelLook.c1 : self.th == "holo" ? #ffffffe6 : self.th == "terminal" ? #ffffff1f : #ffffff66;
                drop-shadow-blur: self.th == "neon" ? 12px : 0px;
                drop-shadow-offset-x: self.th == "comic" || self.th == "y2k" ? 4px : 0px;
                drop-shadow-offset-y: self.th == "comic" || self.th == "y2k" ? 4px : 0px;
                drop-shadow-color: self.th == "neon" ? PanelLook.c1 : #111111;
                // (Synthwave: a striped sun setting on a grid)
                if pi.th == "synthwave": Rectangle {
                    property <length> hz: p.body ? parent.height - 24px : parent.height * 0.7;
                    property <length> sr: p.body ? 24px : min(30px, self.hz - 10px);
                    Rectangle { y: 0; height: parent.hz; background: @linear-gradient(180deg, #120326 0%, #4a0d67 100%); }
                    Rectangle {
                        x: parent.width - 46px - parent.sr;
                        y: parent.hz - parent.sr;
                        width: parent.sr * 2;
                        height: parent.sr;
                        clip: true;
                        Path { width: parent.width; height: parent.height; viewbox-width: 100; viewbox-height: 50; commands: "M 0 50 A 50 50 0 0 1 100 50 Z"; fill: @linear-gradient(180deg, #ffd36e 0%, PanelLook.c2 100%); stroke-width: 0; }
                        for k in 4: Rectangle { y: parent.height * (0.5 + k * 0.12); height: 1.5px + k * 1px; background: #3b0a55; }
                    }
                    // (a shade behind the words, over the grid)
                    Rectangle { x: 0; y: p.body ? 0 : parent.hz - 4px; width: parent.width * 0.75; height: p.body ? parent.height : parent.height - parent.hz + 4px; background: @linear-gradient(90deg, #120226b8 0%, #12022600 100%); }
                    Path { y: parent.hz; width: parent.width; height: parent.height - parent.hz; viewbox-width: 320; viewbox-height: 100; commands: "M 0 6.5 L 320 6.5 M 0 21.1 L 320 21.1 M 0 42.0 L 320 42.0 M 0 68.4 L 320 68.4 M 0 100.0 L 320 100.0 M 211 0 L -302 100 M 218 0 L -238 100 M 225 0 L -174 100 M 232 0 L -110 100 M 239 0 L -46 100 M 246 0 L 18 100 M 253 0 L 82 100 M 260 0 L 146 100 M 267 0 L 210 100 M 274 0 L 274 100 M 281 0 L 338 100 M 288 0 L 402 100 M 295 0 L 466 100 M 302 0 L 530 100 M 309 0 L 594 100 M 316 0 L 658 100 M 323 0 L 722 100 M 330 0 L 786 100 M 337 0 L 850 100"; stroke: PanelLook.c1.with-alpha(0.85); stroke-width: 1px; fill: transparent; }
                }
                // (Paper: a ruled note, taped on)
                if pi.th == "paper": Rectangle {
                    for k in 34: Rectangle { y: 28px + k * 18px; height: 1px; background: #c9d8ef; visible: self.y < parent.height - 6px; }
                    Rectangle { x: 14px; width: 1px; background: #eaa3a3; }
                    Rectangle { x: 24px; y: 1px; width: 62px; height: 15px; background: PanelLook.c1.with-alpha(0.62); transform-rotation: -10deg; }
                    Rectangle { x: parent.width - 62px; y: 2px; width: 54px; height: 15px; background: PanelLook.c2.with-alpha(0.62); transform-rotation: 9deg; }
                }
                // (Bauhaus: shapes of your colours, and a black bar)
                if pi.th == "bauhaus": Rectangle {
                    property <length> hh: p.body ? 74px : parent.height;
                    property <length> s: min(44px, self.hh * 0.44);
                    Rectangle { x: parent.width - 38px - parent.s; y: parent.hh / 2 - parent.s * 1.3; width: parent.s * 2; height: self.width; border-radius: self.width / 2; background: PanelLook.c1; }
                    Path { x: parent.width - 106px; y: parent.hh / 2 - parent.s * 0.55; width: 72px; height: parent.s * 1.65; viewbox-width: 72; viewbox-height: 100; commands: "M 0 100 L 36 0 L 72 100 Z"; fill: PanelLook.c2; stroke-width: 0; }
                    Rectangle { x: parent.width - 118px; y: 13px; width: 7px; height: parent.hh - 26px; background: #111111; }
                    Rectangle { x: 3px; width: 6px; background: #111111; }
                }
                // (Holo: foil that shines)
                if pi.th == "holo": Rectangle {
                    Rectangle { background: @linear-gradient(120deg, #ffd1f2 0%, #c7f0ff 25%, #fff6c2 50%, #d9c7ff 75%, #b8fff0 100%); }
                    Rectangle { background: @linear-gradient(90deg, PanelLook.c1 0%, PanelLook.c2 100%); opacity: 0.2; }
                    Rectangle { background: @linear-gradient(110deg, #ffffff00 25%, #ffffffa6 45%, #ffffff00 65%); }
                }
                // (Terminal: a window of glowing type)
                if pi.th == "terminal": Rectangle {
                    y: 0;
                    height: 18px;
                    background: #1c2420;
                    Rectangle { x: 9px; y: 5px; width: 7px; height: 7px; background: PanelLook.c1; }
                    Rectangle { x: 22px; y: 5px; width: 7px; height: 7px; background: PanelLook.c2; }
                    Rectangle { x: 35px; y: 5px; width: 7px; height: 7px; background: #ffffff59; }
                    Text { text: "~/" + p.title.to-lowercase(); color: #ffffff73; font-size: 10px; font-family: "Cascadia Mono"; horizontal-alignment: center; vertical-alignment: center; }
                }
                // (Watercolour: soft washes of your colours)
                if pi.th == "watercolour": Rectangle {
                    for b in [{ x: 0.15, y: 0.3, r: 70, c: 0 }, { x: 0.72, y: 0.8, r: 90, c: 1 }, { x: 0.9, y: 0.12, r: 60, c: 0 }, { x: 0.45, y: 0.6, r: 55, c: 1 }, { x: 0.3, y: 0.95, r: 65, c: 0 }]: Rectangle {
                        x: parent.width * Math.mod(b.x + i * 0.37, 1.0) - b.r * 1px;
                        y: parent.height * b.y - b.r * 1px;
                        width: b.r * 2px;
                        height: self.width;
                        background: @radial-gradient(circle, (b.c == 0 ? PanelLook.c1 : PanelLook.c2).with-alpha(0.42) 0%, (b.c == 0 ? PanelLook.c1 : PanelLook.c2).with-alpha(0.14) 70%, (b.c == 0 ? PanelLook.c1 : PanelLook.c2).with-alpha(0) 100%);
                    }
                }
                // (Cyber: cut corners, hazard stripes, a number)
                if pi.th == "cyber": Rectangle {
                    Path {
                        property <float> w: self.width / 1px;
                        property <float> h: self.height / 1px;
                        viewbox-width: self.w;
                        viewbox-height: self.h;
                        commands: "M 17 3 L " + (self.w - 3) + " 3 L " + (self.w - 3) + " " + (self.h - 17) + " L " + (self.w - 17) + " " + (self.h - 3) + " L 3 " + (self.h - 3) + " L 3 17 Z";
                        fill: @linear-gradient(135deg, #0b1020 0%, #171029 100%);
                        stroke: PanelLook.c1;
                        stroke-width: 1.5px;
                    }
                    Rectangle { x: parent.width - 95px; y: parent.height - 10px; width: 62px; height: 7px; background: PanelLook.c2; }
                    Rectangle { x: 3px; y: 37px; width: 3px; height: 18px; background: PanelLook.c1; }
                    Rectangle { x: parent.width - 6px; y: 13px; width: 3px; height: 18px; background: PanelLook.c1; }
                    Text { x: parent.width - self.width - 13px; y: 9px; text: "// " + (i < 9 ? "0" : "") + (i + 1); color: PanelLook.c2; font-size: 9px; font-family: "Cascadia Mono"; }
                }
                // (Galaxy: stars, and nebulae of your colours)
                if pi.th == "galaxy": Rectangle {
                    Rectangle { x: parent.width * 0.8 - 200px; y: parent.height * 0.2 - 200px; width: 400px; height: 400px; background: @radial-gradient(circle, PanelLook.c1.with-alpha(0.6) 0%, PanelLook.c1.with-alpha(0) 70%); }
                    Rectangle { x: parent.width * 0.18 - 200px; y: parent.height * 0.95 - 200px; width: 400px; height: 400px; background: @radial-gradient(circle, PanelLook.c2.with-alpha(0.5) 0%, PanelLook.c2.with-alpha(0) 70%); }
                    Path { x: 0; y: 0; width: 320px; height: 600px; viewbox-width: 320; viewbox-height: 600; commands: "M 306.3 580.8 h 1.1 v 1.1 h -1.1 Z M 194.8 210.7 h 1.3 v 1.3 h -1.3 Z M 285.9 0.6 h 1.4 v 1.4 h -1.4 Z M 34.5 339.5 h 1.5 v 1.5 h -1.5 Z M 196.9 84.4 h 1.3 v 1.3 h -1.3 Z M 201.4 534.8 h 1.5 v 1.5 h -1.5 Z M 120.3 259.0 h 0.4 v 0.4 h -0.4 Z M 72.4 174.9 h 1.0 v 1.0 h -1.0 Z M 311.2 227.9 h 1.5 v 1.5 h -1.5 Z M 307.6 548.2 h 1.2 v 1.2 h -1.2 Z M 190.7 155.9 h 1.5 v 1.5 h -1.5 Z M 313.9 297.8 h 0.5 v 0.5 h -0.5 Z M 133.0 191.5 h 1.0 v 1.0 h -1.0 Z M 315.0 295.1 h 0.7 v 0.7 h -0.7 Z M 91.6 286.2 h 1.1 v 1.1 h -1.1 Z M 39.0 373.0 h 1.1 v 1.1 h -1.1 Z M 141.9 175.9 h 0.4 v 0.4 h -0.4 Z M 250.1 496.1 h 0.7 v 0.7 h -0.7 Z M 4.2 319.5 h 0.7 v 0.7 h -0.7 Z M 87.6 561.2 h 1.5 v 1.5 h -1.5 Z M 250.2 147.4 h 1.3 v 1.3 h -1.3 Z M 85.7 92.9 h 0.6 v 0.6 h -0.6 Z M 316.4 175.9 h 1.4 v 1.4 h -1.4 Z M 194.6 284.8 h 0.6 v 0.6 h -0.6 Z M 206.4 362.3 h 1.1 v 1.1 h -1.1 Z M 237.9 70.9 h 0.6 v 0.6 h -0.6 Z M 243.3 180.4 h 0.4 v 0.4 h -0.4 Z M 170.7 201.7 h 1.4 v 1.4 h -1.4 Z M 95.0 317.9 h 0.7 v 0.7 h -0.7 Z M 148.6 216.6 h 0.7 v 0.7 h -0.7 Z M 238.4 354.5 h 1.6 v 1.6 h -1.6 Z M 11.7 151.5 h 1.4 v 1.4 h -1.4 Z M 145.8 549.9 h 0.7 v 0.7 h -0.7 Z M 284.1 327.4 h 1.6 v 1.6 h -1.6 Z M 4.7 467.0 h 1.0 v 1.0 h -1.0 Z M 136.9 345.4 h 1.2 v 1.2 h -1.2 Z M 226.6 379.3 h 0.6 v 0.6 h -0.6 Z M 154.2 547.0 h 1.5 v 1.5 h -1.5 Z M 123.4 235.1 h 1.2 v 1.2 h -1.2 Z M 272.6 117.9 h 1.6 v 1.6 h -1.6 Z M 94.9 498.0 h 1.5 v 1.5 h -1.5 Z M 21.1 501.8 h 0.8 v 0.8 h -0.8 Z M 222.3 259.7 h 0.8 v 0.8 h -0.8 Z M 91.6 468.4 h 0.6 v 0.6 h -0.6 Z M 291.4 85.6 h 0.6 v 0.6 h -0.6 Z M 153.1 329.5 h 0.5 v 0.5 h -0.5 Z M 159.3 198.4 h 0.8 v 0.8 h -0.8 Z M 49.1 351.5 h 1.1 v 1.1 h -1.1 Z M 259.8 41.1 h 0.4 v 0.4 h -0.4 Z M 73.6 491.8 h 1.2 v 1.2 h -1.2 Z M 253.4 398.2 h 0.8 v 0.8 h -0.8 Z M 8.2 433.6 h 0.8 v 0.8 h -0.8 Z M 313.2 599.0 h 1.4 v 1.4 h -1.4 Z M 224.4 29.3 h 1.0 v 1.0 h -1.0 Z M 269.5 131.5 h 0