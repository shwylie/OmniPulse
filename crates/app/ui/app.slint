    if root.name-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000080;
        TouchArea { clicked => { root.name-open = false; } }
        Rectangle {
            width: 380px;
            height: 176px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.elevated;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.line;
            TouchArea { }
            VerticalLayout {
                padding: 20px;
                spacing: 14px;
                Text { text: root.name-head; color: Theme.text; font-size: 18px; font-weight: 800; }
                Rectangle {
                    clip: true;
                    height: 38px;
                    border-radius: 8px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.accent;
                    TextInput { property <length> sx; cursor-position-changed(p) => { if (p.x + self.sx < 0px) { self.sx = -p.x; } else if (p.x + self.sx > parent.width - 24px - 2px) { self.sx = parent.width - 24px - 2px - p.x; } } 
                        x: 12px + min(0px, max(parent.width - 24px - self.width, self.sx));
