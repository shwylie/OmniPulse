                    if aiti.text == "": Text { x: 12px; height: parent.height; vertical-alignment: center; text: root.ask-input-hint; color: Theme.muted; font-size: 13px; }
                    aiti := TextInput { property <length> sx; cursor-position-changed(p) => { if (p.x + self.sx < 0px) { self.sx = -p.x; } else if (p.x + self.sx > parent.width - 24px - 2px) { self.sx = parent.width - 24px - 2px - p.x; } }  x: 12px + min(0px, max(parent.width - 24px - self.width, self.sx)); width: max(parent.width - 24px, self.preferred-width + 4px); height: parent.height; vertical-alignment: center; color: Theme.text; font-size: 13px; single-line: true; input-type: root.ask-input-secret ? InputType.password : InputType.text; text <=> root.ask-input; init => { self.focus(); self.select-all(); } accepted => { root.ask-answer(true); } }
                }
                if root.ask-input-on && root.ask-input-options.length > 0: Text { text: "Or pick one there is:"; color: Theme.muted; font-size: 12px; }
                if root.ask-input-on && root.ask-input-options.length > 0: ScrollView {
                    height: min(160px, root.ask-input-options.length * 32px + 4px);
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        for o in root.ask-input-options: MenuRow { label: o; on: o == root.ask-input; clicked => { root.ask-input = o; } }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Pill { label: "Cancel"; clicked => { root.ask-answer(false); } }
                    Pill { label: root.ask-ok; on: true; clicked => { root.ask-answer(true); } }
                }
            }
            if !root.ask-input-on: FocusScope {
                width: 0; height: 0;
                init => { self.focus(); }
                key-pressed(e) => {
                    if (e.text == Key.Escape) { root.ask-answer(false); return accept; }
                    if (e.text == Key.Return) { root.ask-answer(true); return accept; }
                    return reject;
                }
            }
        }
    }
    if root.jam-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000080;
        TouchArea { clicked => { root.jam-open = false; } }
        Rectangle {
            width: 420px;
            height: jam-col.preferred-height;
            x: (parent.width - self.width) / 2;
