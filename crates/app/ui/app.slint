// OmniPulse, native: the window, title bar, sidebar, pages, queue and player bar.
// Colours, sizes and icons follow the web app's dark theme (dist/style.css).

import { ListView, Slider, LineEdit, ScrollView, Switch, Palette, AboutSlint } from "std-widgets.slint";

export global Theme {
    /// (tiles' own colours, set from the theme's accent: Suite's cards, each different)
    in-out property <[color]> tints: [#8e9bff, #b48eff, #5ad1ff, #4ad295, #ffb547, #ff6b8a];
    in-out property <color> bg: #08090c;
    in-out property <color> panel: #111318;
    in-out property <color> elevated: #1a1d25;
    /// (menus' and pop-ups' own: always solid, even with Aurora's see-through panels)
    in-out property <color> menu: #1a1d25;
    in-out property <color> line: #262a35;
    in-out property <color> text: #e9ebf2;
    in-out property <color> muted: #9097a8;
    // the accent shown: the one set (picked, or the cover's), and during a mix with album-art colours
    // on, a slow fade to the next cover's and back, over and over, till the mix is over
    in-out property <color> accent-own: #8e9bff;
    in-out property <color> accent-2-own: #b48eff;
    in-out property <color> accent-next: #8e9bff;
    in-out property <color> accent-2-next: #b48eff;
    in-out property <bool> pulsing;
    // the player's colours: each accent a little into the panel (the first on the left, the second on the right)
    // (into the theme's own panel, without the tint: the tint doesn't touch the accents)
    in-out property <color> plain-panel: #1a1d24;
    out property <color> bar-a: plain-panel.mix(accent, 0.86);
    out property <color> bar-b: plain-panel.mix(accent-2, 0.86);
    property <float> pulse: pulsing ? (1 - cos(animation-tick() / 3.2s * 360deg)) / 2 : 0;
    out property <color> accent: pulsing ? accent-own.mix(accent-next, 1 - pulse) : accent-own;
    out property <color> accent-2: pulsing ? accent-2-own.mix(accent-2-next, 1 - pulse) : accent-2-own;
    in-out property <color> on-accent: #111318;
    // (Rounded Corners off: 0, square, everywhere they're used: the player, the cards)
    in-out property <length> radius: 10px;
    in-out property <length> card-radius: 18px;
    // the sidebar, the page and the queue: square with Rounded Corners off (Settings > App)
    in-out property <length> panel-radius: 10px;
    // a track row and its cover: smaller with List Density at Compact (Settings > Look)
    in-out property <length> row-h: 60px;
    in-out property <length> row-art: 44px;
    // Settings > Look > Animations: off, everything moves at once
    in-out property <bool> motion: true;
    // a theme of its own's look (Settings > App & Look > Theme): its headings' font, what's playing glowing,
    // the Aurora glow behind see-through panels, covers round as records
    in-out property <string> head-font;
    in-out property <bool> glow;
    in-out property <bool> aurora;
    in-out property <bool> round-art;
}

/// A theme, to pick: its name and colours (Custom's: the step and tint as they're set)
export struct ThemeOpt { id: string, name: string, bg: color, panel: color, text: color, a: color, b: color }
export struct ThemeRow { items: [ThemeOpt] }

// Drag and drop (as the web app's js/dnd.js): a track of the page ("t:<row>") or a playlist of the
// sidebar ("p:<side>") dragged; dropped on a playlist in the sidebar ("side:<i>"), the queue ("queue")
// or the open playlist's page ("page"). What's carried, what takes it and the drop are the app's.
/// Whether a widget's on (its id: goals, timer, wheel...), asked of the app; rev changes as one's switched
export global Wid {
    in-out property <int> rev;
    pure callback on(string, int) -> bool;
}

export global Dnd {
    pure callback payload(string) -> data-transfer;
    pure callback accepts(string, data-transfer) -> bool;
    callback dropped(string, data-transfer);
}

// (and for its menu, as the web app's: its artists one by one, its uploader if it's someone else, a
// like and a star, where it opens, Stream-Safe Music's Allow / Stop allowing)
export struct Row { alb: string, alb-by: string, alb-plat: string, alb-art: image, alb-i: int, dim: bool, versions: string, version: bool, title: string, artist: string, album: string, dur: string, plat: string, playing: bool, head: string, auto: bool, art: image, liked: bool, sc-link: bool, sp-link: bool, yt-link: bool, picked: bool, genres: [string], added-by: string, artists: [string], uploader: string, can-like: bool, fav: bool, fav-on: bool, open-label: string, cleared: string, coming: bool }
// (merged: playlists combined into it, to unmerge)
export struct Side { title: string, plat: string, own: bool, share: bool, sc: bool, sp: bool, collab: bool, collab-owner: bool, merged: bool, pinned: bool }
/// A platform in the title bar: on (in its colours), set up (ready; grey until it is), its name
export struct Plat { id: string, on: bool, name: string, ready: bool, d: string }
// (a genre's tile, as the web app's: a coloured cover, its name on it; c1 its middle, c2 its edge)
// (a song's tile: a track menu on right-click, as the web app's; liked, for its line)
/// An artist page's platform: its symbol, and how many follow them there ("12,345 followers")
export struct ArtistOn { plat: string, text: string }
export struct Tile { miss: bool, title: string, sub: string, art: image, plat: string, genre: bool, c1: color, c2: color, track: bool, liked: bool, row: Row }
/// Pick genres (and Fine-tune): a row of up to four chips, under a group's name (on its first row)
export struct TasteChip { label: string, on: bool }
export struct TasteRow { head: string, chips: [TasteChip] }
export struct Shelf { title: string, tiles: [Tile], open: bool, gone: bool, shown: int }
export struct Line { text: string }
/// A switch in Settings: under its section's heading (head, on the first of a section)
/// An account in Settings: its name, what's known (who's signed in, or what it needs), and its button
export struct Account { name: string, status: string, signed: bool, busy: bool, keys: string, switch: string, on: bool, manage: string, settings: string, short: string }
// Settings' search: a setting found (its path, what it is), where it lives (its category, a panel to
// open), and its switch if it has one
export struct SetHit { path: string, label: string, note: string, cat: string, panel: string, key: string, on: bool, toggle: bool }
// A song being added that looks like one there already: the new one, the one there, what's chosen
export struct LookAlike { new: string, old: string, choice: string }
// Stats' closer look at one card: its blocks (a bar chart, a big number, a ranked list, a calendar)
export struct StatBar { label: string, v: float, tip: string }
export struct StatRow { rank: int, name: string, sub: string, share: float, art: image, row: Row, song: bool }
export struct StatBlock { kind: string, kicker: string, big: string, sub: string, wide: bool, bars: [StatBar], rows: [StatRow], cells: [int] }
export struct SetRow { head: string, label: string, note: string, on: bool, key: string, sub: bool, more: bool, button: string }
/// One of a plugin's settings: its kind ("toggle", "text", "password", "number", "select"), what it's
/// set to (as text; "true"/"false" for a toggle), and a select's options
/// A step of the key setup: what to do, whether it has a page to open, and values to copy
export struct KeyStep { text: string, has-url: bool, copies: [string] }
/// A key to paste: its label, what's typed, and whether it looks right
export struct KeyField { label: string, value: string, ok: bool }
// the Lyrics Widget's look, for its page's preview
/// The Stream Widget's preview: its design and look as they're set
export struct WidgetLook { design: string, right: bool, rounded: bool, text: float, c1: color, c2: color, spin: bool, requester: bool }

/// The alerts' preview: their theme and colours as they're set
/// A HUD frame, for its editor: where it is on the screenshot (fractions), and whether it's the one picked
export struct HudRect { x: float, y: float, w: float, h: float, label: string, picked: bool }
export global HudLook {
    in-out property <image> shot;
    in-out property <float> ratio: 0.5625;
    in-out property <[HudRect]> frames;
    in-out property <color> c1;
}
/// A channel panel, for the Panels' preview
export struct PanelItem { title: string, line: string, body: bool, lines: int, icon: string, img: image, has-img: bool }
export global PanelLook {
    in-out property <[PanelItem]> items;
    // (the Powered by OmniPulse panel's mark: theme, omnipulse or plain)
    in-out property <string> logo-colours: "theme";
    in-out property <string> theme;
    in-out property <string> shape;
    in-out property <string> height;
    in-out property <bool> icons;
    in-out property <color> c1;
    in-out property <color> c2;
    in-out property <color> term-ink: #5dff9c;
    // (your own words' and background's colours, if set)
    in-out property <bool> ink-on;
    in-out property <color> ink;
    in-out property <bool> bg-on;
    in-out property <color> bg;
}
/// A webcam overlay's piece, for its preview: the camera, or a part (fractions of the canvas)
export struct CamRect { id: string, label: string, x: float, y: float, w: float, h: float }
/// The webcam overlay being set up: its layout and look (the app sets it as its page opens and changes)
export global CamLook {
    in-out property <[CamRect]> rects;
    // (the area shown's height for its width: the camera's and its parts', not the canvas's)
    in-out property <float> ratio: 0.5625;
    in-out property <string> shape;
    in-out property <string> border;
    in-out property <string> theme;
    in-out property <color> c1;
    in-out property <color> c2;
}
export struct AlertLook { theme: string, c1: color, c2: color, glow: bool, icon: float, transition: string, anim: string, in-widget: bool }

/// The Multichat Overlay's preview: its look as it's set
export struct ChatLook { style: string, size: float, bg: float, shadow: bool, top: bool, badges: bool, marks: bool, from: string, above: bool }
/// (a made-up message, for the preview)
export struct ChatSample { name: string, text: string, kick: bool, colour: color, badge: string }

/// The Social Plug's preview: each platform shown (its icon, as the widget's, or its first letter), and its look
export struct SocialItem { name: string, handle: string, c1: color, c2: color, d: string, letter: string }
export struct SocialLook { style: string, coloured: bool, align: string, rounded: bool, all: bool, secs: int, motion: string, sample: bool }
export struct LyricsLook { color: color, hi: color, own-hi: bool, dim: float, size: float, align: string, style: string, shadow: bool, outline: bool, outline-color: color, boxed: bool, box-color: color, box-opacity: float, title: bool, before: bool, lines: int, upper: bool, place: string }
export struct PlugField { key: string, label: string, note: string, kind: string, value: string, options: [string], at: int, changed: bool }
// the chatbot's page: a service's tile, a feature's card, a setup step, a line of what it did (or of a try), a sheet's line
export struct BotTile { id: string, name: string, state: string, line1: string, line2: string }
export struct BotFeat { id: string, name: string, note: string, on: bool, open: bool, changed: bool }
export struct BotStep { id: string, title: string, note: string, state: string, optional: bool }
export struct BotLine { who: string, heard: string, did: string, platform: string }
export struct BotField { key: string, kind: string, label: string, note: string, value: string, extra: string, changed: bool, n: int, opts: [string], opt-ids: [string], c1: color, c2: color }
// (an artist you follow: whether on SoundCloud and on Spotify, for its menu)
export struct Item { name: string, sub: string, art: image, plat: string, on-sc: bool, on-sp: bool, on-yt: bool, row: Row }
/// A page being loaded: each platform it asks, and whether it's answered yet
export struct LoadStep { plat: string, name: string, done: bool }
/// The chatbot's Actions page: one thing a trigger or a step asks for (its kind: text, number, select,
/// toggle; a select's choices and which is picked)
export struct FlowField { key: string, label: string, note: string, kind: string, value: string, options: [string], at: int }
/// A trigger or a step: which kind it is (of the page's list of them), what it says, what it asks for
export struct FlowNode { kind-at: int, note: string, fields: [FlowField], depth: int, label: string }
/// A trigger's or a step's menu: a category's heading, or one in it (hit: what's searched for)
export struct MenuEntry { cat: string, label: string, head: bool, hit: bool }
/// An action in the page's list: its name, what starts it and how many steps, on or off
/// An action in the Actions list: its group's heading above it when it's the group's first (`head`), and
/// shown unless its group is folded or it isn't what's searched for
/// A Channel Points reward to make (Twitch, Kick or both), and whether an action's made for it
export struct RewardForm { title: string, cost: string, prompt: string, input: bool, cooldown: string, per-stream: string, per-user: string, skip: bool, where: string, colour: color, action: bool }
export struct FlowItem { name: string, summary: string, on: bool, group: string, head: bool, shown: bool, count: int, shut: bool, marked: bool }
/// A slice of the Ring visualiser: its outline, and where it is from the foot (0, the bass) to the top (1)
export struct RingPiece { d: string, f: float }

