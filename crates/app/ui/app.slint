    callback theme-picked(string);
    in property <bool> theme-own-accents: true;
    callback theme-own-accents-changed(bool);
    // (your own accents, picked with +: shown as a swatch of their own)
    in property <color> accent-mine;
    in property <bool> accent-mine-on;
    in property <color> accent2-mine;
    in property <bool> accent2-mine-on;
    callback accent-custom(int);
    in property <bool> beta-updates;
