// Tooltips (as the web app's title="..."): one label for the whole window, put up by a control the
// pointer has rested on for a moment, under it (over it near the window's foot); gone when the pointer
// leaves, the control's clicked, or after a few seconds
/// The window's size, for menus opened near its edges (they open up or to the left instead)
export global Win {
    in-out property <length> w: 1200px;
    in-out property <length> h: 800px;
}

export global Tips {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <length> h;
    in-out property <bool> on;
}

// A control's tooltip: as big as the control it's in, and told when the pointer's over it
component TipSpot inherits Rectangle {
    in property <string> tip;
    in property <bool> hover;
    width: 100%;
    height: 100%;
    Timer {
        interval: 500ms;
        running: root.hover && root.tip != "" && !(Tips.on && Tips.text == root.tip);
        triggered => {
            Tips.text = root.tip;
            Tips.x = root.absolute-position.x + root.width / 2;
            Tips.y = root.absolute-position.y;
            Tips.h = root.height;
            Tips.on = true;
        }
    }
    changed hover => { if (!root.hover && Tips.text == root.tip) { Tips.on = false; } }
}

component Glyph inherits Path {
    in property <string> d;
    commands: d;
    // (shapes with holes: the YouTube screen, Spotify's mark)
    fill-rule: evenodd;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke-width: 0;
}

component IconButton inherits Rectangle {
    in property <string> d;
    in property <string> tip;
    in property <length> size: 36px;
    in property <bool> filled: false;
    in property <color> tint: Theme.muted;
    callback clicked;
    callback right-click(length, length);
    width: size;
    height: size;
    border-radius: size / 2;
    background: filled ? Theme.accent : (ta.has-hover ? Theme.elevated : transparent);
    Glyph { d: root.d; width: root.size * 0.55; height: root.size * 0.55; fill: filled ? Theme.on-accent : (ta.has-hover ? Theme.text : root.tint); }
    TipSpot { tip: root.tip; hover: ta.has-hover; }
    ta := TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) { root.right-click(self.mouse-x, self.mouse-y); } } clicked => { Tips.on = false; root.clicked(); } }
}

component RoundButton inherits Rectangle {
    in property <string> d;
    in property <string> tip;
    in property <bool> enabled: true;
    callback clicked;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: Theme.bg.mix(Theme.panel, ta.has-hover && root.enabled ? 0.45 : 0.7);
    opacity: root.enabled ? 1 : 0.45;
    Glyph { d: root.d; width: 20px; height: 20px; fill: Theme.text; }
    TipSpot { tip: root.tip; hover: ta.has-hover; }
    ta := TouchArea { enabled: root.enabled; clicked => { Tips.on = false; root.clicked(); } }
}

component Pill inherits Rectangle {
    in property <string> label;
    in property <string> tip;
    in property <string> d;
    in property <bool> on;
    callback clicked;
    callback right-click(length, length);
    height: 38px;
    width: t.preferred-width + 36px + (root.d != "" ? 20px : 0px);
    border-radius: 19px;
    border-width: 1px;
    border-color: root.on ? Theme.accent : (ta.has-hover ? Theme.muted : Theme.line);
    background: root.on ? Theme.accent.with-alpha(0.14) : transparent;
    HorizontalLayout {
        spacing: 6px;
        alignment: center;
        if root.d != "": Glyph { d: root.d; width: 14px; height: 14px; y: (parent.height - self.height) / 2; fill: root.on ? Theme.accent : Theme.muted; }
        t := Text { text: root.label; color: Theme.text; font-size: 13px; font-weight: 600; vertical-alignment: center; }
    }
    TipSpot { tip: root.tip; hover: ta.has-hover; }
    ta := TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) { root.right-click(self.mouse-x, self.mouse-y); } } clicked => { Tips.on = false; root.clicked(); } }
}

component Range inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> value;
    in property <bool> enabled: true;
    /// as it's dragged, and where it's let go
    callback changed(float);
    callback released(float);
    height: 20px;
    min-width: 40px;
    property <float> drag: -1;
    property <float> shown: root.drag >= 0 ? root.drag : root.value;
    property <float> frac: max(0, min(1, (root.shown - root.minimum) / max(0.0001, root.maximum - root.minimum)));
    property <float> at: max(0, min(1, ta.mouse-x / max(1px, root.width)));
    opacity: root.enabled ? 1 : 0.45;
    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.text.with-alpha(0.18);
        Rectangle { x: 0; width: parent.width * root.frac; height: 100%; border-radius: 2px; background: Theme.accent; }
    }
    Rectangle {
        x: (root.width - 14px) * root.frac;
        y: (root.height - 14px) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: ta.has-hover || ta.pressed ? Theme.accent.brighter(0.15) : Theme.accent;
        border-width: 2px;
        border-color: Theme.panel;
    }
    ta := TouchArea {
        enabled: root.enabled;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.drag = root.minimum + root.at * (root.maximum - root.minimum);
                root.changed(root.drag);
            } else if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.drag >= 0) {
                root.released(root.drag);
                root.drag = -1;
            }
        }
        moved => {
            if (self.pressed) {
                root.drag = root.minimum + root.at * (root.maximum - root.minimum);
                root.changed(root.drag);
            }
        }
    }
}

// A slider of named steps (Theme, Tint Strength): a notch at each, the thumb only ever on one (dragged,
// it moves from notch to notch), each name under its own notch
component Steps inherits Rectangle {
    in property <[string]> names;
    in property <int> value;
    callback changed(int);
    property <int> n: root.names.length;
    property <length> pad: 7px;
    property <length> span: max(1px, root.width - 14px);
    property <int> at: max(0, min(root.n - 1, round((ta.mouse-x - root.pad) / root.span * (root.n - 1))));
    height: 44px;
    min-width: 120px;
    // the track, filled up to the step it's on
    Rectangle {
        x: root.pad;
        y: 8px;
        width: root.span;
        height: 4px;
        border-radius: 2px;
        background: Theme.text.with-alpha(0.18);
        Rectangle { x: 0; width: root.span * root.value / max(1, root.n - 1); height: 100%; border-radius: 2px; background: Theme.accent; }
    }
    // a notch at each step
    for nm[i] in root.names: Rectangle {
        x: root.pad + root.span * i / max(1, root.n - 1) - 1px;
        y: 3px;
        width: 2px;
        height: 14px;
        border-radius: 1px;
        background: i <= root.value ? Theme.accent : Theme.text.with-alpha(0.32);
    }
    Rectangle {
        x: root.span * root.value / max(1, root.n - 1);
        y: 3px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: ta.has-hover || ta.pressed ? Theme.accent.brighter(0.15) : Theme.accent;
        border-width: 2px;
        border-color: Theme.panel;
    }
    // each name under its notch (the first and last kept inside)
    for nm[i] in root.names: Text {
        text: nm;
        y: 24px;
        x: i == 0 ? 0px : i == root.n - 1 ? root.width - self.width : root.pad + root.span * i / max(1, root.n - 1) - self.width / 2;
        color: i == root.value ? Theme.text : Theme.muted;
        font-size: 12px;
        font-weight: i == root.value ? 700 : 400;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down && root.at != root.value) { root.changed(root.at); }
        }
        moved => { if (self.pressed && root.at != root.value) { root.changed(root.at); } }
    }
}

component Progress inherits Rectangle {
    /// where it is (0 to 1), and the track's length in seconds (for the time shown while pointed at)
    in property <float> value;
    in property <float> length-secs;
    /// the next track being found (the song before still playing, its progress behind, not draggable),
    /// or found ahead while this one plays: a marquee glides along the bar, as Windows Vista's did
    in property <bool> loading;
    in property <bool> preloading;
    /// a mix playing (Seamless Mix): the played part sweeps from one accent to the other
    in property <bool> mixing;
    callback released(float);
    height: 16px;
    property <float> drag: -1;
    property <float> at: max(0, min(1, ta.mouse-x / max(1px, root.width)));
    property <float> frac: max(0, min(1, root.drag >= 0 ? root.drag : root.value));
    property <bool> live: ta.has-hover || root.drag >= 0;
    property <float> tip-secs: (root.drag >= 0 ? root.drag : root.at) * root.length-secs;
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: root.live ? 6px : 3px;
        animate height { duration: Theme.motion ? 120ms : 0ms; }
        border-radius: 3px;
        background: Theme.text.with-alpha(0.16);
        clip: true;
        Rectangle { x: 0; width: parent.width * root.frac; height: 100%; background: Theme.accent; opacity: root.loading ? 0.6 : 1; }
        if root.mixing: Rectangle {
            property <float> ph: mod(animation-tick() / 1ms, 1400) / 1400;
            x: 0;
            width: parent.width * root.frac;
            height: 100%;
            clip: true;
            Rectangle {
                x: -parent.width + parent.width * 2 * parent.ph;
                width: parent.width * 2;
                height: 100%;
                background: @linear-gradient(90deg, Theme.accent 0%, Theme.accent-2 25%, Theme.accent 50%, Theme.accent-2 75%, Theme.accent 100%);
            }
        }
    }
    if root.loading || root.preloading: Rectangle {
        // (a layer of its own, clipped to the bar's length; the glow fades in and out near its ends)
        y: (parent.height - self.height) / 2;
        height: 14px;
        clip: true;
        property <float> phase: mod(animation-tick() / 1ms, 1600) / 1600;
        property <length> glow: root.width * 0.24;
        Rectangle {
            x: -parent.glow + (root.width + parent.glow) * parent.phase;
            width: parent.glow;
            height: 12px;
            y: 1px;
            border-radius: 6px;
            opacity: min(1, min(parent.phase * 5, (1 - parent.phase) * 5));
            background: @radial-gradient(circle, #ffffff 0%, Theme.accent.mix(#ffffff, 0.3) 30%, Theme.accent.with-alpha(0.55) 60%, transparent 100%);
        }
    }
    // the time there, above it
    if root.live && root.length-secs > 0: Rectangle {
        property <int> secs: floor(root.tip-secs);
        x: max(0px, min(root.width - self.width, root.width * (root.drag >= 0 ? root.drag : root.at) - self.width / 2));
        y: -22px;
        width: tip.preferred-width + 12px;
        height: 18px;
        border-radius: 6px;
        background: Theme.elevated;
        tip := Text { text: floor(parent.secs / 60) + ":" + (mod(parent.secs, 60) < 10 ? "0" : "") + mod(parent.secs, 60); color: Theme.text; font-size: 11px; }
    }
    if root.live: Rectangle {
        x: root.width * root.frac - 6px;
        y: (root.height - 12px) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.accent;
    }
    ta := TouchArea {
        enabled: !root.loading;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.drag = root.at;
            } else if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.drag >= 0) {
                root.released(root.drag);
                root.drag = -1;
            }
        }
        moved => { if (self.pressed) { root.drag = root.at; } }
    }
}

// A line of text too long for its room: it scrolls (a pause at its start, along to its end, a pause,
// back), never cut short with an ellipsis; one that fits just shows. (Animations off: it stays still.)
component Marquee inherits Rectangle {
    in property <string> text;
    in property <brush> ink: Theme.text;
    in property <length> font-size: 14px;
    in property <int> font-weight: 700;
    in property <bool> right;
    clip: true;
    height: t.preferred-height;
    preferred-width: t.preferred-width;
    min-width: 0;
    property <length> over: max(0px, t.preferred-width - root.width);
    // (a one-way glide as long as it is: about 40 px a second, a second and a half at least)
    property <float> per: max(1500, root.over / 1px * 25);
    property <float> ph: mod(animation-tick() / 1ms, root.per * 2 + 4000);
    property <float> k: !Theme.motion || root.over <= 0 ? 0
        : root.ph < 2000 ? 0
        : root.ph < 2000 + root.per ? (root.ph - 2000) / root.per
        : root.ph < 4000 + root.per ? 1
        : max(0, 1 - (root.ph - 4000 - root.per) / root.per);
    t := Text {
        text: root.text;
        color: root.ink;
        font-size: root.font-size;
        font-weight: root.font-weight;
        width: self.preferred-width;
        vertical-alignment: center;
        x: root.over > 0 ? -root.over * root.k : (root.right ? root.width - self.width : 0px);
    }
}

component MenuRow inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    /// (where the sound plays: OmniPulse Offset plays here, a ring and its name)
    in property <bool> offset;
    /// (opens a list: an arrow after it; the way back: one before it)
    in property <bool> more;
    in property <bool> back;
    callback clicked;
    height: 32px;
    border-radius: 6px;
    background: ta.has-hover ? Theme.accent.with-alpha(0.22) : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Rectangle { width: 8px; Rectangle { width: 8px; height: 8px; y: (parent.height - self.height) / 2; border-radius: 4px; background: root.on ? Theme.accent : transparent; } }
        if root.offset: Rectangle { width: 8px; Rectangle { width: 8px; height: 8px; y: (parent.height - self.height) / 2; border-radius: 4px; border-width: 2px; border-color: Theme.accent-2; } }
        if root.back: Text { text: "\u{2039}"; color: Theme.accent; font-size: 16px; vertical-alignment: center; }
        Text { text: root.label; color: Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        if root.more: Text { text: "\u{203a}"; color: Theme.accent; font-size: 16px; vertical-alignment: center; }
        if root.offset: Text { text: "Offset"; color: Theme.accent-2; font-size: 11px; font-weight: 700; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

/// One entry of our own right-click menu: a label (or a line), shown or not, and which of the two
/// lists it opens instead (1, 2), if any
export struct MenuEnt { label: string, show: bool, sep: bool, sub: int }

/// Our own right-click menu, in the app's look (Slint's own only follows light or dark): placed over
/// what it's for, opened by open() from that one's right-click. A list entry ("Add to Playlist >")
/// shows that list in its place, with a way back. picked(entry, which in its list, or -1)
component CtxMenu inherits Rectangle {
    in property <[MenuEnt]> items;
    in property <[string]> list1;
    in property <[string]> list1-more;
    in property <[string]> list2;
    in property <[string]> list2-more;
    in property <bool> enabled: true;
    callback picked(int, int);
    property <int> sub: 0;
    property <int> from: -1;
    property <length> px;
    property <length> py;
    public function open(x: length, y: length) {
        if (!root.enabled) { return; }
        root.sub = 0;
        root.px = x;
        root.py = y;
        pop.show();
    }
    function pick(n: int, k: int) {
        pop.close();
        root.picked(n, k);
    }
    pop := PopupWindow {
        // (kept in the window: up from the pointer near the bottom, left of it near the right)
        x: root.absolute-position.x + root.px + 250px > Win.w - 8px ? root.px - 250px : root.px;
        y: root.absolute-position.y + root.py + frame.preferred-height > Win.h - 8px ? max(root.py - frame.preferred-height, 8px - root.absolute-position.y) : root.py;
        width: 250px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        frame := Rectangle {
            background: Theme.elevated;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000070;
            VerticalLayout {
                padding: 6px;
                if root.sub == 0: VerticalLayout {
                    for m[n] in root.items: VerticalLayout {
                        if m.show && m.sep: Rectangle { height: 9px; Rectangle { height: 1px; background: Theme.line; } }
                        if m.show && !m.sep: MenuRow {
                            label: m.label;
                            more: m.sub > 0;
                            clicked => { if (m.sub > 0) { root.from = n; root.sub = m.sub; } else { root.pick(n, -1); } }
                        }
                    }
                }
                if root.sub > 0: VerticalLayout {
                    MenuRow { label: "Back"; back: true; clicked => { root.sub = 0; } }
                    Rectangle { height: 9px; Rectangle { height: 1px; background: Theme.line; } }
                    Flickable {
                        height: min(col.preferred-height, 360px);
                        col := VerticalLayout {
                            if root.sub == 1: VerticalLayout {
                                for l[k] in root.list1: MenuRow { label: l; clicked => { root.pick(root.from, k); } }
                                for l[k] in root.list1-more: MenuRow { label: l; clicked => { root.pick(root.from, root.list1.length + k); } }
                            }
                            if root.sub == 2: VerticalLayout {
                                for l[k] in root.list2: MenuRow { label: l; clicked => { root.pick(root.from, k); } }
                                for l[k] in root.list2-more: MenuRow { label: l; clicked => { root.pick(root.from, root.list2.length + k); } }
                            }
                        }
                    }
                }
            }
        }
    }
}

component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled();
    width: 42px;
    height: 24px;
    border-radius: 12px;
    background: root.checked ? Theme.accent : Theme.line;
    animate background { duration: Theme.motion ? 150ms : 0ms; }
    Rectangle {
        x: root.checked ? parent.width - self.width - 3px : 3px;
        animate x { duration: Theme.motion ? 150ms : 0ms; easing: ease-out; }
        y: 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.checked ? Theme.on-accent : Theme.muted;
    }
    TouchArea { clicked => { root.checked = !root.checked; root.toggled(); } }
}

component PlatIcon inherits Rectangle {
    in property <string> plat;
    in property <bool> title-bar;   // (YouTube Music's own mark there)
    in property <brush> fill: root.plat == "xpl" ? transparent : root.plat == "spotify" ? #1ed760 : root.plat == "youtube" ? #ff0033 : root.plat == "local" ? #f2b544 : root.plat == "musicbrainz" ? #ba478f : root.plat == "plugin" ? #38bdf8 : root.plat == "deezer" ? #a238ff : root.plat == "itunes" ? #fa2d48 : #ff5500;
    if root.plat != "xpl": Glyph { d: root.plat == "xpl" ? Icons.xpl : root.plat == "spotify" ? Icons.spotify : root.plat == "youtube" ? (root.title-bar ? Icons.youtube-mark : Icons.youtube) : root.plat == "local" ? Icons.local : root.plat == "musicbrainz" ? Icons.musicbrainz : root.plat == "plugin" ? Icons.plugin : root.plat == "deezer" ? Icons.deezer : root.plat == "itunes" ? Icons.itunes : Icons.soundcloud; fill: root.fill; width: parent.width; height: parent.height; }
    // (a playlist on this PC: the web app's rainbow, as a picture: a gradient on a shape is drawn against the
    // window here, not the icon, and slides as the list does)
    if root.plat == "xpl": Image { source: @image-url("xpl.svg"); width: parent.width; height: parent.height; }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> d;
    in property <bool> active;
    /// the narrow window: the icon alone, in the middle
    in property <bool> compact;
    /// its icon turns slowly while it's pointed at (Favourites' star)
    in property <bool> spin;
    callback clicked;
    callback right-click(length, length);
    height: 38px;
    border-radius: 8px;
    background: active ? Theme.elevated : (ta.has-hover ? #ffffff08 : transparent);
    HorizontalLayout {
        padding-left: root.compact ? 0px : 12px;
        spacing: 12px;
        alignment: root.compact ? center : start;
        Glyph {
            d: root.d;
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            fill: active ? Theme.text : Theme.muted;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-rotation: root.spin && ta.has-hover ? mod(animation-tick() / 1ms, 4000) / 4000 * 360deg : 0deg;
        }
        if !root.compact: Text { text: root.label; color: active ? Theme.text : Theme.muted; font-size: 14px; font-weight: active ? 700 : 500; vertical-alignment: center; overflow: elide; }
    }
    ta := TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) { root.right-click(self.mouse-x, self.mouse-y); } } clicked => { root.clicked(); } }
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked;
    height: 32px;
    width: t.preferred-width + 28px;
    border-radius: 16px;
    background: on ? Theme.accent : (ta.has-hover ? Theme.line : Theme.elevated);
    t := Text { text: root.label; color: on ? Theme.on-accent : Theme.text; font-size: 13px; font-weight: 600; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component TrackRow inherits Rectangle {
    in property <Row> item;
    in property <int> index;
    /// little room: no album column
    in property <bool> compact;
    /// your playlists on this PC (to add to), and whether this list is one of them
    in property <[string]> lists;
    in property <bool> removable;
    // Search: each track's genres as tags, a click searching that genre
    in property <bool> show-genres;
    callback genre(string);
    callback play();
    callback act(string);
    // Ctrl+click picks it (or lets it go), Shift+click picks everything from the last one picked
    callback pick(int);
    property <bool> picking;
    height: Theme.row-h;
    border-radius: 6px;
    background: root.item.picked ? Theme.accent.with-alpha(0.2) : ta.has-hover ? Theme.elevated : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 16px;
        spacing: 16px;
        Rectangle {
            width: 28px;
            if !ta.has-hover && !root.item.playing: Text { text: index + 1; width: parent.width; height: parent.height; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; font-size: 13px; }
            if ta.has-hover || root.item.playing: Path { commands: Icons.play; x: (parent.width - 16px) / 2; y: (parent.height - 16px) / 2; width: 16px; height: 16px; fill: Theme.accent; }
        }
        Rectangle {
            width: Theme.row-art;
            height: Theme.row-art;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            clip: true;
            background: Theme.elevated;
            Image { source: root.item.art; width: parent.width; height: parent.height; image-fit: cover; }
        }
        PlatIcon { plat: root.item.plat; width: 18px; height: 18px; y: (parent.height - self.height) / 2; fill: Theme.muted; opacity: ta.has-hover || root.item.picked ? 1 : 0; animate opacity { duration: Theme.motion ? 150ms : 0ms; } }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: root.item.title; color: root.item.playing ? Theme.accent : Theme.text; font-weight: 700; font-size: 14px; overflow: elide; }
            HorizontalLayout {
                spacing: 6px;
                Text { text: root.item.artist; color: Theme.muted; font-size: 13px; overflow: elide; horizontal-stretch: 1; max-width: self.preferred-width; }
                // (a collaborative playlist: who added it, as you hover over it)
                if (ta.has-hover || root.item.picked) && root.item.added-by != "": Text { text: "Added by " + root.item.added-by; color: Theme.muted; font-size: 12px; overflow: elide; vertical-alignment: center; }
                for g in root.item.genres: Rectangle {
                    visible: root.show-genres;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    width: root.show-genres ? gt.preferred-width + 12px : 0px;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: gta.has-hover ? Theme.accent : Theme.line;
                    gt := Text { text: g; color: gta.has-hover ? Theme.text : Theme.muted; font-size: 11px; }
                    gta := TouchArea { clicked => { root.genre(g); } }
                }
                Rectangle { horizontal-stretch: 0; }
            }
        }
        if !root.compact: Text { text: root.item.album; width: 26%; color: Theme.muted; font-size: 13px; overflow: elide; vertical-alignment: center; }
        Rectangle {
            width: 24px;
            if root.item.liked: Glyph { d: Icons.library; width: 18px; height: 18px; y: (parent.height - self.height) / 2; fill: Theme.accent; }
        }
        Text { text: root.item.dur; width: 48px; color: Theme.muted; font-size: 13px; horizontal-alignment: right; vertical-alignment: center; }
    }
    DragArea {
      allow-copy: true;
      data: Dnd.payload("t:" + root.index);
      Rectangle {
        ta := TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) { cm1.open(self.mouse-x, self.mouse-y); }
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.picking = e.modifiers.control || e.modifiers.shift;
                    if (root.picking) { root.pick(e.modifiers.shift ? 2 : 1); }
                }
            }
            clicked => { if (!root.picking) { root.play(); } }
        }
          // (on top: it only takes right-clicks, the rest goes through to what's under it)
          cm1 := CtxMenu {
              width: 100%; height: 100%;
              items: [
                  { label: "Play", show: true },
                  { label: "Play Next", show: true },
                  { label: "Add to Queue", show: true },
                  { label: "Add to Playlist", show: true, sub: 1 },
                  { sep: true, show: true },
                  { label: root.item.liked ? "Remove from Likes" : "Add to Likes", show: root.item.can-like },
                  { label: root.item.fav ? "Remove from Favourites" : "Add to Favourites", show: root.item.fav-on },
                  { label: "Go to Artist", show: root.item.artists.length > 1, sub: 2 },
                  { label: "Go to Artist", show: root.item.artists.length <= 1 },
                  { label: "Go to " + root.item.uploader + " (Uploader)", show: root.item.uploader != "" },
                  { label: "Remove from This Playlist", show: root.removable },
                  { sep: true, show: true },
                  { label: "Don't Recommend This Track", show: true },
                  { label: "Don't Recommend This Album", show: root.item.album != "" },
                  { label: "Don't Recommend " + root.item.artist, show: root.item.artist != "" },
                  { label: root.item.cleared, show: root.item.cleared != "" },
                  { sep: true, show: true },
                  { label: root.item.open-label, show: root.item.open-label != "" },
                  { label: "Copy SoundCloud Link", show: root.item.sc-link },
                  { label: "Copy Spotify Link", show: root.item.sp-link },
                  { label: "Copy YouTube Music Link", show: root.item.yt-link },
                  { sep: true, show: true },
                  { label: "Track Preferences...", show: true }
              ];
              list1: root.lists;
              list1-more: ["New Playlist..."];
              list2: root.item.artists;
              picked(n, k) => {
                  if (n == 0) { root.act("play"); }
                  if (n == 1) { root.act("next"); }
                  if (n == 2) { root.act("add"); }
                  if (n == 3) { if (k < root.lists.length) { root.act("pl" + k); } else if (k == root.lists.length + 0) { root.act("plnew"); } }
                  if (n == 5) { root.act("like"); }
                  if (n == 6) { root.act("fav"); }
                  if (n == 7) { if (k < root.item.artists.length) { root.act("artist:" + k); } }
                  if (n == 8) { root.act("artist:0"); }
                  if (n == 9) { root.act("uploader"); }
                  if (n == 10) { root.act("plremove"); }
                  if (n == 12) { root.act("hide:track"); }
                  if (n == 13) { root.act("hide:album"); }
                  if (n == 14) { root.act("hide:artist"); }
                  if (n == 15) { root.act("cleared"); }
                  if (n == 17) { root.act("open"); }
                  if (n == 18) { root.act("link:soundcloud"); }
                  if (n == 19) { root.act("link:spotify"); }
                  if (n == 20) { root.act("link:youtube"); }
                  if (n == 22) { root.act("prefs"); }
              }
          }
      }
    }
}

component Cover inherits Rectangle {
    in property <image> art;
    in property <string> initial;
    border-radius: 8px;
    background: Theme.elevated;
    clip: true;
    Text { text: root.initial; color: Theme.muted; font-size: root.height * 0.35; font-weight: 800; }
    Image { source: root.art; width: parent.width; height: parent.height; image-fit: cover; }
}

// A cover with where it plays from as a round badge on its corner (the player bar's and Now Playing's,
// as the web app's): always there, with YouTube Music's own mark (on the art it can't pass for a play button)
component BadgedCover inherits Rectangle {
    in property <image> art;
    in property <string> initial;
    in property <string> plat;
    in property <length> badge: 22px;
    in property <length> corner: 6px;
    Cover { art: root.art; initial: root.initial; width: parent.width; height: parent.height; border-radius: root.corner; }
    if root.plat != "": Rectangle {
        x: parent.width - self.width * 0.78;
        y: parent.height - self.height * 0.78;
        width: root.badge;
        height: root.badge;
        border-radius: self.width / 2;
        background: Theme.panel;
        border-width: 2px;
        border-color: Theme.panel;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000060;
        PlatIcon { plat: root.plat; title-bar: true; width: root.badge * 0.6; height: root.badge * 0.6; }
    }
}

component TileView inherits Rectangle {
    in property <Tile> tile;
    callback clicked;
    // a song's tile right-clicked: what's picked from its menu
    callback act(string);
    // an album's tile (the Library's Albums): its own menu
    in property <bool> album;
    // (pointed at: its play button and platform show)
    property <bool> hover: ta.has-hover;
    width: 170px;
    height: 226px;
    VerticalLayout {
        spacing: 8px;
        Rectangle {
            height: 170px;
            if !root.tile.genre: Cover { art: root.tile.art; initial: root.tile.title; width: 100%; height: 100%; }
            if root.tile.genre: Rectangle {
                border-radius: 8px;
                clip: true;
                background: @radial-gradient(circle, root.tile.c1 0%, root.tile.c2 100%);
                Text { x: 12px; y: parent.height - self.height - 14px; width: parent.width - 24px; text: root.tile.title; color: #ffffff; font-size: 22px; font-weight: 800; wrap: word-wrap; }
            }
            if hover: Rectangle { x: parent.width - 52px; y: parent.height - 52px; width: 42px; height: 42px; border-radius: 21px; background: Theme.accent;
                Glyph { d: Icons.play; width: 22px; height: 22px; fill: Theme.on-accent; } }
            if hover: PlatIcon { plat: root.tile.plat; title-bar: true; x: 8px; y: 8px; width: 18px; height: 18px; }
        }
        Text { text: root.tile.title; color: Theme.text; font-weight: 700; font-size: 13px; overflow: elide; }
        Text { text: root.tile.sub; color: Theme.muted; font-size: 12px; overflow: elide; }
    }
    Rectangle {
        ta := TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) { cm2.open(self.mouse-x, self.mouse-y); } } clicked => { root.clicked(); } }
        // (on top: it only takes right-clicks, the rest goes through to what's under it)
        cm2 := CtxMenu {
            width: 100%; height: 100%;
            enabled: root.tile.track || root.album;
            items: [
                { label: "Open", show: root.album },
                { label: "Play", show: root.album },
                { sep: true, show: root.album },
                { label: "Don't Recommend This Album", show: root.album },
                { label: "Play", show: !root.album },
                { label: "Play Next", show: !root.album },
                { label: "Add to Queue", show: !root.album },
                { sep: true, show: !root.album },
                { label: root.tile.liked ? "Remove from Likes" : "Add to Likes", show: !root.album },
                { label: "Add to Favourites", show: !root.album },
                { label: "Go to Artist", show: !root.album },
                { sep: true, show: !root.album },
                { label: "Don't Recommend This Track", show: !root.album },
                { label: "Don't Recommend This Artist", show: !root.album },
                { sep: true, show: !root.album },
                { label: "Open on Its Platform", show: !root.album },
                { label: "Track Preferences...", show: !root.album }
            ];
            picked(n, k) => {
                if (n == 0) { root.clicked(); }
                if (n == 1) { root.act("album-play"); }
                if (n == 3) { root.act("album-hide"); }
                if (n == 4) { root.clicked(); }
                if (n == 5) { root.act("next"); }
                if (n == 6) { root.act("add"); }
                if (n == 8) { root.act("like"); }
                if (n == 9) { root.act("fav"); }
                if (n == 10) { root.act("artist:0"); }
                if (n == 12) { root.act("hide:track"); }
                if (n == 13) { root.act("hide:artist"); }
                if (n == 15) { root.act("open"); }
                if (n == 16) { root.act("prefs"); }
            }
        }
    }
}

/// A Settings category's title: a click opens or closes it

component Card inherits Rectangle {
    in property <brush> fill: Theme.panel;
    border-radius: Theme.card-radius;
    background: fill;
    border-width: 1px;
    border-color: Theme.line;
}

// A category on Settings' first page (as Windows' Settings lists them): its icon, its name, what's in it
component CatCard inherits Card {
    in property <string> name;
    in property <string> note;
    in property <string> d;
    callback clicked;
    fill: cta.has-hover ? Theme.elevated : Theme.panel;
    height: 72px;
    cta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 18px;
        Glyph { d: root.d; width: 24px; height: 24px; y: (parent.height - self.height) / 2; fill: Theme.accent; }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text { text: root.name; color: Theme.text; font-weight: 700; font-size: 15px; }
            Text { text: root.note; color: Theme.muted; font-size: 12px; overflow: elide; }
        }
        Text { text: "›"; color: Theme.muted; font-size: 26px; vertical-alignment: center; }
    }
}

// A switch in Settings: its name and what it does, its switch; one with settings of its own (a page) opens
// them from its Settings button, or from anywhere on the row; one that's a button (Add a Plugin) is that
component SetRowView inherits Card {
    in property <SetRow> r;
    callback toggle(string);
    callback more(string);
    fill: rta.has-hover && root.r.more ? Theme.elevated : Theme.panel;
    // (under the rest, so the switch and the buttons are still theirs)
    rta := TouchArea { enabled: root.r.more; mouse-cursor: root.r.more ? MouseCursor.pointer : MouseCursor.default; clicked => { root.more(root.r.key); } }
    HorizontalLayout {
        padding: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        padding-left: root.r.sub ? 34px : 16px;
        spacing: 14px;
        if root.r.sub: Rectangle { width: 2px; background: Theme.accent.with-alpha(0.5); }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text { text: root.r.label; color: Theme.text; font-weight: 700; }
            if root.r.note != "": Text { text: root.r.note; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
        }
        if root.r.more: Pill { label: "Settings ›"; y: (parent.height - self.height) / 2; clicked => { root.more(root.r.key); } }
        if root.r.button != "": Pill { label: root.r.button + " ›"; y: (parent.height - self.height) / 2; clicked => { root.more(root.r.key); } }
        if root.r.button == "": Toggle { checked: root.r.on; y: (parent.height - self.height) / 2; toggled => { root.toggle(root.r.key); } }
    }
}

export component AppWindow inherits Window {
    changed width => { Win.w = self.width; }
    changed height => { Win.h = self.height; }
    title: root.app-name != "" ? root.app-name : "OmniPulse";
    // Settings > App > Display Name: in the title bar and the taskbar (the web app's appName)
    in-out property <string> app-name;
    callback app-name-changed(string);
    in property <bool> title-prompt;
    callback title-rename();
    callback title-signin();
    // Settings > App > Listening Along: Timing, in ms (the web app's listenNudge)
    in-out property <string> listen-nudge: "0";
    callback listen-nudge-changed(string);
    no-frame: true;
    background: Theme.bg;
    preferred-width: 1180px;
    preferred-height: 760px;
    // Settings > App & Look > Player Style: "tab" (the default), "bar", "float" or "minimal"; the
    // window's narrowest follows it (the others put everything on one row)
    in property <string> player-style: "tab";
    callback player-style-picked(string);
    property <bool> tab-style: root.player-style == "tab";
    min-width: root.player-style == "float" ? 1040px : root.tab-style ? 820px : 1000px;
    min-height: 520px;
    default-font-family: "Segoe UI Variable Text";

    // pages
    in property <string> page: "library";
    in-out property <string> page-kind: "tracks";
    in property <string> page-title: "Library";
    in property <string> page-sub;
    in property <[string]> chips;
    in property <int> chip-on;
    in property <[Row]> rows;
    in property <[Side]> sides;
    // your playlists on this PC, by name; the page is one of them
    in property <[string]> own-lists;
    in property <bool> own-page;
    // Track preferences (the bar's menu): its title and artist as you want them, and its start and end
    in-out property <bool> tp-open;
    in-out property <string> tp-title;
    in-out property <string> tp-artist;
    in-out property <string> tp-start;
    in-out property <string> tp-end;
    in property <string> tp-note;
    // "Plays from YouTube Music" (a Go+ track, a MusicBrainz song): the versions it could play, the
    // one it plays marked
    in property <[string]> tp-versions;
    in property <int> tp-version-on: -1;
    callback tp-version(int);
    // a YouTube or YouTube Music link pasted, for what it plays as
    callback tp-link(string);
    callback tp-save();
    callback tp-reset();
    // "now": where the track is playing, for its start (0) or end (1)
    callback tp-now(int);
    // the track as a bar, its part that plays between the handles (0..1); dragged (where, which end);
    // a preview of its start (0) or end (1); the whole track again; versions searched for
    in property <float> tp-from: 0;
    in property <float> tp-to: 1;
    callback tp-drag(float, int);
    callback tp-preview(int);
    callback tp-whole();
    callback tp-search(string);
    // the naming dialog (a new playlist, or renaming one)
    in-out property <bool> name-open;
    in-out property <string> name-text;
    in property <string> name-head;
    in property <string> name-ok;
    callback name-done(string);
    callback pl-new();
    // a playlist file (M3U or CSV) as a playlist on this PC: the New playlist button's right-click menu
    callback pl-import();
    callback side-action(int, string);
    // the bar's playlist button: one of yours (by its place in own-lists), or -1 for a new one
    callback bar-pl(int);
    in property <int> side-on: -1;
    in property <[Shelf]> shelves;
    // the Library's Albums chip
    in property <[Tile]> album-tiles;
    callback album-tile(int);
    in-out property <string> search-text;
    in property <bool> can-back;
    // narrower than 980 px (as the web app: set from Rust as the window changes): the sidebar down to
    // its icons, no volume slider
    in property <bool> narrow;
    in property <[Item]> artists;
    in-out property <bool> fav-only;
    in property <bool> shuffle-on;
    in property <string> repeat-mode: "off";
    // stats
    in property <string> st-big;
    in property <string> st-sub;
    in property <string> st-top-name;
    in property <string> st-top-sub;
    in property <image> st-top-art;
    in property <[Item]> st-songs;
    in property <[Item]> st-artists;
    in property <string> st-kind;
    in property <string> st-kind-sub;
    in property <[float]> st-clock;
    in property <string> st-streak;
    in property <string> st-streak-sub;
    in property <[Item]> st-plats;
    in property <[string]> st-facts;
    // (each fact's heading, as the web app's: "Day after day", "Marathon"...)
    in property <[string]> st-fact-heads;
    // a card looked at more closely ("time", "artists", "songs", "when", "where", "streak"; "" for them all)
    in property <string> st-detail;
    in property <string> st-detail-head;
    in property <[StatBlock]> st-blocks;
    callback stats-open(string);
    callback stats-row(int);
    callback stats-play-these();
    callback stats-song(int);
    // Clear Listening History: asked once more before it's done
    in-out property <bool> st-clear-asking;
    callback stats-clear();
    // now playing
    in property <image> now-art-big;
    in property <string> now-album;
    // who uploaded it, where that's not its artist (Now Playing only)
    in property <string> now-uploader;
    // its tempo and key, once measured ("132 BPM · F# major · 2B")
    in property <string> now-rhythm;
    in property <[Line]> lyrics;
    in property <int> lyric-on: -1;
    in property <bool> st-empty;
    // Settings > Look (and the built-in controls, light or dark to match)
    in property <bool> light-theme;
    changed light-theme => { Palette.color-scheme = self.light-theme ? ColorScheme.light : ColorScheme.dark; }
    init => { Palette.color-scheme = self.light-theme ? ColorScheme.light : ColorScheme.dark; Win.w = self.width; Win.h = self.height; }
    in-out property <float> theme-step: 3;
    in-out property <float> tint-hue: 225;
    in-out property <float> tint-strength: 1;
    in property <string> theme-step-name;
    in property <string> tint-strength-name;
    in property <color> tint-preview;
    in property <[color]> accent-list;
    in property <int> accent-on: -1;
    in-out property <bool> art-accent;
    // the track info tab at the bar's right end instead of its left (Settings > Look)
    in property <bool> tab-right;
    callback tab-align-picked(string);
    // the title bar: Streamer Mode, and each platform on or off
    in-out property <bool> streamer;
    in property <[Plat]> plats;
    in property <string> lyrics-note;
    /// where the lyrics are from ("Lyrics from KuGou."), and the other places to try
    in property <string> lyrics-from;
    in property <[string]> lyrics-others;
    callback lyrics-pick(int);
    // the queue and the bar
    in property <[Row]> queue-rows;
    in property <string> status;
    /// the status is a problem (red, as the web app's)
    out property <bool> status-bad: {
        root.status.to-lowercase().starts-with("couldn") || root.status.to-lowercase().starts-with("can't") || root.status.to-lowercase().starts-with("error") || root.status.to-lowercase().starts-with("skipped")
    }
    in property <string> now-title: "Nothing playing";
    in property <string> now-artist;
    in property <string> now-plat;
    // the next track being found (the seek bar's marquee), or found ahead while this one plays
    in property <bool> track-loading;
    in property <bool> preloading;
    in property <image> now-art;
    in property <bool> playing;
    in property <float> pos-frac;
    in property <string> pos-text: "0:00";
    in property <string> dur-text: "0:00";
    in property <float> dur-secs;
    // the bar's heart and star, the output devices, and the track's menu
    in property <bool> now-liked;
    in property <bool> now-fav;
    in property <bool> can-like;
    in property <[string]> devices;
    in property <int> device-on: -1;
    in property <[string]> more-items;
    // Settings, beyond Look: its switches, section by section
    // Settings' switches, by category, and which categories are closed
    in property <[SetRow]> set-rows-integrations;
    // your own keys (Accounts): the key setup
    in-out property <bool> ks-open;
    in property <string> ks-head;
    in property <string> ks-note;
    in property <[KeyStep]> ks-steps;
    in property <[KeyField]> ks-fields;
    callback ks-open-url(int);
    callback ks-copy(int, int);
    callback ks-set(int, string);
    callback ks-save();
    // a Settings row's own settings (a plugin's): its key; the dialog with its fields
    callback set-more(string);
    in-out property <bool> pf-open;
    // Settings, as Windows' is: its categories first; one open shows on its own, its path as the title
    in-out property <string> set-cat;
    // a settings page's path, before its name ("Settings › Streaming")
    in property <string> pf-crumb;
    // (the panel's path, each part a way back to it)
    in property <[string]> pf-crumbs;
    callback crumb-go(int);
    // Settings: closed (the X), and searched (its own search: settings, not music)
    callback settings-close();
    // a status's buttons (the web app's say(..., { actions })): Update, Later, Choose a version, Skip...
    in property <[string]> status-actions;
    callback status-act(int);
    callback status-dismiss();
    // Adding look-alikes to a playlist: asked about (each one's choice cycles; all at once; Add, or Cancel)
    in-out property <bool> la-open;
    in property <string> la-head;
    in property <[LookAlike]> la-rows;
    callback la-cycle(int);
    callback la-all(int);
    callback la-done(bool);
    in property <[SetHit]> set-hits;
    in property <string> set-query;
    callback set-hit(int);
    // a settings panel's address: copied
    callback pf-copy(int);
    // Pick genres (step 1) and Fine-tune (step 2: the picked genres' subgenres), and Discover's card
    // asking for likes while there are none
    in-out property <bool> taste-open;
    in property <int> taste-step: 1;
    in property <[TasteRow]> taste-rows;
    in property <bool> likes-prompt;
    in property <string> taste-label: "Pick genres";
    // Discover's language: shown, and clicked through (Any, English, Spanish...)
    in property <string> lang-label: "English";
    callback lang-next();
    callback taste-pick();
    callback taste-toggle(int, int);
    callback taste-save();
    callback taste-back();
    callback taste-skip();
    in property <string> pf-head;
    in property <[PlugField]> pf-fields;
    callback pf-set(int, string);
    callback pf-save();
    in property <[SetRow]> set-rows-library;
    in property <[SetRow]> set-rows-sound;
    // Seamless Mix's cost, as measured (an audit: the engine's work only, not measuring songs)
    in property <string> mix-audit;
    in property <[SetRow]> set-rows-plugins;
    in property <[SetRow]> set-rows-streaming;
    in property <bool> closed-look;
    in property <bool> closed-integrations;
    in property <bool> closed-library;
    in property <bool> closed-sound;
    in property <bool> closed-streaming;
    callback section-flip(string);
    in-out property <float> volume: 80;
    in-out property <bool> queue-open: false;
    in-out property <bool> autoplay: true;
    in property <string> autoplay-note;
    in property <bool> is-max;

    callback nav(string);
    callback side(int);
    callback chip(int);
    callback play-row(int);
    /// the track list's rows in view (first, how many), for loading their covers
    callback rows-in-view(int, int);
    callback tile(int, int);
    callback lucky();
    callback search(string);
    // typing in the search bar: the page you're on is filtered as you type (Enter searches everywhere)
    callback search-edited(string);
    callback play-queue(int);
    callback row-action(int, string);
    callback genre-search(string);
    callback queue-action(int, string);
    // the queue's Clear, and Clear requests (true)
    callback queue-clear(bool);
    // a song's tile on a shelf: its menu's choice
    callback tile-act(int, int, string);
    // an artist's page: following on one platform ("Follow on SoundCloud", "Unfollow on Spotify"; "" none)
    in property <string> follow-sc;
    in property <string> follow-sp;
    callback follow-plat(string);
    callback album-act(int, string);
    // YouTube Music's helpers: what's said, a Set Up (or Try Again) button, a Remove one
    in property <string> helpers-note;
    // Apple Music's import: what's said, its button (Import, Import again, ...)
    in property <string> apple-note;
    in property <string> apple-label: "Import";
    callback apple-import();
    in property <string> helpers-setup;
    in property <bool> helpers-remove;
    callback helpers-act(string);
    // Now Playing: where its song opens ("Open on SoundCloud"...), and its buttons' and artist's actions
    in property <string> now-open;
    in property <string> now-desc;
    callback now-act(string);
    // the open playlist's header: what it offers
    in property <bool> pl-share;
    in property <string> pl-collab;
    in property <bool> pl-own;
    in property <bool> pl-merged;
    callback page-pl(string);
    // the Artists page: an artist's menu, and following everyone from one platform on another
    callback artist-act(int, string);
    in property <[string]> artists-batch;
    callback artists-batch-go(int);
    // the playing song right-clicked in the player bar: the "..." menu
    callback now-menu();
    in-out property <int> now-menu-asks;
    in property <int> queue-requests;
    callback shuffle();
    callback play-page();
    callback refresh();
    callback set-toggle(string);
    callback like-toggle();
    callback fav-toggle();
    callback devices-want();
    callback device-pick(int);
    callback more-want();
    callback more-pick(int);
    callback artist(int);
    callback back();
    callback fav-only-changed(bool);
    // an artist's page: Unfollow (or Follow again), and Also follow on the platform you don't yet
    in property <string> follow-label;
    in property <bool> follow-on;
    in property <string> follow-more;
    callback follow-click();
    callback follow-more-click();
    // Sets & Podcasts: only the ones in your likes (the web app's setsLiked)
    in-out property <bool> sets-liked;
    callback sets-liked-changed(bool);
    // Search: leave out what you've liked (the web app's Hide likes)
    in-out property <bool> hide-likes;
    callback hide-likes-changed(bool);
    callback shuffle-toggle();
    callback repeat-cycle();
    callback look-changed(string, float);
    callback streamer-changed(bool);
    // the Streamer Mode button's next step: off -> private info hidden -> and safe music only -> off
    callback streamer-step();
    in property <bool> stream-safe;
    // the Library's order: "artist" / "title" (1 A to Z, -1 Z to A), or "" as you liked them
    in property <string> sort-by;
    in property <int> sort-dir;
    callback sort-pick(string);
    // Settings > Sound: Match Loudness ("off" / "quiet" / "normal" / "loud"), the equalizer
    in property <string> loud-on;
    in property <[float]> eq-gains;
    in-out property <bool> eq-on;
    in property <[string]> eq-presets;
    callback loud-pick(string);
    callback eq-on-changed(bool);
    callback eq-band(int, float);
    callback eq-preset(int);
    in-out property <bool> fade-on;
    in property <int> fade-ms;
    in property <int> skip-silence;
    callback fade-on-changed(bool);
    callback fade-ms-pick(int);
    callback skip-pick(int);
    in property <[Account]> accounts;
    // your music folders (Settings > Your Music), and what's been found in them
    in property <[string]> folders;
    in property <string> folders-note;
    callback folder-add();
    callback folder-remove(int);
    callback folders-rescan();
    callback account-act(int);
    /// an account's other button (Spotify's own keys, once signed in)
    callback account-keys(int);
    in-out property <bool> rounded: true;
    callback rounded-changed(bool);
    // Settings > Look > List Density: Compact (the web app's setting too)
    in-out property <bool> compact-rows;
    callback density-changed(bool);
    // Settings > App: Close to Tray, Animations (the web app's settings too)
    in-out property <bool> close-to-tray;
    callback close-to-tray-changed(bool);
    // Settings > App: Taskbar Widget, Hardware Acceleration
    in-out property <bool> taskbar-widget;
    in-out property <bool> gpu-on;
    callback app-pref(string, bool);
    // a web page opened in your browser
    callback open-web(string);
    in-out property <bool> anim-on: true;
    callback anim-changed(bool);
    // Updates: what's known (this version, or a newer one), and its button ("Check" or "Update")
    in property <string> update-note: "Checks for a newer version a little after it starts.";
    in property <string> update-label: "Check";
    callback update-act();
    callback backup-make();
    callback backup-restore();
    callback plat-toggle(string);
    callback accent-picked(int);
    callback art-accent-changed(bool);
    callback autoplay-changed(bool);
    callback toggle();
    callback next();
    callback prev();
    // picking tracks on a page: a row (1 one more or less, 2 everything from the last one), all (Ctrl+A), none (Escape)
    callback row-pick(int, int);
    callback pick-all();
    callback pick-none();
    callback seek(float);
    callback volume-changed(float);
    callback drag();
    callback minimize();
    // Jams: the title bar's button ("" hides it), someone asking for one, and the Jam's own dialog
    in property <string> jam-label;
    in property <bool> jam-on;
    // the queue panel's bar while in a room: "Your Jam · 2 listening" (End Jam), or listening along (Leave)
    in property <string> queue-room;
    in property <bool> queue-room-host;
    in property <string> jam-ask;
    // Listen Along & Jams switched off: no Jam button
    in property <bool> jam-hidden;
    // Settings > Library > Favourites Page (the stars stay either way)
    in property <bool> fav-page: true;
    // the sidebar's pages, in your order (the web app's navOrder: its button ids), the hidden ones out
    in property <[string]> nav-ids: ["navDiscover", "navRediscover", "navLikes", "navFavourites", "navSets", "navArtists", "navStats"];
    callback nav-hide(string);
    pure function nav-page(id: string) -> string {
        return id == "navDiscover" ? "discover" : id == "navRediscover" ? "rediscover" : id == "navLikes" ? "library" : id == "navFavourites" ? "favourites" : id == "navSets" ? "sets" : id == "navArtists" ? "artists" : "stats";
    }
    pure function nav-label(id: string) -> string {
        return id == "navDiscover" ? (root.stream-safe ? "Streamer Mode" : "Discover") : id == "navRediscover" ? "Rediscover" : id == "navLikes" ? "Library" : id == "navFavourites" ? "Favourites" : id == "navSets" ? "Sets & Podcasts" : id == "navArtists" ? "Artists" : "Stats";
    }
    pure function nav-icon(id: string) -> string {
        return id == "navDiscover" ? Icons.discover : id == "navRediscover" ? Icons.rediscover : id == "navLikes" ? Icons.library : id == "navFavourites" ? Icons.star : id == "navSets" ? Icons.sets : id == "navArtists" ? Icons.person : Icons.stats;
    }
    pure function nav-active(id: string) -> bool {
        return root.page == root.nav-page(id) || (id == "navDiscover" && root.page == "streamer") || (id == "navArtists" && root.page == "artist");
    }
    in property <string> jam-ring;
    in-out property <bool> jam-open;
    in property <string> jam-link;
    in property <string> jam-members;
    callback jam-clicked();
    callback jam-accept();
    callback jam-decline();
    callback jam-copy();
    callback jam-end();
    callback maximize();
    callback close-window();
    // Seamless Mix: on or off (the title bar's button, as its switch in Settings > Sound), and a mix
    // playing now
    in property <bool> mix-on;
    // the output menu: where its cast devices start (-1: none)
    in property <int> devices-cast-from: -1;
    // and where OmniPulse Offset plays (-1: it isn't)
    in property <int> device-offset: -1;
    in property <bool> mixing;
    callback mix-toggle();
    // an edge or corner pressed: the window resized from it (0 top ... 7 bottom-right)
    callback resize(int);

    VerticalLayout {
        // ---------- title bar ----------
        Rectangle {
            height: 34px;
            TouchArea {
                pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.drag(); } }
                double-clicked => { root.maximize(); }
            }
            HorizontalLayout {
                padding-left: 14px;
                spacing: 10px;
                // (right-click: rename it; signed out of SoundCloud: an invitation to sign in, as the web app's)
                Rectangle {
                    width: tt.preferred-width;
                    tt := Text { text: root.title-prompt ? "Sign in to SoundCloud" : (root.app-name != "" ? root.app-name : "OmniPulse"); color: root.title-prompt ? (tta.has-hover ? Theme.text : Theme.accent) : Theme.text; font-weight: 700; font-size: 13px; vertical-alignment: center; height: parent.height; }
                    tta := TouchArea {
                        mouse-cursor: root.title-prompt ? MouseCursor.pointer : MouseCursor.default;
                        clicked => { if (root.title-prompt) { root.title-signin(); } }
                        // (the name drags the window as the rest of the title bar does)
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) { root.title-rename(); }
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left && !root.title-prompt) { root.drag(); }
                        }
                        double-clicked => { if (!root.title-prompt) { root.maximize(); } }
                    }
                }
                // Streamer Mode: grey when off; on, it pulses YouTube red, Twitch purple and Kick green
                Rectangle {
                    width: 26px;
                    height: 26px;
                    y: 4px;
                    border-radius: 7px;
                    background: sta-s.has-hover ? Theme.elevated : transparent;
                    property <float> phase: mod(animation-tick() / 1ms, 3600) / 1200;
                    Glyph {
                        d: Icons.broadcast;
                        width: 16px;
                        height: 16px;
                        x: 5px;
                        y: 5px;
                        fill: !root.streamer && !root.stream-safe ? Theme.muted
                            : parent.phase < 1 ? #ff0033.mix(#9146ff, 1 - parent.phase)
                            : parent.phase < 2 ? #9146ff.mix(#53fc18, 2 - parent.phase)
                            : #53fc18.mix(#ff0033, 3 - parent.phase);
                        opacity: root.streamer || root.stream-safe ? 1 : 0.55;
                    }
                    // Stream-Safe Music on: a dot
                    if root.stream-safe: Rectangle { x: 18px; y: 2px; width: 7px; height: 7px; border-radius: 3.5px; background: #53fc18; }
                    TipSpot { hover: sta-s.has-hover; tip: root.stream-safe ? "Streamer Mode, Extended: private info hidden, and only music that's safe on stream. Click to turn it off." : root.streamer ? "Streamer Mode: private info hidden. Click again for Extended (only music that's safe on stream)." : "Streamer Mode: off. Click to hide private info; again for Extended (only music that's safe on stream)."; }
                    sta-s := TouchArea { clicked => { Tips.on = false; root.streamer-step(); } }
                }
                // Seamless Mix: grey when off; on, its colour flows from one accent to the other with a
                // glow, brighter and quicker while a mix is playing
                Rectangle {
                    width: 26px;
                    height: 26px;
                    y: 4px;
                    border-radius: 7px;
                    background: sta-m.has-hover ? Theme.elevated : transparent;
                    property <float> phase: mod(animation-tick() / 1ms, root.mixing ? 1200 : 3000) / (root.mixing ? 1200 : 3000);
                    property <float> swing: phase < 0.5 ? phase * 2 : 2 - phase * 2;
                    // the glow
                    if root.mix-on: Rectangle {
                        x: 3px;
                        y: 3px;
                        width: 20px;
                        height: 20px;
                        border-radius: 10px;
                        background: Theme.accent.mix(Theme.accent-2, 1 - parent.swing).with-alpha(root.mixing ? 0.30 + 0.25 * parent.swing : 0.16);
                        drop-shadow-blur: root.mixing ? 10px : 6px;
                        drop-shadow-color: Theme.accent.mix(Theme.accent-2, parent.swing).with-alpha(root.mixing ? 0.9 : 0.5);
                    }
                    Glyph {
                        d: Icons.mix;
                        width: 16px;
                        height: 16px;
                        x: 5px;
                        y: 5px;
                        fill: !root.mix-on ? Theme.muted : Theme.accent.mix(Theme.accent-2, 1 - parent.swing);
                        opacity: root.mix-on ? 1 : 0.55;
                    }
                    TipSpot { hover: sta-m.has-hover; tip: root.mix-on ? "Seamless Mix: on. Click to turn it off." : "Seamless Mix: off. Click to mix songs into each other on the beat."; }
                    sta-m := TouchArea { clicked => { Tips.on = false; root.mix-toggle(); } }
                }
                // the platforms: in their colours when on, plain when off
                if root.plats.length > 1: Rectangle {
                    y: 4px;
                    height: 26px;
                    width: root.plats.length * 28px + 4px;
                    border-radius: 8px;
                    background: Theme.elevated;
                    HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;
                        for p in root.plats: Rectangle {
                            width: 26px;
                            border-radius: 6px;
                            background: !p.on ? transparent : p.id == "spotify" ? #1ed76029 : p.id == "youtube" ? #ff003329 : p.id == "local" ? #f2b54429 : #ff550029;
                            PlatIcon {
                                plat: p.id;
                                title-bar: true;
                                width: 15px;
                                height: 15px;
                                x: 5.5px;
                                y: 5.5px;
                                fill: !p.on ? Theme.text : p.id == "spotify" ? #1ed760 : p.id == "youtube" ? #ff0033 : p.id == "local" ? #f2b544 : #ff5500;
                                opacity: p.on ? 1 : !p.ready ? (ta-p.has-hover ? 0.5 : 0.25) : (ta-p.has-hover ? 0.7 : 0.4);
                            }
                            TipSpot { hover: ta-p.has-hover; tip: p.name + (!p.ready ? ": not set up yet. Click to set it up." : p.on ? " is on. Click to hide it everywhere." : " is off. Click to show it again."); }
                            ta-p := TouchArea { clicked => { Tips.on = false; root.plat-toggle(p.id); } }
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                // someone asking you to start a Jam: in the button's place, with a ring that empties
                if root.jam-ask != "": Rectangle {
                    y: 4px;
                    height: 26px;
                    width: ask-row.preferred-width + 16px;
                    border-radius: 13px;
                    background: @linear-gradient(100deg, Theme.accent 0%, Theme.accent-2 100%);
                    ask-row := HorizontalLayout {
                        x: 8px;
                        spacing: 8px;
                        Rectangle {
                            width: 16px;
                            Path { commands: "M 10 4 A 7 7 0 1 1 9.99 4"; viewbox-width: 20; viewbox-height: 20; width: 16px; height: 16px; y: (parent.height - self.height) / 2; stroke: Theme.on-accent.with-alpha(0.3); stroke-width: 2px; fill: transparent; }
                            if root.jam-ring != "": Path { commands: root.jam-ring; viewbox-width: 20; viewbox-height: 20; width: 16px; height: 16px; y: (parent.height - self.height) / 2; stroke: Theme.on-accent; stroke-width: 2px; fill: transparent; }
                        }
                        Text { text: root.jam-ask; color: Theme.on-accent; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                        Rectangle {
                            width: yes-t.preferred-width + 18px;
                            height: 20px;
                            y: 3px;
                            border-radius: 10px;
                            background: Theme.on-accent;
                            yes-t := Text { text: "Accept"; color: Theme.accent; font-size: 12px; font-weight: 700; }
                            TouchArea { clicked => { root.jam-accept(); } }
                        }
                        Rectangle {
                            width: no-t.preferred-width + 18px;
                            height: 20px;
                            y: 3px;
                            border-radius: 10px;
                            background: Theme.on-accent.with-alpha(0.18);
                            no-t := Text { text: "Decline"; color: Theme.on-accent; font-size: 12px; font-weight: 700; }
                            TouchArea { clicked => { root.jam-decline(); } }
                        }
                    }
                }
                if root.jam-ask == "" && root.jam-label != "" && !root.jam-hidden: Rectangle {
                    y: 6px;
                    height: 22px;
                    width: jam-t.preferred-width + 24px;
                    border-radius: 11px;
                    border-width: root.jam-on ? 0 : 1px;
                    border-color: Theme.line;
                    background: root.jam-on ? Theme.accent : (jam-ta.has-hover ? Theme.elevated : transparent);
                    jam-t := Text { text: root.jam-label; color: root.jam-on ? Theme.on-accent : (jam-ta.has-hover ? Theme.text : Theme.muted); font-size: 12px; font-weight: 600; }
                    jam-ta := TouchArea { clicked => { root.jam-clicked(); } }
                }
                Rectangle { width: 6px; }
                for b in [{ d: "M1 6h10", act: "min" }, { d: root.is-max ? "M3.5 3.5V1.5h7v7h-2M1.5 3.5h7v7h-7z" : "M1.5 1.5h9v9h-9z", act: "max" }, { d: "M1.5 1.5l9 9M10.5 1.5l-9 9", act: "close" }]: Rectangle {
                    width: 46px;
                    background: wta.has-hover ? (b.act == "close" ? #e81123 : Theme.elevated) : transparent;
                    Path { commands: b.d; viewbox-width: 12; viewbox-height: 12; width: 11px; height: 11px; stroke: wta.has-hover && b.act == "close" ? white : Theme.muted; stroke-width: 1.2px; fill: transparent; }
                    TipSpot { hover: wta.has-hover; tip: b.act == "min" ? "Minimize" : b.act == "max" ? (root.is-max ? "Restore" : "Maximize") : "Close"; }
                    wta := TouchArea { clicked => { Tips.on = false; if (b.act == "min") { root.minimize(); } else if (b.act == "max") { root.maximize(); } else { root.close-window(); } } }
                }
            }
        }

        // the pages, reaching down to the bar's body (its tab is drawn over their bottom)
        Rectangle {
            vertical-stretch: 1;
            property <length> body-h: root.status != "" ? 99px : 68px;
            animate body-h { duration: Theme.motion ? 220ms : 0ms; easing: ease-out; }
        HorizontalLayout {
            y: 0;
            height: parent.height - parent.body-h - 16px;
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;
            // ---------- sidebar ----------
            Rectangle {
                width: root.narrow ? 68px : 230px;
                background: Theme.panel;
                border-radius: Theme.panel-radius;
                VerticalLayout {
                    padding: 10px;
                    spacing: 2px;
                    for id in root.nav-ids: ndz := DropArea {
                        height: 38px;
                        can-drop(e) => { return Dnd.accepts("nav:" + id, e.data) ? DragAction.move : DragAction.none; }
                        dropped(e) => { Dnd.dropped("nav:" + id, e.data); return e.proposed-action; }
                        // (where it goes: a line above it)
                        if ndz.has-drag: Rectangle { y: 0; height: 2px; background: Theme.accent; }
                        DragArea {
                            allow-move: true;
                            data: Dnd.payload("n:" + id);
                            Rectangle {
                                NavItem { right-click(x, y) => { cm3.open(x, y); } label: root.nav-label(id); d: root.nav-icon(id); spin: id == "navFavourites"; compact: root.narrow; active: root.nav-active(id); clicked => { root.nav(root.nav-page(id)); } }
                                // (on top: it only takes right-clicks, the rest goes through to what's under it)
                                cm3 := CtxMenu {
                                    width: 100%; height: 100%;
                                    items: [
                                        { label: "Hide from the Sidebar", show: id == "navFavourites" || id == "navSets" || id == "navStats" }
                                    ];
                                    picked(n, k) => {
                                        if (n == 0) { root.nav-hide(id); }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { height: 10px; }
                    if !root.narrow: HorizontalLayout {
                        padding-left: 12px;
                        Text { text: "Playlists"; color: Theme.muted; font-size: 12px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                        Rectangle { width: 26px; height: 26px;
                            IconButton { right-click(x, y) => { cm4.open(x, y); } tip: "New playlist"; d: Icons.add; size: 26px; clicked => { root.pl-new(); } }
                            // (on top: it only takes right-clicks, the rest goes through to what's under it)
                            cm4 := CtxMenu {
                                width: 100%; height: 100%;
                                items: [
                                    { label: "New playlist", show: true },
                                    { label: "Import a playlist file...", show: true }
                                ];
                                picked(n, k) => {
                                    if (n == 0) { root.pl-new(); }
                                    if (n == 1) { root.pl-import(); }
                                }
                            }
                        }
                    }
                    if root.narrow: Rectangle { height: 1px; background: Theme.line; }
                    ListView {
                        vertical-stretch: 1;
                        // (the last one with room below it, clear of the track tab)
                        for s[i] in root.sides: VerticalLayout {
                          Rectangle {
                            height: 32px;
                            border-radius: 6px;
                            background: sdz.has-drag ? Theme.accent.with-alpha(0.3) : root.side-on == i ? Theme.elevated : (sta.has-hover ? #ffffff08 : transparent);
                            border-width: sdz.has-drag ? 1px : 0px;
                            border-color: Theme.accent;
                            HorizontalLayout {
                                padding-left: root.narrow ? 0px : 12px;
                                spacing: 10px;
                                alignment: root.narrow ? center : start;
                                PlatIcon { plat: s.plat; width: 14px; height: 14px; y: (parent.height - self.height) / 2; }
                                if !root.narrow: Text { text: s.title; color: root.side-on == i ? Theme.text : Theme.muted; font-size: 13px; vertical-alignment: center; overflow: elide; }
                            }
                            sdz := DropArea {
                              can-drop(e) => { return Dnd.accepts("side:" + i, e.data) ? DragAction.copy : DragAction.none; }
                              dropped(e) => { Dnd.dropped("side:" + i, e.data); return e.proposed-action; }
                             DragArea {
                              allow-copy: true;
                              data: Dnd.payload("p:" + i);
                            Rectangle {
                                sta := TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) { cm5.open(self.mouse-x, self.mouse-y); } } clicked => { root.side(i); } }
                                // (on top: it only takes right-clicks, the rest goes through to what's under it)
                                cm5 := CtxMenu {
                                    width: 100%; height: 100%;
                                    items: [
                                        { label: "Open", show: true },
                                        { label: "Share", show: s.share },
                                        { label: "Copy SoundCloud Link", show: s.sc },
                                        { label: "Copy Spotify Link", show: s.sp },
                                        { label: s.collab ? "Copy invite link" : "Invite collaborators", show: s.share && !(s.collab && !s.collab-owner) },
                                        { label: s.collab-owner ? "Stop collaborating" : "Leave collaboration", show: s.collab },
                                        { label: "Export to SoundCloud & Spotify", show: s.own },
                                        { label: "Unmerge Playlists", show: s.merged },
                                        { label: "Rename...", show: s.own },
                                        { label: "Delete", show: s.own },
                                        { label: "Hide playlist", show: true },
                                        { label: "Switch to a Playlist on This PC", show: !s.own && s.share },
                                        { label: "Export as M3U...", show: true },
                                        { label: "Export as CSV...", show: true }
                                    ];
                                    picked(n, k) => {
                                        if (n == 0) { root.side(i); }
                                        if (n == 1) { root.side-action(i, "share"); }
                                        if (n == 2) { root.side-action(i, "link:soundcloud"); }
                                        if (n == 3) { root.side-action(i, "link:spotify"); }
                                        if (n == 4) { root.side-action(i, "collab"); }
                                        if (n == 5) { root.side-action(i, "collab-leave"); }
                                        if (n == 6) { root.side-action(i, "export"); }
                                        if (n == 7) { root.side-action(i, "unmerge"); }
                                        if (n == 8) { root.side-action(i, "rename"); }
                                        if (n == 9) { root.side-action(i, "delete"); }
                                        if (n == 10) { root.side-action(i, "hide"); }
                                        if (n == 11) { root.side-action(i, "switch"); }
                                        if (n == 12) { root.side-action(i, "export:m3u"); }
                                        if (n == 13) { root.side-action(i, "export:csv"); }
                                    }
                                }
                            }
                             }
                            }
                          }
                          if i == root.sides.length - 1: Rectangle { height: 76px; }
                        }
                    }
                }
            }
            // ---------- the page ----------
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.panel;
                border-radius: Theme.panel-radius;
                clip: true;
                border-width: pdz.has-drag ? 2px : 0px;
                border-color: Theme.accent;
                // the accent's glow at the top, fading into the panel (its top corners the page's: what's in
                // the page isn't rounded off with it)
                Rectangle {
                    y: 0;
                    height: 340px;
                    border-top-left-radius: Theme.panel-radius;
                    border-top-right-radius: Theme.panel-radius;
                    background: @linear-gradient(180deg, Theme.panel.mix(Theme.accent, 0.7) 0%, Theme.panel 100%);
                }
                pdz := DropArea {
                    can-drop(e) => { return Dnd.accepts("page", e.data) ? DragAction.copy : DragAction.none; }
                    dropped(e) => { Dnd.dropped("page", e.data); return e.proposed-action; }
                }
                VerticalLayout {
                    padding: 24px;
                    padding-top: 14px;
                    padding-bottom: 6px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 12px;
                        RoundButton { tip: "Back"; d: Icons.back; enabled: root.can-back || (root.page == "settings" && root.set-cat != ""); clicked => { if (root.page == "settings" && root.set-cat != "") { root.set-cat = ""; } else { root.back(); } } }
                        Rectangle { horizontal-stretch: 1; }
                        // the search bar: a pill in the middle
                        Rectangle {
                            preferred-width: 440px;
                            min-width: 180px;
                            horizontal-stretch: 0;
                            height: 40px;
                            border-radius: 20px;
                            background: Theme.bg.mix(Theme.panel, 0.7);
                            border-width: 1px;
                            border-color: ti.has-focus ? Theme.accent.with-alpha(0.6) : transparent;
                            Glyph { d: Icons.search; x: 16px; width: 20px; height: 20px; fill: Theme.muted; }
                            if root.search-text == "": Text {
                                x: 48px;
                                text: root.page == "settings" ? "Search settings" : "Search everywhere";
                                color: Theme.muted;
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                            ti := TextInput {
                                x: 48px;
                                width: parent.width - 64px;
                                height: parent.height;
                                vertical-alignment: center;
                                color: Theme.text;
                                font-size: 14px;
                                single-line: true;
                                text <=> root.search-text;
                                accepted => { if (root.page != "settings") { root.search(self.text); keys.focus(); } }
                                edited => { root.search-edited(self.text); }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        RoundButton { tip: root.page == "settings" ? "Close Settings" : "Settings"; d: root.page == "settings" ? Icons.close : Icons.gear; clicked => { if (root.page == "settings") { root.settings-close(); } else { root.nav("settings"); } } }
                    }
                    Rectangle { height: 10px; }
                    // the title, and (on pages made from what the platforms send) fetching them again
                    if root.page-kind != "now": HorizontalLayout {
                        spacing: 14px;
                        if !(root.page == "settings" && root.set-cat != "" && root.set-query == ""): Text { text: root.page == "settings" && root.set-query != "" ? "Settings" : root.page-title; color: Theme.text; font-size: 44px; font-weight: 800; overflow: elide; horizontal-stretch: 0; }
                        if root.page == "settings" && root.set-cat != "" && root.set-query == "": HorizontalLayout {
                            spacing: 14px;
                            Text {
                                text: "Settings";
                                color: sct.has-hover ? Theme.text : Theme.muted;
                                font-size: 44px;
                                font-weight: 800;
                                sct := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.set-cat = ""; } }
                            }
                            Text { text: "›"; color: Theme.muted; font-size: 40px; font-weight: 400; vertical-alignment: center; }
                            Text { text: root.set-cat; color: Theme.text; font-size: 44px; font-weight: 800; overflow: elide; }
                        }
                        if root.page == "discover" || root.page == "rediscover" || root.page == "sets" || root.page == "artists" || root.page == "mix": RoundButton {
                            tip: "New recommendations";
                            d: Icons.refresh;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.refresh(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if root.page-kind != "now" && root.page-sub != "": Text { text: root.page-sub; color: Theme.muted; font-size: 14px; wrap: word-wrap; overflow: elide; max-height: 60px; }
                    if root.chips.length > 0: HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        padding-top: 8px;
                        for c[i] in root.chips: Chip { label: c; on: root.chip-on == i; clicked => { root.chip(i); } }
                        // (Search: leave out what you've liked)
                        if root.page == "search": Rectangle { width: 8px; }
                        if root.page == "search": Chip { label: "Hide likes"; on: root.hide-likes; clicked => { root.hide-likes = !root.hide-likes; root.hide-likes-changed(root.hide-likes); } }
                    }
                    // play the page, shuffle it; Favourites only on the right
                    if root.page-kind == "tracks": HorizontalLayout {
                        spacing: 14px;
                        padding-top: 10px;
                        padding-bottom: 6px;
                        Rectangle {
                            width: 52px;
                            height: 52px;
                            border-radius: 26px;
                            background: pa.has-hover ? Theme.accent.brighter(0.08) : Theme.accent;
                            opacity: root.rows.length > 0 ? 1 : 0.5;
                            Glyph { d: Icons.play; width: 24px; height: 24px; fill: Theme.on-accent; }
                            pa := TouchArea { enabled: root.rows.length > 0; clicked => { root.play-page(); } }
                        }
                        Pill { label: "Shuffle"; y: 7px; clicked => { root.shuffle(); } }
                        // a playlist's own: Share, Invite collaborators (or its invite link), Delete playlist, as the web app's
                        if root.page == "playlist" && root.pl-share: Pill { label: "Share"; y: 7px; clicked => { root.page-pl("share"); } }
                        if root.page == "playlist" && root.pl-collab != "": Pill { label: root.pl-collab; y: 7px; clicked => { root.page-pl("collab"); } }
                        if root.page == "playlist" && root.pl-own: Pill { label: "Export"; tip: "Its SoundCloud songs to a playlist on SoundCloud, its Spotify songs to one on Spotify (again: brought up to date)"; y: 7px; clicked => { root.page-pl("export"); } }
                        if root.page == "playlist" && root.pl-merged: Pill { label: "Unmerge"; tip: "Take out what each playlist combined into this one brought"; y: 7px; clicked => { root.page-pl("unmerge"); } }
                        if root.page == "playlist" && root.pl-own: Pill { label: "Delete playlist"; y: 7px; clicked => { root.page-pl("delete"); } }
                        Rectangle { horizontal-stretch: 1; }
                        // the Library's sort, clicked through: A to Z, Z to A, off
                        if root.page == "library": Rectangle {
                            y: 7px;
                            height: 38px;
                            width: sorts.preferred-width + 8px;
                            border-radius: 19px;
                            border-width: 1px;
                            border-color: Theme.line;
                            sorts := HorizontalLayout {
                                x: 4px;
                                y: 3px;
                                spacing: 4px;
                                for k[i] in ["artist", "title"]: Chip {
                                    label: (i == 0 ? "Artist" : "Title") + (root.sort-by == k ? (root.sort-dir > 0 ? " ↑" : " ↓") : "");
                                    on: root.sort-by == k;
                                    clicked => { root.sort-pick(k); }
                                }
                            }
                        }
                        if root.page == "sets": Pill { label: "Liked only"; d: Icons.library; on: root.sets-liked; y: 7px; clicked => { root.sets-liked = !root.sets-liked; root.sets-liked-changed(root.sets-liked); } }
                        if root.page == "artist" && root.follow-more != "": Pill { label: root.follow-more; y: 7px; clicked => { root.follow-more-click(); } }
                        // (right-click: each platform on its own, as the web app's)
                        if root.page == "artist" && root.follow-label != "": Rectangle {
                            width: fpill.preferred-width;

                            fpill := Pill { right-click(x, y) => { cm6.open(x, y); } label: root.follow-label; on: root.follow-on; y: 7px; clicked => { root.follow-click(); } }
                            // (on top: it only takes right-clicks, the rest goes through to what's under it)
                            cm6 := CtxMenu {
                                width: 100%; height: 100%;
                                enabled: root.follow-sc != "" || root.follow-sp != "";
                                items: [
                                    { label: root.follow-sc, show: root.follow-sc != "" },
                                    { label: root.follow-sp, show: root.follow-sp != "" }
                                ];
                                picked(n, k) => {
                                    if (n == 0) { root.follow-plat("soundcloud"); }
                                    if (n == 1) { root.follow-plat("spotify"); }
                                }
                            }
                        }
                        Pill { label: "Favourites only"; d: Icons.star; on: root.fav-only; y: 7px; clicked => { root.fav-only = !root.fav-only; root.fav-only-changed(root.fav-only); } }
                    }
                    // the list's column heads
                    if root.page-kind == "tracks": VerticalLayout {
                        HorizontalLayout {
                            height: 30px;
                            padding-left: 8px;
                            padding-right: 16px;
                            spacing: 16px;
                            Text { text: "#"; width: 28px; color: Theme.muted; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                            Text { text: "Title"; color: Theme.muted; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                            Text { text: "Time"; width: 48px; color: Theme.muted; font-size: 13px; horizontal-alignment: right; vertical-alignment: center; }
                        }
                        Rectangle { height: 1px; background: Theme.line; }
                        Rectangle { height: 6px; }
                    }
                    if root.page-kind != "tracks": Rectangle { height: 4px; }
                    // a list of tracks (Library, playlists, Search, Favourites, Sets, Rediscover)
                    if root.page-kind == "tracks": track-list := ListView {
                        vertical-stretch: 1;
                        property <int> first: max(0, floor(-self.content-y / Theme.row-h));
                        property <int> count: ceil(self.visible-height / Theme.row-h) + 1;
                        changed first => { root.rows-in-view(self.first, self.count); }
                        changed count => { root.rows-in-view(self.first, self.count); }
                        init => { root.rows-in-view(self.first, self.count); }
                        // (the last one with room below it, so it scrolls clear of the track tab)
                        for r[i] in root.rows: VerticalLayout {
                            TrackRow { item: r; index: i; compact: root.narrow || root.queue-open; lists: root.own-lists; removable: root.own-page; show-genres: root.page == "search" && Theme.row-h >= 60px; genre(g) => { root.genre-search(g); } play => { root.play-row(i); } act(a) => { root.row-action(i, a); } pick(m) => { root.row-pick(i, m); } }
                            if i == root.rows.length - 1: Rectangle { height: 76px; }
                        }
                    }
                    // the Library's Albums: a grid of covers
                    if root.page-kind == "albumgrid": agrid := ScrollView {
                        vertical-stretch: 1;
                        property <int> cols: max(1, floor(self.visible-width / 186px));
                        content-width: self.visible-width;
                        content-height: ceil(root.album-tiles.length / self.cols) * 240px + 76px;
                        for t[i] in root.album-tiles: TileView {
                            x: mod(i, agrid.cols) * 186px;
                            y: floor(i / agrid.cols) * 240px + 12px;
                            tile: t;
                            album: true;
                            clicked => { root.album-tile(i); }
                            act(a) => { root.album-act(i, a); }
                        }
                    }
                    // Artists: everyone you follow, round, A to Z
                    if root.page-kind == "artists" && root.artists-batch.length > 0: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        for b[k] in root.artists-batch: Pill { label: b; clicked => { root.artists-batch-go(k); } }
                    }
                    if root.page-kind == "artists": grid := ScrollView {
                        vertical-stretch: 1;
                        property <int> cols: max(1, floor(self.visible-width / 186px));
                        content-width: self.visible-width;
                        content-height: ceil(root.artists.length / self.cols) * 240px;
                        for a[i] in root.artists: Rectangle {
                            x: mod(i, grid.cols) * 186px;
                            y: floor(i / grid.cols) * 240px;
                            width: 170px;
                            height: 228px;
                            VerticalLayout {
                                spacing: 8px;
                                Rectangle {
                                    height: 170px;
                                    border-radius: 85px;
                                    clip: true;
                                    background: Theme.elevated;
                                    Glyph { d: Icons.person; width: 64px; height: 64px; fill: Theme.muted; }
                                    Image { source: a.art; width: parent.width; height: parent.height; image-fit: cover; }
                                    if ata.has-hover: Rectangle { x: parent.width - 52px; y: parent.height - 52px; width: 42px; height: 42px; border-radius: 21px; background: Theme.accent;
                                        Glyph { d: Icons.play; width: 22px; height: 22px; fill: Theme.on-accent; } }
                                }
                                Text { text: a.name; color: Theme.text; font-weight: 700; font-size: 13px; overflow: elide; horizontal-alignment: center; }
                                Text { text: a.sub; color: Theme.muted; font-size: 12px; overflow: elide; horizontal-alignment: center; }
                            }
                            Rectangle {
                                ata := TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) { cm7.open(self.mouse-x, self.mouse-y); } } clicked => { root.artist(i); } }
                                // (on top: it only takes right-clicks, the rest goes through to what's under it)
                                cm7 := CtxMenu {
                                    width: 100%; height: 100%;
                                    items: [
                                        { label: "Open", show: true },
                                        { label: "Follow on SoundCloud Too", show: !a.on-sc },
                                        { label: "Follow on Spotify Too", show: !a.on-sp },
                                        { label: "Unfollow Everywhere", show: true }
                                    ];
                                    picked(n, k) => {
                                        if (n == 0) { root.artist(i); }
                                        if (n == 1) { root.artist-act(i, "follow:soundcloud"); }
                                        if (n == 2) { root.artist-act(i, "follow:spotify"); }
                                        if (n == 3) { root.artist-act(i, "unfollow"); }
                                    }
                                }
                            }
                        }
                    }
                    // Search: its first tracks (Show all lists them all), then artists, albums and playlists
                    if root.page-kind == "search": ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 22px;
                            if root.rows.length > 0: VerticalLayout {
                                spacing: 6px;
                                HorizontalLayout {
                                    Text { text: "Tracks"; color: Theme.text; font-size: 20px; font-weight: 800; horizontal-stretch: 1; vertical-alignment: center; }
                                    if root.rows.length > 8: Pill { label: "Show all"; clicked => { root.page-kind = "tracks"; } }
                                }
                                for r[i] in root.rows: VerticalLayout {
                                    if i < 8: TrackRow { item: r; index: i; compact: root.narrow || root.queue-open; lists: root.own-lists; removable: false; show-genres: true; genre(g) => { root.genre-search(g); } play => { root.play-row(i); } act(a) => { root.row-action(i, a); } pick(m) => { root.row-pick(i, m); } }
                                }
                            }
                            for sh[s] in root.shelves: VerticalLayout {
                                spacing: 10px;
                                Text { text: sh.title; color: Theme.text; font-size: 20px; font-weight: 800; }
                                Flickable {
                                    height: 230px;
                                    content-width: sh.tiles.length * 186px;
                                    HorizontalLayout {
                                        spacing: 16px;
                                        alignment: start;
                                        for t[k] in sh.tiles: TileView { tile: t; clicked => { root.tile(s, k); } act(a) => { root.tile-act(s, k, a); } }
                                    }
                                }
                            }
                            Rectangle { height: 76px; }
                        }
                    }
                    // Discover: shelves
                    if root.page-kind == "discover": ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 22px;
                            HorizontalLayout {
                                alignment: start;
                                spacing: 8px;
                                Chip { label: "I'm Feeling Lucky"; on: true; clicked => { root.lucky(); } }
                                Chip { label: root.taste-label; clicked => { root.taste-pick(); } }
                                Chip { label: root.lang-label; clicked => { root.lang-next(); } }
                            }
                            // no likes or favourites yet: asked for some, for better recommendations
                            if root.likes-prompt: Rectangle {
                                height: 76px;
                                border-radius: 12px;
                                background: Theme.accent.with-alpha(0.10);
                                border-width: 1px;
                                border-color: Theme.accent.with-alpha(0.30);
                                HorizontalLayout {
                                    padding: 14px;
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;
                                        Text { text: "Get better recommendations"; color: Theme.text; font-weight: 700; }
                                        Text { text: "Add some music to your likes or favourites (the heart or the star on any song), and Discover and Rediscover will be built around it."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                    }
                                    Pill { label: "Pick genres"; y: (parent.height - self.height) / 2; clicked => { root.taste-pick(); } }
                                    Pill { label: "Find music"; y: (parent.height - self.height) / 2; clicked => { ti.focus(); } }
                                }
                            }
                            for sh[s] in root.shelves: VerticalLayout {
                                spacing: 10px;
                                Text { text: sh.title; color: Theme.text; font-size: 20px; font-weight: 800; }
                                Flickable {
                                    height: 230px;
                                    content-width: sh.tiles.length * 186px;
                                    HorizontalLayout {
                                        spacing: 16px;
                                        alignment: start;
                                        for t[k] in sh.tiles: TileView { tile: t; clicked => { root.tile(s, k); } act(a) => { root.tile-act(s, k, a); } }
                                    }
                                }
                            }
                        }
                    }
                    // Stats, Wrapped-style
                    if root.page-kind == "stats": ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start;
                            spacing: 14px;
                            padding-right: 14px;
                            // a closer look at one card
                            if root.st-detail != "": VerticalLayout {
                                alignment: start;
                                spacing: 14px;
                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 10px;
                                    Pill { label: "\u{2039} Your Listening"; clicked => { root.stats-open(""); } }
                                    if root.st-detail == "songs": Pill { label: "Play These"; on: true; clicked => { root.stats-play-these(); } }
                                }
                                Text { text: root.st-detail-head; color: Theme.text; font-size: 28px; font-weight: 800; wrap: word-wrap; }
                                for b in root.st-blocks: Card {
                                    VerticalLayout {
                                        alignment: start;
                                        padding: 20px;
                                        spacing: 8px;
                                        if b.kicker != "": Text { text: b.kicker; color: Theme.muted; font-size: 12px; font-weight: 800; letter-spacing: 1.5px; }
                                        if b.kind == "big": Text { text: b.big; color: Theme.text; font-size: 30px; font-weight: 800; wrap: word-wrap; }
                                        if b.kind == "big" || b.kind == "text": Text { text: b.sub; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                                        if b.kind == "bars": HorizontalLayout {
                                            height: 150px;
                                            spacing: 3px;
                                            for x in b.bars: VerticalLayout {
                                                spacing: 4px;
                                                Rectangle {
                                                    vertical-stretch: 1;
                                                    VerticalLayout {
                                                        alignment: end;
                                                        Rectangle { height: max(3px, (150px - 22px) * x.v); border-radius: 2px; background: x.v >= 0.999 ? Theme.accent : #8e9bff66; }
                                                    }
                                                    TouchArea { }
                                                }
                                                Text { text: x.label; color: Theme.muted; font-size: 10px; horizontal-alignment: center; height: 14px; }
                                            }
                                        }
                                        if b.kind == "rows": VerticalLayout {
                                            spacing: 6px;
                                            for r[k] in b.rows: Rectangle {
                                                height: 52px;
                                                border-radius: 8px;
                                                background: rta.has-hover ? Theme.elevated : transparent;
                                                HorizontalLayout {
                                                    padding-left: 6px;
                                                    padding-right: 6px;
                                                    spacing: 12px;
                                                    Text { text: r.rank; width: 28px; color: Theme.accent; font-size: 18px; font-weight: 800; vertical-alignment: center; }
                                                    Cover { art: r.art; initial: r.name; width: 42px; height: 42px; y: (parent.height - self.height) / 2; }
                                                    VerticalLayout {
                                                        alignment: center;
                                                        horizontal-stretch: 1;
                                                        Marquee { text: r.name; font-size: 14px; }
                                                        Text { text: r.sub; color: Theme.muted; font-size: 12px; }
                                                    }
                                                    Rectangle {
                                                        width: 120px;
                                                        height: 6px;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: 3px;
                                                        background: Theme.text.with-alpha(0.1);
                                                        Rectangle { x: 0; width: parent.width * r.share; height: 100%; border-radius: 3px; background: Theme.accent; }
                                                    }
                                                }
                                                rta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.stats-row(k); } }
                                            }
                                        }
                                        // (twelve weeks: a column a week, a square a day, Sunday at the top)
                                        if b.kind == "cal": HorizontalLayout {
                                            alignment: start;
                                            spacing: 4px;
                                            for w in (b.cells.length + 6) / 7: VerticalLayout {
                                                spacing: 4px;
                                                for d in 7: Rectangle {
                                                    property <int> at: w * 7 + d;
                                                    property <int> n: self.at < b.cells.length ? b.cells[self.at] : -1;
                                                    width: 16px;
                                                    height: 16px;
                                                    border-radius: 3px;
                                                    background: self.n < 0 ? transparent : self.n == 0 ? Theme.text.with-alpha(0.08) : self.n == 1 ? #8e9bff55 : self.n == 2 ? #8e9bffaa : Theme.accent;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if root.st-detail == "": Card {
                                height: 150px;
                                fill: @linear-gradient(135deg, Theme.accent 0%, Theme.accent-2 100%);
                                border-width: 0px;
                                VerticalLayout {
                                    padding: 20px;
                                    alignment: center;
                                    Text { text: "YOU LISTENED FOR"; color: Theme.on-accent; font-size: 12px; font-weight: 800; letter-spacing: 1.5px; }
                                    Text { text: root.st-big; color: Theme.on-accent; font-size: 56px; font-weight: 800; }
                                    Text { text: root.st-sub; color: Theme.on-accent; font-size: 13px; }
                                }
                                TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.stats-open("time"); } }
                            }
                            if !root.st-empty && root.st-detail == "": VerticalLayout {
                                alignment: start;
                                spacing: 14px;
                                HorizontalLayout {
                                    spacing: 14px;
                                    Card {
                                        height: 150px;
                                        fill: @radial-gradient(circle, #4b52b8 0%, #171a2e 100%);
                                        border-width: 0px;
                                        HorizontalLayout {
                                            padding: 20px;
                                            spacing: 16px;
                                            Cover { art: root.st-top-art; initial: root.st-top-name; width: 100px; height: 100px; border-radius: 50px; y: (parent.height - self.height) / 2; }
                                            VerticalLayout {
                                                alignment: center;
                                                Text { text: "YOUR TOP ARTIST"; color: #ffffffcc; font-size: 12px; font-weight: 800; letter-spacing: 1.5px; }
                                                Text { text: root.st-top-name; color: white; font-size: 26px; font-weight: 800; overflow: elide; }
                                                Text { text: root.st-top-sub; color: #ffffffcc; font-size: 13px; }
                                            }
                                        }
                                        TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.stats-open("artists"); } }
                                    }
                                    Card {
                                        height: 150px;
                                        width: 330px;
                                        VerticalLayout {
                                            alignment: start;
                                            padding: 20px;
                                            spacing: 4px;
                                            Text { text: "YOU'RE A"; color: Theme.muted; font-size: 12px; font-weight: 800; letter-spacing: 1.5px; }
                                            Text { text: root.st-kind; color: Theme.text; font-size: 24px; font-weight: 800; }
                                            Text { text: root.st-kind-sub; color: Theme.muted; font-size: 12px; overflow: elide; }
                                            HorizontalLayout {
                                                spacing: 3px;
                                                height: 40px;
                                                for v in root.st-clock: Rectangle {
                                                    VerticalLayout {
                                                        alignment: end;
                                                        Rectangle { height: max(3px, 40px * v); border-radius: 2px; background: v >= 0.999 ? Theme.accent : #8e9bff66; }
                                                    }
                                                }
                                            }
                                        }
                                        TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.stats-open("when"); } }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 14px;
                                    Card {
                                        VerticalLayout {
                                            alignment: start;
                                            padding: 20px;
                                            spacing: 10px;
                                            Text { text: "YOUR TOP SONGS  \u{203a}"; color: sth.has-hover ? Theme.text : Theme.muted; font-size: 12px; font-weight: 800; letter-spacing: 1.5px; sth := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.stats-open("songs"); } } }
                                            for it[i] in root.st-songs: HorizontalLayout {
                                                spacing: 12px;
                                                height: 48px;
                                                Text { text: i + 1; width: 22px; color: Theme.accent; font-size: 22px; font-weight: 800; vertical-alignment: center; }
                                                Cover { art: it.art; initial: it.name; width: 48px; height: 48px; }
                                                VerticalLayout {
                                                    alignment: center;
                                                    Text { text: it.name; color: Theme.text; font-weight: 700; overflow: elide; }
                                                    Text { text: it.sub; color: Theme.muted; font-size: 12px; overflow: elide; }
                                                }
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: start;
                                        spacing: 14px;
                                        Card {
                                            height: 110px;
                                            VerticalLayout {
                                                alignment: start;
                                                padding: 20px;
                                                Text { text: "STREAK"; color: Theme.muted; font-size: 12px; font-weight: 800; letter-spacing: 1.5px; }
                                                Text { text: root.st-streak; color: Theme.text; font-size: 34px; font-weight: 800; }
                                                Text { text: root.st-streak-sub; color: Theme.muted; font-size: 12px; }
                                            }
                                            TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.stats-open("streak"); } }
                                        }
                                        Card {
                                            VerticalLayout {
                                                alignment: start;
                                                padding: 20px;
                                                spacing: 8px;
                                                Text { text: "WHERE IT CAME FROM"; color: Theme.muted; font-size: 12px; font-weight: 800; letter-spacing: 1.5px; }
                                                for p in root.st-plats: HorizontalLayout {
                                                    alignment: start;
                                                    spacing: 8px;
                                                    PlatIcon { plat: p.plat; width: 16px; height: 16px; }
                                                    Text { text: p.name; color: Theme.text; font-size: 13px; }
                                                    Text { text: p.sub; color: Theme.muted; font-size: 13px; }
                                                }
                                            }
                                            TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.stats-open("where"); } }
                                        }
                                    }
                                }
                                Card {
                                    VerticalLayout {
                                        alignment: start;
                                        padding: 20px;
                                        spacing: 10px;
                                        Text { text: "YOUR TOP ARTISTS"; color: Theme.muted; font-size: 12px; font-weight: 800; letter-spacing: 1.5px; }
                                        HorizontalLayout {
                                            spacing: 16px;
                                            alignment: start;
                                            for a in root.st-artists: VerticalLayout {
                                                alignment: start;
                                                width: 96px;
                                                spacing: 6px;
                                                Cover { art: a.art; initial: a.name; width: 80px; height: 80px; border-radius: 40px; }
                                                Text { text: a.name; color: Theme.text; font-weight: 700; font-size: 12px; overflow: elide; horizontal-alignment: center; }
                                                Text { text: a.sub; color: Theme.muted; font-size: 11px; horizontal-alignment: center; }
                                            }
                                        }
                                    }
                                }
                                for f[i] in root.st-facts: Card {
                                    fill: #8e9bff1a;
                                    VerticalLayout {
                                        padding: 18px;
                                        spacing: 6px;
                                        if i < root.st-fact-heads.length && root.st-fact-heads[i] != "": Text { text: root.st-fact-heads[i]; color: Theme.muted; font-size: 12px; font-weight: 800; letter-spacing: 1.5px; }
                                        Text { text: f; color: Theme.text; font-size: 15px; wrap: word-wrap; }
                                    }
                                }
                                // Clear Listening History (a second click within a few seconds does it: it can't be undone)
                                HorizontalLayout {
                                    alignment: start;
                                    Pill { label: root.st-clear-asking ? "Clear it all? Click again" : "Clear Listening History"; on: root.st-clear-asking; clicked => { root.stats-clear(); } }
                                }
                            }
                        }
                    }
                    // Settings
                    if root.page-kind == "settings": ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start;
                            spacing: 14px;
                            padding-right: 14px;
                            if root.set-query != "": VerticalLayout {
                                spacing: 8px;
                                if root.set-hits.length == 0: Text { text: "No settings match \u{201c}" + root.set-query + "\u{201d}."; color: Theme.muted; font-size: 14px; }
                                for h[i] in root.set-hits: Card {
                                    HorizontalLayout {
                                        padding: 16px;
                                        padding-top: 12px;
                                        padding-bottom: 12px;
                                        spacing: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: h.path; color: Theme.muted; font-size: 11px; }
                                            Text { text: h.label; color: Theme.text; font-weight: 700; }
                                            if h.note != "": Text { text: h.note; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                        }
                                        if h.toggle: Toggle { checked: h.on; y: (parent.height - self.height) / 2; toggled => { root.set-toggle(h.key); } }
                                        if !h.toggle: Text { text: "\u{203a}"; color: Theme.muted; font-size: 22px; vertical-alignment: center; }
                                    }
                                    TouchArea { width: h.toggle ? parent.width - 80px : parent.width; x: 0; mouse-cursor: MouseCursor.pointer; clicked => { root.set-hit(i); } }
                                }
                            }
                            if root.set-cat == "" && root.set-query == "": VerticalLayout {
                                spacing: 8px;
                                // (Updates: pinned at the top)
                                Card {
                                    HorizontalLayout {
                                        padding: 16px;
                                        padding-top: 12px;
                                        padding-bottom: 12px;
                                        spacing: 10px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: "Updates"; color: Theme.text; font-weight: 700; }
                                            Text { text: root.update-note; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                        }
                                        Pill { label: root.update-label; on: root.update-label == "Update"; y: (parent.height - self.height) / 2; clicked => { root.update-act(); } }
                                    }
                                }
                                for c in [
                                    { name: "App & Look", note: "Theme, colours, player style, name, tray, taskbar widget, animations, backups", d: Icons.gear },
                                    { name: "Integrations", note: "Accounts, platforms, catalogues, following, Listen Along & Jams, Last.fm", d: Icons.person },
                                    { name: "Plugins", note: "Music sources made by others: switched on and off, their settings, adding and removing them", d: Icons.plugin },
                                    { name: "Library", note: "Pages, autoplay, recent plays, hidden and not recommended, music folders", d: Icons.library },
                                    { name: "Sound", note: "Loudness, fades, silences, equalizer, seamless mixing", d: Icons.volume },
                                    { name: "Streaming", note: "Streamer Mode, the widget and alerts, song requests, Stream Deck, OmniPulse Offset", d: Icons.broadcast },
                                ]: CatCard { name: c.name; note: c.note; d: c.d; clicked => { root.set-cat = c.name; } }
                            }
                            if root.set-cat == "App & Look" && root.set-query == "": VerticalLayout {
                                spacing: 14px;
                                Card {
                                    VerticalLayout {
                                        alignment: start;
                                        padding: 18px;
                                        spacing: 8px;
                                        HorizontalLayout {
                                            alignment: start;
                                            spacing: 8px;
                                            Text { text: "Theme"; color: Theme.text; font-weight: 700; }
                                            Text { text: root.theme-step-name; color: Theme.muted; font-weight: 600; }
                                        }
                                        // steps from light to dark: it stops at each, never in between
                                        Steps { names: ["Bright", "Soft", "Dim", "Dark", "Black"]; value: round(root.theme-step); changed(k) => { root.theme-step = k; root.look-changed("themeStep", k); } }
                                        Rectangle { height: 8px; }
                                        HorizontalLayout {
                                            alignment: start;
                                            spacing: 8px;
                                            Text { text: "Tint"; color: Theme.text; font-weight: 700; }
                                            Rectangle { width: 12px; height: 12px; y: 3px; border-radius: 6px; background: root.tint-preview; border-width: 1px; border-color: Theme.line; }
                                        }
                                        Text { text: "A colour through the whole theme. Accent and album art colours still show on top."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                        Rectangle {
                                            height: 8px;
                                            border-radius: 4px;
                                            opacity: root.tint-strength > 0.5 ? 1 : 0.35;
                                            background: @linear-gradient(90deg, #e04848 0%, #e0e048 17%, #48d848 33%, #48d8d8 50%, #6a72ec 67%, #d84ad6 83%, #e04848 100%);
                                        }
                                        Range { minimum: 0; maximum: 359; value: root.tint-hue; enabled: root.tint-strength > 0.5; changed(v) => { root.tint-hue = v; root.look-changed("tintHue", round(v)); } }
                                        Rectangle { height: 8px; }
                                        HorizontalLayout {
                                            alignment: start;
                                            spacing: 8px;
                                            Text { text: "Tint Strength"; color: Theme.text; font-weight: 700; }
                                            Text { text: root.tint-strength-name; color: Theme.muted; font-weight: 600; }
                                        }
                                        Steps { names: ["Off", "Subtle", "Medium", "Strong"]; value: round(root.tint-strength); changed(k) => { root.tint-strength = k; root.look-changed("tintStrength", k); } }
                                        Rectangle { height: 8px; }
                                        Text { text: "Accent"; color: Theme.text; font-weight: 700; }
                                        HorizontalLayout {
                                            alignment: start;
                                            spacing: 10px;
                                            for c[i] in root.accent-list: Rectangle {
                                                width: 28px;
                                                height: 28px;
                                                border-radius: 14px;
                                                background: c;
                                                border-width: root.accent-on == i ? 3px : 0px;
                                                border-color: Theme.text;
                                                TouchArea { clicked => { root.accent-picked(i); } }
                                            }
                                        }
                                        Rectangle { height: 8px; }
                                        HorizontalLayout {
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                Text { text: "Colours from Album Art"; color: Theme.text; font-weight: 700; }
                                                Text { text: "Both colours come from the cover that's playing."; color: Theme.muted; font-size: 12px; }
                                            }
                                            Toggle { checked <=> root.art-accent; y: (parent.height - self.height) / 2; toggled => { root.art-accent-changed(self.checked); } }
                                        }
                                        Rectangle { height: 8px; }
                                        Text { text: "Player Style"; color: Theme.text; font-weight: 700; }
                                        Text {
                                            text: root.player-style == "bar" ? "Everything on one full-width bar: what's playing on the left, the controls in the middle. Needs the window at least 1000 px wide."
                                                : root.player-style == "float" ? "One bar too, floating above the bottom of the window with rounded ends. Needs the window at least 1040 px wide."
                                                : root.player-style == "minimal" ? "A slim row in the panel colour, with the progress as a thin line along its top. Needs the window at least 1000 px wide."
                                                : "What's playing on a tab above the controls, as wide as it needs.";
                                            color: Theme.muted; font-size: 12px; wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            alignment: start;
                                            spacing: 8px;
                                            for k[i] in ["tab", "bar", "float", "minimal"]: Chip { label: ["Tab", "Classic Bar", "Floating", "Minimal"][i]; on: root.player-style == k; clicked => { root.player-style-picked(k); } }
                                        }
                                        if root.tab-style: Rectangle { height: 8px; }
                                        if root.tab-style: HorizontalLayout {
                                            spacing: 8px;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                Text { text: "Track Info Tab"; color: Theme.text; font-weight: 700; }
                                                Text { text: "Which end of the player bar the tab sits at."; color: Theme.muted; font-size: 12px; }
                                            }
                                            Chip { label: "Left"; on: !root.tab-right; y: (parent.height - self.height) / 2; clicked => { root.tab-align-picked("left"); } }
                                            Chip { label: "Right"; on: root.tab-right; y: (parent.height - self.height) / 2; clicked => { root.tab-align-picked("right"); } }
                                        }
                                    }
                                }
                                Card {
                                    HorizontalLayout {
                                        padding: 16px;
                                        padding-top: 12px;
                                        padding-bottom: 12px;
                                        spacing: 8px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: "List Density"; color: Theme.text; font-weight: 700; }
                                            Text { text: "How tightly tracks are listed. Compact fits more on screen."; color: Theme.muted; font-size: 12px; }
                                        }
                                        Chip { label: "Comfortable"; on: !root.compact-rows; y: (parent.height - self.height) / 2; clicked => { root.compact-rows = false; root.density-changed(false); } }
                                        Chip { label: "Compact"; on: root.compact-rows; y: (parent.height - self.height) / 2; clicked => { root.compact-rows = true; root.density-changed(true); } }
                                    }
                                }
                                Card {
                                    HorizontalLayout {
                                        padding: 16px;
                                        padding-top: 12px;
                                        padding-bottom: 12px;
                                        spacing: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: "Display Name"; color: Theme.text; font-weight: 700; }
                                            Text { text: "Shown in the title bar and taskbar."; color: Theme.muted; font-size: 12px; }
                                        }
                                        Rectangle {
                                            width: 220px;
                                            height: 34px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 8px;
                                            background: Theme.panel;
                                            border-width: 1px;
                                            border-color: Theme.line;
                                            if root.app-name == "": Text { x: 10px; text: "OmniPulse"; color: Theme.muted; font-size: 14px; vertical-alignment: center; height: parent.height; }
                                            TextInput { x: 10px; width: parent.width - 20px; height: parent.height; vertical-alignment: center; color: Theme.text; font-size: 14px; single-line: true; text <=> root.app-name; edited => { root.app-name-changed(self.text); } }
                                        }
                                    }
                                }
                                Card {
                                    HorizontalLayout {
                                        padding: 16px;
                                        padding-top: 12px;
                                        padding-bottom: 12px;
                                        spacing: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: "Listening Along: Timing"; color: Theme.text; font-weight: 700; }
                                            Text { text: "Plays this much later than the host (or earlier, below 0), to line up with their stream when you're hearing it too (a Discord screen share runs behind, often by a second or two)."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                        }
                                        Rectangle {
                                            width: 90px;
                                            height: 34px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 8px;
                                            background: Theme.panel;
                                            border-width: 1px;
                                            border-color: Theme.line;
                                            TextInput { x: 10px; width: parent.width - 20px; height: parent.height; vertical-alignment: center; color: Theme.text; font-size: 14px; single-line: true; input-type: InputType.decimal; text <=> root.listen-nudge; edited => { root.listen-nudge-changed(self.text); } }
                                        }
                                        Text { text: "ms"; color: Theme.muted; font-size: 13px; vertical-alignment: center; }
                                    }
                                }
                                Card {
                                    HorizontalLayout {
                                        padding: 16px;
                                        padding-top: 12px;
                                        padding-bottom: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: "Close to Tray"; color: Theme.text; font-weight: 700; }
                                            Text { text: "Closing hides the window; music keeps playing. Quit from the tray."; color: Theme.muted; font-size: 12px; }
                                        }
                                        Toggle { checked <=> root.close-to-tray; y: (parent.height - self.height) / 2; toggled => { root.close-to-tray-changed(self.checked); } }
                                    }
                                }
                                Card {
                                    HorizontalLayout {
                                        padding: 16px;
                                        padding-top: 12px;
                                        padding-bottom: 12px;
                                        spacing: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: "Taskbar Widget"; color: Theme.text; font-weight: 700; }
                                            Text { text: "What's playing, always on show in the taskbar by the clock, with its controls. Hidden while a game or video is full screen, or the taskbar is hidden."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                        }
                                        Toggle { checked <=> root.taskbar-widget; y: (parent.height - self.height) / 2; toggled => { root.app-pref("taskbarWidget", self.checked); } }
                                    }
                                }
                                Card {
                                    HorizontalLayout {
                                        padding: 16px;
                                        padding-top: 12px;
                                        padding-bottom: 12px;
                                        spacing: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: "Hardware Acceleration"; color: Theme.text; font-weight: 700; }
                                            Text { text: "Draws the app with your graphics card: smoother on big screens, about 100 MB more memory. Turn off if you see glitches. Takes effect the next time OmniPulse starts."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                        }
                                        Toggle { checked <=> root.gpu-on; y: (parent.height - self.height) / 2; toggled => { root.app-pref("nativeGpu", self.checked); } }
                                    }
                                }
                                Card {
                                    HorizontalLayout {
                                        padding: 16px;
                                        padding-top: 12px;
                                        padding-bottom: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: "Animations"; color: Theme.text; font-weight: 700; }
                                            Text { text: "Fades and motion."; color: Theme.muted; font-size: 12px; }
                                        }
                                        Toggle { checked <=> root.anim-on; y: (parent.height - self.height) / 2; toggled => { root.anim-changed(self.checked); } }
                                    }
                                }
                                Card {
                                    HorizontalLayout {
                                        padding: 16px;
                                        padding-top: 12px;
                                        padding-bottom: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: "Rounded Corners"; color: Theme.text; font-weight: 700; }
                                            Text { text: "On the sidebar, the page and the queue. Off: square."; color: Theme.muted; font-size: 12px; }
                                        }
                                        Toggle { checked <=> root.rounded; y: (parent.height - self.height) / 2; toggled => { root.rounded-changed(self.checked); } }
                                    }
                                }
                                Card {
                                    HorizontalLayout {
                                        padding: 16px;
                                        padding-top: 12px;
                                        padding-bottom: 12px;
                                        spacing: 10px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: "Back Up & Restore"; color: Theme.text; font-weight: 700; }
                                            Text { text: "Your settings, keys, favourites, playlists, stats and alerts, in one .zip. Sign-ins aren't in it."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                        }
                                        Pill { label: "Back up"; y: (parent.height - self.height) / 2; clicked => { root.backup-make(); } }
                                        Pill { label: "Restore"; y: (parent.height - self.height) / 2; clicked => { root.backup-restore(); } }
                                    }
                                }
                            }
                            if root.set-cat == "Integrations" && root.set-query == "": VerticalLayout {
                                spacing: 14px;
                                Card {
                                    HorizontalLayout {
                                        padding: 16px;
                                        padding-top: 12px;
                                        padding-bottom: 12px;
                                        spacing: 10px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: "YouTube Music's Helpers"; color: Theme.text; font-weight: 700; }
                                            Text { text: root.helpers-note; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                        }
                                        if root.helpers-setup != "": Pill { label: root.helpers-setup; on: true; y: (parent.height - self.height) / 2; clicked => { root.helpers-act("setup"); } }
                                        if root.helpers-remove: Pill { label: "Remove"; y: (parent.height - self.height) / 2; clicked => { root.helpers-act("remove"); } }
                                    }
                                }
                                Card {
                                    VerticalLayout {
                                        padding: 16px;
                                        padding-top: 8px;
                                        padding-bottom: 8px;
                                        for acc[i] in root.accounts: VerticalLayout {
                                            if i > 0: Rectangle { height: 1px; background: Theme.line; }
                                            HorizontalLayout {
                                                padding-top: 8px;
                                                padding-bottom: 8px;
                                                spacing: 12px;
                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    alignment: center;
                                                    spacing: 2px;
                                                    Text { text: acc.name; color: Theme.text; font-weight: 700; }
                                                    Text { text: acc.status; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                                }
                                                // (the platform's plans: Go+, Premium, Pro...)
                                                if acc.manage != "": Pill {
                                                    label: "Manage subscription";
                                                    y: (parent.height - self.height) / 2;
                                                    clicked => { root.open-web(acc.manage); }
                                                }
                                                if acc.keys != "": Pill {
                                                    label: acc.keys;
                                                    y: (parent.height - self.height) / 2;
                                                    clicked => { root.account-keys(i); }
                                                }
                                                Pill {
                                                    label: acc.busy ? "Waiting..." : acc.signed ? "Sign out" : "Sign in";
                                                    on: !acc.signed && !acc.busy;
                                                    y: (parent.height - self.height) / 2;
                                                    clicked => { if (!acc.busy) { root.account-act(i); } }
                                                }
                                                // (its platform, switched on or off here too: SoundCloud, Spotify, YouTube Music,
                                                // Last.fm's scrobbling)
                                                if acc.switch != "": Toggle { checked: acc.on; y: (parent.height - self.height) / 2; toggled => { root.set-toggle(acc.switch); } }
                                            }
                                        }
                                    }
                                }
                                // Apple Music: an import, once (read only)
                                Card {
                                    HorizontalLayout {
                                        padding: 16px;
                                        padding-top: 12px;
                                        padding-bottom: 12px;
                                        spacing: 10px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: "Apple Music"; color: Theme.text; font-weight: 700; }
                                            Text { text: root.apple-note; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                        }
                                        Pill { label: root.apple-label; y: (parent.height - self.height) / 2; clicked => { root.apple-import(); } }
                                    }
                                }
                                // YouTube Music's helpers (yt-dlp and Deno): how they are, set up, or taken off
                                for r[i] in root.set-rows-integrations: SetRowView { r: r; toggle(k) => { root.set-toggle(k); } more(k) => { root.set-more(k); } }
                            }
                            if root.set-cat == "Plugins" && root.set-query == "": VerticalLayout {
                                spacing: 14px;
                                for r[i] in root.set-rows-plugins: SetRowView { r: r; toggle(k) => { root.set-toggle(k); } more(k) => { root.set-more(k); } }
                            }
                            if root.set-cat == "Library" && root.set-query == "": VerticalLayout {
                                spacing: 14px;
                                Card {
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 10px;
                                        Text { text: "Music Folders"; color: Theme.text; font-weight: 700; }
                                        Text { text: root.folders-note; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                        for f[i] in root.folders: HorizontalLayout {
                                            spacing: 10px;
                                            Glyph { d: Icons.local; width: 16px; height: 16px; y: (parent.height - self.height) / 2; fill: Theme.muted; }
                                            Text { text: f; color: Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                            Pill { label: "Remove"; clicked => { root.folder-remove(i); } }
                                        }
                                        HorizontalLayout {
                                            alignment: start;
                                            spacing: 8px;
                                            Pill { label: "Add folder"; clicked => { root.folder-add(); } }
                                            if root.folders.length > 0: Pill { label: "Rescan"; clicked => { root.folders-rescan(); } }
                                        }
                                    }
                                }
                                for r[i] in root.set-rows-library: SetRowView { r: r; toggle(k) => { root.set-toggle(k); } more(k) => { root.set-more(k); } }
                            }
                            if root.set-cat == "Sound" && root.set-query == "": VerticalLayout {
                                spacing: 14px;
                                Card {
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 12px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                Text { text: "Match Loudness"; color: Theme.text; font-weight: 700; }
                                                Text { text: root.loud-on == "off" ? "Tracks play as loud as they were made." : "Every track at the same loudness."; color: Theme.muted; font-size: 12px; }
                                            }
                                            for k[i] in ["off", "quiet", "normal", "loud"]: Chip {
                                                label: ["Off", "Quiet", "Normal", "Loud"][i];
                                                on: root.loud-on == k;
                                                y: (parent.height - self.height) / 2;
                                                clicked => { root.loud-pick(k); }
                                            }
                                        }
                                        Rectangle { height: 1px; background: Theme.line; }
                                        HorizontalLayout {
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                Text { text: "Fade Between Tracks"; color: Theme.text; font-weight: 700; }
                                                Text { text: "Each track fades out where its sound ends, and the next fades in."; color: Theme.muted; font-size: 12px; }
                                            }
                                            Toggle { checked <=> root.fade-on; y: (parent.height - self.height) / 2; toggled => { root.fade-on-changed(self.checked); } }
                                        }
                                        if root.fade-on: HorizontalLayout {
                                            alignment: start;
                                            spacing: 8px;
                                            Text { text: "Fade Length"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                            for ms in [1000, 2000, 3000, 5000, 8000]: Chip { label: (ms / 1000) + " s"; on: root.fade-ms == ms; clicked => { root.fade-ms-pick(ms); } }
                                        }
                                        Rectangle { height: 1px; background: Theme.line; }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                Text { text: "Skip Silences"; color: Theme.text; font-weight: 700; }
                                                Text { text: "Jumps over long silences, and moves on when the rest is silent."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                            }
                                            for s in [0, 5, 8, 15, 30]: Chip { label: s == 0 ? "Off" : s + " s"; on: root.skip-silence == s; y: (parent.height - self.height) / 2; clicked => { root.skip-pick(s); } }
                                        }
                                        Rectangle { height: 1px; background: Theme.line; }
                                        HorizontalLayout {
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                Text { text: "Equalizer"; color: Theme.text; font-weight: 700; }
                                                Text { text: "Ten bands."; color: Theme.muted; font-size: 12px; }
                                            }
                                            Toggle { checked <=> root.eq-on; y: (parent.height - self.height) / 2; toggled => { root.eq-on-changed(self.checked); } }
                                        }
                                        if root.eq-on: HorizontalLayout {
                                            alignment: start;
                                            spacing: 8px;
                                            for p[i] in root.eq-presets: Chip { label: p; clicked => { root.eq-preset(i); } }
                                        }
                                        // (the bands from 0 to 24, as the slider doesn't go below zero: 12 is flat)
                                        if root.eq-on: VerticalLayout {
                                            spacing: 6px;
                                            for g[i] in root.eq-gains: HorizontalLayout {
                                                spacing: 12px;
                                                Text { text: ["31 Hz", "62 Hz", "125 Hz", "250 Hz", "500 Hz", "1 kHz", "2 kHz", "4 kHz", "8 kHz", "16 kHz"][i]; width: 56px; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                                Range { minimum: 0; maximum: 24; value: g + 12; changed(v) => { root.eq-band(i, round(v) - 12); } }
                                                Text { text: (g > 0 ? "+" : "") + round(g) + " dB"; width: 52px; color: Theme.text; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                                            }
                                        }
                                    }
                                }
                                // (Seamless Mix and its band handoff)
                                for r[i] in root.set-rows-sound: SetRowView { r: r; toggle(k) => { root.set-toggle(k); } more(k) => { root.set-more(k); } }
                                if root.mix-audit != "": Card {
                                    VerticalLayout {
                                        padding: 16px;
                                        padding-top: 12px;
                                        padding-bottom: 12px;
                                        spacing: 2px;
                                        Text { text: "Seamless Mix: What It Costs"; color: Theme.text; font-weight: 700; }
                                        Text { text: root.mix-audit; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                    }
                                }
                            }
                            if root.set-cat == "Streaming" && root.set-query == "": VerticalLayout {
                                spacing: 14px;
                                for r[i] in root.set-rows-streaming: SetRowView { r: r; toggle(k) => { root.set-toggle(k); } more(k) => { root.set-more(k); } }
                            }
                            Rectangle { height: 96px; }
                        }
                    }
                    // Now Playing: the cover, and the lyrics as they're sung
                    if root.page-kind == "now": npl := HorizontalLayout {
                        vertical-stretch: 1;
                        // (the page's room, from the window: the sidebar's and the queue's taken off. Short of
                        // it, the middle gives way: a narrower column, its buttons one above another, and the
                        // cover above the lyrics instead)
                        property <length> room: root.width - (root.narrow ? 68px : 230px) - (root.queue-open ? 300px : 0px) - 60px;
                        property <bool> slim: room < 780px;
                        spacing: slim ? 18px : 30px;
                        padding-top: 10px;
                        VerticalLayout {
                            width: npl.slim ? max(150px, min(220px, npl.room * 0.36)) : 360px;
                            spacing: 10px;
                            // (smaller on a short window: its title, artist and buttons stay in sight)
                            property <length> side: min(360px, max(180px, root.height - 470px));
                            if !npl.slim: BadgedCover { art: root.now-art-big; initial: root.now-title; plat: root.now-plat; badge: 52px; corner: 14px; height: parent.side; width: parent.side; }
                            Text { text: root.now-title; color: Theme.text; font-size: npl.slim ? 20px : 26px; font-weight: 800; wrap: word-wrap; }
                            // (the artist: their page, a click away, as the web app's)
                            Text { text: root.now-artist; color: nat.has-hover ? Theme.text : Theme.accent; font-size: 16px; font-weight: 600; wrap: word-wrap; nat := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.now-act("artist:0"); } } }
                            if root.now-uploader != "": Text { text: "uploaded by " + root.now-uploader; color: Theme.muted; font-size: 13px; }
                            Text { text: root.now-album; color: Theme.muted; font-size: 13px; }
                            if root.now-rhythm != "": Text { text: root.now-rhythm; color: Theme.muted; font-size: 12px; }
                            // Like, Add to Favourites, Open on its platform
                            if root.now-title != "" && !npl.slim: HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                if root.can-like: Pill { label: root.now-liked ? "Liked" : "Like"; on: root.now-liked; clicked => { root.like-toggle(); } }
                                Pill { label: root.now-fav ? "In Favourites" : "Add to Favourites"; on: root.now-fav; clicked => { root.fav-toggle(); } }
                                if root.now-open != "": Pill { label: root.now-open; clicked => { root.now-act("open"); } }
                            }
                            if root.now-title != "" && npl.slim: VerticalLayout {
                                spacing: 8px;
                                alignment: start;
                                if root.can-like: HorizontalLayout { alignment: start; Pill { label: root.now-liked ? "Liked" : "Like"; on: root.now-liked; clicked => { root.like-toggle(); } } }
                                HorizontalLayout { alignment: start; Pill { label: root.now-fav ? "In Favourites" : "Add to Favourites"; on: root.now-fav; clicked => { root.fav-toggle(); } } }
                                if root.now-open != "": HorizontalLayout { alignment: start; Pill { label: root.now-open; clicked => { root.now-act("open"); } } }
                            }

                            Rectangle { vertical-stretch: 1; }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            // (the cover, above the lyrics, when there's no room for it beside them)
                            if npl.slim: HorizontalLayout {
                                alignment: start;
                                property <length> side: min(220px, max(120px, root.height - 560px));
                                BadgedCover { art: root.now-art-big; initial: root.now-title; plat: root.now-plat; badge: 40px; corner: 12px; height: parent.side; width: parent.side; }
                            }
                            if npl.slim: Rectangle { height: 6px; }
                            // (a SoundCloud song's description, as its uploader wrote it, above its lyrics)
                            if root.now-desc != "": Text { text: root.now-desc; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                            if root.now-desc != "": Rectangle { height: 8px; }
                            if root.lyrics-note != "": Text { text: root.lyrics-note; color: Theme.muted; }
                            // where they're from, and the other places, a click each
                            if root.lyrics-from != "" || root.lyrics-others.length > 0: HorizontalLayout {
                                spacing: 10px;
                                Text { text: root.lyrics-from == "" ? "Other sources:" : root.lyrics-from + " Other sources:"; color: Theme.muted; font-size: 12px; overflow: elide; min-width: 0; horizontal-stretch: 0; }
                                for name[i] in root.lyrics-others: lt := TouchArea {
                                    width: lx.preferred-width;
                                    mouse-cursor: pointer;
                                    clicked => { root.lyrics-pick(i); }
                                    lx := Text { text: name; color: lt.has-hover ? Theme.text : Theme.accent; font-size: 12px; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            lv := ListView {
                                vertical-stretch: 1;
                                for l[i] in root.lyrics: Rectangle {
                                    height: 40px;
                                    Text {
                                        x: 0;
                                        text: l.text;
                                        color: i == root.lyric-on ? Theme.text : Theme.muted;
                                        opacity: i == root.lyric-on ? 1 : 0.65;
                                        font-size: i == root.lyric-on ? 21px : 19px;
                                        font-weight: 700;
                                        overflow: elide;
                                        animate color, opacity, font-size { duration: Theme.motion ? 400ms : 0ms; easing: ease-out; }
                                    }
                                }
                            }
                            property <int> on: root.lyric-on;
                            changed on => {
                                lv.content-y = min(0px, -(root.lyric-on * 40px) + lv.visible-height / 2 - 20px);
                            }
                        }
                    }
                }
                // a switch's or a plugin's settings: the page (and the queue's room) taken over, as a page of
                // its own, back to where you were
                if root.pf-open: Rectangle {
                    background: Theme.panel;
                    border-radius: Theme.panel-radius;
                    clip: true;
                    TouchArea { }
                    Rectangle {
                        y: 0;
                        height: 340px;
                        border-top-left-radius: Theme.panel-radius;
                        border-top-right-radius: Theme.panel-radius;
                        background: @linear-gradient(180deg, Theme.panel.mix(Theme.accent, 0.7) 0%, Theme.panel 100%);
                    }
                    pf-col := VerticalLayout {
                        padding: 24px;
                        padding-top: 14px;
                        padding-bottom: 16px;
                        spacing: 12px;
                        HorizontalLayout {
                            RoundButton { tip: "Back"; d: Icons.back; clicked => { root.pf-open = false; } }
                            Rectangle { horizontal-stretch: 1; }
                            RoundButton { tip: "Close Settings"; d: Icons.close; clicked => { root.settings-close(); } }
                        }
                        HorizontalLayout {
                            spacing: 14px;
                            for c[i] in root.pf-crumbs: HorizontalLayout {
                                spacing: 14px;
                                horizontal-stretch: 0;
                                Text {
                                    text: c;
                                    color: pct.has-hover ? Theme.text : Theme.muted;
                                    font-size: root.pf-crumbs.length >= 3 ? 28px : 44px;
                                    font-weight: 800;
                                    pct := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.crumb-go(i); } }
                                }
                                Text { text: "\u{203a}"; color: Theme.muted; font-size: 40px; font-weight: 400; vertical-alignment: center; }
                            }
                            Marquee { text: root.pf-head; font-size: root.pf-crumbs.length >= 3 ? 28px : 44px; font-weight: 800; horizontal-stretch: 1; y: (parent.height - self.height) / 2; }
                        }
                        ScrollView {
                          vertical-stretch: 1;
                          VerticalLayout {
                          spacing: 12px;
                          padding-right: 10px;
                          for f[i] in root.pf-fields: VerticalLayout {
                           spacing: 6px;
                           // instructions: just text
                           if f.kind == "note": Text { text: f.label; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                           // an address: shown, and copied
                           if f.kind == "info": VerticalLayout {
                            spacing: 4px;
                            Text { text: f.label; color: Theme.text; font-weight: 700; }
                            if f.note != "": Text { text: f.note; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                            HorizontalLayout {
                              spacing: 8px;
                              Rectangle {
                                horizontal-stretch: 1;
                                height: 34px;
                                border-radius: 8px;
                                background: Theme.panel;
                                border-width: 1px;
                                border-color: Theme.line;
                                Text { x: 10px; width: parent.width - 20px; text: f.value; color: Theme.text; font-size: 12px; overflow: elide; vertical-alignment: center; }
                              }
                              Pill { label: "Copy"; clicked => { root.pf-copy(i); } }
                            }
                           }
                           if f.kind != "note" && f.kind != "info": HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                Text { text: f.label; color: Theme.text; font-weight: 700; }
                                if f.note != "": Text { text: f.note; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                            }
                            if f.kind == "toggle": Toggle { checked: f.value == "true"; y: (parent.height - self.height) / 2; toggled => { root.pf-set(i, self.checked ? "true" : "false"); } }
                    // a list's row: its buttons, then its switch
                    if f.kind == "row": HorizontalLayout {
                        spacing: 6px;
                        for o[k] in f.options: Pill { label: o; y: (parent.height - self.height) / 2; clicked => { root.pf-set(i, "btn:" + k); } }
                    }
                    if f.kind == "row": Toggle { checked: f.value == "true"; y: (parent.height - self.height) / 2; toggled => { root.pf-set(i, self.checked ? "true" : "false"); } }
                            // a choice: each click moves on to the next of its options
                            if f.kind == "select": Pill { label: f.value; y: (parent.height - self.height) / 2; clicked => { root.pf-set(i, "\u{1}next"); } }
                            if f.kind == "text" || f.kind == "password" || f.kind == "number": Rectangle {
                                width: 180px;
                                height: 34px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 8px;
                                background: Theme.panel;
                                border-width: 1px;
                                border-color: Theme.line;
                                TextInput { x: 10px; width: parent.width - 20px; height: parent.height; vertical-alignment: center; color: Theme.text; font-size: 14px; single-line: true; input-type: f.kind == "password" ? InputType.password : f.kind == "number" ? InputType.decimal : InputType.text; text: f.value; edited => { root.pf-set(i, self.text); } }
                            }
                            // a button: done at once
                            if f.kind == "button": Pill { label: f.value; y: (parent.height - self.height) / 2; clicked => { root.pf-set(i, "press"); } }
                           }
                          }
                          }
                        }
                        HorizontalLayout {
                            alignment: end;
                            spacing: 8px;
                            Pill { label: "Cancel"; clicked => { root.pf-open = false; } }
                            Pill { label: "Save"; on: true; clicked => { root.pf-save(); } }
                        }
                    }
                }
            }
            // ---------- the queue ----------
            // (not while Settings, or a settings page, has the room)
            if root.queue-open && !root.pf-open && root.page != "settings": Rectangle {
                width: 300px;
                background: Theme.panel;
                border-radius: Theme.panel-radius;
                border-width: qdz.has-drag ? 2px : 0px;
                border-color: Theme.accent;
                qdz := DropArea {
                    can-drop(e) => { return Dnd.accepts("queue", e.data) ? DragAction.copy : DragAction.none; }
                    dropped(e) => { Dnd.dropped("queue", e.data); return e.proposed-action; }
                }
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "Queue"; color: Theme.text; font-size: 18px; font-weight: 800; vertical-alignment: center; horizontal-stretch: 1; }
                        // (as the web app's: waiting chat requests out; everything but what's playing out)
                        if root.queue-requests > 0: Pill { label: "Clear requests"; y: (parent.height - self.height) / 2; clicked => { root.queue-clear(true); } }
                        if root.queue-room == "" || root.queue-room-host: Pill { label: "Clear"; y: (parent.height - self.height) / 2; clicked => { root.queue-clear(false); } }
                        Text { text: "Autoplay"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                        Toggle { checked <=> root.autoplay; y: (parent.height - self.height) / 2; toggled => { root.autoplay-changed(self.checked); } }
                    }
                    if root.queue-room != "": Rectangle {
                        height: 40px;
                        border-radius: 10px;
                        background: Theme.accent.with-alpha(0.14);
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 4px;
                            Text { text: root.queue-room; color: Theme.text; font-size: 13px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            Pill { label: root.queue-room-host ? "End Jam" : "Leave"; y: 1px; clicked => { if (root.queue-room-host) { root.jam-end(); } else { root.jam-clicked(); } } }
                        }
                    }
                    if root.autoplay-note != "": Text { text: root.autoplay-note; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                    if root.queue-rows.length == 0: Text { text: "Nothing queued. Play something, or right-click a track to add it."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                    ListView {
                        vertical-stretch: 1;
                        for q[i] in root.queue-rows: VerticalLayout {
                            if q.head != "": Text { text: q.head; color: Theme.muted; font-size: 11px; font-weight: 800; letter-spacing: 1px; height: 26px; vertical-alignment: bottom; }
                            Rectangle {
                                height: 48px;
                                border-radius: 6px;
                                background: qta.has-hover ? Theme.elevated : transparent;
                                border-width: qrdz.has-drag ? 2px : 0px;
                                border-color: Theme.accent;
                                qrdz := DropArea {
                                    can-drop(e) => { return Dnd.accepts("qrow:" + i, e.data) ? DragAction.move : DragAction.none; }
                                    dropped(e) => { Dnd.dropped("qrow:" + i, e.data); return e.proposed-action; }
                                }
                                HorizontalLayout {
                                    padding-left: 6px;
                                    spacing: 10px;
                                    PlatIcon { plat: q.plat; width: 16px; height: 16px; y: (parent.height - self.height) / 2; opacity: q.auto ? 0.7 : 1; }
                                    VerticalLayout {
                                        alignment: center;
                                        Text { text: q.title; color: q.playing ? Theme.accent : Theme.text; font-weight: 600; font-size: 13px; overflow: elide; }
                                        Text { text: q.artist; color: Theme.muted; font-size: 12px; overflow: elide; }
                                    }
                                }
                                Rectangle {
                                    DragArea {
                                        allow-move: true;
                                        allow-copy: true;
                                        data: Dnd.payload("q:" + i);
                                        qta := TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) { cm8.open(self.mouse-x, self.mouse-y); } } clicked => { root.play-queue(i); } }
                                    }
                                    // (on top: it only takes right-clicks, the rest goes through to what's under it)
                                    cm8 := CtxMenu {
                                        width: 100%; height: 100%;
                                        items: [
                                            { label: "Play", show: !q.playing },
                                            { label: "Play Next", show: !q.playing },
                                            { label: "Remove from Queue", show: !q.playing },
                                            { label: "Shuffle Next Up", show: true },
                                            { label: "Add to Playlist", show: true, sub: 1 },
                                            { sep: true, show: true },
                                            { label: q.liked ? "Remove from Likes" : "Add to Likes", show: q.can-like },
                                            { label: q.fav ? "Remove from Favourites" : "Add to Favourites", show: q.fav-on },
                                            { label: "Go to Artist", show: true },
                                            { label: "Don't Recommend This Track", show: true },
                                            { label: q.open-label, show: q.open-label != "" },
                                            { label: "Copy SoundCloud Link", show: q.sc-link },
                                            { label: "Copy Spotify Link", show: q.sp-link },
                                            { label: "Copy YouTube Music Link", show: q.yt-link },
                                            { label: "Track Preferences...", show: true }
                                        ];
                                        list1: root.own-lists;
                                        list1-more: ["New Playlist..."];
                                        picked(n, k) => {
                                            if (n == 0) { root.play-queue(i); }
                                            if (n == 1) { root.queue-action(i, "next"); }
                                            if (n == 2) { root.queue-action(i, "remove"); }
                                            if (n == 3) { root.queue-action(i, "shuffle"); }
                                            if (n == 4) { if (k < root.own-lists.length) { root.queue-action(i, "pl" + k); } else if (k == root.own-lists.length + 0) { root.queue-action(i, "plnew"); } }
                                            if (n == 6) { root.queue-action(i, "like"); }
                                            if (n == 7) { root.queue-action(i, "fav"); }
                                            if (n == 8) { root.queue-action(i, "artist:0"); }
                                            if (n == 9) { root.queue-action(i, "hide:track"); }
                                            if (n == 10) { root.queue-action(i, "open"); }
                                            if (n == 11) { root.queue-action(i, "link:soundcloud"); }
                                            if (n == 12) { root.queue-action(i, "link:spotify"); }
                                            if (n == 13) { root.queue-action(i, "link:youtube"); }
                                            if (n == 14) { root.queue-action(i, "prefs"); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---------- player bar ----------
        Rectangle {
            // (as the web app's: the track info on a tab only as wide as it needs, on top of the
            // body with the controls and the progress; the status strip, under the tab, adds its height)
            y: parent.height - self.height;
            height: parent.body-h + (root.tab-style ? 80px : 16px);
            VerticalLayout {
                // (Floating: in from the window's edges)
                x: root.player-style == "float" ? 14px : 8px;
                y: 8px;
                width: parent.width - (root.player-style == "float" ? 28px : 16px);
                height: parent.height - 16px;
                // the tab: what's playing (opens Now Playing), as wide as it needs and sliding there; drawn
                // over the bottom of the pages, inside a gap of the window's colour, with an inward curve
                // where its side meets the body
                Rectangle {
                    height: root.tab-style ? 64px : 0;
                    visible: root.tab-style;
                    tab := Rectangle {
                        x: root.tab-right ? parent.width - self.width : 0;
                        // never narrower than the panel above it: the sidebar (on the left), or the queue
                        // (on the right, while it's open), so their edges line up
                        property <length> floor: root.tab-right ? (root.queue-open ? 300px : 0) : (root.narrow ? 68px : 230px);
                        width: min(max(info.preferred-width + 38px, self.floor), root.width - 40px);
                        animate width { duration: Theme.motion ? 320ms : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                        height: parent.height;
                        // the gap around it
                        Rectangle {
                            x: -8px;
                            y: -8px;
                            width: parent.width + 16px;
                            height: parent.height + 8px;
                            background: Theme.bg;
                            border-top-left-radius: Theme.radius + 8px;
                            border-top-right-radius: Theme.radius + 8px;
                        }
                        Rectangle {
                            background: Theme.panel.mix(Theme.accent, 0.86);
                            border-top-left-radius: Theme.radius;
                            border-top-right-radius: Theme.radius;
                            clip: true;
                            // (mirrored on the right: the cover at the window's edge, the text lined up beside it)
                            info := HorizontalLayout {
                                x: root.tab-right ? 24px : 14px;
                                y: 10px;
                                width: parent.width - 38px;
                                height: 44px;
                                spacing: 12px;
                                if root.tab-right: VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Marquee { text: root.now-title; font-size: 15px; right: root.tab-right; max-width: 420px; }
                                    Text { text: root.now-artist; color: Theme.muted; font-size: 13px; overflow: elide; horizontal-alignment: root.tab-right ? right : left; }
                                }
                                if !root.tab-right: BadgedCover { art: root.now-art; initial: ""; plat: root.now-plat; width: 44px; height: 44px; }
                                if root.tab-right: BadgedCover { art: root.now-art; initial: ""; plat: root.now-plat; width: 44px; height: 44px; }
                                if !root.tab-right: VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Marquee { text: root.now-title; font-size: 15px; right: root.tab-right; max-width: 420px; }
                                    Text { text: root.now-artist; color: Theme.muted; font-size: 13px; overflow: elide; horizontal-alignment: root.tab-right ? right : left; }
                                }
                            }
                            DragArea {
                                allow-copy: true;
                                data: Dnd.payload("now");
                                TouchArea {
                                    clicked => { root.nav(root.page == "now" ? "library" : "now"); }
                                    pointer-event(e) => { if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) { root.now-menu(); } }
                                }
                            }
                        }
                    }
                    // the curve: the body's colour, with the gap's quarter circle cut from it
                    Rectangle {
                        x: root.tab-right ? tab.x - 8px : tab.width;
                        y: parent.height - 8px;
                        width: 8px;
                        height: 8px;
                        clip: true;
                        background: Theme.panel.mix(Theme.accent, 0.86);
                        Rectangle { x: root.tab-right ? -8px : 0px; y: -8px; width: 16px; height: 16px; border-radius: 8px; background: Theme.bg; }
                    }
                }
                // the body: the status, the controls and the progress
                Rectangle {
                    vertical-stretch: 1;
                    // Minimal: the panel's own colour; Floating: round ends and a shadow
                    property <length> r: root.player-style == "float" && Theme.radius > 0 ? 22px : Theme.radius;
                    background: root.player-style == "minimal" ? Theme.panel : Theme.panel.mix(Theme.accent, 0.86);
                    border-top-left-radius: root.tab-style && !root.tab-right ? 0 : self.r;
                    border-top-right-radius: root.tab-style && root.tab-right ? 0 : self.r;
                    border-bottom-left-radius: self.r;
                    border-bottom-right-radius: self.r;
                    drop-shadow-blur: root.player-style == "float" ? 24px : 0;
                    drop-shadow-offset-y: root.player-style == "float" ? 8px : 0;
                    drop-shadow-color: #00000060;
                    VerticalLayout {
                // (it opens and closes from the controls' top edge, smoothly, never jumping: what it says is
                // kept while it closes)
                sbox := Rectangle {
                    property <string> said;
                    property <string> now: root.status;
                    changed now => { if (self.now != "") { self.said = self.now; } }
                    init => { self.said = root.status; }
                    property <length> full: root.status-actions.length > 0 ? 42px : 31px;
                    height: root.status != "" ? self.full : 0px;
                    animate height { duration: Theme.motion ? 200ms : 0ms; easing: ease-in-out; }
                    clip: true;
                    VerticalLayout {
                        y: 0;
                        height: sbox.full;
                        padding-left: 18px;
                        padding-right: 18px;
                        padding-top: 8px;
                        opacity: root.status != "" ? 1 : 0;
                        animate opacity { duration: Theme.motion ? 160ms : 0ms; }
                        HorizontalLayout {
                            height: sbox.full - 9px;
                            spacing: 10px;
                            property <bool> bad: root.status-bad;
                            Rectangle { width: 8px; height: 8px; y: (parent.height - self.height) / 2; border-radius: 4px; background: parent.bad ? #ff8a80 : Theme.accent; }
                            // (a click on it puts it away, as the web app's)
                            Rectangle {
                                horizontal-stretch: 1;
                                Text { x: 0; width: parent.width; height: parent.height; text: sbox.said; color: root.status-bad ? #ff8a80 : Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; }
                                TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.status-dismiss(); } }
                            }
                            for a[i] in root.status-actions: Pill { label: a; y: (parent.height - self.height) / 2; on: i == 0; clicked => { root.status-act(i); } }
                        }
                        Rectangle { height: 1px; background: Theme.line; }
                    }
                }
                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 6px;
                    padding-bottom: 4px;
                    // the controls and the volume on the left, the buttons on the right
                    // Minimal: the progress a line along the top
                    if root.player-style == "minimal": Progress { value: root.pos-frac; length-secs: root.dur-secs; loading: root.track-loading; preloading: root.preloading; mixing: root.mixing; released(v) => { root.seek(v); } }
                    HorizontalLayout {
                        height: 42px;
                        spacing: 4px;
                        if !root.tab-style: Rectangle {
                            width: min(300px, max(160px, (root.width - 640px) / 2));
                            HorizontalLayout {
                                spacing: 10px;
                                BadgedCover { art: root.now-art; initial: ""; plat: root.now-plat; badge: root.player-style == "minimal" ? 18px : 20px; width: root.player-style == "minimal" ? 34px : 40px; height: self.width; y: (parent.height - self.height) / 2; }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    Marquee { text: root.now-title; font-size: root.player-style == "minimal" ? 13px : 14px; }
                                    Text { text: root.now-artist; color: Theme.muted; font-size: 12px; overflow: elide; }
                                }
                            }
                            DragArea {
                                allow-copy: true;
                                data: Dnd.payload("now");
                                TouchArea {
                                    clicked => { root.nav(root.page == "now" ? "library" : "now"); }
                                    pointer-event(e) => { if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) { root.now-menu(); } }
                                }
                            }
                        }
                        if !root.tab-style: Rectangle { horizontal-stretch: 1; }
                        IconButton { tip: root.playing ? "Pause" : "Play"; d: root.playing ? Icons.pause : Icons.play; filled: true; size: 40px; y: (parent.height - self.height) / 2; clicked => { root.toggle(); } }
                        Rectangle { width: 6px; }
                        IconButton { tip: "Previous"; d: Icons.prev; y: (parent.height - self.height) / 2; clicked => { root.prev(); } }
                        IconButton { tip: "Next"; d: Icons.next; y: (parent.height - self.height) / 2; clicked => { root.next(); } }
                        IconButton { tip: root.shuffle-on ? "Shuffle on" : "Shuffle off"; d: Icons.shuffle; tint: root.shuffle-on ? Theme.accent : Theme.muted; y: (parent.height - self.height) / 2; clicked => { root.shuffle-toggle(); } }
                        Rectangle {
                            width: 36px;
                            IconButton { tip: root.repeat-mode == "one" ? "Repeat this track" : root.repeat-mode == "all" ? "Repeat the queue" : "Repeat off"; d: Icons.repeat; tint: root.repeat-mode != "off" ? Theme.accent : Theme.muted; y: (parent.height - self.height) / 2; clicked => { root.repeat-cycle(); } }
                            if root.repeat-mode == "one": Text { text: "1"; x: 23px; y: parent.height / 2 - 14px; color: Theme.accent; font-size: 9px; font-weight: 800; }
                        }
                        Rectangle { width: 4px; }
                        // (a click mutes, and again puts it back where it was, as the web app's)
                        Rectangle {
                            width: 28px;
                            property <float> before: 80;
                            Glyph { d: Icons.volume; width: 20px; height: 20px; y: (parent.height - self.height) / 2; fill: muta.has-hover ? Theme.text : Theme.muted; opacity: root.volume <= 0 ? 0.35 : 1; }
                            if root.volume <= 0: Rectangle { width: 22px; height: 2px; y: (parent.height - self.height) / 2; background: Theme.muted; transform-rotation: 45deg; }
                            TipSpot { hover: muta.has-hover; tip: root.volume <= 0 ? "Unmute" : "Mute"; }
                            muta := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    Tips.on = false;
                                    if (root.volume > 0) { parent.before = root.volume; root.volume = 0; } else { root.volume = parent.before > 0 ? parent.before : 80; }
                                    root.volume-changed(root.volume / 100);
                                }
                            }
                        }
                        Range { width: root.narrow ? 64px : 84px; y: (parent.height - self.height) / 2; minimum: 0; maximum: 100; value: root.volume; changed(v) => { root.volume = v; root.volume-changed(v / 100); } }
                        Rectangle { horizontal-stretch: 1; }
                        // like and favourite, as the web app's (on the track that's playing)
                        if root.can-like: IconButton { tip: root.now-liked ? "Remove from Likes" : "Add to Likes"; d: root.now-liked ? Icons.library : Icons.heart-out; tint: root.now-liked ? Theme.accent : Theme.muted; y: (parent.height - self.height) / 2; clicked => { root.like-toggle(); } }
                        if root.can-like: IconButton { tip: root.now-fav ? "Remove from Favourites" : "Add to Favourites"; d: root.now-fav ? Icons.star : Icons.star-out; tint: root.now-fav ? Theme.accent : Theme.muted; y: (parent.height - self.height) / 2; clicked => { root.fav-toggle(); } }
                        if root.now-plat != "": Rectangle {
                            width: 36px;
                            IconButton { tip: "Add to playlist"; d: Icons.playlist-add; y: (parent.height - self.height) / 2; clicked => { pl-menu.show(); } }
                            pl-menu := PopupWindow {
                                x: parent.width - 240px;
                                y: -12px - (root.own-lists.length + 2) * 32px - 16px;
                                width: 240px;
                                Rectangle {
                                    background: Theme.elevated;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    VerticalLayout {
                                        padding: 6px;
                                        Text { text: "Add to playlist"; color: Theme.muted; font-size: 12px; font-weight: 700; height: 32px; vertical-alignment: center; x: 10px; }
                                        for l[k] in root.own-lists: MenuRow { label: l; clicked => { root.bar-pl(k); } }
                                        MenuRow { label: "New playlist..."; clicked => { root.bar-pl(-1); } }
                                    }
                                }
                            }
                        }
                        IconButton { tip: root.page == "now" ? "Close Now Playing" : "Now Playing and lyrics"; d: Icons.lyrics; tint: root.page == "now" ? Theme.accent : Theme.muted; y: (parent.height - self.height) / 2; clicked => { root.nav(root.page == "now" ? "library" : "now"); } }
                        // where the sound plays
                        Rectangle {
                            width: 36px;
                            IconButton { tip: "Output device and casting"; d: Icons.output; y: (parent.height - self.height) / 2; clicked => { root.devices-want(); devices-menu.show(); } }
                            devices-menu := PopupWindow {
                                x: parent.width - 280px;
                                y: -12px - root.devices.length * 32px - 16px - (root.devices-cast-from >= 0 ? 38px : 0px);
                                width: 280px;
                                Rectangle {
                                    background: Theme.elevated;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    VerticalLayout {
                                        padding: 6px;
                                        for d[i] in root.devices: VerticalLayout {
                                            // (the cast devices apart, under a heading of their own)
                                            if i == root.devices-cast-from: VerticalLayout {
                                                padding-top: 6px;
                                                spacing: 6px;
                                                Rectangle { height: 1px; background: Theme.line; }
                                                Text { text: "CHROMECAST"; color: Theme.muted; font-size: 10px; font-weight: 800; letter-spacing: 1px; x: 10px; height: 25px; vertical-alignment: center; }
                                            }
                                            MenuRow { label: d; on: root.device-on == i; offset: root.device-offset == i; clicked => { root.device-pick(i); } }
                                        }
                                    }
                                }
                            }
                        }
                        // the track's menu: open it on its platform, look for its artist
                        Rectangle {
                            width: 36px;
                            IconButton { tip: "More options for this track"; d: Icons.more; y: (parent.height - self.height) / 2; clicked => { root.more-want(); more-menu.show(); } }
                            // (right-clicking the playing song shows it too)
                            property <int> menu-asked: root.now-menu-asks;
                            changed menu-asked => { root.more-want(); more-menu.show(); }
                            more-menu := PopupWindow {
                                x: parent.width - 240px;
                                y: -12px - root.more-items.length * 32px - 16px;
                                width: 240px;
                                Rectangle {
                                    background: Theme.elevated;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    VerticalLayout {
                                        padding: 6px;
                                        for m[i] in root.more-items: MenuRow { label: m; clicked => { root.more-pick(i); } }
                                    }
                                }
                            }
                        }
                        Rectangle { width: 1px; height: 24px; y: (parent.height - self.height) / 2; background: Theme.line; }
                        // (tracks dropped on it go in the queue, as the web app's)
                        IconButton {
                            tip: root.queue-open ? "Close the queue" : "Queue";
                            d: Icons.queue;
                            tint: root.queue-open || qbd.has-drag ? Theme.accent : Theme.muted;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.queue-open = !root.queue-open; }
                            qbd := DropArea {
                                can-drop(e) => { return Dnd.accepts("queue", e.data) ? DragAction.copy : DragAction.none; }
                                dropped(e) => { Dnd.dropped("queue", e.data); return e.proposed-action; }
                            }
                        }
                    }
                    // the progress: click or drag along it (along the top, in Minimal)
                    if root.player-style != "minimal": Progress { value: root.pos-frac; length-secs: root.dur-secs; loading: root.track-loading; preloading: root.preloading; mixing: root.mixing; released(v) => { root.seek(v); } }
                }
                    }
                }
            }
        }
        }
    }
    // Pick genres, then Fine-tune
    if root.taste-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000080;
        TouchArea { clicked => { root.taste-open = false; } }
        Rectangle {
            width: 600px;
            height: min(root.height - 40px, 190px + root.taste-rows.length * 40px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.elevated;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.line;
            TouchArea { }
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: root.taste-step == 1 ? "What do you like?" : "Fine-tune"; color: Theme.text; font-size: 18px; font-weight: 800; }
                Text {
                    text: root.taste-step == 1 ? "Pick a few genres, and Discover starts from them: stations for their artists, their charts and their mixes. What you like and play counts for more as you go. Change them here any time."
                        : "Any of these you like most? Each one you pick gets a mix of its own on Discover. You can skip this.";
                    color: Theme.muted; font-size: 12px; wrap: word-wrap;
                }
                Flickable {
                    vertical-stretch: 1;
                    content-height: root.taste-rows.length * 40px;
                    VerticalLayout {
                        alignment: start;
                        for r[i] in root.taste-rows: VerticalLayout {
                            spacing: 4px;
                            if r.head != "": Text { height: 28px; vertical-alignment: bottom; text: r.head; color: Theme.muted; font-size: 12px; font-weight: 600; }
                            if r.chips.length > 0: HorizontalLayout {
                                height: 40px;
                                spacing: 6px;
                                alignment: start;
                                for c[k] in r.chips: Pill { label: c.label; on: c.on; clicked => { root.taste-toggle(i, k); } }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    if root.taste-step == 2: Pill { label: "Back"; clicked => { root.taste-back(); } }
                    Rectangle { horizontal-stretch: 1; }
                    if root.taste-step == 1: Pill { label: "Cancel"; clicked => { root.taste-open = false; } }
                    if root.taste-step == 2: Pill { label: "Skip"; clicked => { root.taste-skip(); } }
                    Pill { label: "Save"; on: true; clicked => { root.taste-save(); } }
                }
            }
        }
    }
    // your own keys for a platform: the steps (with pages to open and values to copy), then the keys
    if root.ks-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000080;
        TouchArea { clicked => { root.ks-open = false; } }
        Rectangle {
            width: 560px;
            // (sized by what's in it: a size taken from its own layout would size the window by it too)
            height: 150px + root.ks-steps.length * 74px + root.ks-fields.length * 58px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.elevated;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.line;
            TouchArea { }
            VerticalLayout {
                alignment: start;
                padding: 20px;
                spacing: 10px;
                Text { text: root.ks-head; color: Theme.text; font-size: 18px; font-weight: 800; }
                for st[i] in root.ks-steps: HorizontalLayout {
                    spacing: 10px;
                    height: 64px;
                    Text { text: (i + 1) + "."; color: Theme.accent; font-weight: 800; width: 18px; }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        Text { text: st.text; color: Theme.text; font-size: 13px; wrap: word-wrap; }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 6px;
                            for c[k] in st.copies: Pill { label: "Copy " + c; clicked => { root.ks-copy(i, k); } }
                        }
                    }
                    if st.has-url: Pill { label: "Open"; y: 0; clicked => { root.ks-open-url(i); } }
                }
                for f[i] in root.ks-fields: VerticalLayout {
                    spacing: 4px;
                    Text { text: f.label + (f.value == "" ? "" : f.ok ? "  \u{2713}" : "  (doesn't look right yet)"); color: f.ok ? Theme.accent : Theme.muted; font-size: 12px; }
                    Rectangle {
                        height: 34px;
                        border-radius: 8px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: f.ok ? Theme.accent : Theme.line;
                        TextInput { x: 10px; width: parent.width - 20px; height: parent.height; vertical-alignment: center; color: Theme.text; font-size: 13px; single-line: true; text: f.value; edited => { root.ks-set(i, self.text); } }
                    }
                }
                Text { text: root.ks-note; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Pill { label: "Cancel"; clicked => { root.ks-open = false; } }
                    Pill { label: "Save and sign in"; on: true; clicked => { root.ks-save(); } }
                }
            }
        }
    }
    // a plugin's settings, as its manifest lists them
    // Track preferences: the title and artist shown for it (everywhere), and the part of it that plays
    if root.tp-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000080;
        TouchArea { clicked => { root.tp-open = false; } }
        Rectangle {
            width: 440px;
            height: tp-col.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.elevated;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.line;
            TouchArea { }
            tp-col := VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "Track preferences"; color: Theme.text; font-size: 18px; font-weight: 800; }
                for f[i] in [{ label: "Title", which: 0 }, { label: "Artist", which: 1 }]: VerticalLayout {
                    spacing: 4px;
                    Text { text: f.label; color: Theme.muted; font-size: 12px; }
                    Rectangle {
                        height: 34px;
                        border-radius: 8px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Theme.line;
                        if f.which == 0: TextInput { x: 10px; width: parent.width - 20px; height: parent.height; vertical-alignment: center; color: Theme.text; font-size: 14px; single-line: true; text <=> root.tp-title; }
                        if f.which == 1: TextInput { x: 10px; width: parent.width - 20px; height: parent.height; vertical-alignment: center; color: Theme.text; font-size: 14px; single-line: true; text <=> root.tp-artist; }
                    }
                }
                Text { text: "Start and end (m:ss; empty for its own)"; color: Theme.muted; font-size: 12px; }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 34px;
                        border-radius: 8px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Theme.line;
                        TextInput { x: 10px; width: parent.width - 20px; height: parent.height; vertical-alignment: center; color: Theme.text; font-size: 14px; single-line: true; text <=> root.tp-start; edited => { root.tp-drag(-1, -1); } }
                    }
                    Pill { label: "Now"; clicked => { root.tp-now(0); } }
                    Rectangle {
                        height: 34px;
                        border-radius: 8px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Theme.line;
                        TextInput { x: 10px; width: parent.width - 20px; height: parent.height; vertical-alignment: center; color: Theme.text; font-size: 14px; single-line: true; text <=> root.tp-end; edited => { root.tp-drag(-1, -1); } }
                    }
                    Pill { label: "Now"; clicked => { root.tp-now(1); } }
                }
                // the track, with the part that plays: drag either end (or click where it should be)
                Rectangle {
                    height: 26px;
                    property <int> which;
                    Rectangle { y: 9px; height: 8px; border-radius: 4px; background: Theme.text.with-alpha(0.12); }
                    Rectangle { x: parent.width * root.tp-from; width: parent.width * max(0, root.tp-to - root.tp-from); y: 9px; height: 8px; border-radius: 4px; background: Theme.accent; }
                    for h in [root.tp-from, root.tp-to]: Rectangle { x: parent.width * h - 7px; y: 6px; width: 14px; height: 14px; border-radius: 7px; background: Theme.text; }
                    tbt := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                parent.which = abs(self.mouse-x / self.width - root.tp-from) <= abs(self.mouse-x / self.width - root.tp-to) ? 0 : 1;
                                root.tp-drag(max(0, min(1, self.mouse-x / self.width)), parent.which);
                            }
                        }
                        moved => { if (self.pressed) { root.tp-drag(max(0, min(1, self.mouse-x / self.width)), parent.which); } }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Pill { label: "Preview the Start"; clicked => { root.tp-preview(0); } }
                    Pill { label: "Preview the End"; clicked => { root.tp-preview(1); } }
                    Pill { label: "Whole Track"; clicked => { root.tp-whole(); } }
                }
                if root.tp-note != "": Text { text: root.tp-note; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                if root.tp-versions.length > 0: Text { text: "Plays from YouTube Music"; color: Theme.muted; font-size: 12px; }
                for v[k] in root.tp-versions: Rectangle {
                    height: 30px;
                    border-radius: 8px;
                    background: k == root.tp-version-on ? Theme.accent.with-alpha(0.22) : vta.has-hover ? Theme.panel : transparent;
                    Text { x: 10px; width: parent.width - 20px; text: v; color: k == root.tp-version-on ? Theme.text : Theme.muted; font-size: 13px; overflow: elide; vertical-alignment: center; }
                    vta := TouchArea { clicked => { root.tp-version(k); } }
                }
                if root.tp-versions.length > 0: Rectangle {
                    height: 34px;
                    border-radius: 8px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.line;
                    if tpl.text == "": Text { x: 10px; text: "Or paste a YouTube or YouTube Music link"; color: Theme.muted; font-size: 13px; vertical-alignment: center; height: parent.height; }
                    tpl := TextInput { x: 10px; width: parent.width - 20px; height: parent.height; vertical-alignment: center; color: Theme.text; font-size: 13px; single-line: true; edited => { if (self.text != "") { root.tp-link(self.text); } } accepted => { root.tp-search(self.text); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Pill { label: "Reset"; clicked => { root.tp-reset(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Pill { label: "Cancel"; clicked => { root.tp-open = false; } }
                    Pill { label: "Save"; on: true; clicked => { root.tp-save(); } }
                }
            }
        }
    }
    // naming a playlist: a new one, or a new name for one of yours
    if root.la-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000080;
        TouchArea { clicked => { root.la-done(false); } }
        Rectangle {
            width: min(640px, root.width - 60px);
            height: min(root.height - 80px, 170px + root.la-rows.length * 64px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.elevated;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.line;
            TouchArea { }
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: root.la-head; color: Theme.text; font-size: 18px; font-weight: 800; }
                Text { text: "Each looks like a song that's there already, under a slightly different name."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                if root.la-rows.length > 1: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text { text: "For all:"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                    Pill { label: "Keep Both"; clicked => { root.la-all(0); } }
                    Pill { label: "Keep the Ones There"; clicked => { root.la-all(1); } }
                    Pill { label: "Use the New Ones"; clicked => { root.la-all(2); } }
                }
                Flickable {
                    vertical-stretch: 1;
                    content-height: lav.preferred-height;
                    lav := VerticalLayout {
                        spacing: 10px;
                        for r[i] in root.la-rows: HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Marquee { text: "New: " + r.new; font-size: 13px; font-weight: 400; }
                                Marquee { text: "There: " + r.old; font-size: 12px; font-weight: 400; ink: Theme.muted; }
                            }
                            Pill { label: r.choice; y: (parent.height - self.height) / 2; clicked => { root.la-cycle(i); } }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Pill { label: "Cancel"; clicked => { root.la-done(false); } }
                    Pill { label: "Add"; on: true; clicked => { root.la-done(true); } }
                }
            }
        }
    }
    if root.name-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000080;
        TouchArea { clicked => { root.name-open = false; } }
        Rectangle {
            width: 380px;
            height: 176px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.elevated;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.line;
            TouchArea { }
            VerticalLayout {
                padding: 20px;
                spacing: 14px;
                Text { text: root.name-head; color: Theme.text; font-size: 18px; font-weight: 800; }
                Rectangle {
                    height: 38px;
                    border-radius: 8px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.accent;
                    TextInput {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        vertical-alignment: center;
                        color: Theme.text;
                        font-size: 14px;
                        single-line: true;
                        text <=> root.name-text;
                        accepted => { root.name-done(self.text); }
                        init => { self.focus(); self.select-all(); }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Pill { label: "Cancel"; clicked => { root.name-open = false; } }
                    Pill { label: root.name-ok; on: true; clicked => { root.name-done(root.name-text); } }
                }
            }
        }
    }
    // your Jam: its invite, who's in, and End
    if root.jam-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000080;
        TouchArea { clicked => { root.jam-open = false; } }
        Rectangle {
            width: 420px;
            height: jam-col.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.elevated;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.line;
            TouchArea { }
            jam-col := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: "Your Jam"; color: Theme.text; font-size: 18px; font-weight: 800; }
                Text { text: "Send this invite to the friends you want in. They hear what you play, and can add songs; you pick what plays."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                Rectangle {
                    height: 34px;
                    border-radius: 8px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.line;
                    Text { x: 10px; width: parent.width - 20px; text: root.jam-link; color: Theme.text; font-size: 12px; vertical-alignment: center; overflow: elide; }
                }
                Text { text: root.jam-members; color: Theme.text; font-size: 13px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Pill { label: "Copy invite"; clicked => { root.jam-copy(); } }
                    Pill { label: "End Jam"; clicked => { root.jam-end(); } }
                    Pill { label: "Close"; on: true; clicked => { root.jam-open = false; } }
                }
            }
        }
    }
    // its edges and corners, dragged to resize it (it has no frame of its own to): not while maximized
    // 0 top, 1 bottom, 2 left, 3 right, 4 top-left, 5 top-right, 6 bottom-left, 7 bottom-right
    property <length> edge: 5px;
    property <length> corner: 12px;
    if !root.is-max: TouchArea { x: root.corner; y: 0; width: root.width - 2 * root.corner; height: root.edge; mouse-cursor: MouseCursor.ns-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.resize(0); } } }
    if !root.is-max: TouchArea { x: root.corner; y: root.height - root.edge; width: root.width - 2 * root.corner; height: root.edge; mouse-cursor: MouseCursor.ns-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.resize(1); } } }
    if !root.is-max: TouchArea { x: 0; y: root.corner; width: root.edge; height: root.height - 2 * root.corner; mouse-cursor: MouseCursor.ew-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.resize(2); } } }
    if !root.is-max: TouchArea { x: root.width - root.edge; y: root.corner; width: root.edge; height: root.height - 2 * root.corner; mouse-cursor: MouseCursor.ew-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.resize(3); } } }
    if !root.is-max: TouchArea { x: 0; y: 0; width: root.corner; height: root.corner; mouse-cursor: MouseCursor.nwse-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.resize(4); } } }
    if !root.is-max: TouchArea { x: root.width - root.corner; y: 0; width: root.corner; height: root.corner; mouse-cursor: MouseCursor.nesw-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.resize(5); } } }
    if !root.is-max: TouchArea { x: 0; y: root.height - root.corner; width: root.corner; height: root.corner; mouse-cursor: MouseCursor.nesw-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.resize(6); } } }
    if !root.is-max: TouchArea { x: root.width - root.corner; y: root.height - root.corner; width: root.corner; height: root.corner; mouse-cursor: MouseCursor.nwse-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.resize(7); } } }
    // the keyboard (as the web app's): Space plays or pauses, Shift+Right/Left skip, / goes to the search
    // bar, Q opens or closes the queue, L likes; Ctrl+A picks every track on the page, Escape none
    // the tooltip (one for the window): under the control it's for, over it near the window's foot, kept
    // inside the window; it goes by itself after a few seconds
    if Tips.on: Rectangle {
        property <length> below: Tips.y + Tips.h + 6px;
        x: max(4px, min(root.width - self.width - 4px, Tips.x - self.width / 2));
        y: self.below + self.height > root.height - 4px ? Tips.y - self.height - 6px : self.below;
        width: min(360px, tipt.preferred-width + 18px);
        height: tipt.preferred-height + 10px;
        border-radius: 6px;
        background: Theme.elevated;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 6px;
        drop-shadow-color: #00000060;
        tipt := Text { x: 9px; y: 5px; width: parent.width - 18px; text: Tips.text; color: Theme.text; font-size: 12px; wrap: word-wrap; }
        Timer { interval: 6s; running: Tips.on; triggered => { Tips.on = false; } }
    }
    keys := FocusScope {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.modifiers.control && (e.text == "a" || e.text == "A")) { root.pick-all(); return accept; }
            if (e.text == Key.Escape) { root.pick-none(); return accept; }
            if (e.modifiers.control || e.modifiers.alt || e.modifiers.meta) { return reject; }
            if (e.text == " ") { root.toggle(); return accept; }
            if (e.modifiers.shift && e.text == Key.RightArrow) { root.next(); return accept; }
            if (e.modifiers.shift && e.text == Key.LeftArrow) { root.prev(); return accept; }
            if (e.text == "/") { ti.focus(); return accept; }
            if (e.text == "q") { root.queue-open = !root.queue-open; return accept; }
            if (e.text == "l") { root.like-toggle(); return accept; }
            reject
        }
    }
}

// Settings > App > Taskbar Widget: what's playing, always on show in the taskbar by the clock (a small
// window of its own over the taskbar's empty room, never taking the focus). Its colours are the app's,
// set on its own Theme.
export component TaskbarWidget inherits Window {
    in property <string> song;
    in property <string> artist;
    in property <image> art;
    in property <string> plat;
    in property <bool> playing;
    in property <bool> liked;
    in property <bool> can-like;
    in property <float> frac;
    in property <bool> mixing;
    in property <bool> has-track;
    /// see-through, over a dark taskbar: black is clear, the rest added to what's under it
    in property <bool> glass;
    callback act(string);
    no-frame: true;
    always-on-top: true;
    title: "OmniPulse Taskbar Widget";
    background: root.glass ? transparent : Theme.panel;
    preferred-width: 280px;
    preferred-height: 40px;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 4px;
        spacing: 8px;
        alignment: stretch;
        Rectangle {
            width: 30px;
            height: self.width;
            y: (parent.height - self.height) / 2;
            BadgedCover { art: root.art; plat: root.plat; badge: 14px; corner: 4px; initial: root.song == "" ? "" : "♪"; width: parent.width; height: parent.height; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 0px;
            Marquee { text: root.has-track ? root.song : "OmniPulse"; font-size: 12px; }
            Marquee { text: root.has-track ? (root.mixing ? "Mixing · " + root.artist : root.artist) : "Nothing playing"; font-size: 11px; font-weight: 400; ink: Theme.muted; }
        }
        if root.can-like: IconButton { d: root.liked ? Icons.library : Icons.heart-out; size: 26px; tint: root.liked ? Theme.accent : Theme.muted; y: (parent.height - self.height) / 2; clicked => { root.act("like"); } }
        IconButton { d: Icons.prev; size: 26px; y: (parent.height - self.height) / 2; clicked => { root.act("prev"); } }
        IconButton { d: root.playing ? Icons.pause : Icons.play; size: 30px; tint: Theme.text; y: (parent.height - self.height) / 2; clicked => { root.act("play"); } }
        IconButton { d: Icons.next; size: 26px; y: (parent.height - self.height) / 2; clicked => { root.act("next"); } }
    }
    // where it is, along its foot (the mix sweeping through it, as the player bar's)
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: Theme.text.with-alpha(0.12);
        clip: true;
        Rectangle { x: 0; width: parent.width * max(0, min(1, root.frac)); height: 100%; background: Theme.accent; }
        if root.mixing: Rectangle {
            property <float> ph: mod(animation-tick() / 1ms, 1400) / 1400;
            x: 0;
            width: parent.width * max(0, min(1, root.frac));
            height: 100%;
            clip: true;
            Rectangle {
                x: -parent.width + parent.width * 2 * parent.ph;
                width: parent.width * 2;
                height: 100%;
                background: @linear-gradient(90deg, Theme.accent 0%, Theme.accent-2 25%, Theme.accent 50%, Theme.accent-2 75%, Theme.accent 100%);
            }
        }
    }
    // the cover and the names: the app's window, shown
    TouchArea { x: 0; width: root.width - (root.can-like ? 150px : 120px); height: parent.height - 2px; clicked => { root.act("show"); } }
}

// Apple Music's sign-in (Settings > Integrations > Apple Music > Import): Apple's own page, in a window of
// its own, only until you're signed in (then your music's read once, and the sign-in forgotten)
export component AppleSignIn inherits Window {
    title: "Sign in to Apple Music (once, to import your music)";
    preferred-width: 1000px;
    preferred-height: 760px;
    background: #ffffff;
}
