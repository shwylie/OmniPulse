// OmniPulse, native: the window, title bar, sidebar, pages, queue and player bar.
// Colours, sizes and icons follow the web app's dark theme (dist/style.css).

import { ListView, Slider, LineEdit, ScrollView, Switch, Palette } from "std-widgets.slint";

export global Theme {
    in-out property <color> bg: #08090c;
    in-out property <color> panel: #111318;
    in-out property <color> elevated: #1a1d25;
    in-out property <color> line: #262a35;
    in-out property <color> text: #e9ebf2;
    in-out property <color> muted: #9097a8;
    // the accent shown: the one set (picked, or the cover's), and during a mix with album-art colours
    // on, a slow fade to the next cover's and back, over and over, till the mix is over
    in-out property <color> accent-own: #8e9bff;
    in-out property <color> accent-2-own: #b48eff;
    in-out property <color> accent-next: #8e9bff;
    in-out property <color> accent-2-next: #b48eff;
    in-out property <bool> pulsing;
    // the player's colours: each accent a little into the panel (the first on the left, the second on the right)
    // (into the theme's own panel, without the tint: the tint doesn't touch the accents)
    in-out property <color> plain-panel: #1a1d24;
    out property <color> bar-a: plain-panel.mix(accent, 0.86);
    out property <color> bar-b: plain-panel.mix(accent-2, 0.86);
    property <float> pulse: pulsing ? (1 - cos(animation-tick() / 3.2s * 360deg)) / 2 : 0;
    out property <color> accent: pulsing ? accent-own.mix(accent-next, 1 - pulse) : accent-own;
    out property <color> accent-2: pulsing ? accent-2-own.mix(accent-2-next, 1 - pulse) : accent-2-own;
    in-out property <color> on-accent: #111318;
    // (Rounded Corners off: 0, square, everywhere they're used: the player, the cards)
    in-out property <length> radius: 10px;
    in-out property <length> card-radius: 18px;
    // the sidebar, the page and the queue: square with Rounded Corners off (Settings > App)
    in-out property <length> panel-radius: 10px;
    // a track row and its cover: smaller with List Density at Compact (Settings > Look)
    in-out property <length> row-h: 60px;
    in-out property <length> row-art: 44px;
    // Settings > Look > Animations: off, everything moves at once
    in-out property <bool> motion: true;
}

// Drag and drop (as the web app's js/dnd.js): a track of the page ("t:<row>") or a playlist of the
// sidebar ("p:<side>") dragged; dropped on a playlist in the sidebar ("side:<i>"), the queue ("queue")
// or the open playlist's page ("page"). What's carried, what takes it and the drop are the app's.
export global Dnd {
    pure callback payload(string) -> data-transfer;
    pure callback accepts(string, data-transfer) -> bool;
    callback dropped(string, data-transfer);
}

// (and for its menu, as the web app's: its artists one by one, its uploader if it's someone else, a
// like and a star, where it opens, Stream-Safe Music's Allow / Stop allowing)
export struct Row { alb: string, alb-by: string, alb-plat: string, alb-art: image, alb-i: int, dim: bool, versions: string, version: bool, title: string, artist: string, album: string, dur: string, plat: string, playing: bool, head: string, auto: bool, art: image, liked: bool, sc-link: bool, sp-link: bool, yt-link: bool, picked: bool, genres: [string], added-by: string, artists: [string], uploader: string, can-like: bool, fav: bool, fav-on: bool, open-label: string, cleared: string, coming: bool }
// (merged: playlists combined into it, to unmerge)
export struct Side { title: string, plat: string, own: bool, share: bool, sc: bool, sp: bool, collab: bool, collab-owner: bool, merged: bool }
/// A platform in the title bar: on (in its colours), set up (ready; grey until it is), its name
export struct Plat { id: string, on: bool, name: string, ready: bool, d: string }
// (a genre's tile, as the web app's: a coloured cover, its name on it; c1 its middle, c2 its edge)
// (a song's tile: a track menu on right-click, as the web app's; liked, for its line)
/// An artist page's platform: its symbol, and how many follow them there ("12,345 followers")
export struct ArtistOn { plat: string, text: string }
export struct Tile { miss: bool, title: string, sub: string, art: image, plat: string, genre: bool, c1: color, c2: color, track: bool, liked: bool, row: Row }
/// Pick genres (and Fine-tune): a row of up to four chips, under a group's name (on its first row)
export struct TasteChip { label: string, on: bool }
export struct TasteRow { head: string, chips: [TasteChip] }
export struct Shelf { title: string, tiles: [Tile], open: bool, gone: bool, shown: int }
export struct Line { text: string }
/// A switch in Settings: under its section's heading (head, on the first of a section)
/// An account in Settings: its name, what's known (who's signed in, or what it needs), and its button
export struct Account { name: string, status: string, signed: bool, busy: bool, keys: string, switch: string, on: bool, manage: string, settings: string }
// Settings' search: a setting found (its path, what it is), where it lives (its category, a panel to
// open), and its switch if it has one
export struct SetHit { path: string, label: string, note: string, cat: string, panel: string, key: string, on: bool, toggle: bool }
// A song being added that looks like one there already: the new one, the one there, what's chosen
export struct LookAlike { new: string, old: string, choice: string }
// Stats' closer look at one card: its blocks (a bar chart, a big number, a ranked list, a calendar)
export struct StatBar { label: string, v: float, tip: string }
export struct StatRow { rank: int, name: string, sub: string, share: float, art: image, row: Row, song: bool }
export struct StatBlock { kind: string, kicker: string, big: string, sub: string, wide: bool, bars: [StatBar], rows: [StatRow], cells: [int] }
export struct SetRow { head: string, label: string, note: string, on: bool, key: string, sub: bool, more: bool, button: string }
/// One of a plugin's settings: its kind ("toggle", "text", "password", "number", "select"), what it's
/// set to (as text; "true"/"false" for a toggle), and a select's options
/// A step of the key setup: what to do, whether it has a page to open, and values to copy
export struct KeyStep { text: string, has-url: bool, copies: [string] }
/// A key to paste: its label, what's typed, and whether it looks right
export struct KeyField { label: string, value: string, ok: bool }
export struct PlugField { key: string, label: string, note: string, kind: string, value: string, options: [string], at: int }
// (an artist you follow: whether on SoundCloud and on Spotify, for its menu)
export struct Item { name: string, sub: string, art: image, plat: string, on-sc: bool, on-sp: bool, on-yt: bool, row: Row }
/// A page being loaded: each platform it asks, and whether it's answered yet
export struct LoadStep { plat: string, name: string, done: bool }
/// A slice of the Ring visualiser: its outline, and where it is from the foot (0, the bass) to the top (1)
export struct RingPiece { d: string, f: float }

