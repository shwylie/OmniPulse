                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        clip: true;
                        height: 34px;
                        border-radius: 8px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Theme.line;
                        TextInput { property <length> sx; cursor-position-changed(p) => { if (p.x + self.sx < 0px) { self.sx = -p.x; } else if (p.x + self.sx > parent.width - 20px - 2px) { self.sx = parent.width - 20px - 2px - p.x; } }  x: 10px + min(0px, max(parent.width - 20px - self.width, self.sx)); width: max(parent.width - 20px, self.preferred-width + 4px); height: parent.height; vertical-alignment: center; color: Theme.text; font-size: 14px; single-line: true; text <=> root.tp-start; edited => { root.tp-drag(-1, -1); } }
                    }
                    Pill { label: "Now"; clicked => { root.tp-now(0); } }
                    Rectangle {
                        clip: true;
                        height: 34px;
                        border-radius: 8px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Theme.line;
                        TextInput { property <length> sx; cursor-position-changed(p) => { if (p.x + self.sx < 0px) { self.sx = -p.x; } else if (p.x + self.sx > parent.width - 20px - 2px) { self.sx = parent.width - 20px - 2px - p.x; } }  x: 10px + min(0px, max(parent.width - 20px - self.width, self.sx)); width: max(parent.width - 20px, self.preferred-width + 4px); height: parent.height; vertical-alignment: center; color: Theme.text; font-size: 14px; single-line: true; text <=> root.tp-end; edited => { root.tp-drag(-1, -1); } }
                    }
                    Pill { label: "Now"; clicked => { root.tp-now(1); } }
                }
                // the track, with the part that plays: drag either end (or click where it should be)
                Rectangle {
                    height: 26px;
                    property <int> which;
                    Rectangle { y: 9px; height: 8px; border-radius: 4px; background: Theme.text.with-alpha(0.12); }
                    Rectangle { x: parent.width * root.tp-from; width: parent.width * max(0, root.tp-to - root.tp-from); y: 9px; height: 8px; border-radius: 4px; background: Theme.accent; }
                    for h in [root.tp-from, root.tp-to]: Rectangle { x: parent.width * h - 7px; y: 6px; width: 14px; height: 14px; border-radius: 7px; background: Theme.text; }
                    tbt := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                parent.which = abs(self.mouse-x / self.width - root.tp-from) <= abs(self.mouse-x / self.width - root.tp-to) ? 0 : 1;
                                root.tp-drag(max(0, min(1, self.mouse-x / self.width)), parent.which);
                            }
                        }
                        moved => { if (self.pressed) { root.tp-drag(max(0, min(1, self.mouse-x / self.width)), parent.which); } }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Pill { label: "Preview the Start"; clicked => { root.tp-preview(0); } }
                    Pill { label: "Preview the End"; clicked => { root.tp-preview(1); } }
                    Pill { label: "Whole Track"; clicked => { root.tp-whole(); } }
                }
                // Smart Transitions: beat 1, moved by hand where the measuring got it wrong (as a DJ app's beat grid)
                if root.tp-beat-shown: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text { text: "Beat 1"; color: Theme.text; font-size: 13px; vertical-alignment: center; }
                    Pill { label: "Earlier"; tip: "Beat 1 a beat earlier, for blending on the beat"; clicked => { root.tp-beat = max(-8, root.tp-beat - 1); } }
                    Text {
                        text: root.tp-beat == 0 ? "as measured" : (abs(root.tp-beat) + (abs(root.tp-beat) == 1 ? " beat " : " beats ") + (root.tp-beat < 0 ? "earlier" : "later"));
                        color: root.tp-beat == 0 ? Theme.muted : Theme.text; font-size: 13px; vertical-alignment: center; min-width: 110px; horizontal-alignment: center;
                    }
                    Pill { label: "Later"; tip: "Beat 1 a beat later"; clicked => { root.tp-beat = min(8, root.tp-beat + 1); } }
                }
                if root.tp-beat-shown: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text { text: "Phrases start"; color: Theme.text; font-size: 13px; vertical-alignment: center; }
                    Pill { label: "Earlier"; tip: "Move its phrases (16 beats) a bar earlier"; clicked => { root.tp-phrase = max(-3, root.tp-phrase - 1); } }
                    Text {
                        text: root.tp-phrase == 0 ? "as measured" : (abs(root.tp-phrase) + (abs(root.tp-phrase) == 1 ? " bar " : " bars ") + (root.tp-phrase < 0 ? "earlier" : "later"));
                        color: root.tp-phrase == 0 ? Theme.muted : Theme.text; font-size: 13px; vertical-alignment: center; min-width: 110px; horizontal-alignment: center;
                    }
                    Pill { label: "Later"; tip: "Move its phrases a bar later"; clicked => { root.tp-phrase = min(3, root.tp-phrase + 1); } }
                }
                if root.tp-beat-shown: Text { text: "If Seamless Mix blends this song badly: when it's a beat or two off, move Beat 1 to where you hear the bar start. When it's on the beat but a bar off, move where its phrases start. A quiet or filtered bar can start a phrase."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                if root.tp-note != "": Text { text: root.tp-note; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                if root.tp-versions.length > 0: Text { text: "Plays from YouTube Music"; color: Theme.muted; font-size: 12px; }
                for v[k] in root.tp-versions: Rectangle {
                    height: 30px;
                    border-radius: 8px;
                    background: k == root.tp-version-on ? Theme.accent.with-alpha(0.22) : vta.has-hover ? Theme.panel : transparent;
                    Text { x: 10px; width: parent.width - 20px; text: v; color: k == root.tp-version-on ? Theme.text : Theme.muted; font-size: 13px; overflow: elide; vertical-alignment: center; }
                    vta := TouchArea { clicked => { root.tp-version(k); } }
                }
                if root.tp-versions.length > 0: Rectangle {
                    clip: true;
                    height: 34px;
                    border-radius: 8px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.line;
                    if tpl.text == "": Text { x: 10px; text: "Or paste a YouTube or YouTube Music link"; color: Theme.muted; font-size: 13px; vertical-alignment: center; height: parent.height; }
                    tpl := TextInput { property <length> sx; cursor-position-changed(p) => { if (p.x + self.sx < 0px) { self.sx = -p.x; } else if (p.x + self.sx > parent.width - 20px - 2px) { self.sx = parent.width - 20px - 2px - p.x; } }  x: 10px + min(0px, max(parent.width - 20px - self.width, self.sx)); width: max(parent.width - 20px, self.preferred-width + 4px); height: parent.height; vertical-alignment: center; color: Theme.text; font-size: 13px; single-line: true; edited => { if (self.text != "") { root.tp-link(self.text); } } accepted => { root.tp-search(self.text); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Pill { label: "Reset"; clicked => { root.tp-reset(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Pill { label: "Cancel"; clicked => { root.tp-open = false; } }
                    Pill { label: "Save"; on: true; clicked => { root.tp-save(); } }
                }
            }
        }
    }
    // naming a playlist: a new one, or a new name for one of yours
    if root.la-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000080;
        TouchArea { clicked => { root.la-done(false); } }
        Rectangle {
            width: min(640px, root.width - 60px);
            height: min(root.height - 80px, 170px + root.la-rows.length * 64px);
