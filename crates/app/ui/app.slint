                        if f.which == 0: TextInput { property <length> sx; cursor-position-changed(p) => { if (p.x + self.sx < 0px) { self.sx = -p.x; } else if (p.x + self.sx > parent.width - 20px - 2px) { self.sx = parent.width - 20px - 2px - p.x; } }  x: 10px + min(0px, max(parent.width - 20px - self.width, self.sx)); width: max(parent.width - 20px, self.preferred-width + 4px); height: parent.height; vertical-alignment: center; color: Theme.text; font-size: 14px; single-line: true; text <=> root.tp-title; }
                        if f.which == 1: TextInput { property <length> sx; cursor-position-changed(p) => { if (p.x + self.sx < 0px) { self.sx = -p.x; } else if (p.x + self.sx > parent.width - 20px - 2px) { self.sx = parent.width - 20px - 2px - p.x; } }  x: 10px + min(0px, max(parent.width - 20px - self.width, self.sx)); width: max(parent.width - 20px, self.preferred-width + 4px); height: parent.height; vertical-alignment: center; color: Theme.text; font-size: 14px; single-line: true; text <=> root.tp-artist; }
                    }
