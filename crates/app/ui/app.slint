241.1 402.0 h 0.8 v 0.8 h -0.8 Z M 306.2 538.3 h 1.1 v 1.1 h -1.1 Z M 220.1 503.0 h 1.5 v 1.5 h -1.5 Z M 236.4 366.6 h 1.4 v 1.4 h -1.4 Z M 66.8 310.0 h 0.9 v 0.9 h -0.9 Z M 286.8 143.5 h 1.4 v 1.4 h -1.4 Z M 311.9 326.4 h 1.2 v 1.2 h -1.2 Z M 125.9 1.8 h 0.8 v 0.8 h -0.8 Z M 124.9 106.9 h 0.6 v 0.6 h -0.6 Z M 209.0 539.7 h 1.1 v 1.1 h -1.1 Z M 291.3 368.1 h 1.1 v 1.1 h -1.1 Z"; fill: #ffffffc0; stroke-width: 0; }
                }
                // (Ticket: admit one, its stub torn along the dots)
                if pi.th == "ticket": Rectangle {
                    Rectangle { x: parent.width - 69px; width: 69px; background: @linear-gradient(135deg, PanelLook.c1 0%, PanelLook.c2 100%); }
                    Rectangle { x: 10px; y: 10px; width: parent.width - 89px; height: parent.height - 20px; border-radius: 5px; border-width: 1.2px; border-color: PanelLook.c1.with-alpha(0.75); }
                    for k in 90: Rectangle { x: 250px; y: 13px + k * 7px; width: 1.5px; height: 3px; background: #3b24108c; visible: self.y < parent.height - 15px; }
                    for n in [{ x: 251, y: 0 }, { x: 251, y: 1 }, { x: 3, y: 0.5 }, { x: 317, y: 0.5 }]: Rectangle {
                        x: n.x * 1px - 7px;
                        y: (n.y == 0 ? 3px : n.y == 1 ? parent.height - 3px : parent.height / 2) - 7px;
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        background: #16141f;
                    }
                    Text { x: parent.width - 34px - self.width / 2; y: (parent.height - self.height) / 2; text: parent.height > 110px ? "ADMIT ONE" : "No. " + (i < 9 ? "0" : "") + (i + 1); color: #ffffff; font-size: parent.height > 110px ? 15px : 13px; font-weight: 800; font-family: "Bahnschrift"; transform-rotation: -90deg; }
                }
                if pi.th == "dark": Rectangle { y: 0; x: 12px; width: parent.width - 24px; height: 3px; background: PanelLook.c1.mix(PanelLook.c2, 0.5); }
                if pi.th == "minimal": Rectangle { y: parent.height - 4px; height: 4px; background: PanelLook.c1.mix(PanelLook.c2, 0.5); }
                if pi.th == "y2k": Rectangle {
                    y: 0;
                    height: 22px;
                    background: @linear-gradient(90deg, #ff9ad5 0%, #9ad0ff 100%);
                    Rectangle { y: parent.height - 2px; height: 2px; background: #2b1b40; }
                    Text { x: parent.width - self.width - 8px; text: "–  □  ×"; color: #2b1b40; font-size: 10px; font-weight: 900; }
                }
                // (a short one: its icon, title and line side by side)
                if !p.body: HorizontalLayout {
                    padding-left: 22px;
                    padding-top: pi.top;
                    padding-right: 16px + pi.keep;
                    spacing: 16px;
                    if p.title == "Powered by OmniPulse": VerticalLayout {
                        alignment: center;
                        Glyph {
                            d: p.icon;
                            width: min(54px, root.ph - 26px);
                            height: self.width;
                            fill: PanelLook.logo-colours == "omnipulse" ? @linear-gradient(45deg, #00e5ff 0%, #ff2bd0 100%) : PanelLook.logo-colours == "plain" ? pi.ink : @linear-gradient(45deg, PanelLook.c1 0%, PanelLook.c2 100%);
                        }
                    }
                    if PanelLook.icons && p.title != "Powered by OmniPulse": VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: min(46px, root.ph - 34px);
                            height: self.width;
                            border-radius: pi.th == "pixel" || pi.th == "cyber" ? 0px : pi.th == "pastel" ? self.width / 2 : pi.th == "ticket" ? 5px : 10px;
                            background: pi.th == "terminal" ? pi.ink.with-alpha(0.14) : pi.light ? PanelLook.c1 : PanelLook.c1.mix(PanelLook.c2, 0.4);
                            border-width: pi.th == "terminal" ? 1.2px : 0px;
                            border-color: pi.ink;
                            if !p.has-img: Glyph { d: p.icon; width: parent.width * 0.6; height: self.width; fill: pi.th == "terminal" ? pi.ink : #ffffff; }
                            if p.has-img: Image { width: parent.width; height: parent.height; source: p.img; image-fit: cover; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text { text: pi.shown-title; color: pi.ink; font-size: min(28px, root.ph * 0.3, ((PanelLook.icons ? 214px : 276px) - pi.keep) / max(1, pi.shown-title.character-count) * 1.75); font-weight: 800; font-family: pi.ff; }
                        if p.line != "": Text { text: p.line; color: pi.ink.with-alpha(0.78); font-size: 11px; font-family: pi.ff; }
                    }
                }
                // (a long one, or extended: its header, a line in its colours, then all its words)
                if p.body: VerticalLayout {
                    padding-left: 22px;
                    padding-top: 14px + pi.top;
                    padding-right: 22px + (pi.th == "ticket" ? 66px : 0px);
                    spacing: 10px;
                    alignment: start;
                    HorizontalLayout {
                        spacing: 14px;
                        if p.title == "Powered by OmniPulse": Glyph {
                            d: p.icon;
                            width: 40px;
                            height: 40px;
                            fill: PanelLook.logo-colours == "omnipulse" ? @linear-gradient(45deg, #00e5ff 0%, #ff2bd0 100%) : PanelLook.logo-colours == "plain" ? pi.ink : @linear-gradient(45deg, PanelLook.c1 0%, PanelLook.c2 100%);
                        }
                        if PanelLook.icons && p.title != "Powered by OmniPulse": Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: pi.th == "pixel" || pi.th == "cyber" ? 0px : pi.th == "pastel" ? 18px : pi.th == "ticket" ? 5px : 9px;
                            background: pi.th == "terminal" ? pi.ink.with-alpha(0.14) : pi.light ? PanelLook.c1 : PanelLook.c1.mix(PanelLook.c2, 0.4);
                            border-width: pi.th == "terminal" ? 1.2px : 0px;
                            border-color: pi.ink;
                            if !p.has-img: Glyph { d: p.icon; width: 22px; height: 22px; fill: pi.th == "terminal" ? pi.ink : #ffffff; }
                            if p.has-img: Image { width: parent.width; height: parent.height; source: p.img; image-fit: cover; }
                        }
                        Text { text: pi.shown-title; color: pi.ink; font-size: min(24px, ((PanelLook.icons ? 226px : 276px) - pi.keep) / max(1, pi.shown-title.character-count) * 1.75); font-weight: 800; vertical-alignment: center; font-family: pi.ff; }
                    }
                    Rectangle { height: 2px; background: pi.th == "comic" || pi.th == "bauhaus" ? #111111 : PanelLook.c1.mix(PanelLook.c2, 0.5); }
                    Text { text: p.line; color: pi.ink.with-alpha(0.8); font-size: 12.5px; wrap: word-wrap; font-family: pi.ff; }
                }
            }
        }
    }
}

/// The webcam overlay on a 16:9 canvas: a made-up camera in its frame, each part a stand-in where it'll go
component CamPreview inherits Rectangle {
    height: self.width * CamLook.ratio;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;
    background: #2a2e3c;
    Rectangle { background: @linear-gradient(135deg, #2b3550 0%, #3a2b48 100%); }
    for r in CamLook.rects: Rectangle {
        x: parent.width * r.x;
        y: parent.height * r.y;
        width: parent.width * r.w;
        height: parent.height * r.h;
        property <bool> cam: r.id == "cam";
        property <bool> light: CamLook.theme == "comic" || CamLook.theme == "pastel";
        border-radius: self.cam ? (CamLook.shape == "circle" ? min(self.width, self.height) / 2 : CamLook.shape == "square" || CamLook.shape == "hex" ? 0px : 12px) : 6px;
        background: self.cam ? #3b4766 : r.id == "live" ? #e5243b : r.id == "name" || r.id == "clock" ? (self.light ? #ffffff : CamLook.theme == "gradient" ? CamLook.c1.mix(CamLook.c2, 0.5) : #0a0814d9) : #ffffff1f;
        border-width: self.cam ? (CamLook.border == "thick" ? 5px : CamLook.border == "double" ? 4px : CamLook.border == "brackets" ? 0px : 2.5px) : r.id == "name" && CamLook.theme == "neon" ? 2px : 1px;
        border-color: self.cam ? CamLook.c1 : r.id == "name" && CamLook.theme == "neon" ? CamLook.c1 : #ffffff55;
        drop-shadow-blur: self.cam && (CamLook.border == "glow" || CamLook.border == "edge") ? 14px : 0px;
        drop-shadow-color: CamLook.c1;
        // (the camera: someone in it)
        if self.cam: Rectangle {
            Rectangle { width: parent.height * 0.26; height: self.width; border-radius: self.width / 2; x: (parent.width - self.width) / 2; y: parent.height * 0.22; background: #7f8bb0; }
            Rectangle { width: parent.width * 0.5; height: parent.height * 0.34; border-radius: self.width / 2; x: (parent.width - self.width) / 2; y: parent.height * 0.72; background: #6b7699; }
        }
        // (Corner Brackets: only the corners)
        if self.cam && CamLook.border == "brackets": Rectangle {
            Rectangle { x: 0; y: 0; width: parent.width * 0.18; height: 3px; background: CamLook.c1; }
            Rectangle { x: 0; y: 0; width: 3px; height: parent.height * 0.18; background: CamLook.c1; }
            Rectangle { x: parent.width - self.width; y: 0; width: parent.width * 0.18; height: 3px; background: CamLook.c1; }
            Rectangle { x: parent.width - 3px; y: 0; width: 3px; height: parent.height * 0.18; background: CamLook.c1; }
            Rectangle { x: 0; y: parent.height - 3px; width: parent.width * 0.18; height: 3px; background: CamLook.c2; }
            Rectangle { x: 0; y: parent.height - self.height; width: 3px; height: parent.height * 0.18; background: CamLook.c2; }
            Rectangle { x: parent.width - self.width; y: parent.height - 3px; width: parent.width * 0.18; height: 3px; background: CamLook.c2; }
            Rectangle { x: parent.width - 3px; y: parent.height - self.height; width: 3px; height: parent.height * 0.18; background: CamLook.c2; }
        }
        if !self.cam: Text {
            text: r.id == "live" ? "\u{25cf} LIVE" : r.label;
            color: r.id == "name" && parent.light ? #111111 : #ffffff;
            font-size: clamp(parent.height * 0.42, 7px, 14px);
            font-weight: 800;
            overflow: elide;
            width: parent.width - 6px;
            horizontal-alignment: center;
        }
    }
}

/// A Suite widget as it'll look in OBS (Goals, Timer, Latest Follow or Sub, Raid Shoutout), with made-up
/// numbers, in its theme (dark, glass, neon, comic, minimal)
component SuitePreview inherits Rectangle {
    in property <string> which;
    in property <string> theme;
    in property <bool> rings;
    // (the Goals' look: bars, rings, liquid, jar or hourglass)
    in property <string> look;
    property <bool> shapes: root.look == "liquid" || root.look == "jar" || root.look == "hourglass";
    // (a palette's or your own colours; none (see-through): the accent)
    in property <color> own-c1;
    in property <color> own-c2;
    // (a GIF set for it: a stand-in where it'll go)
    in property <bool> gif;
    // (Emote Rain's spot: all, bl, br, tl, tr, b, c, custom)
    in property <string> spot;
    height: root.which == "raid" || root.which == "wheel" || root.which == "emoterain" ? 220px : root.which == "goals" || root.which == "leaderboard" ? 200px : 130px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;
    Rectangle { background: @linear-gradient(135deg, #2b3550 0%, #3a2b48 100%); }
    Caps { r: 14px; outside: Theme.panel; tl: #2b3550; tr: #33304c; bl: #33304c; br: #3a2b48; top: true; bottom: true; }
    Text { x: 12px; y: 8px; text: "A preview, with made-up numbers"; color: #ffffffa0; font-size: 11px; }
    property <string> t: root.theme == "" ? "dark" : root.theme;
    property <bool> comic: root.t == "comic";
    // (the light ones, with dark words)
    property <bool> light: root.comic || root.t == "pastel" || root.t == "y2k" || root.t == "sticker";
    property <color> c1: root.own-c1.alpha > 0 ? root.own-c1 : Theme.accent;
    property <color> c2: root.own-c2.alpha > 0 ? root.own-c2 : Theme.accent-2;
    property <color> ink: root.light ? (root.t == "y2k" ? #2b1b40 : root.t == "pastel" ? #3a2a4a : #111111) : #ffffff;
    // (the goals' bars filling, again and again)
    property <float> fill: Theme.motion ? mod(animation-tick() / 1ms, 6000) / 6000 : 0.6;
    // (the wheel: turning; emote rain: falling, with no panel of its own)
    if root.which == "wheel": Rectangle {
        width: 170px;
        height: 170px;
        x: (parent.width - self.width) / 2;
        y: 32px;
        border-radius: 85px;
        background: root.c1.mix(root.c2, 0.5);
        border-width: 5px;
        border-color: #ffffffd8;
        clip: true;
        property <angle> turn: Theme.motion ? mod(animation-tick() / 1ms, 7000) / 7000 * 360deg : 20deg;
        // (its spokes: one path, its ends worked out from the turn, as a rectangle can't be turned here)
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 100;
            viewbox-height: 100;
            stroke: #ffffffa0;
            stroke-width: 2.5px;
            fill: transparent;
            property <angle> a: parent.turn;
            commands: "M " + (50 + 50 * cos(self.a)) + " " + (50 + 50 * sin(self.a)) + " L " + (50 - 50 * cos(self.a)) + " " + (50 - 50 * sin(self.a))
                + " M " + (50 + 50 * cos(self.a + 60deg)) + " " + (50 + 50 * sin(self.a + 60deg)) + " L " + (50 - 50 * cos(self.a + 60deg)) + " " + (50 - 50 * sin(self.a + 60deg))
                + " M " + (50 + 50 * cos(self.a + 120deg)) + " " + (50 + 50 * sin(self.a + 120deg)) + " L " + (50 - 50 * cos(self.a + 120deg)) + " " + (50 - 50 * sin(self.a + 120deg));
        }
        Rectangle { width: 26px; height: 26px; border-radius: 13px; background: #ffffff; }
    }
    if root.which == "wheel": Path { x: (parent.width - 20px) / 2; y: 24px; width: 20px; height: 22px; commands: "M 0 0 L 20 0 L 10 22 Z"; fill: #ffffff; viewbox-width: 20; viewbox-height: 22; }
    // (emote rain: which way (in look), from where (in spot): all over, or out of a spot)
    if root.which == "emoterain": Rectangle {
        y: 22px;
        height: parent.height - 22px;
        clip: true;
        property <string> dir: root.look == "" ? "down" : root.look;
        property <bool> spotted: root.spot != "" && root.spot != "all";
        property <float> sx: root.spot == "bl" || root.spot == "tl" ? 0.12 : root.spot == "br" || root.spot == "tr" ? 0.88 : 0.5;
        property <float> sy: root.spot == "tl" || root.spot == "tr" ? 0.15 : root.spot == "c" || root.spot == "custom" ? 0.5 : 0.88;
        for k in 12: Glyph {
            property <float> lag: mod(k * 0.37, 1);
            property <float> t: Theme.motion ? mod(animation-tick() / 1ms / (parent.dir == "burst" ? 1800 : parent.dir == "fountain" ? 2600 : 4200) + self.lag, 1) : self.lag;
            // (a spread for each: along an edge, or an angle out of the spot)
            property <float> lane: 0.06 + mod(k * 0.29, 0.9);
            property <angle> a: parent.dir == "burst" ? k * 30deg : parent.dir == "fountain" ? -90deg + (mod(k * 0.53, 1) - 0.5) * 60deg
                : (parent.dir == "up" ? -90deg : parent.dir == "left" ? 180deg : parent.dir == "right" ? 0deg : 90deg) + (mod(k * 0.41, 1) - 0.5) * 50deg;
            property <length> ox: parent.spotted || parent.dir == "burst" || parent.dir == "fountain" ? parent.width * (parent.spotted ? parent.sx : 0.5) : 0px;
            property <length> oy: parent.spotted || parent.dir == "burst" || parent.dir == "fountain" ? parent.height * (parent.spotted ? parent.sy : (parent.dir == "fountain" ? 1 : 0.5)) : 0px;
            property <length> reach: parent.dir == "burst" ? 110px : parent.width;
            d: mod(k, 3) == 0 ? Icons.heart-out : mod(k, 3) == 1 ? Icons.star-out : Icons.chat;
            width: 24px;
            height: 24px;
            x: parent.dir == "float" ? (parent.spotted ? self.ox : parent.width * self.lane) + sin(self.t * 360deg + k * 40deg) * 14px - 12px
                : parent.spotted || parent.dir == "burst" || parent.dir == "fountain" ? self.ox + cos(self.a) * self.t * self.reach * (parent.dir == "fountain" ? 0.5 : 1) - 12px
                : parent.dir == "left" ? parent.width + 30px - self.t * (parent.width + 60px) : parent.dir == "right" ? -30px + self.t * (parent.width + 60px) : parent.width * self.lane;
            y: parent.dir == "float" ? (parent.spotted ? self.oy : parent.height + 20px) - self.t * (parent.height * 0.9) - 12px
                : parent.dir == "fountain" ? self.oy - 12px + sin(self.a) * self.t * parent.height * 1.4 + self.t * self.t * parent.height * 1.5
                : parent.spotted || parent.dir == "burst" ? self.oy + sin(self.a) * self.t * self.reach - 12px
                : parent.dir == "up" ? parent.height + 30px - self.t * (parent.height + 60px) : parent.dir == "left" || parent.dir == "right" ? parent.height * self.lane - 12px : -30px + self.t * (parent.height + 40px);
            fill: mod(k, 2) == 0 ? root.c1 : root.c2;
            opacity: parent.dir == "burst" ? 1 - self.t : 0.95;
        }
    }
    // (a GIF set: a stand-in for it, where it'll go)
    if root.gif: Rectangle {
        width: 46px;
        height: 40px;
        x: root.which == "wheel" ? parent.width / 2 + 70px : pan.x + (pan.width - self.width) / 2;
        y: root.which == "wheel" ? 30px : max(20px, pan.y - 34px);
        border-radius: 9px;
        background: #ffffff2e;
        border-width: 1px;
        border-color: #ffffff70;
        Text { text: "GIF"; color: #ffffff; font-size: 13px; font-weight: 900; }
    }
    pan := Rectangle {
        visible: root.which != "wheel" && root.which != "emoterain";
        width: root.which == "goals" ? min(parent.width - 40px, 420px) : root.which == "raid" ? min(parent.width - 40px, 380px) : min(parent.width - 40px, 360px);
        height: inner.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + 8px;
        border-radius: root.comic ? 6px : root.t == "pastel" ? 20px : root.t == "y2k" ? 6px : root.t == "pixel" ? 0px : root.t == "sticker" ? 18px : 14px;
        background: root.t == "glass" ? #ffffff24 : root.t == "neon" ? #080614e0 : root.comic || root.t == "sticker" ? #ffffff : root.t == "minimal" ? transparent
            : root.t == "pastel" ? root.c1.mix(#fffafc, 0.12) : root.t == "y2k" ? #fdf6ff : root.t == "pixel" ? #1b1030 : root.t == "edge" ? #0c0a18b3 : #0a0814d1;
        border-width: root.t == "glass" ? 1px : root.t == "neon" || root.t == "y2k" ? 2px : root.comic || root.t == "pastel" || root.t == "pixel" ? 3px : root.t == "edge" ? 1.5px : root.t == "sticker" ? 4px : 0px;
        border-color: root.t == "neon" || root.t == "edge" ? root.c1 : root.comic || root.t == "y2k" ? #2b1b40 : root.t == "pastel" ? root.c1.mix(#ffffff, 0.45) : root.t == "pixel" || root.t == "sticker" ? #f4f0ff : #ffffff48;
        drop-shadow-blur: root.t == "neon" || root.t == "edge" ? 16px : root.t == "sticker" || root.t == "pastel" ? 12px : 0px;
        drop-shadow-offset-x: root.t == "y2k" ? 3px : 0px;
        drop-shadow-offset-y: root.t == "y2k" ? 3px : 0px;
        drop-shadow-color: root.t == "y2k" ? #2b1b40 : root.t == "sticker" || root.t == "pastel" ? #00000060 : root.c1;
        // (Y2K's title bar)
        if root.t == "y2k": Rectangle {
            y: 0;
            height: 14px;
            background: @linear-gradient(90deg, #ff9ad5 0%, #9ad0ff 100%);
            Rectangle { y: parent.height - 2px; height: 2px; background: #2b1b40; }
            Text { x: parent.width - self.width - 6px; text: "–  □  ×"; color: #2b1b40; font-size: 8px; font-weight: 900; }
        }
        inner := VerticalLayout {
            padding: 14px;
            spacing: 8px;
            // (shapes: three side by side, filling; the liquid's level, the jar's drops, the hourglass's sand)
            if root.which == "goals" && root.shapes: HorizontalLayout {
                alignment: center;
                spacing: 26px;
                for g[i] in [{ n: "Followers", p: 0.7 }, { n: "Subs", p: 0.45 }, { n: "Bits", p: 0.85 }]: VerticalLayout {
                    spacing: 4px;
                    property <float> lv: g.p * (0.55 + 0.45 * root.fill);
                    Rectangle {
                        width: 58px;
                        height: root.look == "hourglass" ? 74px : 62px;
                        // (the glass, rounded; what's in it rising from the bottom)
                        if root.look != "hourglass": Rectangle {
                            border-radius: 12px;
                            border-width: 2px;
                            border-color: root.comic ? #111111 : #ffffffe0;
                            background: #ffffff1a;
                            clip: true;
                            if root.look == "liquid": Rectangle {
                                y: parent.height * (1 - lv);
                                height: parent.height * lv;
                                background: root.c1.mix(root.c2, 0.5);
                            }
                            if root.look == "jar": Rectangle {
                                for d in 18: Rectangle {
                                    property <int> r: floor(d / 6);
                                    visible: d < round(lv * 18);
                                    width: 9px;
                                    height: 9px;
                                    border-radius: 4.5px;
                                    x: 4px + mod(d, 6) * 8px + (mod(self.r, 2) == 1 ? 3px : 0px);
                                    y: parent.height - 12px - self.r * 8px;
                                    background: mod(d, 3) == 0 ? root.c1 : mod(d, 3) == 1 ? root.c2 : #ffd36e;
                                }
                            }
                        }
                        if root.look != "hourglass": Rectangle { y: -7px; width: 34px; height: 7px; border-radius: 2px; border-width: 2px; border-color: root.comic ? #111111 : #ffffffe0; }
                        // (the hourglass: two bulbs, sand leaving the top and piling at the bottom)
                        if root.look == "hourglass": Rectangle {
                            Rectangle { x: 14px; y: 36px - (1 - lv) * 26px; width: 30px; height: (1 - lv) * 26px; background: #e9bf6e; }
                            Rectangle { x: 14px; y: 70px - lv * 26px; width: 30px; height: lv * 26px; background: #e9bf6e; }
                            Path {
                                width: 58px;
                                height: 74px;
                                viewbox-width: 58;
                                viewbox-height: 74;
                                fill: transparent;
                                stroke: root.comic ? #111111 : #ffffffe0;
                                stroke-width: 2px;
                                commands: "M 4 2 L 54 2 M 4 72 L 54 72 M 10 2 C 10 22 26 30 28 37 C 26 44 10 52 10 72 M 48 2 C 48 22 32 30 30 37 C 32 44 48 52 48 72";
                            }
                        }
                    }
                    Text { text: g.n; color: root.ink; font-size: 11px; font-weight: 700; horizontal-alignment: center; }
                }
            }
            if root.which == "goals" && !root.rings && !root.shapes: VerticalLayout {
                spacing: 8px;
                for g[i] in [{ n: "Followers", a: 7, b: 10 }, { n: "Subs", a: 3, b: 5 }, { n: "Bits", a: 650, b: 1000 }]: VerticalLayout {
                    spacing: 3px;
                    HorizontalLayout { Text { text: g.n; color: root.ink; font-size: 13px; font-weight: 700; horizontal-stretch: 1; } Text { text: g.a + " / " + g.b; color: root.ink.with-alpha(0.8); font-size: 12px; } }
                    Rectangle {
                        height: 9px;
                        border-radius: 5px;
                        background: root.comic ? #0000001f : #ffffff29;
                        Rectangle { x: 0; width: parent.width * min(1, g.a / g.b * (0.6 + 0.4 * root.fill)); border-radius: 5px; background: root.c1.mix(root.c2, 1 - i * 0.3); }
                    }
                }
            }
            if root.which == "goals" && root.rings: HorizontalLayout {
                alignment: center;
                spacing: 22px;
                for g in [{ n: "Followers", p: 70 }, { n: "Subs", p: 60 }, { n: "Bits", p: 65 }]: VerticalLayout {
                    spacing: 4px;
                    Rectangle {
                        width: 64px;
                        height: 64px;
                        border-radius: 32px;
                        border-width: 6px;
                        border-color: root.c1;
                        Text { text: g.p + "%"; color: root.ink; font-size: 14px; font-weight: 800; }
                    }
                    Text { text: g.n; color: root.ink; font-size: 11px; horizontal-alignment: center; }
                }
            }
            // (Name That Tune: the hint filling in, the time running down)
            if root.which == "tune": VerticalLayout {
                spacing: 6px;
                Text { text: "NAME THAT TUNE: TYPE THE SONG OR THE ARTIST"; color: root.ink.with-alpha(0.75); font-size: 10px; horizontal-alignment: center; }
                Text {
                    text: root.fill < 0.33 ? "M_ _____ ___" : root.fill < 0.66 ? "Mr B______ ___" : "Mr Bl_e S_y";
                    color: root.ink;
                    font-size: 22px;
                    font-weight: 800;
                    letter-spacing: 3px;
                    horizontal-alignment: center;
                }
                Rectangle {
                    height: 7px;
                    border-radius: 4px;
                    background: root.comic ? #0000001f : #ffffff29;
                    Rectangle { x: 0; width: parent.width * (1 - root.fill); border-radius: 4px; background: root.c1.mix(root.c2, 0.5); }
                }
            }
            if root.which == "hype" || root.which == "voteskip": VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    Text { text: root.which == "hype" ? (root.look == "meter" ? "Hype" : "HYPE TRAIN") : "Skip this song? Type !skip"; color: root.ink; font-size: 14px; font-weight: 700; horizontal-stretch: 1; }
                    Text { text: root.which == "hype" ? "Level 3" : "3 / 5"; color: root.ink; font-size: 15px; font-weight: 800; }
                }
                Rectangle {
                    height: 12px;
                    border-radius: 6px;
                    background: root.comic ? #0000001f : #ffffff29;
                    Rectangle { x: 0; width: parent.width * (root.which == "hype" ? 0.25 + 0.7 * root.fill : 0.6); border-radius: 6px; background: root.c1.mix(root.c2, 0.4); }
                }
                // (the train's: who gave the most, where it's come from, the time it has left)
                if root.which == "hype" && root.look != "meter": HorizontalLayout {
                    spacing: 6px;
                    Text { text: "Top: PixelPanda"; color: root.ink.with-alpha(0.85); font-size: 11px; horizontal-stretch: 1; }
                    Glyph { d: Icons.twitch; width: 12px; height: 12px; fill: root.ink.with-alpha(0.85); }
                    Glyph { d: Icons.kick; width: 12px; height: 12px; fill: root.ink.with-alpha(0.85); }
                    Text { text: (4 - floor(root.fill * 4)) + ":" + (floor(59 - mod(root.fill * 240, 60)) < 10 ? "0" : "") + floor(59 - mod(root.fill * 240, 60)); color: root.ink; font-size: 11px; font-weight: 800; }
                }
            }
            if root.which == "leaderboard": VerticalLayout {
                spacing: 5px;
                Text { text: "TOP POINTS"; color: root.ink.with-alpha(0.75); font-size: 11px; letter-spacing: 1.2px; }
                for p[i] in [{ n: "PixelPanda", s: 4820 }, { n: "Nova", s: 3610 }, { n: "Zed", s: 2950 }, { n: "quietcat", s: 1200 }]: HorizontalLayout {
                    spacing: 10px;
                    Rectangle { width: 22px; height: 22px; border-radius: 11px; background: root.c1.mix(root.c2, 1 - i * 0.25); Text { text: i + 1; color: #ffffff; font-size: 11px; font-weight: 800; } }
                    Text { text: p.n; color: root.ink; font-size: 14px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                    Text { text: p.s; color: root.ink.with-alpha(0.85); font-size: 13px; vertical-alignment: center; }
                }
            }
            if root.which == "timer": VerticalLayout {
                alignment: center;
                Text { text: "SUBATHON"; color: root.ink.with-alpha(0.75); font-size: 11px; letter-spacing: 1.5px; horizontal-alignment: center; }
                Text { text: Theme.motion ? "59:" + (59 - mod(floor(animation-tick() / 1000ms), 60) < 10 ? "0" : "") + (59 - mod(floor(animation-tick() / 1000ms), 60)) : "59:32"; color: root.ink; font-size: 40px; font-weight: 800; horizontal-alignment: center; }
            }
            if root.which == "latest": HorizontalLayout {
                spacing: 12px;
                Rectangle { width: 44px; height: 44px; border-radius: 10px; background: root.c1.mix(root.c2, 0.5); Glyph { d: Icons.heart-out; width: 24px; height: 24px; fill: #ffffff; } }
                VerticalLayout { alignment: center; Text { text: "LATEST FOLLOWER"; color: root.ink.with-alpha(0.75); font-size: 11px; letter-spacing: 1.2px; } Text { text: "PixelPanda"; color: root.ink; font-size: 20px; font-weight: 800; } }
            }
            if root.which == "raid": VerticalLayout {
                spacing: 6px;
                alignment: center;
                Text { text: "GO FOLLOW"; color: root.c1; font-size: 13px; font-weight: 900; letter-spacing: 4px; horizontal-alignment: center; }
                Text { text: "RaidLeader"; color: root.ink; font-size: 28px; font-weight: 800; horizontal-alignment: center; }
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: rt.preferred-width + 28px;
                        height: 30px;
                        border-radius: 15px;
                        background: root.c1.mix(root.c2, 0.5);
                        rt := Text { text: "twitch.tv/raidleader"; color: #ffffff; font-size: 13px; font-weight: 700; }
                    }
                }
                Rectangle { height: 60px; border-radius: 8px; background: #000000; Text { text: "Their clip plays here"; color: #ffffff80; font-size: 11px; } }
            }
        }
    }
}

/// One message, as the Multichat Overlay draws it in its theme
component ChatRow inherits Rectangle {
    in property <ChatSample> m;
    in property <ChatLook> look;
    property <length> fs: clamp(root.look.size * 0.7, 10, 30) * 1px;
    property <color> pc: root.m.kick ? #53fc18 : #a970ff;
    property <string> st: root.look.style;
    property <bool> comic: root.st == "comic";
    property <bool> term: root.st == "terminal";
    property <bool> y2k: root.st == "y2k";
    property <bool> pastel: root.st == "pastel";
    property <bool> pixel: root.st == "pixel";
    property <bool> mono: root.term || root.pixel;
    // (light ones, with dark words)
    property <bool> light: root.comic || root.y2k || root.pastel;
    // (the name on a line of its own: Cards' and Y2K's always, the rest when it's set to)
    property <bool> own-line: root.st == "cards" || root.y2k || root.look.above;
    height: rowl.preferred-height;
    clip: root.y2k;
    border-radius: root.st == "bubbles" ? 4px : root.term ? 3px : root.comic ? 16px : root.pastel ? 16px : root.y2k ? 6px : root.pixel || root.st == "minimal" ? 0px : root.st == "edge" ? 14px : 11px;
    background: root.st == "plain" ? #0a0c12.with-alpha(root.look.bg) : root.st == "bubbles" ? #0a0c12.with-alpha(max(root.look.bg, 0.55)) : root.st == "glass" ? #ffffff1f
        : root.st == "neon" ? #060412b8 : root.st == "cards" ? #191c28 : root.term ? #000000c7 : root.comic ? #ffffff : root.st == "edge" ? #0c0a18a8
        : root.y2k ? #fdf6ff : root.pastel ? root.m.colour.mix(#fffafc, 0.18) : root.pixel ? #1b1030 : transparent;
    border-width: root.st == "glass" || root.st == "neon" ? 1px : root.comic || root.y2k ? 2px : root.st == "edge" ? 1.5px : root.pixel ? 3px : 0px;
    border-color: root.st == "neon" ? root.pc : root.comic || root.y2k ? #111111 : root.st == "edge" ? root.pc.with-alpha(0.75) : root.pixel ? #f4f0ff : #ffffff38;
    drop-shadow-blur: root.st == "neon" ? 10px : root.st == "cards" ? 12px : root.st == "edge" ? 8px : 0px;
    drop-shadow-offset-x: root.y2k ? 3px : 0px;
    drop-shadow-offset-y: root.y2k ? 3px : 0px;
    drop-shadow-color: root.st == "neon" || root.st == "edge" ? root.pc.with-alpha(0.6) : root.y2k ? #2b1b40 : #00000070;
    // (Bubbles', Cards' and Terminal's coloured edge; Y2K's title bar; Pixel's inner edge)
    if root.st == "bubbles" || root.term: Rectangle { x: 0; width: root.term ? 2px : 3px; background: root.term ? #3cff6e : root.pc; border-radius: 2px; }
    if root.st == "cards": Rectangle { y: 0; height: 3px; background: root.pc; }
    if root.y2k: Rectangle {
        y: 0;
        height: root.fs * 0.8 * 1.35 + 6px;
        background: @linear-gradient(90deg, #ff9ad5 0%, #9ad0ff 100%);
        Rectangle { y: parent.height - 2px; height: 2px; background: #2b1b40; }
        Text { x: parent.width - self.width - 8px; text: "–  □  ×"; color: #2b1b40; font-size: root.fs * 0.6; font-weight: 900; }
    }
    if root.pixel: Rectangle { x: 3px; y: 3px; width: parent.width - 6px; height: parent.height - 6px; border-width: 2px; border-color: root.pc; }
    rowl := HorizontalLayout {
        padding-left: root.st == "minimal" ? 4px : 10px;
        padding-right: 10px;
        padding-top: root.st == "minimal" ? 2px : root.y2k ? 3px : 6px;
        padding-bottom: root.st == "minimal" ? 2px : 6px;
        spacing: 7px;
        if root.look.marks: VerticalLayout { alignment: start; padding-top: 2px; Glyph { d: root.m.kick ? Icons.kick : Icons.twitch; width: root.y2k ? root.fs * 0.8 : root.fs; height: self.width; fill: root.y2k ? #2b1b40 : root.pc; } }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: root.y2k ? 5px : 1px;
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                if root.look.badges && root.m.badge != "": Rectangle {
                    width: bt.preferred-width + 6px;
                    height: root.fs * 0.8;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3px;
                    background: root.m.badge == "MOD" ? #3ccd6c : root.m.badge == "VIP" ? #e05ce0 : root.m.badge == "SUB" ? #7aa2ff : #ff4f4f;
                    bt := Text { text: root.m.badge; color: #111111; font-size: root.fs * 0.55; font-weight: 800; }
                }
                // (the name: Pastel's in a pill of its colour)
                Rectangle {
                    width: nt.preferred-width + (root.pastel ? 14px : 0px);
                    height: nt.preferred-height;
                    border-radius: self.height / 2;
                    background: root.pastel ? root.m.colour.mix(#ffffff, 0.55) : transparent;
                    nt := Text {
                        text: root.m.name + (root.own-line || root.pastel ? "" : ":");
                        color: root.y2k || root.pastel ? #2a1a3a : root.m.colour;
                        font-size: root.st == "cards" || root.y2k ? root.fs * 0.8 : root.st == "minimal" || root.pastel ? root.fs * 0.85 : root.fs;
                        font-weight: 800;
                        font-family: root.mono ? "Consolas" : "";
                    }
                }
                if !root.own-line: Text { text: root.m.text; color: root.light ? #2b1b40 : root.term ? #b6ffbe : #ffffff; font-size: root.fs; font-weight: 500; wrap: word-wrap; horizontal-stretch: 1; font-family: root.mono ? "Consolas" : ""; }
            }
            if root.own-line: Text { text: root.m.text; color: root.light ? #2b1b40 : root.term ? #b6ffbe : #ffffff; font-size: root.fs; font-weight: 500; wrap: word-wrap; font-family: root.mono ? "Consolas" : ""; }
        }
    }
}

/// The Multichat Overlay as it'll look in OBS: over a stream, made-up chat coming in every couple of seconds
component ChatPreview inherits Rectangle {
    in property <ChatLook> look;
    in property <[ChatSample]> samples;
    height: 230px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;
    // (two colours only: a third stop drew a seam across it in the software renderer)
    Rectangle { background: @linear-gradient(135deg, #2b3550 0%, #3a2b48 100%); }
    Caps { r: 14px; outside: Theme.bg; tl: #2b3550; tr: #33304c; bl: #33304c; br: #3a2b48; top: true; bottom: true; }
    Text { x: 12px; y: 8px; text: "A preview, with made-up chat"; color: #ffffffa0; font-size: 11px; }
    // (a new one every 2 s: the newest is the turn's, the rest the ones before it)
    property <int> n: max(1, root.samples.length);
    property <int> turn: Theme.motion ? floor(animation-tick() / 2000ms) : 4;
    property <float> into: Theme.motion ? mod(animation-tick() / 1ms, 2000) / 350 : 1;
    property <float> come: clamp(root.into, 0, 1);
    VerticalLayout {
        x: 14px;
        y: 26px;
        width: parent.width * 0.55;
        height: parent.height - 34px;
        alignment: root.look.top ? LayoutAlignment.start : LayoutAlignment.end;
        spacing: 6px;
        // (newest at the bottom: the oldest first; at the top, the newest first)
        for k in 5: ChatRow {
            property <int> age: root.look.top ? k : 4 - k;
            m: root.samples[mod(root.turn - self.age + root.n * 100, root.n)];
            look: root.look;
            opacity: self.age == 0 ? root.come : 1;
        }
    }
}

/// One platform, as the Social Plug draws it (Card, Pill or Minimal; in its colours or not)
component SocialCard inherits Rectangle {
    in property <SocialItem> it;
    in property <SocialLook> look;
    property <bool> pill: root.look.style == "pill";
    property <bool> bare: root.look.style == "minimal";
    property <bool> glass: root.look.style == "glass";
    property <bool> neon: root.look.style == "neon";
    property <bool> comic: root.look.style == "comic";
    // (Coloured: only Card's and Pill's panel; the others have their own)
    property <bool> coloured: root.look.coloured && (root.look.style == "card" || root.pill);
    height: 58px;
    width: row.preferred-width;
    border-radius: !root.look.rounded ? 0px : root.pill ? self.height / 2 : 12px;
    background: root.bare ? transparent : root.glass ? #ffffff24 : root.neon ? #080614e0 : root.comic ? #ffffff : root.coloured ? root.it.c1.mix(root.it.c2, 0.5) : #0a0814d1;
    border-width: root.glass ? 1px : root.neon ? 2px : root.comic ? 3px : 0px;
    border-color: root.neon ? root.it.c1 : root.comic ? #111111 : #ffffff48;
    drop-shadow-blur: root.neon ? 14px : 0px;
    drop-shadow-color: root.it.c1;
    clip: !root.neon;
    row := HorizontalLayout {
        padding: 9px;
        padding-right: root.pill ? 22px : 16px;
        spacing: 11px;
        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: !root.look.rounded ? 0px : root.pill ? 20px : 10px;
            // (solid blends, not gradients: the software renderer would draw them square-cornered)
            background: root.neon ? transparent : root.coloured && !root.bare ? #00000038 : root.it.c1.mix(root.it.c2, 0.5);
            border-width: root.neon || root.comic ? 2px : 0px;
            border-color: root.neon ? root.it.c1 : #111111;
            if root.it.d != "": Glyph { d: root.it.d; width: 25px; height: 25px; fill: #ffffff; }
            if root.it.d == "": Text { text: root.it.letter; color: #ffffff; font-size: 21px; font-weight: 800; }
        }
        VerticalLayout {
            alignment: center;
            Text { text: root.it.handle; color: root.comic ? #111111 : #ffffff; font-size: 17px; font-weight: 700; overflow: elide; }
            Text { text: root.it.name.to-uppercase(); color: root.comic ? #111111bf : #ffffffbf; font-size: 11px; letter-spacing: 0.5px; }
        }
    }
}

/// The Social Plug as it'll look in OBS: over a stream, one at a time in turn (coming in as its Animation
/// says) or all together; shown while its settings are, as they're changed
component SocialPreview inherits Rectangle {
    in property <[SocialItem]> items;
    in property <SocialLook> look;
    height: 150px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;
    // (two colours only: a third stop drew a seam across it in the software renderer)
    Rectangle { background: @linear-gradient(135deg, #2b3550 0%, #3a2b48 100%); }
    // (its corners rounded off over the stream behind it: the software renderer draws a gradient square)
    Caps { r: 14px; outside: Theme.bg; tl: #2b3550; tr: #33304c; bl: #33304c; br: #3a2b48; top: true; bottom: true; }
    if root.look.sample: Text { x: 12px; y: 8px; text: "Sample platforms: add yours below to see them here."; color: #ffffffb0; font-size: 11px; }
    // (one at a time: which one's up, and how far into its turn)
    property <int> secs: max(3, root.look.secs);
    property <int> ms: Theme.motion ? mod(animation-tick() / 1ms, root.secs * 1000 * max(1, root.items.length)) : 1000;
    property <int> at: root.items.length > 0 ? floor(root.ms / (root.secs * 1000)) : 0;
    property <float> into: root.ms - root.at * root.secs * 1000;
    // (0 to 1: coming in over its first 0.65 s, going out over its last 0.5 s)
    property <float> come: !Theme.motion || root.look.motion == "none" ? 1 : clamp(root.into / 650, 0, 1);
    property <float> go: !Theme.motion || root.look.motion == "none" ? 0 : clamp((root.into - (root.secs * 1000 - 500)) / 500, 0, 1);
    property <float> ease: 1 - (1 - root.come) * (1 - root.come) * (1 - root.come);
    property <length> pad: 24px;
    if !root.look.all && root.items.length > 0: SocialCard {
        it: root.items[root.at];
        look: root.look;
        property <length> home: root.look.align == "left" ? root.pad : root.look.align == "right" ? root.width - self.width - root.pad : (root.width - self.width) / 2;
        x: self.home + (root.look.motion == "slide" ? (1 - root.ease) * -32px + root.go * 32px : 0px);
        y: (root.height - self.height) / 2 + (root.look.motion == "rise" || root.look.motion == "type" ? (1 - root.ease) * 14px - root.go * 10px : 0px);
        opacity: root.come * (1 - root.go);
        // (Pop and Flip: grown or turned in from nothing, as near as a flat preview shows it)
        transform-scale-x: root.look.motion == "pop" ? 0.5 + 0.5 * root.ease : 1;
        transform-scale-y: root.look.motion == "pop" ? 0.5 + 0.5 * root.ease : root.look.motion == "flip" ? max(0.05, root.ease) * (1 - root.go) + (root.go > 0 ? 0 : 0) : 1;
    }
    // (all together: only made while it's chosen, so nothing of it's drawn otherwise)
    if root.look.all: HorizontalLayout {
        x: root.look.align == "left" ? root.pad : root.look.align == "right" ? root.width - self.preferred-width - root.pad : (root.width - self.preferred-width) / 2;
        y: (root.height - 58px) / 2;
        width: self.preferred-width;
        height: 58px;
        spacing: 10px;
        for it in root.items: SocialCard { it: it; look: root.look; }
    }
}

component LyricsPreview inherits Rectangle {
    in property <LyricsLook> look;
    height: 190px;
    border-radius: 14px;
    background: #1d2230;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;
    // (a game behind it, to read it over; two colours only: a third stop drew a seam across it)
    Rectangle { background: @linear-gradient(135deg, #2b3550 0%, #3a2b48 100%); }
    property <length> fs: clamp(root.look.size * 0.42, 12, 34) * 1px;
    property <color> hi: root.look.own-hi ? root.look.hi : Theme.accent;
    property <TextHorizontalAlignment> al: root.look.align == "left" ? TextHorizontalAlignment.left : root.look.align == "right" ? TextHorizontalAlignment.right : TextHorizontalAlignment.center;
    property <[string]> words: root.look.upper ? ["THE LINE JUST SUNG", "THE LINE BEING SUNG", "THE NEXT LINE", "AND THE ONE AFTER"] : ["The line just sung", "The line being sung", "The next line", "And the one after"];
    lcol := VerticalLayout {
        padding: 16px;
        spacing: 2px;
        alignment: root.look.place == "top" ? LayoutAlignment.start : root.look.place == "bottom" ? LayoutAlignment.end : LayoutAlignment.center;
        if root.look.title: Text { text: "Song name · Artist"; color: root.look.color.with-alpha(0.7); font-size: root.fs * 0.45; horizontal-alignment: root.al; }
        Rectangle {
            height: lines.preferred-height + (root.look.boxed ? 16px : 0px);
            if root.look.boxed: Rectangle { border-radius: 10px; background: root.look.box-color.with-alpha(root.look.box-opacity); }
            lines := VerticalLayout {
                y: root.look.boxed ? 8px : 0px;
                padding-left: root.look.boxed ? 12px : 0px;
                padding-right: root.look.boxed ? 12px : 0px;
                spacing: 2px;
                for t[k] in root.words: Rectangle {
                    // (which show: the line before, if on; the sung one; then as many as it shows)
                    property <bool> shown: (k == 0 && root.look.before) || k == 1 || (k >= 2 && k - 1 < max(1, root.look.lines));
                    height: self.shown ? lt.preferred-height : 0px;
                    visible: self.shown;
                    if root.look.outline: Text { x: 1px; y: 1px; width: parent.width; text: t; font-size: root.fs * (k == 1 ? 1 : 0.85); font-weight: 800; color: root.look.outline-color; horizontal-alignment: root.al; }
                    if root.look.shadow: Text { x: 0px; y: 2px; width: parent.width; text: t; font-size: root.fs * (k == 1 ? 1 : 0.85); font-weight: 800; color: #00000080; horizontal-alignment: root.al; }
                    lt := Text {
                        width: parent.width;
                        text: t;
                        font-size: root.fs * (k == 1 ? 1 : 0.85);
                        font-weight: 800;
                        horizontal-alignment: root.al;
                        // (the sung line: lit, or (karaoke) its first half lit, the rest its own colour)
                        color: k == 1 ? (root.look.style == "highlight" ? root.hi : root.look.color) : root.look.color.with-alpha(max(0.15, root.look.dim));
                    }
                    if k == 1 && root.look.style != "highlight": Rectangle {
                        clip: true;
                        width: parent.width * 0.55;
                        x: root.look.align == "right" ? parent.width * 0.45 : 0px;
                        Text { x: root.look.align == "right" ? -parent.x : 0px; width: lt.width; text: t; font-size: root.fs; font-weight: 800; horizontal-alignment: root.al; color: root.hi; }
                    }
                }
            }
        }
    }
    Text { x: parent.width - self.width - 10px; y: parent.height - self.height - 8px; text: "Preview"; color: #ffffff70; font-size: 10px; }
}

/// (a line between a group's rows)
component GroupLine inherits Rectangle { height: 1px; background: Theme.line; }

component Card inherits Rectangle {
    in property <brush> fill: Theme.panel;
    border-radius: Theme.card-radius;
    background: fill;
    border-width: 1px;
    border-color: Theme.line;
}

// A category on Settings' first page (as Windows' Settings lists them): its icon, its name, what's in it
component CatCard inherits Card {
    in property <string> name;
    in property <string> note;
    in property <string> d;
    callback clicked;
    fill: cta.has-hover ? Theme.elevated : Theme.panel;
    height: 72px;
    cta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 18px;
        VerticalLayout { alignment: center; Glyph { d: root.d; width: 24px; height: 24px; fill: Theme.accent; } }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text { text: root.name; color: Theme.text; font-weight: 700; font-size: 15px; }
            Text { text: root.note; color: Theme.muted; font-size: 12px; overflow: elide; }
        }
        Text { text: "›"; color: Theme.muted; font-size: 26px; vertical-alignment: center; }
    }
}

// A switch in Settings: its name and what it does, its switch; one with settings of its own (a page) opens
// them from its Settings button, or from anywhere on the row; one that's a button (Add a Plugin) is that
component SetRowView inherits Card {
    in property <SetRow> r;
    callback toggle(string);
    callback more(string);
    fill: rta.has-hover && root.r.more ? Theme.elevated : Theme.panel;
    // (under the rest, so the switch and the buttons are still theirs)
    rta := TouchArea { enabled: root.r.more; mouse-cursor: root.r.more ? MouseCursor.pointer : MouseCursor.default; clicked => { root.more(root.r.key); } }
    HorizontalLayout {
        padding: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        padding-left: root.r.sub ? 34px : 16px;
        spacing: 14px;
        if root.r.sub: Rectangle { width: 2px; background: Theme.accent.with-alpha(0.5); }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text { text: root.r.label; color: Theme.text; font-weight: 700; }
            // (its height at the width it gets: wrapped onto more lines in a narrow window, all of it counted)
            if root.r.note != "": Text { text: root.r.note; color: Theme.muted; font-size: 12px; wrap: word-wrap; min-height: self.preferred-height; }
        }
        if root.r.more: VerticalLayout { alignment: center; IconButton { d: Icons.gear; size: 36px; tip: root.r.label + ": its settings"; clicked => { root.more(root.r.key); } } }
        if root.r.button != "": VerticalLayout { alignment: center; Pill { label: root.r.button + " ›"; clicked => { root.more(root.r.key); } } }
        if root.r.button == "": CenterToggle { checked: root.r.on; toggled => { root.toggle(root.r.key); } }
    }
    HiGlow { lit: Hi.label != "" && Hi.label == root.r.label; r: Theme.card-radius; }
}

// ---------- the chatbot's own page (Settings > Streaming > OmniPulse Chatbot) ----------
// The first time: a path of steps (each service connected, or skipped), the one being done open, its steps
// numbered. After that: the bot as it is (its card, a chat to try it in), its services as tiles with a light
// each, what it does as cards with switches, and what it's done lately. A service's details: a sheet over it.

/// The chatbot page's colours and marks, by what they're for (a service, a feature)
global BotLook {
    /// (a tile's own colour, the nth of the theme's)
    public pure function tile(n: int) -> color {
        return Theme.tints.length > 0 ? Theme.tints[mod(n, Theme.tints.length)] : Theme.accent;
    }
    public pure function tint(id: string) -> color {
        return id == "twitch" || id == "twitchbot" ? #a970ff : id == "kick" || id == "kickbot" ? #53fc18 : id == "youtube" ? #ff3355 : id == "obs" ? Theme.accent : id == "meld" ? #ff7a59 : id == "slobs" ? #80f5d2 : id == "streamlabs" ? #4ad295 : id == "streamelements" ? #5ad1ff : id == "kofi" ? #ff5e5b
            : id == "requests" ? Theme.accent : id == "alerts" ? #ff6b8a : id == "points" ? #ffb547 : id == "games" ? #5ad1ff : Theme.accent-2;
    }
    public pure function icon(id: string) -> string {
        return id == "twitch" || id == "twitchbot" ? Icons.twitch : id == "kick" || id == "kickbot" ? Icons.kick : id == "youtube" ? Icons.youtube-mark : id == "obs" || id == "meld" || id == "slobs" || id == "software" ? Icons.broadcast : id == "tips" ? Icons.coins : id == "streamlabs" || id == "streamelements" || id == "kofi" ? Icons.coins
            : id == "requests" ? Icons.playlist-add : id == "alerts" ? Icons.bell : id == "points" ? Icons.coins : id == "games" ? Icons.dice : id == "moderation" ? Icons.shield
            : id == "hype" ? Icons.broadcast : id == "voteskip" ? Icons.next : id == "wheel" ? Icons.dice : id == "leaderboard" ? Icons.coins : id == "emoterain" ? Icons.chat : id == "tune" ? Icons.lyrics
            : id == "goals" ? Icons.check : id == "timer" ? Icons.refresh : id == "latest" ? Icons.heart-out : id == "raid" ? Icons.broadcast : Icons.actions;
    }
}

/// (a change not saved yet: a ring round it, breathing, until it's saved or put back)
component Pulse inherits Rectangle {
    in property <length> r: 12px;
    border-radius: root.r;
    border-width: 2px;
    property <float> ph: Theme.motion ? (1 - cos(animation-tick() / 1.6s * 360deg)) / 2 : 1;
    border-color: Theme.accent.with-alpha(0.3 + 0.55 * self.ph);
    background: Theme.accent.with-alpha(0.04 * self.ph);
}

/// (a light: green working, amber trying or waiting, grey off, red wrong)
component Light inherits Rectangle {
    in property <string> state;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.state == "ok" ? #4ad295 : root.state == "warn" ? #ffb547 : root.state == "bad" ? #ff5c6c : #4a5060;
}

/// One line of a sheet or a step: a heading, a numbered instruction (with its link or something to copy), a
/// box to type in, a switch, or one of the two accounts with its sign-in icons
component BotFieldRow inherits VerticalLayout {
    in property <BotField> f;
    callback set(string, string);
    callback act(string);
    spacing: 4px;
    if root.f.kind == "head": Text { text: root.f.label; color: Theme.muted; font-size: 12px; font-weight: 700; }
    if root.f.kind == "note": Text { text: root.f.label; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
    if root.f.kind == "step": HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 22px;
            height: 22px;
            y: 2px;
            border-radius: 7px;
            background: Theme.elevated;
            border-width: 1px;
            border-color: Theme.line;
            Text { text: "" + root.f.n; color: Theme.muted; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;
            Text { text: root.f.label; color: Theme.text; font-size: 13px; wrap: word-wrap; }
            // (an address to give it, as it must be: shown, and copied with one click)
            if root.f.value != "": HorizontalLayout {
                alignment: start;
                spacing: 6px;
                Rectangle {
                    height: 26px;
                    width: ct.preferred-width + 18px;
                    border-radius: 7px;
                    background: Theme.bg;
                    border-width: 1px;
                    border-color: Theme.line;
                    ct := Text { x: 9px; text: root.f.value; color: Theme.accent.mix(Theme.text, 0.55); font-size: 12px; font-family: "Consolas"; vertical-alignment: center; }
                }
                IconButton { d: Icons.copy; size: 26px; tip: "Copy it"; clicked => { root.act("copy:" + root.f.value); } }
            }
        }
        if root.f.extra != "": IconButton { d: Icons.open; size: 30px; tint: Theme.accent; tip: root.f.note != "" ? root.f.note : "Open it in your browser"; clicked => { root.act("url:" + root.f.extra); } }
    }
    if root.f.kind == "text" || root.f.kind == "password" || root.f.kind == "number": VerticalLayout {
        spacing: 4px;
        Text { text: root.f.label; color: Theme.text; font-weight: 700; font-size: 13px; }
        if root.f.note != "": Text { text: root.f.note; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
        Rectangle {
            clip: true;
            height: 36px;
            border-radius: 9px;
            background: Theme.bg;
            border-width: 1px;
            border-color: inp.has-focus ? Theme.accent : Theme.line;
            if root.f.changed || inp.touched: Pulse { r: 9px; }
            inp := TextInput { property <length> sx; cursor-position-changed(p) => { if (p.x + self.sx < 0px) { self.sx = -p.x; } else if (p.x + self.sx > parent.width - 24px - 2px) { self.sx = parent.width - 24px - 2px - p.x; } } 
                in-out property <bool> touched;
                x: 12px + min(0px, max(parent.width - 24px - self.width, self.sx));
                width: max(parent.width - 24px, self.preferred-width + 4px);
                height: parent.height;
                vertical-alignment: center;
                color: Theme.text;
                font-size: 13px;
                single-line: true;
                input-type: root.f.kind == "password" ? InputType.password : root.f.kind == "number" ? InputType.decimal : InputType.text;
                text: root.f.value;
                edited => { self.touched = true; root.set(root.f.key, self.text); }
            }
            if inp.text == "" && root.f.extra != "": Text { x: 12px; text: root.f.extra; color: Theme.muted.with-alpha(0.6); font-size: 13px; vertical-alignment: center; }
        }
    }
    // (a list, a row each: typed into, taken out, one more added; kept as "a | b | c")
    if root.f.kind == "list" || root.f.kind == "piclist": VerticalLayout {
        spacing: 6px;
        Text { text: root.f.label; color: Theme.text; font-weight: 700; font-size: 13px; }
        if root.f.note != "": Text { text: root.f.note; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
        for it[i] in root.f.opts: HorizontalLayout {
            spacing: 8px;
            Text { width: 22px; text: (i + 1) + "."; color: Theme.muted; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
            Rectangle {
                clip: true;
                horizontal-stretch: 1;
                height: 34px;
                border-radius: 9px;
                background: Theme.bg;
                border-width: 1px;
                border-color: li.has-focus ? Theme.accent : Theme.line;
                li := TextInput { property <length> sx; cursor-position-changed(p) => { if (p.x + self.sx < 0px) { self.sx = -p.x; } else if (p.x + self.sx > parent.width - 24px - 2px) { self.sx = parent.width - 24px - 2px - p.x; } } 
                    x: 12px + min(0px, max(parent.width - 24px - self.width, self.sx));
                    width: max(parent.width - 24px, self.preferred-width + 4px);
                    height: parent.height;
                    vertical-alignment: center;
                    color: Theme.text;
                    font-size: 13px;
                    single-line: true;
                    text: it;
                    edited => { root.act("list:" + root.f.key + ":set:" + i + ":" + self.text); }
                }
            }
            // (a list of pictures: one of yours chosen for the row, copied into OmniPulse)
            if root.f.kind == "piclist": VerticalLayout { alignment: center; Pill { label: "Choose..."; clicked => { root.act("list:" + root.f.key + ":pick:" + i); } } }
            VerticalLayout { alignment: center; IconButton { d: Icons.close; size: 30px; tip: "Take it out"; clicked => { root.act("list:" + root.f.key + ":del:" + i); } } }
        }
        HorizontalLayout {
            alignment: start;
            padding-left: 30px;
            Chip { label: "+ Add one"; on: false; clicked => { root.act("list:" + root.f.key + ":add"); } }
        }
    }
    if root.f.kind == "addr": VerticalLayout {
        spacing: 4px;
        if root.f.note != "": Text { text: root.f.note; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                horizontal-stretch: 1;
                height: 32px;
                border-radius: 8px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.line;
                Text { x: 10px; width: parent.width - 20px; text: root.f.value; color: Theme.text; font-size: 12px; font-family: "Consolas"; overflow: elide; vertical-alignment: center; }
            }
            VerticalLayout { alignment: center; IconButton { d: Icons.copy; size: 32px; tip: "Copy it"; clicked => { root.act("copy:" + root.f.value); } } }
        }
    }
    if root.f.kind == "reset": HorizontalLayout {
        spacing: 12px;
        VerticalLayout { horizontal-stretch: 1; alignment: center; Text { text: root.f.label; color: Theme.text; font-weight: 700; font-size: 13px; } }
        for c in [{ id: "stream", n: "Each Stream" }, { id: "daily", n: "Each Day" }, { id: "weekly", n: "Each Week" }, { id: "monthly", n: "Each Month" }, { id: "never", n: "Never" }]: VerticalLayout { alignment: center; Chip { label: c.n; on: root.f.value == c.id; clicked => { root.set(root.f.key, c.id); } } }
    }
    // (a row of choices, as many as it has)
    if root.f.kind == "chips": VerticalLayout {
        spacing: 6px;
        Text { text: root.f.label; color: Theme.text; font-weight: 700; font-size: 13px; }
        if root.f.note != "": Text { text: root.f.note; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
        HorizontalLayout { spacing: 6px; alignment: start; for c[i] in root.f.opts: Chip { label: c; on: root.f.value == root.f.opt-ids[i]; clicked => { root.set(root.f.key, root.f.opt-ids[i]); } } }
    }
    // (choices too many for a row: a dropdown of them)
    if root.f.kind == "choose": VerticalLayout {
        spacing: 6px;
        Text { text: root.f.label; color: Theme.text; font-weight: 700; font-size: 13px; }
        if root.f.note != "": Text { text: root.f.note; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
        HorizontalLayout { alignment: start; Dropdown { options: root.f.opts; current: root.f.n; picked(k) => { root.set(root.f.key, root.f.opt-ids[k]); } } }
    }
    // (a Suite widget's preview: which one, its theme in extra, the Goals' look in label)
    if root.f.kind == "campreview": CamPreview { }
    if root.f.kind == "panelpreview": PanelPreview { }
    if root.f.kind == "hudedit": HudEditor { act(a) => { root.act(a); } }
    if root.f.kind == "suiteprev": SuitePreview { which: root.f.value; theme: root.f.extra; rings: root.f.label == "rings"; look: root.f.label; own-c1: root.f.c1; own-c2: root.f.c2; gif: root.f.n == 1; spot: root.f.key; }
    if root.f.kind == "chips2": HorizontalLayout {
        spacing: 12px;
        VerticalLayout { horizontal-stretch: 1; alignment: center; Text { text: root.f.label; color: Theme.text; font-weight: 700; font-size: 13px; } }
        for c in [{ id: "bars", n: "Bars" }, { id: "rings", n: "Rings" }]: VerticalLayout { alignment: center; Chip { label: c.n; on: root.f.value == c.id; clicked => { root.set(root.f.key, c.id); } } }
    }
    if root.f.kind == "who": HorizontalLayout {
        spacing: 12px;
        VerticalLayout { horizontal-stretch: 1; alignment: center; Text { text: root.f.label; color: Theme.text; font-weight: 700; font-size: 13px; } }
        for c in [{ id: "everyone", n: "Everyone" }, { id: "subscribers", n: "Subscribers" }, { id: "vips", n: "VIPs" }, { id: "mods", n: "Moderators" }]: VerticalLayout { alignment: center; Chip { label: c.n; on: root.f.value == c.id; clicked => { root.set(root.f.key, c.id); } } }
    }
    // (a part that opens: its mark, its name, whether it's set up, and an arrow; clicked, open or shut)
    if root.f.kind == "fold": Rectangle {
        height: fdl.preferred-height;
        fdta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.act("fold:" + root.f.key); } }
        fdl := HorizontalLayout {
            spacing: 12px;
            VerticalLayout { alignment: center; Glyph { d: BotLook.icon(root.f.key); width: 22px; height: 22px; fill: BotLook.tint(root.f.key); } }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 3px;
                Text { text: root.f.label; color: Theme.text; font-weight: 700; font-size: 14px; }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    VerticalLayout { alignment: center; Light { state: root.f.value; } }
                    Text { text: root.f.note; color: Theme.muted; font-size: 12px; }
                }
            }
            VerticalLayout { alignment: center; Chevron { open: root.f.extra == "open"; tint: fdta.has-hover ? Theme.text : Theme.muted; } }
        }
    }
    if root.f.kind == "link": HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text { text: root.f.label; color: Theme.text; font-weight: 700; font-size: 13px; }
            if root.f.note != "": Text { text: root.f.note; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
        }
        VerticalLayout { alignment: center; IconButton { d: Icons.open; size: 34px; tint: Theme.accent; tip: "Open"; clicked => { root.act(root.f.extra); } } }
    }
    if root.f.kind == "toggle": Rectangle {
        height: tl.preferred-height;
        if root.f.changed: Pulse { x: -8px; width: parent.width + 16px; height: parent.height + 8px; y: -4px; r: 10px; }
        tl := HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text { text: root.f.label; color: Theme.text; font-weight: 700; font-size: 13px; }
                if root.f.note != "": Text { text: root.f.note; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
            }
            CenterToggle { checked: root.f.value == "true"; toggled => { root.set(root.f.key, self.checked ? "true" : "false"); } }
        }
    }
    // an account: who's signed in (or nobody), and its sign-in opened here or copied for another browser
    if root.f.kind == "account": Rectangle {
        height: 54px;
        border-radius: 12px;
        background: Theme.bg.mix(Theme.panel, 0.5);
        border-width: 1px;
        border-color: root.f.value != "" ? BotLook.tint(root.f.extra) : Theme.line;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 8px;
            spacing: 10px;
            Rectangle {
                width: 30px;
                height: 30px;
                y: (parent.height - self.height) / 2;
                border-radius: 15px;
                background: root.f.value != "" ? BotLook.tint(root.f.extra).with-alpha(0.18) : Theme.elevated;
                Glyph { d: root.f.note == "bot" ? Icons.robot : Icons.person; width: 18px; height: 18px; x: 6px; y: 6px; fill: root.f.value != "" ? BotLook.tint(root.f.extra) : Theme.muted; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;
                Text { text: root.f.label; color: Theme.text; font-weight: 700; font-size: 13px; }
                Text { text: root.f.value != "" ? "Signed in as " + root.f.value : (root.f.note == "bot" ? "Optional: without one, replies come from your channel" : "Not signed in"); color: Theme.muted; font-size: 12px; overflow: elide; }
            }
            VerticalLayout { alignment: center; IconButton { d: Icons.open; size: 34px; tint: Theme.accent; tip: root.f.value != "" ? "Sign in again, here" : "Sign in, in your browser"; clicked => { root.act("in:" + root.f.key); } } }
            VerticalLayout { alignment: center; IconButton { d: Icons.link; size: 34px; tip: "Copy the sign-in link instead. Open it in a private window or another browser to sign in as a different account."; clicked => { root.act("link:" + root.f.key); } } }
            if root.f.value != "": VerticalLayout { alignment: center; IconButton { d: Icons.logout; size: 34px; tip: "Sign this account out"; clicked => { root.act("out:" + root.f.key); } } }
        }
    }
}

/// One of what the chatbot does: its switch (or where it's set up)
component FeatCard inherits Rectangle {
    in property <BotFeat> c;
    in property <color> tint: Theme.accent;
    callback set(string, string);
    callback act(string);
    height: 74px;
    border-radius: 16px;
    background: Theme.panel.mix(root.tint, 0.9);
    border-width: 1px;
    border-color: root.c.on ? root.tint.with-alpha(0.6) : root.tint.with-alpha(0.22);
    clip: true;
    if root.c.changed: Pulse { r: 16px; }
    HorizontalLayout {
        padding: 14px;
        spacing: 12px;
        Rectangle {
            width: 40px; height: 40px; y: (parent.height - self.height) / 2; border-radius: 12px;
            background: root.tint.with-alpha(root.c.on ? 0.18 : 0.08);
            Glyph { d: BotLook.icon(root.c.id); width: 22px; height: 22px; x: 9px; y: 9px; fill: root.c.on ? root.tint : Theme.muted; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text { text: root.c.name; color: Theme.text; font-weight: 700; font-size: 14px; }
            Text { text: root.c.note; color: Theme.muted; font-size: 12px; overflow: elide; }
        }
        if root.c.open: VerticalLayout { alignment: center; IconButton { d: Icons.gear; size: 32px; tip: root.c.name + ": its settings"; clicked => { root.act("sheet:" + root.c.id); } } }
        if root.c.id == "games" || root.c.id == "actions": VerticalLayout { alignment: center; IconButton { d: Icons.open; size: 32px; filled: root.c.id == "actions"; tip: root.c.id == "games" ? "Add games from Actions' templates" : "Open your actions"; clicked => { root.act("actions"); } } }
        if root.c.id != "games" && root.c.id != "actions" && root.c.id != "import": CenterToggle { checked: root.c.on; toggled => { root.set("feat:" + root.c.id, self.checked ? "true" : "false"); } }
    }
                }

/// The page
component BotPage inherits Rectangle {
    /// (its Widgets, or its Docks, as a page of their own ("widgets", "docks"): the rest of it hidden)
    in property <string> widgets-view;
    /// (the page's own colour, behind a settings page of its own)
    in property <brush> page-bg: Theme.panel;
    in property <bool> setup;
    in property <string> name;
    in property <string> sub;
    in property <bool> running;
    in property <string> stats;
    in property <[BotTile]> tiles;
    in property <[BotFeat]> feats;
    in property <[BotStep]> steps;
    in property <[BotField]> step-fields;
    in property <[BotLine]> log;
    in property <[BotLine]> tried;
    in property <[string]> examples;
    in property <string> sheet;
    in property <string> sheet-title;
    in property <[BotField]> sheet-fields;
    /// (a widget's page with a preview: split, the preview on the right)
    in property <bool> sheet-split;
    in property <int> port: 7878;
    in property <bool> widget-on;
    in property <[SetRow]> stream-rows;
    in property <length> foot: 24px;
    callback set(string, string);
    callback act(string);
    callback try-it(string);


    // ----- the first time: the path -----
    if root.setup && root.sheet == "": ScrollView {
        width: parent.width;
        height: parent.height;
        VerticalLayout {
            padding-right: 12px;
            padding-bottom: root.foot;
            spacing: 0px;
            alignment: start;
            HorizontalLayout {
                padding-bottom: 14px;
                padding-left: 46px;
                Text { text: "Let's set up your chatbot"; color: Theme.text; font-size: 20px; font-weight: 800; horizontal-stretch: 1; }
                Text { text: "Skip setup"; color: sk.has-hover ? Theme.text : Theme.muted; font-size: 12px; vertical-alignment: center; sk := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.act("setup:done"); } } }
            }
            for st[i] in root.steps: HorizontalLayout {
                spacing: 12px;
                // (its place on the path: lit as far as it's come)
                Rectangle {
                    width: 34px;
                    property <bool> lit: st.state == "done" || st.state == "skipped";
                    if i < root.steps.length - 1: Rectangle { x: (parent.width - 2px) / 2; y: 34px; width: 2px; height: parent.height - 34px; background: parent.lit ? #4ad295 : Theme.line; }
                    Rectangle {
                        y: 10px;
                        x: (parent.width - self.width) / 2;
                        width: 26px;
                        height: 26px;
                        border-radius: 13px;
                        background: st.state == "done" ? #4ad295 : st.state == "now" ? Theme.accent : st.state == "skipped" ? Theme.elevated : Theme.elevated;
                        border-width: st.state == "now" ? 4px : 1px;
                        border-color: st.state == "now" ? Theme.accent.with-alpha(0.3) : Theme.line;
                        if st.state == "done": Glyph { d: Icons.check; width: 16px; height: 16px; x: 5px; y: 5px; fill: Theme.on-accent; }
                        if st.state != "done": Text { text: st.state == "skipped" ? "\u{2013}" : "" + (i + 1); color: st.state == "now" ? Theme.on-accent : Theme.muted; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    // (the one being done: open; the rest one line each)
                    height: sc.preferred-height + 12px;
                    sc := Rectangle {
                        y: 0;
                        height: sci.preferred-height;
                        border-radius: 14px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: st.state == "now" ? Theme.accent : Theme.line;
                        opacity: st.state == "todo" ? 0.7 : 1;
                        sci := VerticalLayout {
                            padding: 12px;
                            padding-left: 14px;
                            spacing: 10px;
                            HorizontalLayout {
                                spacing: 10px;
                                VerticalLayout { alignment: center; Glyph { d: st.id == "twitchbot" || st.id == "kickbot" ? Icons.robot : BotLook.icon(st.id == "features" ? "actions" : st.id); width: 20px; height: 20px; fill: BotLook.tint(st.id); } }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 1px;
                                    Text { text: st.title; color: Theme.text; font-weight: 700; font-size: 14px; }
                                    Text { text: st.note; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                }
                                if st.state != "now": VerticalLayout { alignment: center; IconButton { d: st.state == "todo" ? Icons.play : Icons.gear; size: 32px; tip: st.state == "todo" ? "Do this step now" : "Change it"; clicked => { root.act("step:" + st.id); } } }
                            }
                            if st.state == "now": VerticalLayout {
                                spacing: 10px;
                                Rectangle { height: 1px; background: Theme.line; }
                                for f in root.step-fields: BotFieldRow { f: f; set(k, v) => { root.set(k, v); } act(a) => { root.act(a); } }
                                HorizontalLayout {
                                    alignment: end;
                                    spacing: 8px;
                                    if st.optional: Pill { label: "Skip"; tip: "Not now: it can be set up later, from its tile"; clicked => { root.act("skip:" + st.id); } }
                                    Pill { label: st.id == "features" ? "Finish" : "Next"; on: true; clicked => { root.act("next:" + st.id); } }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ----- after: the control room (hidden while one of its settings pages is open) -----
    if !root.setup && root.sheet == "": ScrollView {
        width: parent.width;
        height: parent.height;
        VerticalLayout {
            padding-right: 12px;
            padding-bottom: root.foot;
            spacing: 14px;
            alignment: start;
            if root.widgets-view == "": VerticalLayout {
                spacing: 14px;
                // the bot, and a chat to try it in
                HorizontalLayout {
                    spacing: 12px;
                    height: 168px;
                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 18px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Theme.line;
                        HorizontalLayout {
                            padding: 16px;
                            spacing: 16px;
                            // (rings round it, turning slowly while it's running)
                            Rectangle {
                                width: 92px;
                                height: 92px;
                                y: (parent.height - self.height) / 2;
                                property <float> spin: root.running && Theme.motion ? mod(animation-tick() / 1ms, 12000) / 12000 : 0;
                                Rectangle { border-radius: self.width / 2; border-width: 2px; border-color: Theme.accent.with-alpha(root.running ? 0.35 : 0.12); }
                                Rectangle { x: 8px; y: 8px; width: parent.width - 16px; height: self.width; border-radius: self.width / 2; border-width: 2px; border-color: Theme.accent-2.with-alpha(root.running ? 0.6 : 0.15); }
                                if root.running: Rectangle {
                                    x: parent.width / 2 - 4px + (parent.width / 2 - 1px) * cos(parent.spin * 360deg);
                                    y: parent.height / 2 - 4px + (parent.height / 2 - 1px) * sin(parent.spin * 360deg);
                                    width: 8px; height: 8px; border-radius: 4px; background: Theme.accent;
                                }
                                Rectangle {
                                    x: 18px; y: 18px; width: parent.width - 36px; height: self.width; border-radius: self.width / 2; background: Theme.elevated;
                                    Glyph { d: Icons.robot; width: 30px; height: 30px; x: (parent.width - 30px) / 2; y: (parent.height - 30px) / 2; fill: root.running ? Theme.accent : Theme.muted; }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: root.name; color: Theme.text; font-size: 20px; font-weight: 800; overflow: elide; horizontal-stretch: 1; }
                                    IconButton { d: root.running ? Icons.pause : Icons.play; size: 32px; filled: !root.running; tip: root.running ? "Stop the chatbot" : "Start the chatbot"; clicked => { root.act("run"); } }
                                }
                                Text { text: root.sub; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    for t in root.tiles: Rectangle {
                                        visible: t.state != "off";
                                        width: t.state != "off" ? chip.preferred-width + 30px : 0px;
                                        height: 22px;
                                        border-radius: 11px;
                                        background: BotLook.tint(t.id).with-alpha(0.15);
                                        chip := Text { x: 22px; text: t.name; color: BotLook.tint(t.id).mix(Theme.text, 0.6); font-size: 11px; vertical-alignment: center; }
                                        Light { x: 9px; y: 7px; state: t.state; }
                                    }
                                }
                                Text { text: root.stats; color: Theme.muted; font-size: 12px; }
                            }
                        }
                    }
                    Rectangle {
                        width: 300px;
                        border-radius: 18px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Theme.line;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            // (a chat of its own, to try commands in: only you see it)
                            HorizontalLayout {
                                spacing: 6px;
                                VerticalLayout { alignment: center; Glyph { d: Icons.flask; width: 16px; height: 16px; fill: Theme.accent; } }
                                Text { text: "Test chat"; color: Theme.text; font-size: 13px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                                Rectangle {
                                    width: pv.preferred-width + 14px;
                                    height: 18px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 9px;
                                    background: Theme.elevated;
                                    pv := Text { x: 7px; text: "private"; color: Theme.muted; font-size: 10px; vertical-alignment: center; }
                                }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                VerticalLayout {
                                    alignment: end;
                                    spacing: 4px;
                                    if root.tried.length == 0: Text { text: "Try a command. Only you see this."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                    // (some to try, from what it answers: a click tries it)
                                    if root.tried.length == 0: HorizontalLayout {
                                        spacing: 5px;
                                        alignment: start;
                                        for ex in root.examples: Rectangle {
                                            width: ext.preferred-width + 18px;
                                            height: 22px;
                                            border-radius: 11px;
                                            background: exa.has-hover ? Theme.accent.with-alpha(0.18) : Theme.elevated;
                                            border-width: 1px;
                                            border-color: Theme.line;
                                            ext := Text { x: 9px; text: ex; color: Theme.accent.mix(Theme.text, 0.4); font-size: 11px; vertical-alignment: center; }
                                            exa := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.try-it(ex); } }
                                        }
                                    }
                                    for b in root.tried: HorizontalLayout {
                                        alignment: b.who == "You" ? end : start;
                                        Rectangle {
                                            width: min(bt.preferred-width + 20px, 250px);
                                            height: bt.preferred-height + 10px;
                                            border-radius: 10px;
                                            background: b.who == "You" ? Theme.elevated : Theme.accent.with-alpha(0.16);
                                            bt := Text { x: 10px; width: parent.width - 20px; text: b.did; color: b.who == "You" ? Theme.text : Theme.accent.mix(Theme.text, 0.35); font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Rectangle {
                                    clip: true;
                                    horizontal-stretch: 1;
                                    height: 32px;
                                    border-radius: 16px;
                                    background: Theme.bg;
                                    border-width: 1px;
                                    border-color: tin.has-focus ? Theme.accent : Theme.line;
                                    tin := TextInput { property <length> sx; cursor-position-changed(p) => { if (p.x + self.sx < 0px) { self.sx = -p.x; } else if (p.x + self.sx > parent.width - 24px - 2px) { self.sx = parent.width - 24px - 2px - p.x; } }  x: 12px + min(0px, max(parent.width - 24px - self.width, self.sx)); width: max(parent.width - 24px, self.preferred-width + 4px); height: parent.height; vertical-alignment: center; color: Theme.text; font-size: 12px; single-line: true; accepted => { if (self.text != "") { root.try-it(self.text); self.text = ""; } } }
                                    if tin.text == "": Text { x: 12px; text: "Type a command"; color: Theme.muted.with-alpha(0.6); font-size: 12px; vertical-alignment: center; }
                                }
                                IconButton { d: Icons.send; size: 32px; tint: Theme.accent; tip: "Test it (only you see it)"; clicked => { if (tin.text != "") { root.try-it(tin.text); tin.text = ""; } } }
                            }
                        }
                    }
                }
                // where it's connected
                Text { text: "Connections"; color: Theme.muted; font-size: 12px; font-weight: 700; }
                HorizontalLayout {
                    spacing: 8px;
                    for t[ti] in root.tiles: Rectangle {
                        horizontal-stretch: 1;
                        height: 112px;
                        border-radius: 14px;
                        background: tta.has-hover ? Theme.elevated.mix(BotLook.tile(ti), 0.84) : Theme.panel.mix(BotLook.tile(ti), 0.9);
                        border-width: 1px;
                        border-color: t.state == "off" ? BotLook.tile(ti).with-alpha(0.28) : BotLook.tint(t.id).with-alpha(0.7);
                        tta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.act("sheet:" + t.id); } }
                        VerticalLayout {
                            padding: 12px;
                            spacing: 5px;
                            HorizontalLayout {
                                spacing: 6px;
                                Glyph { d: BotLook.icon(t.id); width: 16px; height: 16px; fill: t.state == "off" ? Theme.muted : BotLook.tint(t.id); }
                                Text { text: t.name; color: Theme.text; font-weight: 700; font-size: 13px; overflow: elide; horizontal-stretch: 1; }
                            }
                            HorizontalLayout { spacing: 6px; Light { y: 5px; state: t.state; } Text { text: t.line1; color: Theme.text.mix(Theme.muted, 0.4); font-size: 12px; overflow: elide; horizontal-stretch: 1; } }
                            Text { text: t.line2; color: Theme.muted; font-size: 11px; overflow: elide; }
                            Rectangle { vertical-stretch: 1; }
                            HorizontalLayout {
                                alignment: end;
                                IconButton { d: t.state == "off" ? Icons.add : Icons.gear; size: 28px; tint: t.state == "off" ? Theme.accent : Theme.muted; tip: t.state == "off" ? "Set up " + t.name : t.name + "'s settings and sign-ins"; clicked => { root.act("sheet:" + t.id); } }
                            }
                        }
                    }
                }
                Text { text: "Chatbot"; color: Theme.muted; font-size: 12px; font-weight: 700; }
                for r in ceil(root.feats.length / 2): HorizontalLayout {
                    spacing: 10px;
                    FeatCard { tint: BotLook.tile(r * 2 + 2); horizontal-stretch: 1; preferred-width: 0px; min-width: 0px; c: root.feats[r * 2]; set(k, v) => { root.set(k, v); } act(a) => { root.act(a); } }
                    if r * 2 + 1 < root.feats.length: FeatCard { tint: BotLook.tile(r * 2 + 3); horizontal-stretch: 1; preferred-width: 0px; min-width: 0px; c: root.feats[r * 2 + 1]; set(k, v) => { root.set(k, v); } act(a) => { root.act(a); } }
                    if r * 2 + 1 >= root.feats.length: Rectangle { horizontal-stretch: 1; preferred-width: 0px; min-width: 0px; }
                }
                // the widgets (in a scene, for your viewers) and the docks (in OBS, for you): side by side, their own pages from them
                Text { text: "Widgets and Docks"; color: Theme.muted; font-size: 12px; font-weight: 700; }
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        min-width: 0px;
                        height: 74px;
                        border-radius: 16px;
                        background: widgetsa.has-hover ? Theme.elevated.mix(BotLook.tile(4), 0.86) : Theme.panel.mix(BotLook.tile(4), 0.9);
                        border-width: 1px;
                        border-color: BotLook.tile(4).with-alpha(0.45);
                        widgetsa := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.act("widgets"); } }
                        HorizontalLayout {
                            padding: 14px;
                            spacing: 12px;
                            Rectangle {
                                width: 40px;
                                height: 40px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 12px;
                                background: BotLook.tile(4).with-alpha(0.18);
                                Glyph { d: Icons.broadcast; width: 22px; height: 22px; x: 9px; y: 9px; fill: BotLook.tile(4); }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                Text { text: "Your Widgets"; color: Theme.text; font-size: 14px; font-weight: 700; overflow: elide; }
                                Text { text: "Browser sources for your scenes: the Stream Widget, alerts, goals and the rest."; color: Theme.muted; font-size: 12px; overflow: elide; }
                            }
                            VerticalLayout { alignment: center; Pill { label: "Open"; clicked => { root.act("widgets"); } } }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        min-width: 0px;
                        height: 74px;
                        border-radius: 16px;
                        background: docksa.has-hover ? Theme.elevated.mix(BotLook.tile(5), 0.86) : Theme.panel.mix(BotLook.tile(5), 0.9);
                        border-width: 1px;
                        border-color: BotLook.tile(5).with-alpha(0.45);
                        docksa := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.act("docks"); } }
                        HorizontalLayout {
                            padding: 14px;
                            spacing: 12px;
                            Rectangle {
                                width: 40px;
                                height: 40px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 12px;
                                background: BotLook.tile(5).with-alpha(0.18);
                                Glyph { d: Icons.chat; width: 22px; height: 22px; x: 9px; y: 9px; fill: BotLook.tile(5); }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                Text { text: "Your Docks"; color: Theme.text; font-size: 14px; font-weight: 700; overflow: elide; }
                                Text { text: "Panels in OBS, just for you: the Chat Dock and the Activity Feed."; color: Theme.muted; font-size: 12px; overflow: elide; }
                            }
                            VerticalLayout { alignment: center; Pill { label: "Open"; clicked => { root.act("docks"); } } }
                        }
                    }
                }
                Text { text: "Creators"; color: Theme.muted; font-size: 12px; font-weight: 700; }
                Rectangle {
                    height: 74px;
                    border-radius: 16px;
                    background: creatorsa.has-hover ? Theme.elevated.mix(BotLook.tile(6), 0.86) : Theme.panel.mix(BotLook.tile(6), 0.9);
                    border-width: 1px;
                    border-color: BotLook.tile(6).with-alpha(0.45);
                    creatorsa := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.act("creators"); } }
                    HorizontalLayout {
                        padding: 14px;
                        spacing: 12px;
                        Rectangle {
                            width: 40px;
                            height: 40px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 12px;
                            background: BotLook.tile(6).with-alpha(0.18);
                            Glyph { d: Icons.star-out; width: 22px; height: 22px; x: 9px; y: 9px; fill: BotLook.tile(6); }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text { text: "Your Creators"; color: Theme.text; font-size: 14px; font-weight: 700; }
                            Text { text: "Make your own: a webcam overlay with your widgets built in, and your channel panels."; color: Theme.muted; font-size: 12px; overflow: elide; }
                        }
                        VerticalLayout { alignment: center; Pill { label: "Open"; clicked => { root.act("creators"); } } }
                    }
                }
                // what it's been doing
                Rectangle {
                    border-radius: 14px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.line;
                    height: lg.preferred-height;
                    lg := VerticalLayout {
                        padding: 12px;
                        spacing: 6px;
                        HorizontalLayout {
                            Text { text: "Lately: what it heard, and what it did"; color: Theme.muted; font-size: 12px; horizontal-stretch: 1; }
                            // (now and then: your commands and actions from another bot, or setup again)
                            HorizontalLayout {
                                spacing: 14px;
                                Text { text: "Import from another bot"; color: im.has-hover ? Theme.text : Theme.muted; font-size: 11px; im := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.act("sheet:import"); } } }
                                Text { text: "Run setup again"; color: rs.has-hover ? Theme.text : Theme.muted; font-size: 11px; rs := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.act("setup:again"); } } }
                            }
                        }
                        if root.log.length == 0: Text { text: "Nothing yet: once it's running, what it answers shows here."; color: Theme.muted.with-alpha(0.7); font-size: 12px; }
                        for l in root.log: HorizontalLayout {
                            spacing: 8px;
                            Rectangle { width: 3px; border-radius: 1px; background: BotLook.tint(l.platform); }
                            Text { text: l.who; color: BotLook.tint(l.platform).mix(Theme.text, 0.5); font-size: 12px; font-weight: 700; }
                            Text { text: l.heard; color: Theme.muted; font-size: 12px; overflow: elide; max-width: 220px; }
                            Glyph { d: Icons.next; width: 12px; height: 12px; y: 2px; fill: Theme.muted; }
                            Text { text: l.did; color: Theme.text; font-size: 12px; overflow: elide; horizontal-stretch: 1; }
                        }
                    }
                }
            }
            // (Widgets and Docks, on a page of their own)
            if root.widgets-view != "": VerticalLayout {
                spacing: 14px;
                // the widgets (here while the chatbot's on), its OBS docks, and chat on stream
                if root.widgets-view == "widgets": HorizontalLayout {
                    spacing: 0px;
                    for r in root.stream-rows: HorizontalLayout {
                        horizontal-stretch: (r.key == "widget" || r.key == "lyricsWidget" || r.key == "socials") ? 1 : 0;
                        preferred-width: 0px;
                        min-width: 0px;
                        padding-right: r.key == "widget" || r.key == "lyricsWidget" ? 8px : 0px;
                        if r.key == "widget": StreamTile { tint: BotLook.tile(0); horizontal-stretch: 1; r: r; d: Icons.broadcast; addr: "http://127.0.0.1:" + root.port + "/"; toggle(k) => { root.act("row-toggle:" + k); } more(k) => { root.act("row-more:" + k); } copy(a) => { root.act("copy:" + a); } }
                        if r.key == "lyricsWidget": StreamTile { tint: BotLook.tile(1); horizontal-stretch: 1; r: r; d: Icons.lyrics; addr: "http://127.0.0.1:" + root.port + "/lyrics"; toggle(k) => { root.act("row-toggle:" + k); } more(k) => { root.act("row-more:" + k); } copy(a) => { root.act("copy:" + a); } }
                        if r.key == "socials": StreamTile { tint: BotLook.tile(2); horizontal-stretch: 1; r: r; d: Icons.link; addr: "http://127.0.0.1:" + root.port + "/socials"; toggle(k) => { root.act("row-toggle:" + k); } more(k) => { root.act("row-more:" + k); } copy(a) => { root.act("copy:" + a); } }
                    }
                }
                if root.widgets-view != "creators": HorizontalLayout {
                    spacing: 8px;
                    for d[di] in root.widgets-view == "docks" ? [
                        { n: "Chat Dock", t: "Twitch and Kick chat in OBS, with delete, time-out and ban on every message, and a box to chat back.", p: "/dock/chat", i: Icons.chat, k: "dockchat" },
                        { n: "Activity Feed", t: "Follows, subs, bits, raids, rewards and the rest in OBS, each alert replayed with a click.", p: "/dock/activity", i: Icons.bell, k: "dockfeed" },
                        { n: "Moderation Dock", t: "Pile-Up, Raid Lockdown, chat modes, Shield Mode and Auto-Ban on their own, beside your chat. Its settings are the Chat Dock's.", p: "/dock/mod", i: Icons.shield, k: "dockchat" },
                    ] : [
                        { n: "Multichat Overlay", t: "Twitch and Kick chat together on stream, with a see-through background.", p: "/chat", i: Icons.broadcast, k: "multichat" },
                    ]: Rectangle {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        min-width: 0px;
                        height: 92px;
                        border-radius: 14px;
                        background: Theme.panel.mix(BotLook.tile(di + 3), 0.9);
                        border-width: 1px;
                        border-color: BotLook.tile(di + 3).with-alpha(0.3);
                        dta := TouchArea { }
                        TipSpot { tip: d.t; hover: dta.has-hover; }
                        VerticalLayout {
                            padding: 12px;
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 7px;
                                VerticalLayout { alignment: center; Glyph { d: d.i; width: 16px; height: 16px; fill: root.widget-on ? Theme.accent : Theme.muted; } }
                                Text { text: d.n; color: Theme.text; font-weight: 700; font-size: 13px; horizontal-stretch: 1; overflow: elide; }
                                if d.k == "multichat": CenterToggle { checked: Wid.on("multichat", Wid.rev); toggled => { root.act("woff:multichat"); } }
                                IconButton { d: Icons.copy; size: 30px; tip: "Copy its address, for OBS"; clicked => { root.act("copy:http://127.0.0.1:" + root.port + d.p); } }
                                IconButton { d: Icons.gear; size: 30px; tip: d.n + ": its settings"; clicked => { root.act("dockset:" + d.k); } }
                            }
                            Text { text: "http://127.0.0.1:" + root.port + d.p; color: Theme.accent.mix(Theme.text, 0.55); font-size: 11px; font-family: "Consolas"; overflow: elide; }
                            Text { text: root.widget-on ? d.t : "Turn on the Stream Widget first (Settings > Streaming). This is served from it."; color: Theme.muted; font-size: 11px; overflow: elide; }
                        }
                    }
                }
                // the Suite's own widgets: what's happened on stream, shown
                if root.widgets-view == "widgets": HorizontalLayout {
                    spacing: 8px;
                    for w[wi] in [
                        { n: "Goals", k: "goals", p: "/goals", s: "goals", i: Icons.check, h: "127.0.0.1" },
                        { n: "Timer", k: "timer", p: "/timer", s: "timer", i: Icons.refresh, h: "127.0.0.1" },
                        { n: "Latest Follow", k: "latest-follow", p: "/latest-follow", s: "latest", i: Icons.heart-out, h: "127.0.0.1" },
                        { n: "Latest Sub", k: "latest-sub", p: "/latest-sub", s: "latest", i: Icons.star-out, h: "127.0.0.1" },
                        { n: "Raid Shoutout", k: "raid", p: "/raid", s: "raid", i: Icons.broadcast, h: "localhost" },
                    ]: Rectangle {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        min-width: 0px;
                        height: 74px;
                        border-radius: 14px;
                        background: Theme.panel.mix(BotLook.tile(wi + 1), 0.9);
                        border-width: 1px;
                        border-color: BotLook.tile(wi + 1).with-alpha(0.3);
                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 6px;
                                VerticalLayout { alignment: center; Glyph { d: w.i; width: 15px; height: 15px; fill: Theme.accent; } }
                                Text { text: w.n; color: Theme.text; font-weight: 700; font-size: 12px; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
CenterToggle { checked: Wid.on(w.k, Wid.rev); toggled => { root.act("woff:" + w.k); } }
                                IconButton { d: Icons.copy; size: 28px; tip: "Copy its address, for OBS"; clicked => { root.act("copy:http://" + w.h + ":" + root.port + w.p); } }
                                IconButton { d: Icons.gear; size: 28px; tip: "Its settings"; clicked => { root.act("sheet:" + w.s); } }
                            }
                            Text { text: "http://" + w.h + ":" + root.port + w.p; color: Theme.accent.mix(Theme.text, 0.55); font-size: 10px; font-family: "Consolas"; overflow: elide; }
                        }
                    }
                }
                // the fun: chat playing along, shown
                // the Creators: what you've made, each its own source
                if root.widgets-view == "creators": Rectangle {
                    height: 92px;
                    border-radius: 14px;
                    background: Theme.panel.mix(BotLook.tile(6), 0.9);
                    border-width: 1px;
                    border-color: BotLook.tile(6).with-alpha(0.3);
                    VerticalLayout {
                        padding: 12px;
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 7px;
                            VerticalLayout { alignment: center; Glyph { d: Icons.star-out; width: 16px; height: 16px; fill: Theme.accent; } }
                            Text { text: "Webcam Overlay"; color: Theme.text; font-weight: 700; font-size: 13px; horizontal-stretch: 1; overflow: elide; }
CenterToggle { checked: Wid.on("cam", Wid.rev); toggled => { root.act("woff:" + "cam"); } }
                            IconButton { d: Icons.copy; size: 30px; tip: "Copy its address, for OBS"; clicked => { root.act("copy:http://127.0.0.1:" + root.port + "/cam/main"); } }
                            IconButton { d: Icons.gear; size: 30px; tip: "Make it yours"; clicked => { root.act("sheet:cam"); } }
                        }
                        Text { text: "http://127.0.0.1:" + root.port + "/cam/main"; color: Theme.accent.mix(Theme.text, 0.55); font-size: 11px; font-family: "Consolas"; overflow: elide; }
                        Text { text: "A frame round your camera, with your name, alerts, Now Playing, chat and more on it: one Browser source."; color: Theme.muted; font-size: 11px; overflow: elide; }
                    }
                }
                if root.widgets-view == "creators": Rectangle {
                    height: 92px;
                    border-radius: 14px;
                    background: Theme.panel.mix(BotLook.tile(7), 0.9);
                    border-width: 1px;
                    border-color: BotLook.tile(7).with-alpha(0.3);
                    VerticalLayout {
                        padding: 12px;
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 7px;
                            VerticalLayout { alignment: center; Glyph { d: Icons.actions; width: 16px; height: 16px; fill: Theme.accent; } }
                            Text { text: "Panels"; color: Theme.text; font-weight: 700; font-size: 13px; horizontal-stretch: 1; overflow: elide; }
                            IconButton { d: Icons.open; size: 30px; tip: "Open them to save as pictures"; clicked => { root.act("url:http://127.0.0.1:" + root.port + "/panels"); } }
                            IconButton { d: Icons.gear; size: 30px; tip: "Make them yours"; clicked => { root.act("sheet:panels"); } }
                        }
                        Text { text: "Your channel's panels (About, Schedule, Rules...) in one theme, saved as pictures for Twitch or Kick."; color: Theme.muted; font-size: 11px; overflow: elide; }
                    }
                }
                if root.widgets-view == "creators": Rectangle {
                    height: 92px;
                    border-radius: 14px;
                    background: Theme.panel.mix(BotLook.tile(8), 0.9);
                    border-width: 1px;
                    border-color: BotLook.tile(8).with-alpha(0.3);
                    VerticalLayout {
                        padding: 12px;
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 7px;
                            VerticalLayout { alignment: center; Glyph { d: Icons.broadcast; width: 16px; height: 16px; fill: Theme.accent; } }
                            Text { text: "Game HUD Frames"; color: Theme.text; font-weight: 700; font-size: 13px; horizontal-stretch: 1; overflow: elide; }
CenterToggle { checked: Wid.on("hud", Wid.rev); toggled => { root.act("woff:" + "hud"); } }
                            IconButton { d: Icons.copy; size: 30px; tip: "Copy its address, for OBS"; clicked => { root.act("copy:http://127.0.0.1:" + root.port + "/hud"); } }
                            IconButton { d: Icons.gear; size: 30px; tip: "Make them"; clicked => { root.act("sheet:hud"); } }
                        }
                        Text { text: "http://127.0.0.1:" + root.port + "/hud"; color: Theme.accent.mix(Theme.text, 0.55); font-size: 11px; font-family: "Consolas"; overflow: elide; }
                        Text { text: "Frames round your game's minimap, health and the rest, marked on a screenshot of it."; color: Theme.muted; font-size: 11px; overflow: elide; }
                    }
                }
                if root.widgets-view == "widgets": Text { text: "Fun"; color: Theme.muted; font-size: 12px; font-weight: 700; }
                // (two rows of three: six in one cut their names short)
                if root.widgets-view == "widgets": VerticalLayout {
                  spacing: 8px;
                  for row[ri] in [
                    [{ n: "Hype Train", k: "hype", p: "/hype", s: "hype", i: Icons.broadcast },
                        { n: "Vote Skip", k: "voteskip", p: "/voteskip", s: "voteskip", i: Icons.next },
                        { n: "Spin the Wheel", k: "wheel", p: "/wheel", s: "wheel", i: Icons.dice }],
                    [{ n: "Leaderboard", k: "leaderboard", p: "/leaderboard", s: "leaderboard", i: Icons.coins },
                        { n: "Emote Rain", k: "emotes", p: "/emotes", s: "emoterain", i: Icons.chat },
                        { n: "Name That Tune", k: "tune", p: "/tune", s: "tune", i: Icons.lyrics }],
                    [{ n: "Sponsor Plug", k: "sponsors", p: "/sponsors", s: "sponsors", i: Icons.link }],
                  ]: HorizontalLayout {
                    spacing: 8px;
                    for w[wi] in row: Rectangle {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        min-width: 0px;
                        height: 74px;
                        border-radius: 14px;
                        background: Theme.panel.mix(BotLook.tile(wi + ri * 3 + 3), 0.9);
                        border-width: 1px;
                        border-color: BotLook.tile(wi + ri * 3 + 3).with-alpha(0.3);
                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 6px;
                                VerticalLayout { alignment: center; Glyph { d: w.i; width: 15px; height: 15px; fill: Theme.accent; } }
                                Text { text: w.n; color: Theme.text; font-weight: 700; font-size: 12px; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
CenterToggle { checked: Wid.on(w.k, Wid.rev); toggled => { root.act("woff:" + w.k); } }
                                IconButton { d: Icons.copy; size: 28px; tip: "Copy its address, for OBS"; clicked => { root.act("copy:http://127.0.0.1:" + root.port + w.p); } }
                                IconButton { d: Icons.gear; size: 28px; tip: "Its settings"; clicked => { root.act("sheet:" + w.s); } }
                            }
                            Text { text: "http://127.0.0.1:" + root.port + w.p; color: Theme.accent.mix(Theme.text, 0.55); font-size: 10px; font-family: "Consolas"; overflow: elide; }
                        }
                    }
                  }
                }
                // what it does
            }
        }
    }

    // ----- a service's (or a feature's, or a widget's) settings: a page of their own, as every page in Settings
    // is, its name in the page's title and crumbs (Back goes to where it was opened from) -----
    // (Panels and the Webcam Overlay: split down the middle, the settings on the left, the preview (and
    // Panels' Save) on the right, staying put)
    if root.sheet == "panels" || root.sheet == "cam" || root.sheet-split: Rectangle {
        // (see-through: the page's own gradient behind the settings, as on every page; the preview has its own)
        // (to the page's foot, as the other pages are: the player's room is at the end of what scrolls)
        HorizontalLayout {
            spacing: 18px;
            // (the settings: the width that's left, whatever their words' length)
            ScrollView {
                horizontal-stretch: 1;
                preferred-width: 0px;
                min-width: 0px;
                horizontal-scrollbar-policy: always-off;
                // (as wide inside as it shows: the notes wrap, the boxes fit)
                viewport-width: self.visible-width;
                VerticalLayout {
                    width: parent.width;
                    padding-right: 12px;
                    padding-bottom: root.foot;
                    spacing: 12px;
                    alignment: start;
                    for f in root.sheet-fields: VerticalLayout {
                        // (a heading and a note as they are; the preview's on the right; everything else in a card of its own)
                        if f.kind == "head" || f.kind == "note": BotFieldRow { f: f; set(k, v) => { root.set(k, v); } act(a) => { root.act(a); } }
                        if f.kind != "head" && f.kind != "note" && f.kind != "suiteprev": Rectangle {
                            background: Theme.panel;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Theme.line;
                            // (as tall as what's in it, its words wrapped at the column's width)
                            sfp := VerticalLayout { padding: 14px; BotFieldRow { f: f; set(k, v) => { root.set(k, v); } act(a) => { root.act(a); } } }
                        }
                    }
                }
            }
            // (the preview: its own column, as tall as the page, scrolled on its own if the panels are taller)
            VerticalLayout {
                width: 372px;
                spacing: 10px;
                if root.sheet == "cam": VerticalLayout {
                    spacing: 6px;
                    alignment: start;
                    vertical-stretch: 1;
                    Text { text: "Your webcam's area, with a made-up camera"; color: Theme.muted; font-size: 11px; }
                    CamPreview { }
                    Text { text: "It's where your camera is on your stream, with the parts round it. The frame and the parts change here as you change them."; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                }
                if root.sheet == "panels": HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Pill { label: "Save Them as Pictures"; on: true; clicked => { root.act("url:http://127.0.0.1:" + root.port + "/panels"); } }
                    VerticalLayout { alignment: center; Text { text: "Opens in your browser, each with Save as PNG."; color: Theme.muted; font-size: 11px; wrap: word-wrap; } }
                }
                // (a widget's preview: picture-in-picture, at the top, staying put)
                if root.sheet-split: VerticalLayout {
                    spacing: 6px;
                    alignment: start;
                    vertical-stretch: 1;
                    for f in root.sheet-fields: VerticalLayout {
                        if f.kind == "suiteprev": BotFieldRow { f: f; set(k, v) => { root.set(k, v); } act(a) => { root.act(a); } }
                    }
                }
                if root.sheet == "panels": ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    viewport-width: self.visible-width;
                    VerticalLayout { padding-bottom: root.foot; PanelPreview { width: 360px; } }
                }
            }
        }
    }
    if root.sheet != "" && root.sheet != "panels" && root.sheet != "cam" && !root.sheet-split: Rectangle {
        // (see-through, as the split pages: the page's gradient behind its cards; the page under it is hidden
        // while a sheet's open)
        ScrollView {
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                padding-right: 12px;
                padding-bottom: root.foot;
                spacing: 12px;
                alignment: start;
                for f in root.sheet-fields: VerticalLayout {
                    // (a heading, a note and a preview as they are; everything else in a card of its own)
                    if f.kind == "head" || f.kind == "note" || f.kind == "suiteprev": BotFieldRow { f: f; set(k, v) => { root.set(k, v); } act(a) => { root.act(a); } }
                    if f.kind != "head" && f.kind != "note" && f.kind != "suiteprev": Rectangle {
                        background: Theme.panel;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.line;
                        height: sfc.preferred-height;
                        sfc := VerticalLayout { padding: 14px; BotFieldRow { f: f; set(k, v) => { root.set(k, v); } act(a) => { root.act(a); } } }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    changed width => { Win.w = self.width; root.window-resized(); }
    changed height => { Win.h = self.height; root.window-resized(); }
    title: root.app-name != "" ? root.app-name : "OmniPulse";
    // (the window's own icon: Task Manager's Apps list and Alt+Tab take it from the window, not the exe)
    icon: @image-url("../../../src-tauri/icons/128x128.png");
    // Settings > App > Display Name: in the title bar and the taskbar (the web app's appName)
    in-out property <string> app-name;
    callback app-name-changed(string);
    in property <bool> title-prompt;
    callback title-rename();
    /// the name being typed in the title bar
    in-out property <bool> title-editing;
    callback title-signin();
    // Settings > App > Listening Along: Timing, in ms (the web app's listenNudge)
    in-out property <string> listen-nudge: "0";
    callback listen-nudge-changed(string);
    no-frame: true;
    background: Theme.bg;
    preferred-width: 1180px;
    preferred-height: 760px;
    // Settings > App & Look > Player Style: "tab" (the default), "bar", "float" or "minimal"; the
    // window's narrowest follows it (the others put everything on one row)
    in property <string> player-style: "tab";
    // (the other styles' own: what's next (DJ decks), the song's shape (Waveform), a blurred cover (Cover Strip))
    in property <string> next-title;
    in property <string> next-artist;
    in property <image> next-art;
    in property <[float]> now-wave;
    in property <image> now-art-blur;
    callback now-art-shown();
    changed now-art => { root.now-art-shown(); }
    // Sidebar: the player in the sidebar's foot (a narrow window, or the sidebar collapsed: the bar as usual)
    property <bool> side-player: root.player-style == "sidebar" && !root.slim-side;
    // Island: the pages reach the window's foot, the pill (and the bar it opens into) laid over them
    property <bool> island: root.player-style == "island";
    // (laid over the pages' foot: Tab's tab, or Island: room left under the pages' last rows to scroll past it)
    property <bool> over-foot: root.tab-style || root.island;
    callback player-style-picked(string);
    // Settings > App & Look > Title Bar Colour: "match" (the player bar's colours, changing with the cover), "subtle"
    // (the same, faint) or "plain" (the panel's colour, never changing)
    in property <string> title-colour: "match";
    callback title-colour-picked(string);
    property <bool> tab-style: root.player-style == "tab";
    min-width: root.player-style == "float" ? 1040px : root.tab-style ? 820px : 1000px;
    min-height: 520px;
    default-font-family: "Segoe UI Variable Text";

    // pages
    in property <string> page: "library";
    in-out property <string> page-kind: "tracks";
    in property <string> page-title: "Library";
    in property <string> page-sub;
    in property <[string]> chips;
    in property <int> chip-on;
    in property <[Row]> rows;
    in property <[Side]> sides;
    // your playlists on this PC, by name; the page is one of them
    in property <[string]> own-lists;
    in property <bool> own-page;
    // Track preferences (the bar's menu): its title and artist as you want them, and its start and end
    in-out property <bool> tp-open;
    in-out property <string> tp-title;
    in-out property <string> tp-artist;
    in-out property <string> tp-start;
    in-out property <string> tp-end;
    in property <string> tp-note;
    /// where its beat 1 is, moved by hand (beats; + later), for Smart Transitions (shown while they're on)
    in-out property <int> tp-beat;
    /// where its phrases (16 beats) start, moved by hand (bars; + later)
    in-out property <int> tp-phrase;
    in property <bool> tp-beat-shown;
    // "Plays from YouTube Music" (a Go+ track, a MusicBrainz song): the versions it could play, the
    // one it plays marked
    in property <[string]> tp-versions;
    in property <int> tp-version-on: -1;
    callback tp-version(int);
    // a YouTube or YouTube Music link pasted, for what it plays as
    callback tp-link(string);
    callback tp-save();
    callback tp-reset();
    // "now": where the track is playing, for its start (0) or end (1)
    callback tp-now(int);
    // the track as a bar, its part that plays between the handles (0..1); dragged (where, which end);
    // a preview of its start (0) or end (1); the whole track again; versions searched for
    in property <float> tp-from: 0;
    in property <float> tp-to: 1;
    callback tp-drag(float, int);
    callback tp-preview(int);
    callback tp-whole();
    callback tp-search(string);
    // the naming dialog (a new playlist, or renaming one)
    in-out property <bool> name-open;
    in-out property <string> name-text;
    in property <string> name-head;
    in property <string> name-ok;
    callback name-done(string);
    callback pl-new();
    // a playlist file (M3U or CSV) as a playlist on this PC: the New playlist button's right-click menu
    callback pl-import();
    callback side-action(int, string);
    // the bar's playlist button: one of yours (by its place in own-lists), or -1 for a new one
    callback bar-pl(int);
    in property <int> side-on: -1;
    in property <[Shelf]> shelves;
    // the Library's Albums chip
    in property <[Tile]> album-tiles;
    callback album-tile(int);
    in-out property <string> search-text;
    in property <bool> can-back;
    // narrower than 980 px (as the web app: set from Rust as the window changes): the sidebar down to
    // its icons, no volume slider
    in property <bool> narrow;
    // the sidebar collapsed to its icons by hand (its button, as Twitch's), kept; or by a narrow window
    in-out property <bool> side-collapsed;
    callback side-collapse(bool);
    property <bool> slim-side: root.narrow || root.side-collapsed;
    in property <[Item]> artists;
    in-out property <bool> fav-only;
    in property <bool> shuffle-on;
    in property <string> repeat-mode: "off";
    // stats
    in property <string> st-big;
    in property <string> st-sub;
    in property <string> st-top-name;
    in property <string> st-top-sub;
    in property <image> st-top-art;
    in property <[Item]> st-songs;
    in property <[Item]> st-artists;
    in property <string> st-kind;
    in property <string> st-kind-sub;
    in property <[float]> st-clock;
    in property <string> st-streak;
    in property <string> st-streak-sub;
    in property <[Item]> st-plats;
    in property <[string]> st-facts;
    // (each fact's heading, as the web app's: "Day after day", "Marathon"...)
    in property <[string]> st-fact-heads;
    // a card looked at more closely ("time", "artists", "songs", "when", "where", "streak"; "" for them all)
    in property <string> st-detail;
    in property <string> st-detail-head;
    in property <[StatBlock]> st-blocks;
    callback stats-open(string);
    callback stats-row(int);
    /// the overview's top songs (played) and top artists (their page)
    callback stats-song(int);
    /// a song right-clicked in Stats: (0) a closer look's row, (1) the overview's top songs; its menu's choice
    callback stats-act(int, int, string);
    callback stats-artist(int);
    callback stats-play-these();
    // Clear Listening History: asked once more before it's done
    in-out property <bool> st-clear-asking;
    callback stats-clear();
    // now playing
    in property <image> now-art-big;
    // App & Look's tint: its hues, left to right
    in property <image> tint-strip;
    // Now Playing's visualiser: its style (off, bars, mirror, glow), and its 32 bands, 0 to 1
    in property <string> viz-style: "off";
    // (the style where there's no cover to go round, as in the player's gaps: Ring as Centre)
    property <string> viz-flat: root.viz-style == "ring" ? "centre" : root.viz-style;
    // (the Ring's outline, each frame, while it's the style)
    in property <[RingPiece]> viz-ring;
    // a Seamless Mix under way: its crossfader (Now Playing, the player, the taskbar widget)
    in property <bool> xf-on;
    in property <float> xf-frac;
    in property <image> xf-from-art;
    in property <image> xf-to-art;
    in property <string> xf-label;
    in property <[RingPiece]> viz-ring-small;
    in property <[float]> viz-bands;
    // (and how loud it is now, 0 to 1: the Glow's)
    in property <float> viz-level;
    in property <[float]> viz-peaks;
    in property <[float]> viz-curve;
    // where it's shown: Now Playing, the player (behind its controls), full screen (the whole window)
    in-out property <bool> viz-now: true;
    in-out property <bool> viz-bar;
    /// (paused while a game, or anything else, is full screen)
    in-out property <bool> viz-game-pause: true;
    in-out property <bool> viz-full;
    callback viz-pick(string);
    callback viz-place(string, bool);
    callback viz-cycle();
    in property <string> now-album;
    // who uploaded it, where that's not its artist (Now Playing only)
    in property <string> now-uploader;
    // its tempo and key, once measured ("132 BPM · F# major · 2B")
    in property <string> now-rhythm;
    in property <[Line]> lyrics;
    in property <int> lyric-on: -1;
    in property <bool> st-empty;
    // Settings > Look (and the built-in controls, light or dark to match)
    in property <bool> light-theme;
    changed light-theme => { Palette.color-scheme = self.light-theme ? ColorScheme.light : ColorScheme.dark; }
    init => { Palette.color-scheme = self.light-theme ? ColorScheme.light : ColorScheme.dark; Win.w = self.width; Win.h = self.height; }
    in-out property <float> theme-step: 3;
    in-out property <float> tint-hue: 225;
    in-out property <float> tint-strength: 1;
    in property <string> theme-step-name;
    in property <string> tint-strength-name;
    in property <color> tint-preview;
    in property <[color]> accent-list;
    in property <int> accent-on: -1;
    /// the second accent (the web app's accent2): one of accent-list, or -1 for one colour only
    in property <int> accent2-on: -1;
    in-out property <bool> art-accent;
    // the track info tab at the bar's right end instead of its left (Settings > Look)
    in property <bool> tab-right;
    callback tab-align-picked(string);
    // the title bar: Streamer Mode, and each platform on or off
    in-out property <bool> streamer;
    in property <[Plat]> plats;
    in property <string> lyrics-note;
    /// where the lyrics are from ("Lyrics from KuGou."), and the other places to try
    in property <string> lyrics-from;
    in property <[string]> lyrics-others;
    callback lyrics-pick(int);
    // the queue and the bar
    in property <[Row]> queue-rows;
    in property <string> status;
    /// the status is a problem (red, as the web app's)
    out property <bool> status-bad: {
        root.status.to-lowercase().starts-with("couldn") || root.status.to-lowercase().starts-with("can't") || root.status.to-lowercase().starts-with("error") || root.status.to-lowercase().starts-with("skipped")
    }
    in property <string> now-title: "Nothing playing";
    /// it has start or end times of its own (Track Preferences): an asterisk after its title opens them
    in property <bool> now-trimmed;
    callback picks-copy();
    callback picks-paste();
    in property <string> now-artist;
    /// an artist's page: where they are (each platform's symbol and its count), their picture, their
    /// Wikipedia bio (three lines, all of it on a click) and its address
    in property <[ArtistOn]> artist-on;
    /// what's typed in the bar, narrowing the page: how much of it matches
    in property <string> page-find-note;
    /// the follow button's right-click: YouTube Music's line
    in property <string> follow-yt;
    /// (the self-test: the track list scrolled this far)
    in property <length> list-y;
    in property <image> page-art;
    in property <bool> page-art-on;
    // an album's page (from Search, the Albums grid or an artist's): its cover large, who by, what's on it, and
    // Like Album (every song on it liked, or the likes taken off; its Play and Shuffle are the page's own, below)
    in property <bool> album-head;
    in property <image> album-head-art;
    in property <string> album-head-by;
    in property <string> album-head-plat;
    in property <string> album-head-info;
    in property <bool> album-head-liked;
    in property <bool> album-head-can-like;
    callback album-head-act(string);
    in property <string> artist-bio;
    in property <string> artist-bio-url;
    property <bool> bio-open;
    /// its artists, each a link (several: side by side)
    in property <[string]> now-artists;
    /// genre, year and plays, as the web app's (Now Playing)
    in property <string> now-meta;
    in property <string> now-plat;
    // the next track being found (the seek bar's marquee), or found ahead while this one plays
    in property <bool> track-loading;
    // a page loading (Discover, the Library, Rediscover): its platforms, ticked as each answers; and which page
    in property <[LoadStep]> load-steps;
    in property <string> load-page;
    in property <bool> preloading;
    in property <image> now-art;
    in property <bool> playing;
    in property <float> pos-frac;
    in property <string> pos-text: "0:00";
    in property <string> dur-text: "0:00";
    in property <float> dur-secs;
    // the bar's heart and star, the output devices, and the track's menu
    in property <bool> now-liked;
    in property <bool> now-fav;
    in property <bool> can-like;
    in property <[string]> devices;
    /// Chromecast switched on (the output menu's switch, as Settings > Integrations')
    in property <bool> cast-on;
    callback cast-toggle();
    /// Settings > Sound > Output Device: Windows' devices only (no cast ones), and the one in use
    in property <[string]> outputs;
